
<odoo>
    <data>
        
        <record id="res_config_settings_discount_purchase_id" model="ir.ui.view">
            <field name="name">res.config.settings.discount.purchase.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="l10n_ve_base.l10n_ve_base_view_res_config_settings"/>
            <field name="arch" type="xml">
                
                <xpath expr="//block[@name='l10n_ve_base_block']" position="after">
                    
                    <h2>Purchase Discounts</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Discount product in purchase orders</span>
                            <div class="text-muted">
                                Define the default product to be used for applying discounts on Purchase Orders
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="purchase_discount_product_id" class="col-lg-3 o_form_label"/>
                                    <field name="purchase_discount_product_id" class="col-lg-4" />
                                </div>
                            </div>
                        </div>
                    </div>

                </xpath>
            </field>
        </record>
    </data>
</odoo>
