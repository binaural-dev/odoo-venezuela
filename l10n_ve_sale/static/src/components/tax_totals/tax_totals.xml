<templates xml:space="preserve">
    <t t-name="l10n_ve_sale.TaxTotalsField" t-inherit="account.TaxTotalsField" t-inherit-mode="extension" owl="1">
        <xpath expr="//table[1]/tbody[1]/t[1]" position="before">
            <tr t-if="totals.global_discount_mode == 'global_subtotal'">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Global discount</label>
                </td>
                <td class="o_list_monetary">
                    <span name="global_discount" style="white-space: nowrap;" dir="ltr"
                          t-out="totals.formatted_global_discount"/>
                </td>
            </tr>
        </xpath>
        <xpath expr="//tr[@t-if=&quot;'cash_rounding_base_amount_currency' in totals&quot;]" position="before">
            <tr t-if="totals.global_discount_mode == 'global_total'">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Global discount</label>
                </td>
                <td class="o_list_monetary">
                    <span name="global_discount" style="white-space: nowrap;" dir="ltr"
                          t-out="totals.formatted_global_discount"/>
                </td>
            </tr>
        </xpath>
    </t>
    <t t-name="l10n_ve_sale.TaxForeignTotalsField" t-inherit="l10n_ve_accountant.TaxForeignTotalsField" t-inherit-mode="extension" owl="1">
        <xpath expr="//tbody/t[@t-foreach='totals.subtotals']" position="before">
            <tr t-if="totals.global_discount_mode == 'global_subtotal'">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Global discount</label>
                </td>
                <td class="o_list_monetary">
                    <span style="white-space: nowrap;"
                          t-out="totals.formatted_global_discount_foreign_currency"/>
                </td>
            </tr>
        </xpath>
        <xpath expr="//tbody/tr[last()]" position="before">
            <tr t-if="totals.global_discount_mode == 'global_total'">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Global discount</label>
                </td>
                <td class="o_list_monetary">
                    <span style="white-space: nowrap;"
                          t-out="totals.formatted_global_discount_foreign_currency"/>
                </td>
            </tr>
        </xpath>
    </t>
    <t t-name="l10n_ve_sale.TaxVesTotalsField" t-inherit="l10n_ve_accountant.TaxVesTotalsField" t-inherit-mode="extension" owl="1">
        <xpath expr="//tbody/t[@t-foreach='totals.subtotals']" position="before">
            <tr t-if="totals.global_discount_mode == 'global_subtotal'">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Global discount</label>
                </td>
                <td class="o_list_monetary">
                    <span style="white-space: nowrap;"
                          t-out="showForeign ? totals.formatted_global_discount_foreign_currency : totals.formatted_global_discount_ves"/>
                </td>
            </tr>
        </xpath>
        <xpath expr="//tbody/tr[last()]" position="before">
            <tr t-if="totals.global_discount_mode == 'global_total'">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Global discount</label>
                </td>
                <td class="o_list_monetary">
                    <span style="white-space: nowrap;"
                          t-out="showForeign ? totals.formatted_global_discount_foreign_currency : totals.formatted_global_discount_ves"/>
                </td>
            </tr>
        </xpath>
    </t>
</templates>
