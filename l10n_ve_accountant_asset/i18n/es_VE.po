#. module: l10n_ve_accountant_asset
#. odoo-python
#: code:addons/l10n_ve_accountant_asset/models/account_asset.py:0
msgid ""
"The acquisition date of the asset %(asset)s is missing. Set it before "
"confirming the asset."
msgstr ""
"Falta la fecha de adquisición del activo %(asset)s. Indícala antes de "
"confirmarlo."

#. module: l10n_ve_accountant_asset
#. odoo-python
#: code:addons/l10n_ve_accountant_asset/models/account_asset.py:0
msgid ""
"There is no %(currency)s rate on %(date)s or on earlier dates for the asset "
"%(asset)s. Load the rate and confirm the asset again."
msgstr ""
"No hay tasa %(currency)s al %(date)s ni en fechas anteriores para el activo "
"%(asset)s. Carga la tasa y vuelve a confirmarlo."
