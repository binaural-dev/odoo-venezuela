<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_auto_post_custom" model="ir.ui.view">
        <field name="name">account.move.form.auto.post.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Pestana de facturas y pestana de asientos: el auto_post de un documento ya
                 guardado como 'custom' en borrador no se puede cambiar (solo cancelar). -->
            <xpath expr="//page[@id='other_tab']//field[@name='auto_post']" position="attributes">
                <attribute name="readonly" add="(id and auto_post == 'custom')" separator=" or "/>
                <!-- Al elegir 'custom' el campo pasa a solo lectura en el mismo formulario; sin
                     force_save el cliente web no lo envia al guardar y vuelve a 'no'. -->
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//page[@id='other_tab']//field[@name='auto_post']" position="after">
                <field name="auto_post_custom_date"
                       invisible="auto_post != 'custom'"
                       required="auto_post == 'custom'"
                       readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']//field[@name='auto_post_until']" position="attributes">
                <attribute name="invisible" add="auto_post == 'custom'" separator=" or "/>
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//field[@name='auto_post']" position="attributes">
                <attribute name="readonly" add="(id and auto_post == 'custom')" separator=" or "/>
                <!-- Al elegir 'custom' el campo pasa a solo lectura en el mismo formulario; sin
                     force_save el cliente web no lo envia al guardar y vuelve a 'no'. -->
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//field[@name='auto_post']" position="after">
                <field name="auto_post_custom_date"
                       invisible="auto_post != 'custom'"
                       required="auto_post == 'custom'"
                       readonly="state != 'draft'"/>
            </xpath>
            <xpath expr="//page[@id='other_tab_entry']//field[@name='auto_post_until']" position="attributes">
                <attribute name="invisible" add="auto_post == 'custom'" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
