<?xml version="1.0" encoding="UTF-8"?>
<odoo>
     <template id="appointment_form_inherit"
          inherit_id="appointment.appointment_form"
          name="Appointment Form (Cadipa)">

          <xpath expr="//form[@class='appointment_submit_form']" position="inside">
               <input t-if="staff_user and staff_user.id"
                    type="hidden" name="staff_user_id"
                    t-att-value="staff_user.id" />

               <input t-if="resource and resource.id"
                    type="hidden" name="resource_selected_id"
                    t-att-value="resource.id" />

               <input t-if="available_resource_ids"
                    type="hidden" name="available_resource_ids"
                    t-att-value="available_resource_ids" />
          </xpath>
     </template>
</odoo>