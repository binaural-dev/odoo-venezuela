<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_cadipa_appointment" model="ir.ui.view">
        <field name="name">res.config.settings.cadipa.appointment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_base.l10n_ve_base_view_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='l10n_ve_base']" position="inside">
                <block title="Configuración de Reservas">
                <div class="row mt16 o_settings_container" name="cadipa_appointment_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <group colspan="2" col="4">
                                <field 
                                    name="appointment_open_hour" 
                                    required="appointment_close_hour"/>
                            </group>
                            <div class="text-muted">
                                The open hour will affect the calendar event gantt view to show just hours from this Appointment Open Hour value to Appointment Close Hour.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <group colspan="2" col="4">
                                <field 
                                    name="appointment_close_hour"
                                    required="appointment_open_hour"/>
                            </group>
                            <div class="text-muted">
                                The open hour will affect the calendar event gantt view to show just hours from this Appointment Open Hour value to Appointment Close Hour.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <group colspan="2" col="4">
                                <field name="minimum_child_age"/>
                            </group>
                            <div class="text-muted">
                                Minimum age in years that a minor must have to be included in a membership.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <group colspan="2" col="4">
                                <field name="maximum_child_age"/>
                            </group>
                            <div class="text-muted">
                                Maximum age in years that a minor can have to be included in a membership.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <group colspan="2" col="4">
                                <field name="membership_auto_suspend"/>
                            </group>
                            <div class="text-muted">
                                Automatically suspend memberships that are inactive for a certain period.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" invisible="not membership_auto_suspend">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <group colspan="2" col="4">
                                <field name="membership_suspension_delay_days"/>
                            </group>
                            <div class="text-muted">
                                Number of days before an inactive membership is suspended.
                            </div>
                        </div>
                    </div>
                </div>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
