<odoo>
    <record id="view_sequence_tree_binaural_padding" model="ir.ui.view">
        <field name="name">ir.sequence.tree.padding.editable</field>
        <field name="model">ir.sequence</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="false" delete="false">
                <field name="code" column_invisible="1"/>
                <field name="name" readonly="1"/>
                <field name="prefix" readonly="1"/>
                <field name="padding" readonly="1"/>
                <field name="number_next_actual"/>
                <field name="number_increment" readonly="1"/>
                <field name="implementation" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="binaural_beneficiary_secuence_configuration" model="ir.actions.act_window">
        <field name="name"> </field>
        <field name="res_model">ir.sequence</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">tree</field>
		<field name="domain">
            [('code', '=', 'bin.membership.sequence')]
        </field>
        <field name="view_id" ref="view_sequence_tree_binaural_padding"/>
    </record>

	<menuitem 
        name="Secuence Configuration"
        action="binaural_beneficiary_secuence_configuration"
        id="menu_binaural_beneficiary_secuence_configuration"
        parent="binaural_club_socios.config_socios_menu"
        groups="binaural_memberships.group_beneficiary_manager"
    />

</odoo>
