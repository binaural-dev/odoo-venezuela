<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="appointment_form_multi_slots"
        inherit_id="appointment.appointment_form"
        name="Appointment form: hidden multi_slots">
        <xpath expr="//form[@class='appointment_submit_form']" position="inside">
            <input t-if="multi_slots_json"
                type="hidden" name="multi_slots"
                t-att-value="multi_slots_json" />
        </xpath>
    </template>


    <template id="duration_display" name="Cadipa: Duration display">
        <t t-if="duration">
            <t t-out="duration" t-options="{'widget': 'duration', 'unit': 'hour'}" />
        </t>
        <t t-else="">
            <span t-out="appointment_type.appointment_duration"
                t-options="{'widget': 'duration', 'unit': 'hour'}" />
        </t>
    </template>


    <template id="appointment_meeting_duration_override"
        inherit_id="appointment.appointment_meeting_details"
        name="Appointment: replace duration with t-call">

        <xpath expr="//span[contains(@t-out, 'appointment_type.appointment_duration')]"
            position="replace">

            <t t-call="cadipa_appointment.duration_display" />

        </xpath>
    </template>


    <template id="appointment_meeting_date_time_locale"
        inherit_id="appointment.appointment_meeting_date"
        name="Appointment: meeting date time locale">
        <xpath expr="//span[@t-out='time_locale']" position="replace">
            <span t-out="time_locale" />
        </xpath>

    </template>
</odoo>