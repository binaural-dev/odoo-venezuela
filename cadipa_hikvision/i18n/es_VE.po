"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"padding-top: 16px; background-color: #F1F1F1; font-family: Verdana, Arial, sans-serif; color: #454748; width: 100%; border-collapse: separate;\">\n"
"    <tr>\n"
"        <td align=\"center\">\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"padding: 16px; background-color: #FFFFFF; color: #454748; border-collapse: separate;\">\n"
"                <tbody>\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: #00A09D; padding: 10px 20px; border-collapse: separate; border-radius: 8px 8px 0 0;\">\n"
"                                <tr>\n"
"                                    <td valign=\"middle\">\n"
"                                        <h2 style=\"font-size: 24px; color: #FFFFFF; margin: 0;\">Invitación a la Cita</h2>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: white; padding: 20px; border-collapse: separate;\">\n"
"                                <tr>\n"
"                                    <td valign=\"top\" style=\"font-size: 14px; line-height: 1.6;\">\n"
"                                        <p>Hola <strong>{{ object.first_name }} {{ object.last_name or '' }}</strong>,</p>\n"
"                                        <p>Nos complace confirmar tu visita. Para agilizar tu acceso a nuestras instalaciones, hemos generado el siguiente código QR personal.</p>\n"
"                                        \n"
"                                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; background-color: #F8F8F8; border: 1px solid #EAEAEA; border-radius: 5px; margin: 20px 0; padding: 15px;\">\n"
"                                            <tr>\n"
"                                                <td style=\"padding: 5px 0;\"><strong>Evento:</strong></td>\n"
"                                                <td style=\"padding: 5px 0;\">{{ ctx.get('event_name') }}</td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td style=\"padding: 5px 0;\"><strong>Fecha y Hora:</strong></td>\n"
"                                                <td style=\"padding: 5px 0;\">{{ ctx.get('event_start_str') }}</td>\n"
"                                            </tr>\n"
"                                            <tr>\n"
"                                                <td style=\"padding: 5px 0;\"><strong>Anfitrión:</strong></td>\n"
"                                                <td style=\"padding: 5px 0;\">{{ ctx.get('event_host') }}</td>\n"
"                                            </tr>\n"
"                                        </table>\n"
"                                        \n"
"                                        <p style=\"text-align: center;\">Por favor, presenta este código QR a tu llegada:</p>\n"
"                                        \n"
"                                        <div style=\"text-align: center; margin: 25px 0;\">\n"
"                                            <img src=\"cid:qr_code_image\" alt=\"Código QR de Acceso\" style=\"max-width: 250px; border: 1px solid #ddd; padding: 5px; background-color: white;\">\n"
"                                        </div>\n"
"\n"
"                                        <p>¡Te esperamos!</p>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                            <td align=\"center\" style=\"min-width: 590px;\">\n"
"                            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"min-width: 590px; background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse: separate; border-radius: 0 0 8px 8px;\">\n"
"                                <tr>\n"
"                                    <td style=\"text-align: center; font-size: 12px; opacity: 0.7;\">\n"
"                                        Este es un correo generado automáticamente. Por favor, no respondas a este mensaje.\n"
"                                        <br>\n"
"                                        Gestionado por <strong>{{ ctx.get('company_name', 'tu empresa') }}</strong>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </table>\n"
"                        </td>\n"
"                    </tr>\n"
"                </tbody>\n"
"            </table>\n"
"        </td>\n"
"    </tr>\n"
"</table>\n"
