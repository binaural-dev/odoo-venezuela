<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">binaural.pos.payment.method.igtf.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="l10n_ve_pos.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_setting_ids']//field[@name='cross_journal']" position="after">
                <field name="apply_igtf"/>
            </xpath>
        </field>
    </record>
</odoo>
