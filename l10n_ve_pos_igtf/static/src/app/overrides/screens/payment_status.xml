<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('payment-status-container')]" position="after">
            <div class="d-flex flex-column pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center fw-bold mb-1">
                    <span class="label pe-2 text-muted fs-6">TOTAL</span>
                    <span class="amount" t-esc="totalDueText"/>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="label pe-2 text-muted fs-6">IGTF (<t t-esc="igtfPercentage"/>%)</span>
                    <span class="amount" t-esc="suggestedIgtf"/>
                </div>
                <div class="d-flex justify-content-between align-items-center fs-4 fw-bolder text-success">
                    <span class="label pe-2">TOTAL + IGTF</span>
                    <span class="amount" t-esc="totalDueTextWithIGTFDisplay"/>
                </div>
                <div t-if="isIgtf" class="mt-3 pt-2 border-top small">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">BI IGTF</span>
                        <span class="amount" t-esc="biAmount"/>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">IGTF</span>
                        <span class="amount" t-esc="igtfAmount"/>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Foreign IGTF</span>
                        <span class="amount" t-esc="igtfForeignAmount"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
