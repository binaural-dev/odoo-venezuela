<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_igtf.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-container')]" position="after">
            <div t-if="this.isIgtf" class="d-flex flex-column fs-4 pt-3 border-top text-dark">
                <div class="d-flex justify-content-between gap-2">
                    <span class="label text-muted">BI IGTF</span>
                    <span class="amount"><PriceFormatter price="this.biAmount"/></span>
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <span class="label text-muted">IGTF</span>
                    <span class="amount fw-semibold"><PriceFormatter price="this.igtfAmount"/></span>
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <span class="label text-muted">Foreign IGTF</span>
                    <span class="amount"><PriceFormatter price="this.igtfForeignAmount"/></span>
                </div>
                <div class="d-flex justify-content-between gap-2 pt-2 mt-2 border-top fs-3 fw-bolder">
                    <span class="label">TOTAL a Pagar con IGTF:</span>
                    <span class="d-flex flex-column align-items-end">
                        <span class="amount"><PriceFormatter price="this.totalWithIgtfAmount"/></span>
                        <span class="amount fs-3 fw-bolder text-primary"><PriceFormatter price="this.foreignTotalWithIgtfAmount"/></span>
                    </span>
                </div>
            </div>
        </xpath>
    </t>
</templates>
