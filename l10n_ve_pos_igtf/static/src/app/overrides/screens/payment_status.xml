<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('payment-status-container')]" position="after">
            <div t-if="isIgtf" class="d-flex flex-column fs-6 pt-3 border-top">
                <div class="d-flex justify-content-between gap-2">
                    <span class="label text-muted">BI IGTF</span>
                    <span class="amount" t-esc="biAmount"/>
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <span class="label text-muted">IGTF</span>
                    <span class="amount fw-semibold" t-esc="igtfAmount"/>
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <span class="label text-muted">Foreign IGTF</span>
                    <span class="amount" t-esc="igtfForeignAmount"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
