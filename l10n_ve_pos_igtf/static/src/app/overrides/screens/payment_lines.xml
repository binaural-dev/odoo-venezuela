<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_igtf.PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='this.paymentLines']" position="inside">
            <div t-if="line.include_igtf" class="paymentline-igtf d-flex align-items-center ps-3 pb-2" t-att-class="{ 'bg-body-secondary': line.isSelected() }">
                <span class="d-inline-flex align-items-center gap-1 border border-dark rounded px-2 py-1">
                    IGTF =
                    <PriceFormatter price="this.getIgtfAmount(line)"/>
                    /
                    <PriceFormatter price="this.getForeignIgtfAmount(line)"/>
                </span>
            </div>
        </xpath>
    </t>
</templates>
