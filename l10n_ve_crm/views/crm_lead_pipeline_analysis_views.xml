<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de pivote compartida entre "Análisis de Flujo" (crm_enterprise), el
         reporte de Leads y el dashboard de CRM Team. Se sustituye la medida de
         expected_revenue (que ya perdió su aggregator al pasar a compute=/store=False)
         por su equivalente en moneda comercial. -->
    <record id="crm_lead_view_pivot_foreign_currency" model="ir.ui.view">
        <field name="name">crm.lead.view.pivot.foreign.currency</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_pivot"/>
        <field name="arch" type="xml">
            <field name="expected_revenue" position="replace">
                <field name="expected_revenue_foreign" type="measure"/>
            </field>
        </field>
    </record>

    <!-- Vista de lista base de oportunidades, usada por el kanban de Pipeline en
         modo lista y heredada por la lista de "Análisis de Flujo"
         (crm_lead_view_tree_opportunity_reporting). Se aplica aquí para que
         ambos consumidores queden consistentes, igual que ya se hizo con el
         kanban en crm_case_kanban_view_leads_foreign_currency. -->
    <record id="crm_case_tree_view_oppor_foreign_currency" model="ir.ui.view">
        <field name="name">crm.lead.view.list.oppor.foreign.currency</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <field name="expected_revenue" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="expected_revenue" position="after">
                <field name="foreign_currency_id" column_invisible="True"/>
                <field
                    name="expected_revenue_foreign"
                    sum="Expected Revenues"
                    optional="show"
                    widget="monetary"
                    options="{'currency_field': 'foreign_currency_id'}"
                />
            </field>
        </field>
    </record>
</odoo>
