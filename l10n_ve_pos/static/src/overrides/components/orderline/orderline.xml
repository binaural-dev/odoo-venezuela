<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-price')]" position="replace">
            <span class="product-price fw-bolder">
                <t t-out="env.utils.formatCurrency(props.line.price_unit_with_taxes)"/>
                /
                <t t-out="env.utils.formatForeignCurrency(foreign_price_unit_display)"/>
            </span>
        </xpath>
    </t>
</templates>
