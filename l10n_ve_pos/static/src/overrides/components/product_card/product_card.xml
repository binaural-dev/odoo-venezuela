<templates id="template" xml:space="preserve">
  <t t-name="l10n_ve_pos.ProductCardExt"
     t-inherit="point_of_sale.ProductCard"
     t-inherit-mode="extension">

    <xpath expr="//div[contains(@class, 'product-content')]" position="after">
      <t t-if="this.show_free_qty and this.pos">
        <div class="free-qty p-1" style="display:block; width:100%; margin-top:4px;"
             t-attf-style="{{ this.free_qty &gt; 0 and 'color: green' or 'color: red' }}">
          Disponible:
          <t t-if="this.stockStatus === 'success' or this.stockStatus === 'idle'">
            <t t-out="this.free_qty"/>
          </t>
          <t t-elif="this.stockStatus === 'error'">N/A</t>
          <t t-else="">
            <i class="oi oi-fw oi-spin" data-icon="autorenew" aria-hidden="true"/>
          </t>
        </div>
      </t>
    </xpath>

  </t>
</templates>
