<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.OrderDisplay" t-inherit="point_of_sale.OrderDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-summary')]" position="inside">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; width: 100%;text-align:left;font-size: 95%">
                <div class="left-side" style="flex: 1;">
                    <div class="rate_bcv">
                        Tasa BCV: <t t-out="this.conversionRateText"/>
                    </div>
                    <div class="cant_prod">
                        Total de productos: <t t-out="this.quantityProducts"/>
                    </div>
                </div>

                <div class="divider" style="width: 1px; background-color: #ddd; margin: 0 10px;"></div>

                <div class="right-side" style="flex: 1; text-align: right;">
                    <div class="total">
                        Total:
                        <span t-out="this.foreignTotalText" class="total"/>
                    </div>
                    <div t-if="this.order.prices.taxDetails.has_tax_groups" class="fs-6 text-muted subentry">
                        Taxes: <span t-out="this.foreignTaxText" class="tax"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
