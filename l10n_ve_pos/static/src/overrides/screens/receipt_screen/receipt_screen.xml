<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//OrderReceipt" position="attributes">
            <attribute name="formatForeignCurrency">env.utils.formatForeignCurrency</attribute>
        </xpath>
        <xpath expr="//div[hasclass('fs-4') and hasclass('fw-bold') and hasclass('d-flex') and hasclass('justify-content-center') and hasclass('align-items-center') and hasclass('gap-2')]/span[1]" position="after">
            <span>/ <t t-out="env.utils.formatForeignCurrency(currentOrder.get_foreign_total_with_tax())" /></span>
        </xpath>
    </t>
</templates>
