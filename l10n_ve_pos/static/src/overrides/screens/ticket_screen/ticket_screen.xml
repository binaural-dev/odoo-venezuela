<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button class="control-button btn btn-secondary btn-lg lh-lg flex-grow-1 flex-shrink-1"
                    t-on-click="() => this.onFullRefund()">
                <i class="oi me-1" data-icon="check_box" aria-hidden="true"/>Reembolso total
            </button>
        </xpath>
    </t>
</templates>
