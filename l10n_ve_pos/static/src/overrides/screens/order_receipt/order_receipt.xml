<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="replace">
            <div class="pos-receipt-amount">
                <span class="label-total">
                    Total
                </span>
                <span t-out="env.utils.formatCurrency(orderDisplayData.amount_total) + ' / ' + env.utils.formatForeignCurrency(orderDisplayData.foreign_total_with_taxes)" class="pos-receipt-right-align"/>
            </div>
        </xpath>
        
        <xpath expr="//div[hasclass('paymentlines')]" position="replace">
            <div class="paymentlines text-start pt-1" t-foreach="orderDisplayData.paymentsLine" t-as="line" t-key="line_index">
                <t t-esc="line.name" />
                <span t-out="formatCurrency(line.amount) + ' / ' + env.utils.formatForeignCurrency(line.foreignAmount)" class="pos-receipt-right-align font-monospace"/> 
            </div>
        </xpath>

        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="replace">
        </xpath>
    </t>
</templates>
