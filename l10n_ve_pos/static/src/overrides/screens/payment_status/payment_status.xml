<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreenStatus" t-inherit="point_of_sale.PaymentScreenStatus" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-status-container')]" position="inside">
            <div class="payment-status-foreign d-flex flex-column justify-content-center fs-6 ms-lg-4 mt-2 mt-lg-0">
                <div class="d-flex justify-content-between gap-2">
                    <span class="label">Foreign Total</span>
                    <span class="amount fw-semibold" t-out="foreignTotalDueText" />
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <span class="label">Foreign Remaining</span>
                    <span class="amount" t-out="foreignRemainingText" />
                </div>
                <div class="d-flex justify-content-between gap-2">
                    <span class="label">Foreign Change</span>
                    <span class="amount" t-out="foreignChangeText" />
                </div>
            </div>
        </xpath>
    </t>
</templates>
