<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Venezuela requires an invoice for every POS sale (SENIAT).
        The "Invoice" toggle in the PaymentScreen must not be optional,
        so we remove the button and PosOrder.to_invoice is forced to
        true in JS (see static/src/overrides/models/pos_order.js).
    -->
    <t t-name="l10n_ve_pos.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="replace"/>
    </t>
</templates>
