<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreenDue" t-inherit="point_of_sale.PaymentScreenDue" t-inherit-mode="extension">
        <xpath expr="//section[hasclass('paymentlines-container')]/div[hasclass('total')]" position="after">
            <div class="total text-center text-muted fs-3">
                <t t-out="foreignTotalDueText"/>
            </div>
            <!-- Solo mostrar botón en reembolsos -->
            <t t-if="currentOrder.isRefund">
                <div class="button ms-1 back btn btn-lg btn-secondary"
                    t-on-click="() => this.showPaymentsOrigin()"
                    > 
                    <i class="fa fa-angle-double-left me-2" />
                    <span class="back_text">View Payments Origin</span>
                </div>
            </t>
        </xpath>
    </t>
</templates>
