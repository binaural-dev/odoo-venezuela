<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-screen') and hasclass('p-2')]/PaymentScreenPaymentLines" position="replace"/>

        <xpath expr="//div[hasclass('payment-summary')]/PaymentScreenPaymentLines" position="replace"/>

        <xpath expr="//div[hasclass('payment-screen') and hasclass('p-2')]//div[hasclass('d-flex') and hasclass('flex-column') and hasclass('overflow-y-auto')]/t[@t-call='point_of_sale.PaymentScreenMethods']" position="before">
            <PaymentScreenPaymentLines
                paymentLines="this.sortedPaymentLines"
                deleteLine.bind="this.deletePaymentLine"
                sendForceDone.bind="this.sendForceDone"
                sendForceCancel.bind="this.sendForceCancel"
                sendPaymentCancel.bind="this.sendPaymentCancel"
                sendPaymentRequest.bind="this.sendPaymentRequest"
                selectLine.bind="this.selectPaymentLine"
                updateSelectedPaymentline.bind="this.updateSelectedPaymentline"
                isRefundOrder="this.isRefundOrder" />
        </xpath>

        <xpath expr="//div[hasclass('left-content')]//div[hasclass('flex-grow-1') and hasclass('overflow-auto')]/t[@t-call='point_of_sale.PaymentScreenMethods']" position="before">
            <PaymentScreenPaymentLines
                paymentLines="this.sortedPaymentLines"
                deleteLine.bind="this.deletePaymentLine"
                sendForceDone.bind="this.sendForceDone"
                sendForceCancel.bind="this.sendForceCancel"
                sendPaymentCancel.bind="this.sendPaymentCancel"
                sendPaymentRequest.bind="this.sendPaymentRequest"
                selectLine.bind="this.selectPaymentLine"
                updateSelectedPaymentline.bind="this.updateSelectedPaymentline"
                isRefundOrder="this.isRefundOrder" />
        </xpath>
    </t>
</templates>
