<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-infos')]" position="attributes">
            <attribute name="class">payment-infos d-flex flex-wrap align-items-center justify-content-between column-gap-3 flex-grow-1 overflow-hidden px-3 py-3 cursor-pointer fs-2</attribute>
        </xpath>
        <xpath expr="//span[hasclass('payment-name')]" position="attributes">
            <attribute name="class">payment-name text-truncate</attribute>
        </xpath>
        <xpath expr="//div[hasclass('payment-amount')]" position="attributes">
            <attribute name="class">payment-amount ms-auto text-end</attribute>
        </xpath>
        <xpath expr="//div[hasclass('payment-amount')]/PriceFormatter" position="after">
            <span t-if="line.isForeignPayment" class="d-inline-block text-nowrap text-muted fs-3 ms-1">/ <PriceFormatter price="this.pos.formatCurrency(line.getAmount())" /></span>
        </xpath>
    </t>
</templates>
