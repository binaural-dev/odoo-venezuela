<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos.PaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension">
        <xpath expr="//PriceFormatter" position="replace">
            <t t-if="line.payment_method_id?.is_foreign_currency">
                <PriceFormatter price="env.utils.formatForeignCurrency(line.get_foreign_amount())" />
            </t>
            <t t-else="">
                <PriceFormatter price="env.utils.formatCurrency(line.getAmount())" />
            </t>
        </xpath>
    </t>
</templates>
