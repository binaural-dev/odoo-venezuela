<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
  <t t-name="l10n_ve_pos.ProductScreen"
     t-inherit="point_of_sale.ProductScreen"
     t-inherit-mode="extension">

    <!-- "Crear manualmente" de la pantalla sin productos: solo con la creación permitida -->
    <xpath expr="//button[@t-on-click='()=>pos.editProduct()']" position="attributes">
      <attribute name="t-if">pos.isProductCreationAllowed</attribute>
    </xpath>
  </t>
</templates>
