
<odoo>
<data>

    <record id="group_change_qty_on_pos_order" model="res.groups">
        <field name="name">Change quantity on POS order</field>
        <!-- Sin privilege_id a propósito: si comparte privilegio con
             group_pos_user/group_pos_manager, el formulario de usuario lo
             renderiza como un select de una sola opción (ver
             res_user_group_ids_field.js), haciendo este permiso
             mutuamente excluyente con el nivel de acceso base al PdV y con
             el otro permiso hermano. Sin privilege_id queda como checkbox
             independiente en "Extra Rights". -->
        <field name="privilege_id" eval="False"/>
    </record>

    <record id="group_change_price_on_pos_order" model="res.groups">
        <field name="name">Change price on POS order</field>
        <field name="privilege_id" eval="False"/>
    </record>

</data>
</odoo>
