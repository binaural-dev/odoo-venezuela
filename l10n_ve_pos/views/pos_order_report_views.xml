<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_pos_order_pivot_l10n_ve_pos" model="ir.ui.view">
        <field name="name">report.pos.order.pivot.l10n.ve.pos</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_pivot"/>
        <field name="arch" type="xml">
            <field name="price_total" position="after">
                <field name="foreign_untaxed_total" type="measure"/>
                <field name="foreign_total_billed" type="measure"/>
            </field>
        </field>
    </record>

    <record id="view_report_pos_order_graph_l10n_ve_pos" model="ir.ui.view">
        <field name="name">report.pos.order.graph.l10n.ve.pos</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_graph"/>
        <field name="arch" type="xml">
            <field name="price_total" position="after">
                <field name="foreign_untaxed_total" type="measure"/>
                <field name="foreign_total_billed" type="measure"/>
            </field>
        </field>
    </record>
</odoo>
