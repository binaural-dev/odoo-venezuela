
<odoo>
    <record id="view_pos_payment_tree" model="ir.ui.view">
        <field name="name">pos.payment.tree</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_order_id']" position="after">
                <field name="foreign_currency_id" column_invisible="True"/>
                <field name="foreign_rate" optional="hide" digits="[16, 15]" />
                <field 
                    name="foreign_amount" 
                    sum="Foreign Amount total" 
                    widget="monetary" 
                    options="{'currency_field': 'foreign_currency_id'}"
                    decoration-bf="1"/>
                <!-- Moneda de cobro (tercera moneda, p. ej. EUR; tarea 86066) -->
                <field name="tender_currency_id" column_invisible="True"/>
                <field name="tender_amount" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
              <attribute name="sum">Amount total</attribute>
              <attribute name="decoration-bf">1</attribute>
              <attribute name="widget">monetary</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_form" model="ir.ui.view">
        <field name="name">pos.payment.form</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_order_id']" position="after">
                <field name="foreign_currency_id" invisible="1"/>
                <field name="foreign_rate" digits="[16, 15]"/>
                <field 
                    name="foreign_amount" 
                    widget="monetary" 
                    options="{'currency_field': 'foreign_currency_id'}"/>
                <field name="tender_currency_id" invisible="not tender_currency_id"/>
                <field name="tender_amount" invisible="not tender_currency_id"/>
            </xpath>
        </field>
    </record>
</odoo>
