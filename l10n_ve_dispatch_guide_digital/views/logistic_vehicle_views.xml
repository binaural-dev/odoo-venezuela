<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── LIST VIEW ─────────────────────────────────────────────────── -->
    <record id="logistic_vehicle_view_tree" model="ir.ui.view">
        <field name="name">logistic.vehicle.list</field>
        <field name="model">logistic.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="transport_number"/>
                <field name="vehicle_type"/>
            </list>
        </field>
    </record>

    <!-- ── FORM VIEW ─────────────────────────────────────────────────── -->
    <record id="logistic_vehicle_view_form" model="ir.ui.view">
        <field name="name">logistic.vehicle.form</field>
        <field name="model">logistic.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="license_plate"/>
                            <field name="transport_number"/>
                        </group>
                        <group string="Classification">
                            <field name="vehicle_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── ACTION ────────────────────────────────────────────────────── -->
    <record id="action_logistic_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">logistic.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── MENU: Inventory > Configuration > Vehicles ────────────────── -->
    <menuitem
        id="menu_logistic_vehicle"
        name="Vehicles"
        parent="stock.menu_stock_config_settings"
        action="action_logistic_vehicle"
        sequence="50"
    />
</odoo>
