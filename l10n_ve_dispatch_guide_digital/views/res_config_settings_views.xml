<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_tfhka_transport" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tfhka.transport</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_invoice_digital.view_res_config_settings_inherit_tfhka"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='dispatch_guide_digital_tfhka']/../.." position="after">
                <div class="o_setting_box ms-4" id="l10n_ve_dispatch_guide_transport_data"
                     invisible="not invoice_digital_tfhka or not dispatch_guide_digital_tfhka">
                    <div class="o_setting_left_pane">
                        <field name="transport_data_required"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="transport_data_required"/>
                        <div class="text-muted">
                            Outgoing dispatch guides need driver, driver ID number and vehicle plate to be validated.
                        </div>
                        <div class="mt8">
                            <label for="transport_data_source" class="o_light_label me-2"/>
                            <field name="transport_data_source" class="oe_inline"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
