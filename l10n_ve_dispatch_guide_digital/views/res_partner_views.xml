<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_transport_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.transport.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page name="transport_info" string="Transport Info">
                    <group>
                        <field name="is_driver"/>
                        <field name="driver_license_type_id" invisible="not is_driver"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
