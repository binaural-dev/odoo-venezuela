#. module: l10n_ve_exchange_difference
#. odoo-python
#: code:addons/l10n_ve_exchange_difference/models/account_move.py:0
msgid ""
"Internal consistency error: found %(count)s move(s) tagged with "
"'l10n_ve_exchange_diff_entry' whose move_type ('%(types)s') is neither one "
"this module issues ('out_invoice'/'out_refund') nor the native generic entry"
" it tags for traceability ('entry'). This flag must never be set on any "
"other document type -- aborting instead of silently miscomputing "
"payment_state."
msgstr ""
"Error de consistencia interna: se encontraron %(count)s asiento(s) "
"marcados con 'l10n_ve_exchange_diff_entry' cuyo move_type ('%(types)s') no"
" es ninguno de los que este módulo emite ('out_invoice'/'out_refund') ni "
"el asiento genérico nativo que marca para trazabilidad ('entry'). Este "
"indicador nunca debe establecerse en ningún otro tipo de documento -- se "
"aborta en vez de calcular payment_state incorrectamente en silencio."

