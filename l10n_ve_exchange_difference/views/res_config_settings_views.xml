<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_ve_exchange" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n_ve_exchange</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_accountant.view_res_config_settings_l10n_ve_accountant"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='l10n_ve_base']" position="inside">
                <block
                    title="Exchange Difference Notes (Venezuela)"
                    id="l10n_ve_exchange_notes_block"
                    invisible="not group_multi_currency"
                >
                    <setting string="Use Debit/Credit Notes for exchange differences from invoices" help="El diferencial cambiario que quede al conciliar una factura en moneda extranjera se documenta como Nota de Débito (pérdida) o Nota de Crédito (ganancia) real, en vez de un asiento genérico.">
                        <field name="l10n_ve_exchange_use_nd_nc"/>
                    </setting>
                    <setting string="Producto de Nota de Diferencial Cambiario"
                             invisible="not l10n_ve_exchange_use_nd_nc"
                             help="Producto usado en la línea de la ND/NC. Debe tener el impuesto Exento de venta y de compra configurado.">
                        <field name="l10n_ve_exchange_note_product_id" required="l10n_ve_exchange_use_nd_nc"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
