<odoo>
    <record id="res_config_settings_view_form_inherit_l10n_ve_exchange" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.l10n_ve_exchange</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_accountant.view_res_config_settings_l10n_ve_accountant"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='l10n_ve_base']" position="inside">
                <block
                    title="Customer Invoice Exchange Difference Notes (Venezuela)"
                    id="l10n_ve_exchange_notes_block"
                    invisible="not group_multi_currency"
                    groups="account.group_account_manager"
                >
                    <setting string="Use Debit/Credit Notes for Customer Invoice Exchange Difference" help="Applies only to CUSTOMER invoices and credit notes. The exchange difference left when reconciling a foreign-currency customer invoice is documented as a real Debit Note (gain) or Credit Note (loss), instead of a generic entry.">
                        <field name="l10n_ve_exchange_use_nd_nc"/>
                    </setting>
                    <setting string="Customer Invoice Exchange Difference Note Product"
                             invisible="not group_multi_currency or not l10n_ve_exchange_use_nd_nc"
                             help="Product used on the line of the Debit/Credit Note for CUSTOMER invoices. Must have the sale and purchase Exempt tax configured.">
                        <field name="l10n_ve_exchange_note_product_id"
                               invisible="not group_multi_currency or not l10n_ve_exchange_use_nd_nc"
                               required="group_multi_currency and l10n_ve_exchange_use_nd_nc"/>
                    </setting>
                    <setting string="Customer Invoice Exchange Difference Note Pricelist"
                             invisible="not group_multi_currency or not l10n_ve_exchange_use_nd_nc"
                             help="Pricelist used on the Debit/Credit Note for CUSTOMER invoices (required by account_invoice_pricelist). Must be in the company's own currency -- these notes are always issued in company currency.">
                        <field name="l10n_ve_exchange_note_pricelist_id"
                               invisible="not group_multi_currency or not l10n_ve_exchange_use_nd_nc"
                               required="group_multi_currency and l10n_ve_exchange_use_nd_nc"
                               domain="[('currency_id', '=', currency_id)]"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
