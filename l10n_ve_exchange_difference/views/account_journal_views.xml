<odoo>
    <record id="view_account_journal_form_inherit_l10n_ve_exchange" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.l10n_ve_exchange</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_sequence']" position="after">
                <field name="l10n_ve_exchange_use_nd_nc" invisible="1"/>
                <field
                    name="l10n_ve_exchange_debit_note_sequence_id"
                    invisible="type != 'general' or not l10n_ve_exchange_use_nd_nc"
                    options="{'no_create': True}"
                    groups="account.group_account_manager"
                />
            </xpath>
        </field>
    </record>
</odoo>
