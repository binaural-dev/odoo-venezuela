<odoo>
<!--    view for picking invoice wizard-->
    <record id="picking_invoice_wizard_view_form" model="ir.ui.view">
        <field name="name">picking.invoice.wizard.view.form</field>
        <field name="model">picking.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Invoice For Multiple Picking">
                <sheet>
                    <p>Invoice will generate for selected picking</p>
                    <group>
                        <group>
                            <field name="invoice_type_selection" widget='radio'/>
                        </group>
                        <field name="pickings_ids">
                            <tree>
                                <field name='guide_number'/>
                                <field name='partner_id'/>
                                <field name='state_guide_dispatch'/>
                                <field name='transfer_reason_id'/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="picking_selection_invoice" string="Create Invoice"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_picking_multi_invoice" model="ir.actions.act_window">
        <field name="name">Create Invoices</field>
        <field name="res_model">picking.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
    </record>

</odoo>
