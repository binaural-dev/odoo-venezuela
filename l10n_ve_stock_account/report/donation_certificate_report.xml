<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <!-- Actions Report for account.move-->
    <record id="action_donation_certificate_account_move" model="ir.actions.report">
        <field name="name">Certificado de Donación</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_stock_account.donation_certificate_template_account_move</field>
        <field name="report_file">l10n_ve_stock_account.donation_certificate_template_account_move</field>
        <field name="print_report_name">"Certificado de Donacion - " + object.name</field>
        <field name="paperformat_id" ref="l10n_ve_stock_account.paperformat_donation_certificate"/>
    </record>
        <record id="action_donation_certificate_stock_picking" model="ir.actions.report">
        <field name="name">Certificado de Donación</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_stock_account.donation_certificate_template_stock_picking</field>
        <field name="report_file">l10n_ve_stock_account.donation_certificate_template_stock_picking</field>
        <field name="print_report_name">"Certificado de Donacion - " + object.name</field>
        <field name="paperformat_id" ref="l10n_ve_stock_account.paperformat_donation_certificate"/>
    </record>
</odoo>
