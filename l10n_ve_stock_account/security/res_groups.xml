<odoo>
  <record id="group_stock_account" model="res.groups">
    <field name="name">Ver botón "Crear Factura"</field>
    <field name="privilege_id" ref="account.res_groups_privilege_accounting" />
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    <field name="user_ids" eval="[(4,ref('base.user_root')),(4, ref('base.user_admin'))]"/>
  </record>
  <!-- Grupo técnico (sin category/privilege, igual que en integra): lo asigna el toggle de Ajustes. -->
  <record id="group_dispatch_note_print" model="res.groups">
    <field name="name">Show button dispatch note print</field>
  </record>
</odoo>
