#. module: l10n_ve_auditlog_base
#: model:ir.model,name:l10n_ve_auditlog_base.model_auditlog_http_request
msgid "Auditlog - HTTP request log"
msgstr "Auditlog - Registro de peticiones HTTP"

#. module: l10n_ve_auditlog_base
#: model:ir.ui.menu,name:l10n_ve_auditlog_base.menu_auditoria_root
msgid "Auditoría"
msgstr "Auditoría"

#. module: l10n_ve_auditlog_base
