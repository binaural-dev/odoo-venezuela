#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_auditlog_http_request__error_traceback
msgid ""
"Full Python traceback at the moment the failure occurred, useful for "
"debugging."
msgstr ""
"Traza completa de Python al momento en que ocurrió la falla, útil para "
"depuración."

#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_auditlog_http_request__request_url
msgid "Full URL of the external endpoint that was called."
msgstr "URL completa del endpoint externo que fue llamado."

#. module: l10n_ve_auditlog_base
