#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_auditlog_http_request__http_method
msgid ""
"HTTP method used for the outgoing request: GET, POST, PUT, DELETE, etc."
msgstr ""
"Método HTTP usado para la solicitud saliente: GET, POST, PUT, DELETE, etc."

#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_auditlog_http_request__response_status
msgid ""
"HTTP status code returned by the external server, if a response was received"
" before the error occurred (e.g. 500, 502, 503)."
msgstr ""
"Código de estado HTTP devuelto por el servidor externo, si se recibió una "
"respuesta antes de que ocurriera el error (ej. 500, 502, 503)."

#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,field_description:l10n_ve_auditlog_base.field_auditlog_http_request__id
#: model:ir.model.fields,field_description:l10n_ve_auditlog_base.field_res_company__id
#: model:ir.model.fields,field_description:l10n_ve_auditlog_base.field_res_config_settings__id
msgid "ID"
msgstr "ID"

#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_auditlog_http_request__is_outgoing
msgid ""
"If True, this record corresponds to an outgoing external HTTP request (e.g. "
"API call to Tesote, Megasoft, BCV, etc.) rather than an incoming Odoo "
"request."
msgstr ""
"Si es Verdadero, este registro corresponde a una solicitud HTTP saliente "
"(ej. llamada API a Tesore, Megasoft, BCV, etc.) en lugar de una solicitud "
"entrante de Odoo."

#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,field_description:l10n_ve_auditlog_base.field_auditlog_http_request__is_outgoing
