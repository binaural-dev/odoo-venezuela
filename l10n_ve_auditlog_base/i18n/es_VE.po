msgid ""
"Maximum characters to store for the response body. Set to 0 for full "
"content."
msgstr ""
"Máximo de caracteres a almacenar para el cuerpo de la respuesta. "
"Establezca 0 para el contenido completo."

#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_res_company__response_body_max_chars
#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_res_config_settings__response_body_max_chars
msgid ""
"Maximum characters to store for the response body. Set to 0 to store the "
"full response without truncation."
msgstr ""
"Máximo de caracteres a almacenar para el cuerpo de la respuesta. "
"Establezca 0 para almacenar la respuesta completa sin truncamiento."

