msgstr "Ajustes de configuración"

#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_res_company__log_outgoing_requests
#: model:ir.model.fields,help:l10n_ve_auditlog_base.field_res_config_settings__log_outgoing_requests
msgid ""
"Controls how outgoing HTTP requests are logged. 'Log Only Failed Requests' "
"records only failed requests; 'Log All Outgoing Requests' records both "
"successful and failed requests."
msgstr ""
"Controla cómo se registran las solicitudes HTTP salientes. 'Registrar solo "
"solicitudes fallidas' registra solo las fallidas; 'Registrar todas las "
"solicitudes salientes' registra tanto exitosas como fallidas."

#. module: l10n_ve_auditlog_base
#: model_terms:ir.ui.view,arch_db:l10n_ve_auditlog_base.res_config_settings_l10n_ve_auditlog_base
msgid ""
"Controls logging of outgoing HTTP requests (API calls to Tesore, Megasoft, "
"BCV, etc.)"
msgstr ""
"Controla el registro de solicitudes HTTP salientes (llamadas API a Tesore, "
"Megasoft, BCV, etc.)"

#. module: l10n_ve_auditlog_base
#: model:ir.model.fields,field_description:l10n_ve_auditlog_base.field_res_company__display_name
