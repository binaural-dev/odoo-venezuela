<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_l10n_ve_igtf_note_debit" model="ir.ui.view">
        <field name="name">res.config.settings.l10n_ve_igtf_note_debit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_igtf.res_config_settings_l10n_ve_igtf"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='binaural_igtf_settings']" position="inside">
                <setting string="IGTF Perception Mode"
                         help="'Automatic Fiscal Debit Note' is a new, optional flow: it does not affect payments/advances already registered with the current flow.">
                    <field name="igtf_note_debit_mode" widget="radio"/>
                </setting>
                <setting string="IGTF Perception Product"
                         invisible="igtf_note_debit_mode != 'debit_note'">

                    <field name="igtf_note_debit_valid_product_ids" invisible="1"/>
                    <field name="igtf_note_debit_product_id"
                           required="igtf_note_debit_mode == 'debit_note'"
                           domain="[('id','in',igtf_note_debit_valid_product_ids)]"/>
                </setting>
                <setting string="Include IGTF in Payment by Default"
                         invisible="igtf_note_debit_mode != 'debit_note'"
                         help="Default value of the 'Include IGTF in Payment' checkbox shown in the payment register wizard. The user can check/uncheck it on each payment: checked, the payment covers invoice + IGTF together; unchecked, the payment only covers the invoice and the IGTF is collected separately in VEF, automatically reconciled against the Debit Note.">
                    <field name="igtf_note_debit_include_in_payment_default"/>
                </setting>
                <setting string="VEF Journal for IGTF Collection"
                         invisible="igtf_note_debit_mode != 'debit_note'">
                    <field name="igtf_note_debit_valid_journal_ids" invisible="1"/>
                    <field name="igtf_note_debit_vef_journal_id"
                           required="igtf_note_debit_mode == 'debit_note'"
                           domain="[('id', 'in', igtf_note_debit_valid_journal_ids)]"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>