#. module: l10n_ve_igtf_note_debit
#: model_terms:ir.ui.view,arch_db:l10n_ve_igtf_note_debit.res_config_settings_l10n_ve_igtf_note_debit
msgid ""
"'Automatic Fiscal Debit Note' is a new, optional flow: it does not affect "
"payments/advances already registered with the current flow."
msgstr ""
"'Nota de Débito Fiscal automática' es un flujo nuevo y opcional: no afecta "
"pagos/anticipos ya registrados con el flujo actual."

#. module: l10n_ve_igtf_note_debit
