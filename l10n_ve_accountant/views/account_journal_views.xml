<odoo>
    <record id="view_journal_form_inherit_international_purchase" model="ir.ui.view">
        <field name="name">account.journal.form.international.purchase</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            
            <field name="type" position="after">
                <field name="is_purchase_international" invisible="type != 'purchase'"/>
            </field>
            
        </field>
    </record>

    <record id="view_journal_form_inherit_bank_required_account" model="ir.ui.view">
        <field name="name">account.journal.form.bank.required.account</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_account_id']" position="attributes">
                <attribute name="required">type == 'bank'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
