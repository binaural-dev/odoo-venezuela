#. module: l10n_ve_deductible
#: model:ir.model.fields,help:l10n_ve_deductible.field_account_bank_statement_line__global_deductible_reference_amount
#: model:ir.model.fields,help:l10n_ve_deductible.field_account_move__global_deductible_reference_amount
msgid "Reference: total amount removed from the document by the deductible."
msgstr "Referencia: monto total que el deducible descuenta del documento."

#. module: l10n_ve_deductible
#: model:ir.model.fields,help:l10n_ve_deductible.field_account_move_line__global_deductible_line_amount
msgid ""
"Share of the fixed deductible amount of the document that is taken off this "
"line, in the document currency: proportional to its gross subtotal, with the"
" cents lost to rounding given back by largest remainder, so the lines always"
" add up to the amount entered on the document. Only used when the deductible"
" is a fixed amount; read only."
msgstr "Parte del monto deducible fijo del documento que se resta a esta línea, en la moneda del documento: proporcional a su subtotal bruto, devolviendo por mayor residuo los centavos perdidos por el redondeo, de modo que las líneas siempre sumen el monto ingresado en el documento. Solo se usa cuando el deducible es un monto fijo; solo lectura."

#. module: l10n_ve_deductible
#: model_terms:ir.ui.view,arch_db:l10n_ve_deductible.tax_groups_totals_deductible
#: model_terms:ir.ui.view,arch_db:l10n_ve_deductible.tax_groups_totals_ve_deductible
msgid "Subtotal sin deducible"
msgstr "Subtotal sin deducible"

#. module: l10n_ve_deductible
#. odoo-javascript
#: code:addons/l10n_ve_deductible/static/src/components/tax_totals/tax_totals.xml:0
msgid "Subtotal without deductible"
msgstr "Subtotal sin deducible"

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move.py:0
msgid ""
"The amounts deducted on the lines (%(lines)s) must add up to the deductible "
"amount (%(total)s)."
msgstr "Los montos deducidos en las líneas (%(lines)s) deben sumar el monto deducible (%(total)s)."

#. module: l10n_ve_deductible
#: model:ir.model.fields,help:l10n_ve_deductible.field_account_bank_statement_line__deductible_allowed
#: model:ir.model.fields,help:l10n_ve_deductible.field_account_move__deductible_allowed
msgid "The company enables the deductible for this type of document."
msgstr "La compañía habilita el deducible para este tipo de documento."

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move.py:0
msgid ""
"The deductible amount must be greater than 0 and less than the original "
"document total (%s): 100%% of a document cannot be deducted."
msgstr "El monto deducible debe ser mayor que 0 y menor que el total original del documento (%s): no se puede deducir el 100%% de un documento."

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move.py:0
msgid ""
"The deductible can only be changed on draft documents. Reset %s to draft "
"first."
msgstr "El deducible solo se puede cambiar en documentos en borrador. Restablezca %s a borrador primero."

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move.py:0
msgid "The deductible can only be used on vendor bills and customer invoices."
msgstr "El deducible solo puede usarse en facturas de proveedor y de cliente."

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move.py:0
msgid ""
"The deductible cannot be applied:\n"
"%s"
msgstr "No se puede aplicar el deducible:\n%s"

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move.py:0
msgid ""
"The deductible is not enabled for this company and type of document. Enable "
"it in the accounting settings."
msgstr "El deducible no está habilitado para esta compañía y tipo de documento. Habilítelo en los ajustes de contabilidad."

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move.py:0
msgid ""
"The deductible percentage must be greater than 0 and less than 100: 100% of "
"a document cannot be deducted."
msgstr "El porcentaje deducible debe ser mayor que 0 y menor que 100: no se puede deducir el 100% de un documento."

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move_line.py:0
msgid ""
"The deductible taken off %(product)s must be less than its subtotal "
"(%(subtotal)s)."
msgstr "El deducible que se resta a %(product)s debe ser menor que su subtotal (%(subtotal)s)."

