#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move.py:0
msgid "%s: lines cannot have a previous discount."
msgstr "%s: las líneas no pueden tener un descuento previo."

#. module: l10n_ve_deductible
#. odoo-python
#: code:addons/l10n_ve_deductible/models/account_move_line.py:0
msgid ""
"A deductible document cannot have lines with a discount (percentage or fixed"
" amount). Remove the discount on %(product)s."
msgstr "Un documento deducible no puede tener líneas con descuento (porcentaje o monto fijo). Elimine el descuento en %(product)s."

