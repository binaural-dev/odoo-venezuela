#. module: l10n_ve_deductible
#: model_terms:ir.ui.view,arch_db:l10n_ve_deductible.view_res_config_settings_l10n_ve_deductible
msgid ""
"Allows applying a global deductible (percentage or fixed\n"
"                                amount) to documents. While active on a\n"
"                                document, line discounts are disabled."
msgstr "Permite aplicar un deducible global (porcentaje o monto fijo) a documentos. Mientras esté activo en un documento, los descuentos por línea quedan deshabilitados."

#. module: l10n_ve_deductible
#: model:ir.model.fields,help:l10n_ve_deductible.field_res_company__use_deductible
#: model:ir.model.fields,help:l10n_ve_deductible.field_res_config_settings__use_deductible
msgid ""
"Allows applying a global deductible (percentage or fixed amount) to the "
"documents selected in 'Deductible Applies To'."
msgstr "Permite aplicar un deducible global (porcentaje o monto fijo) a los documentos seleccionados en 'El deducible aplica a'."

#. module: l10n_ve_deductible
#: model:ir.model.fields,help:l10n_ve_deductible.field_account_bank_statement_line__is_deductible
#: model:ir.model.fields,help:l10n_ve_deductible.field_account_move__is_deductible
msgid ""
"Applies a global deductible (percentage or fixed amount) spread over every "
"line of the document."
msgstr "Aplica un deducible global (porcentaje o monto fijo) repartido entre todas las líneas del documento."

