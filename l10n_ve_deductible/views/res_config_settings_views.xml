<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_l10n_ve_deductible" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.deductible</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_base.l10n_ve_base_view_res_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='l10n_ve_base']" position="inside">
                <block title="Deductibles" name="l10n_ve_deductible_block">
                    <div class="col-12 col-lg-6 o_setting_box" id="l10n_ve_deductible_div_use_deductible">
                        <div class="o_setting_left_pane">
                            <field name="use_deductible"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="use_deductible"/>
                            <div class="text-muted">
                                Allows applying a global deductible (percentage or fixed
                                amount) to documents. While active on a
                                document, line discounts are disabled.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="l10n_ve_deductible_div_scope"
                         invisible="not use_deductible">
                        <div class="o_setting_right_pane">
                            <label for="deductible_scope"/>
                            <div class="text-muted">
                                Documents on which the deductible can be activated.
                            </div>
                            <field name="deductible_scope" widget="radio"
                                   required="use_deductible"/>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
