<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_mf_self_order.KioskFiscalOrdersDialog">
        <Dialog title="'Órdenes fiscales del Kiosko'" size="'lg'">
            <div class="d-flex" style="gap: 12px; min-height: 320px;">
                <!-- Lista de órdenes -->
                <div class="d-flex flex-column" style="width: 42%; overflow-y: auto; max-height: 60vh;">
                    <t t-if="state.loading">
                        <div class="text-muted p-3">Cargando órdenes…</div>
                    </t>
                    <t t-elif="!orders.length">
                        <div class="text-muted p-3">No hay órdenes en esta sesión.</div>
                    </t>
                    <t t-foreach="orders" t-as="order" t-key="order.uuid">
                        <button type="button"
                                class="btn text-start d-flex justify-content-between align-items-center mb-1"
                                t-att-class="selected and selected.uuid === order.uuid ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.selectOrder(order)">
                            <span class="text-truncate" t-esc="orderLabel(order)"/>
                            <span t-if="order.mf_invoice_number" class="badge text-bg-success ms-2">
                                Fiscal <t t-esc="order.mf_invoice_number"/>
                            </span>
                            <span t-else="" class="badge text-bg-warning ms-2">Pendiente</span>
                        </button>
                    </t>
                </div>

                <!-- Detalle de la orden seleccionada -->
                <div class="flex-grow-1 border-start ps-3" style="width: 58%;">
                    <t t-if="!selected">
                        <div class="text-muted p-3">Selecciona una orden para ver el detalle.</div>
                    </t>
                    <t t-else="">
                        <div class="fw-bold mb-1" t-esc="orderLabel(selected)"/>
                        <div class="text-muted small mb-2">
                            Cliente: <t t-esc="selected.partner_id and selected.partner_id.name or '—'"/>
                        </div>
                        <div style="max-height: 32vh; overflow-y: auto;">
                            <table class="table table-sm mb-2">
                                <tbody>
                                    <tr t-foreach="selected.lines" t-as="line" t-key="line.uuid || line.id">
                                        <td class="text-nowrap"><t t-esc="line.qty"/> x</td>
                                        <td t-esc="line.product_id and line.product_id.display_name or ''"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between fw-bold border-top pt-2">
                            <span>Total</span>
                            <span t-esc="money(selected.amount_total)"/>
                        </div>
                        <div class="mt-1 small">
                            Estado fiscal:
                            <t t-if="selected.mf_invoice_number">
                                <span class="text-success">impresa (nº <t t-esc="selected.mf_invoice_number"/>)</span>
                            </t>
                            <t t-else="">
                                <span class="text-warning">pendiente de imprimir</span>
                            </t>
                        </div>

                        <button type="button" class="btn btn-primary mt-3"
                                t-on-click="onPrint" t-att-disabled="state.busy">
                            <t t-if="selected.mf_invoice_number">Reimprimir copia</t>
                            <t t-else="">Imprimir factura fiscal</t>
                        </button>
                        <div t-if="state.message" class="alert alert-info mt-2 mb-0 py-2"
                             t-esc="state.message" role="status"/>
                    </t>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-outline-secondary"
                        t-on-click="loadOrders" t-att-disabled="state.loading">
                    Actualizar
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="() => props.close()">
                    Cerrar
                </button>
            </t>
        </Dialog>
    </t>
</templates>
