<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="form_sale_order_form_price" model="ir.ui.view">
			<field name="name">sale.order_form_price</field>
			<field name="model">sale.order</field>
			<field name="inherit_id" ref="sale.view_order_form" />
			<field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//tree//field[@name='price_unit']" position="after">
                    <button name="view_last_price" type="object" icon="fa-dollar" style="color:black;" class="oe_highlight" string=""  />
                </xpath>
            </field>
        </record>
    </data>
</odoo>