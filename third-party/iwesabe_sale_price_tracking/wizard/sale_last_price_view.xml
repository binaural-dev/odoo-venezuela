<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="form_sale_last_price_view" model ="ir.ui.view">
			<field name="name">form.sale.last.price</field>
			<field name="model">sale.last.price</field>
			<field name="arch" type="xml">
			   <form string="Product Last Price">
			   		<div class="container">
						<field name="body_html" widget="html"/>
					</div>
					<footer>
						<button string="Ok" class="btn-default" special="cancel" />
				   </footer>
			   </form>
			</field>
		</record>

		<record id="action_sale_last_price" model="ir.actions.act_window">
			<field name="name">Product Last Price</field>
			<field name="res_model">sale.last.price</field>
			<field name="view_id" ref="form_sale_last_price_view"/>
			<field name="view_mode">form</field>
			<field name="target">new</field>
		</record>
	</data>
</odoo>