<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="sh_default_pages_form" model="ir.ui.view">
        <field name="name">sh.default.pages.form</field>
        <field name="model">default.before.pages</field>
        <field name="arch" type="xml">
            <form string="Before Pages">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>                    
                    </group>
                    <group>
                        <field name="before_datas" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id='sh_default_pages_tree' model='ir.ui.view'>
        <field name="name">sh.default.pages.tree</field>
        <field name="model">default.before.pages</field>
        <field name="arch" type="xml">
            <tree string="Before Pages">
                <field name="name"/>               
            </tree>
        </field>
    </record>
    <record id="sh_default_pages_action" model="ir.actions.act_window">
        <field name="name">Before Pages</field>
        <field name="res_model">default.before.pages</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Before Pages
            </p>
        </field>
    </record>
    <menuitem name="Before Pages" action="sh_default_pages_action" id="sh_default_before_pages_item" parent="sh_product_catalog_generator.sh_default_pages_item" sequence="1"/>
</odoo>