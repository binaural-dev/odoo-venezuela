<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="sh_default_after_pages_form" model="ir.ui.view">
        <field name="name">sh.default.after.pages.form</field>
        <field name="model">default.after.pages</field>
        <field name="arch" type="xml">
            <form string="After Pages">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>                    
                    </group>
                    <group>
                        <field name="after_datas_filename"  invisible="1" />
                        <field name="after_datas" filename="after_datas_filename" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id='sh_default_after_pages_tree' model='ir.ui.view'>
        <field name="name">sh.default.after.pages.tree</field>
        <field name="model">default.after.pages</field>
        <field name="arch" type="xml">
            <tree string="Default Pages">
                <field name="name"/>               
            </tree>
        </field>
    </record>

    <record id="sh_default_after_action" model="ir.actions.act_window">
        <field name="name">After Pages</field>
        <field name="res_model">default.after.pages</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                After Pages
            </p>
        </field>
    </record>
    <menuitem name="After Pages" action="sh_default_after_action" id="sh_default_after_pages_item" parent="sh_product_catalog_generator.sh_default_pages_item" sequence="2"/>
</odoo>