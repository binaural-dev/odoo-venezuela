<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

  <t t-name="ChangeLine">
		<div size="normal" style="font-size: 24px !important; font-weight: bold !important; width: 280px;">
			<line>
				<left width='20'>
					<value><t t-esc="change.quantity" /></value>
						<t t-if="change.uom">
						    <t t-esc="change.uom['name']"/>
					    </t>
                        x
				</left>
				<right><t t-esc="change.name" /></right>
			</line>
		</div>
        <t t-if="change.note">
		 <div size="normal" style="font-size: 20px !important; width: 280px;" >
			<line >
                <span font='c' bold='off' line-ratio='0.4' indent='1' width='30'>
                    -->  <t t-esc="change.note"/>
                </span>
			</line>
		</div>
        </t>
        <div size="normal"  style="font-size: 20px !important; font-weight: normal !important; width: 280px;">---------------------------</div>
    </t>


    <t t-name="KitchenReceipt">
		<div class="pos-receipt" style="font-size: 24px !important; width: 300px;">
		    <div size='normal'><t t-esc="changes.name" /></div>
            <div size='normal'>[<t t-esc="changes.cashier" />]</div>
            <t t-if="changes.floor || changes.table">
                <div>
                    <b><t t-esc="changes.floor" /> / <t t-esc="changes.table"/></b>
                </div>
            </t>
<!--            <div size='normal' t-if="changes.guest_name">Cliente: <t t-esc="changes.guest_name" /></div>-->
            <t t-if="changes.cancelled.length > 0">
                <div color='red'>
                    <div bold='on' size='double'>
                        CANCELLED
                        <span bold='off' size='double-height'>
                            <t t-esc='changes.fecha' />
                            <t t-esc='changes.time.hours' />:<t t-esc='changes.time.minutes'/>
                        </span>
                    </div>
                    <t t-foreach="changes.cancelled" t-as="change">
                        <t t-call="ChangeLine"/>
                    </t>
                    <br/>
                </div>
            </t>
            <t t-if="changes.new.length > 0">
                <div bold='on' size='double'>
                    NEW
                    <span bold='off' size='double-height'>
                        <t t-esc='changes.fecha' />
                        <t t-esc='changes.time.hours' />:<t t-esc='changes.time.minutes'/>
                    </span>
                </div>
                <t t-foreach="changes.new" t-as="change">
                    <t t-call="ChangeLine"/>
                </t>
            </t>
        </div>	
    </t>
	
</templates>