<?xml version="1.0"?>
<odoo>
	<data>
		<record id="picking_lot_wizard_view" model="ir.ui.view">
			<field name="name">Import Lot</field>
			<field name="model">import.lot.multi.wizard</field>
			<field name="arch" type="xml">
				<form>
					<group>
						<field name="import_option"/>
						<field name="select_lot" widget="radio"/>
						<field name="lot_file"/>
						<field name="product_based_on" widget="radio"/>
					</group>
					
					<group>
                    <group string="Download Sample XLS and CSV Files">
                        <field name="down_samp_file" widget="checkbox" />
                        <field name="sample_option" widget="radio" attrs="{'invisible': [('down_samp_file', '=', False)]}"/>
                        <button name="download_auto" string="Download Sample File" type="object" class="oe_highlight" attrs="{'invisible': [('down_samp_file', '=', False)]}"/>
                    </group>
                </group>
					
					<footer>
						<button string="Import" name = "import_bulk_of_lots" class="oe_highlight" type="object"/>
					</footer>
				</form>
			</field>
		</record>

		<record id="picking_lot_wizard_action" model="ir.actions.act_window">
			<field name="name">Import Lots</field>
			<field name="res_model">import.lot.multi.wizard</field>
			<field name="target">new</field>
			<field name="view_mode">form</field>
		</record>

		<record id="picking_lot_inherited_view" model="ir.ui.view">
			<field name="name">Import Picking Details</field>
			<field name="model">stock.picking</field>
			<field name="priority">1</field>
			<field name="inherit_id" ref="stock.view_picking_form"/>
			<field name="arch" type="xml">
				<button name="do_unreserve" position="after">
					<button name="open_multi_wizard" 
					string="Import Lots/Serial No For Picking"
	                type="object" 
	                class="btn-primary"
	                attrs="{'invisible': ['|','|', ('state', '=', 'done'),('picking_type_code', '=','outgoing'),('create_lot','=',False),('create_exist_lot','=',False)]}"/>
	            </button>
	          	<field name="picking_type_id" position = "after">
					<field name = "create_lot" invisible = "1"/>
					<field name = "create_exist_lot" invisible = "1"/>					
				</field>
			</field>
		</record>
		
	</data>
</odoo>
