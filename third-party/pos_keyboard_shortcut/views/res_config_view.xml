<odoo>
    <record id="res_config_settings_view_form_pos_keyboard_shortcuts" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_keyboard_shortcuts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_interface_section']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" title="Don't turn this option on if you take orders on smartphones or tablets. Such devices already benefit from a native keyboard.">
                    <div class="o_setting_left_pane">
                        <field name="pos_enable_shortcuts"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_select_shortcut"/>
                        <div class="text-muted">
                            Choose Keyboard Shortcut for the POS Session
                        </div>
                        <div class="content-group mt16" attrs="{'invisible': [('pos_enable_shortcuts', '=', False)]}">
                            <field name="pos_select_shortcut" colspan="4" nolabel="1" 
                                attrs="{'required': [('pos_enable_shortcuts', '=', True)]}"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>