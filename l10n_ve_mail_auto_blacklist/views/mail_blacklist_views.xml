<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_blacklist_view_list_inherit" model="ir.ui.view">
        <field name="name">mail.blacklist.view.list.inherit.l10n_ve.mail.auto.blacklist</field>
        <field name="model">mail.blacklist</field>
        <field name="inherit_id" ref="mail.mail_blacklist_view_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="l10n_ve_last_bounce_type" string="Last Bounce" widget="badge"
                       decoration-danger="l10n_ve_last_bounce_type == 'hard'"
                       decoration-warning="l10n_ve_last_bounce_type == 'soft'"
                       decoration-muted="not l10n_ve_last_bounce_type"/>
                <field name="l10n_ve_bounce_event_count" string="Failures"/>
            </field>
        </field>
    </record>

    <record id="mail_blacklist_view_form_inherit" model="ir.ui.view">
        <field name="name">mail.blacklist.view.form.inherit.l10n_ve.mail.auto.blacklist</field>
        <field name="model">mail.blacklist</field>
        <field name="inherit_id" ref="mail.mail_blacklist_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('badge')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_l10n_ve_view_bounce_events" type="object"
                            class="oe_stat_button" icon="fa-exclamation-triangle"
                            invisible="not l10n_ve_bounce_event_count">
                        <field name="l10n_ve_bounce_event_count" widget="statinfo" string="Delivery Failures"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
