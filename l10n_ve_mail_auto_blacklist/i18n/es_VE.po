#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
msgid ""
"Minimum number of days between the first and the last counted failure, to "
"avoid blacklisting because of a temporary server issue. 0 = no constraint."
msgstr ""
"Cantidad mínima de días entre el primer y el último fallo contado, para "
"evitar poner en lista negra por un problema temporal del servidor. 0 = sin "
"restricción."

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,help:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_threshold
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
