msgstr "Correo Electrónico"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model,name:l10n_ve_mail_auto_blacklist.model_mail_bounce_event
msgid "Email Delivery Failure"
msgstr "Fallo de Entrega de Correo"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.actions.act_window,name:l10n_ve_mail_auto_blacklist.mail_bounce_event_action
msgid "Email Delivery Failures"
msgstr "Fallos de Entrega de Correo"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,field_description:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_threshold
msgid "Failures Before Blacklist"
msgstr "Fallos Antes de Lista Negra"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,field_description:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_min_spread_days
msgid "Minimum Spread (days)"
msgstr "Dispersión Mínima (días)"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,help:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_min_spread_days
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
msgid ""
"Minimum number of days between the first and the last counted failure, to "
"avoid blacklisting because of a temporary server issue. 0 = no "
"constraint."
msgstr ""
"Cantidad mínima de días entre el primer y el último fallo contado, para "
"evitar poner en lista negra por un problema temporal del servidor. 0 = sin "
"restricción."

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,help:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_threshold
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
msgid ""
"Number of delivery failures (bounces or SMTP refusals) an address must "
"reach before being automatically blacklisted."
msgstr ""
"Número de fallos de entrega (rebotes o rechazos SMTP) que debe alcanzar "
"una dirección antes de ser agregada automáticamente a la lista negra."

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,help:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_window_days
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
msgid "Only failures of the last X days are counted. 0 = no time limit."
msgstr ""
"Solo se cuentan los fallos de los últimos X días. 0 = sin límite de "
"tiempo."

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,field_description:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_window_days
msgid "Period (days)"
msgstr "Período (días)"

#. module: l10n_ve_mail_auto_blacklist
#. odoo-python
#: code:addons/l10n_ve_mail_auto_blacklist/models/res_config_settings.py:0
msgid "Periods cannot be negative."
msgstr "Los períodos no pueden ser negativos."

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,field_description:l10n_ve_mail_auto_blacklist.field_mail_bounce_event__reason
msgid "Reason"
msgstr "Motivo"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,help:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_enabled
msgid ""
"Replaces the native rule (5 bounces within 13 weeks, spread over more than "
"one week) and blocks every outgoing email, including transactional ones, "
"to blacklisted addresses."
msgstr ""
"Reemplaza la regla nativa (5 rebotes en 13 semanas, con al menos una "
"semana de dispersión) y bloquea el envío de cualquier correo, incluyendo "
"transaccionales, a las direcciones en lista negra."

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields.selection,name:l10n_ve_mail_auto_blacklist.selection__mail_bounce_event__event_type__smtp_error
msgid "SMTP Recipient Refused"
msgstr "Destinatario Rechazado por SMTP"

#. module: l10n_ve_mail_auto_blacklist
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.mail_bounce_event_view_search
msgid "SMTP Refusals"
msgstr "Rechazos SMTP"

#. module: l10n_ve_mail_auto_blacklist
#. odoo-python
#: code:addons/l10n_ve_mail_auto_blacklist/models/res_config_settings.py:0
msgid "The minimum spread must be shorter than the counted period."
msgstr "La dispersión mínima debe ser menor que el período contado."

#. module: l10n_ve_mail_auto_blacklist
#. odoo-python
#: code:addons/l10n_ve_mail_auto_blacklist/models/res_config_settings.py:0
msgid "The number of failures before blacklisting must be at least 1."
msgstr "El número de fallos antes de la lista negra debe ser al menos 1."

#. module: l10n_ve_mail_auto_blacklist
#. odoo-python
#: code:addons/l10n_ve_mail_auto_blacklist/models/mail_bounce_event.py:0
msgid ""
"This email has been automatically added to the blocklist after "
"%(count)s delivery failures (limit: %(threshold)s, period: %(period)s)."
msgstr ""
"Este correo fue agregado automáticamente a la lista negra después de "
"%(count)s fallos de entrega (límite: %(threshold)s, período: %(period)s)."

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,field_description:l10n_ve_mail_auto_blacklist.field_mail_bounce_event__event_type
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.mail_bounce_event_view_search
msgid "Type"
msgstr "Tipo"

#. module: l10n_ve_mail_auto_blacklist
#. odoo-python
#: code:addons/l10n_ve_mail_auto_blacklist/models/mail_bounce_event.py:0
msgid "no time limit"
msgstr "sin límite de tiempo"
