msgid "%s days"
msgstr "%s días"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,field_description:l10n_ve_mail_auto_blacklist.field_mail_bounce_event__active
msgid "Active"
msgstr "Activo"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,help:l10n_ve_mail_auto_blacklist.field_res_config_settings__l10n_ve_auto_blacklist_count_smtp_errors
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
msgid ""
"Also count emails refused by the SMTP server because of the recipient "
"address (e.g. 550 mailbox unavailable), not only bounces received "
"afterwards."
msgstr ""
"También cuenta los correos rechazados por el servidor SMTP debido a la "
"dirección del destinatario (ej. 550 buzón no disponible), no solo los "
"rebotes recibidos después."

#. module: l10n_ve_mail_auto_blacklist
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.mail_bounce_event_view_form
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.mail_bounce_event_view_search
msgid "Archived"
msgstr "Archivado"

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields,help:l10n_ve_mail_auto_blacklist.field_mail_bounce_event__active
msgid ""
"Archived failures are not counted anymore (the address was removed from "
"the blacklist or replied to an email)."
msgstr ""
"Los fallos archivados ya no se cuentan (la dirección fue removida de la "
"lista negra o respondió un correo)."

#. module: l10n_ve_mail_auto_blacklist
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
msgid "Automatic Blacklist"
msgstr "Lista Negra Automática"

#. module: l10n_ve_mail_auto_blacklist
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
msgid "Blacklist"
msgstr "Lista Negra"

#. module: l10n_ve_mail_auto_blacklist
#: model_terms:ir.ui.view,arch_db:l10n_ve_mail_auto_blacklist.res_config_settings_view_form
msgid ""
"Blacklist addresses after a configurable number of delivery failures and "
"stop sending them any email (marketing and transactional) until they are "
"manually removed from the blacklist."
msgstr ""
"Agrega direcciones a la lista negra después de un número configurable de "
"fallos de entrega y detiene el envío de cualquier correo (marketing y "
"transaccional) hasta que sean removidas manualmente de la lista negra."

#. module: l10n_ve_mail_auto_blacklist
#: model:ir.model.fields.selection,name:l10n_ve_mail_auto_blacklist.selection__mail_bounce_event__event_type__bounce
msgid "Bounce"
