<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="show_digital_invoice" invisible="1"/>
                <field name="show_digital_credit_note" invisible="1"/>
                <field name="show_digital_debit_note" invisible="1"/>
                <button name="action_tfhka_generate_digital" string="Generate Digital Invoice" type="object"
                    invisible="show_digital_invoice or tfhka_digitalization_state != 'none'"/>
                <button name="action_tfhka_generate_digital" string="Generate Digital Credit Note" type="object"
                    invisible="show_digital_credit_note or tfhka_digitalization_state != 'none'"/>
                <button name="action_tfhka_generate_digital" string="Generate Digital Debit Note" type="object"
                    invisible="show_digital_debit_note or tfhka_digitalization_state != 'none'"/>
                <button name="action_tfhka_retry_digitalization" string="Retry Digitalization" type="object"
                    invisible="tfhka_digitalization_state != 'error'"
                    class="btn-danger"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/label[1]" position="before">
                <field name="journal_digital_invoice" invisible="1"/>
                <field name="is_digitalized" string="Digitized"
                       invisible="move_type not in ['out_invoice', 'out_refund'] or not journal_digital_invoice"
                       readonly="True"/>
                <field name="tfhka_digitalization_state" string="Digitalization Status"
                       invisible="move_type not in ['out_invoice', 'out_refund'] or not journal_digital_invoice or tfhka_digitalization_state == 'success'"
                       readonly="True" widget="badge"
                       decoration-success="tfhka_digitalization_state == 'success'"
                       decoration-danger="tfhka_digitalization_state == 'error'"
                       decoration-info="tfhka_digitalization_state == 'processing'"
                       decoration-warning="tfhka_digitalization_state == 'queued'"
                       decoration-primary="tfhka_digitalization_state == 'none'"/>
                <field name="tfhka_digitalization_error" string="Digitalization Error"
                       invisible="tfhka_digitalization_state != 'error'"
                       readonly="True"
                       groups="l10n_ve_invoice_digital.group_l10n_ve_invoice_digital_admin"/>
            </xpath>
            <!-- Multi-moneda: checkbox + selector de moneda de línea.
                 Solo visible si multi_currency_enabled (compañía) y el diario
                 es de facturacion digital (journal_digital_invoice).
                 line_currency se despliega solo cuando multi_currency_invoice está activo. -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="multi_currency_enabled" invisible="1"/>
                <field name="multi_currency_invoice_lock" invisible="1"/>
                <field name="multi_currency_invoice" invisible="not multi_currency_enabled or not journal_digital_invoice"
                       readonly="is_digitalized or multi_currency_invoice_lock"/>
                <field name="line_currency" invisible="not multi_currency_invoice"
                       readonly="is_digitalized" required="1"/>
                <!-- Cuadro de pago: solo cuando la compañía está en modo "registro de pago"
                     y el diario es de facturacion digital. -->
                <field name="digitalization_with_payment_active" invisible="1"/>
                <field name="show_payment_box" invisible="not digitalization_with_payment_active or not journal_digital_invoice"
                       readonly="is_digitalized"/>
            </xpath>
            <!-- Serie de proveedor (ticket helpdesk #15078): se agrega justo debajo
                 del numero grande de la factura (el "name"), dentro del mismo
                 div "oe_title", en una fila compacta en linea (d-flex) para no
                 competir en tamaño con el h1 ni descuadrar el titulo. Solo en
                 facturas/notas de credito de proveedor, y solo si TFHKA esta activo
                 en la compañia. No obligatorio: no todos los proveedores usan serie. -->
            <xpath expr="//div[@class='oe_title']/h1" position="after">
                <field name="invoice_digital_tfhka_active" invisible="1"/>
                <div class="d-flex align-items-center"
                     invisible="move_type not in ('in_invoice', 'in_refund') or not invoice_digital_tfhka_active">
                    <label for="vendor_series_tfhka" string="Series" class="oe_inline me-2"/>
                    <field name="vendor_series_tfhka" nolabel="1" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_inherit_tfhka_digitalization" model="ir.ui.view">
        <field name="name">account.move.list.inherit.tfhka.digitalization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <!-- TFHKA solo digitaliza facturas de venta (ver _is_eligible_for_tfhka
                     en account_move.py); en la lista de facturas de proveedor esta
                     columna no aporta nada (siempre queda en 'none') y se oculta. -->
                <field name="tfhka_digitalization_state"
                       string="Digitalization Status"
                       widget="badge"
                       decoration-success="tfhka_digitalization_state == 'success'"
                       decoration-danger="tfhka_digitalization_state == 'error'"
                       decoration-info="tfhka_digitalization_state == 'processing'"
                       decoration-warning="tfhka_digitalization_state == 'queued'"
                       decoration-primary="tfhka_digitalization_state == 'none'"
                       column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_inherit_tfhka_digitalization" model="ir.ui.view">
        <field name="name">account.invoice.select.inherit.tfhka.digitalization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='to_check']" position="after">
                <separator/>
                <filter name="tfhka_digitalization_error" string="TFHKA: Error"
                        domain="[('tfhka_digitalization_state', '=', 'error')]"/>
                <filter name="tfhka_digitalization_queued" string="TFHKA: Queued"
                        domain="[('tfhka_digitalization_state', '=', 'queued')]"/>
            </xpath>
            <xpath expr="//filter[@name='status']" position="after">
                <filter name="group_tfhka_digitalization_state" string="TFHKA Digitalization Status"
                        context="{'group_by': 'tfhka_digitalization_state'}"/>
            </xpath>
        </field>
    </record>
</odoo>