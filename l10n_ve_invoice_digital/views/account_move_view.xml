<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="show_digital_invoice" invisible="1"/>
                <field name="show_digital_credit_note" invisible="1"/>
                <field name="show_digital_debit_note" invisible="1"/>
                <button name="generate_document_digital" string="Generate Digital Invoice" type="object" 
                    invisible="show_digital_invoice"/>
                <button name="generate_document_digital" string="Generate Digital Credit Note" type="object" 
                    invisible="show_digital_credit_note"/>
                <button name="generate_document_digital" string="Generate Digital Debit Note" type="object" 
                    invisible="show_digital_debit_note"/>            
            </xpath>
            <xpath expr="//group[@id='header_right_group']/label[1]" position="before">
                <field name="journal_digital_invoice" invisible="1"/>
                <field name="is_digitalized" string="Digitized"
                       invisible="move_type not in ['out_invoice', 'out_refund'] or not journal_digital_invoice"
                       readonly="True"/>
            </xpath>
            <!-- Multi-moneda: checkbox + selector de moneda de línea.
                 Solo visible si multi_currency_enabled (compañía), el diario es
                 de facturacion digital (journal_digital_invoice) y la tarifa
                 está en una moneda distinta a la base (multi_currency_available).
                 line_currency_id se despliega solo cuando multi_currency_invoice
                 está activo, y su dominio son la moneda base y la de la tarifa. -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="multi_currency_enabled" invisible="1"/>
                <field name="multi_currency_invoice_lock" invisible="1"/>
                <field name="multi_currency_available" invisible="1"/>
                <field name="allowed_line_currency_ids" invisible="1"/>
                <field name="multi_currency_invoice"
                       invisible="not multi_currency_enabled or not journal_digital_invoice or not multi_currency_available"
                       readonly="is_digitalized or multi_currency_invoice_lock"/>
                <field name="line_currency_id" invisible="not multi_currency_invoice"
                       readonly="is_digitalized" required="multi_currency_invoice"
                       options="{'no_create': True, 'no_open': True}"/>
                <!-- Cuadro de pago: solo cuando la compañía está en modo "registro de pago"
                     y el diario es de facturacion digital. -->
                <field name="digitalization_with_payment_active" invisible="1"/>
                <field name="show_payment_box" invisible="not digitalization_with_payment_active or not journal_digital_invoice"
                       readonly="is_digitalized"/>
            </xpath>
        </field>
    </record>
</odoo>