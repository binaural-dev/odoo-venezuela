<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherit_tfhka" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tfhka</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_ve_invoice.view_res_config_settings_l10n_ve_invoice" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='l10n_ve_invoice_block']" position="inside">
                <separator string="Digital invoice (TFHKA)" name="l10n_ve_invoice_digital_separator"/>
                <div class="col-12 col-lg-12 o_setting_box" id="l10n_ve_invoice_div_max_product_invoice">
                    <div class="row">
                        <div class="col-6">
                            <div class="o_setting_right_pane">
                                <label for="username_tfhka" class="col-form-label">Username</label>
                                <div class="col-sm-8">
                                    <field name="username_tfhka" class="w-100"/>
                                </div>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="password_tfhka" class="col-form-label">Password</label>
                                <div class="col-sm-8">
                                    <field name="password_tfhka" password="True" class="w-100"/>
                                </div>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="url_tfhka" class="col-form-label">URL</label>
                                <div class="col-sm-8">
                                    <field name="url_tfhka" class="w-100"/>
                                </div>
                            </div>
                            <br/>
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="invoice_digital_tfhka"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="invoice_digital_tfhka"/>
                                </div>
                            </div>
                            <div class="o_setting_box" invisible="not invoice_digital_tfhka">
                                <div class="o_setting_left_pane">
                                    <field name="dispatch_guide_digital_tfhka"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="dispatch_guide_digital_tfhka"/>
                                </div>
                            </div>
                            <div class="o_setting_left_pane">
                                <field name="digitalization_with_payment_tfhka"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="digitalization_with_payment_tfhka"/>
                            </div>
                            <div class="o_setting_box" invisible="not digitalization_with_payment_tfhka">
                                <field name="payment_mode_tfhka" widget="radio" class="oe_inline"/>
                            </div>
                            <!-- Facturación por lotes: reserva un rango de numeración vía
                                 /AsignarNumeraciones y habilita la acción "Generate TFHKA
                                 Digitalization Batch" en la lista de facturas. Depende de
                                 "Digital invoicing with payment registration" (ver
                                 res.config.settings, onchange + set_values):
                                 el lote encola directo, sin pasar por el filtro
                                 "not payment-driven" del encolado normal, así que solo
                                 tiene sentido bajo ese modo. -->
                            <div class="o_setting_box" invisible="not digitalization_with_payment_tfhka">
                                <div class="o_setting_left_pane">
                                    <field name="batch_invoicing_tfhka"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="batch_invoicing_tfhka"/>
                                    <div class="text-muted">
                                        Allows grouping posted invoices into a TFHKA digitalization batch (esLote).
                                    </div>
                                </div>
                            </div>
                            <!-- Multi-moneda: toggle maestro que habilita el checkbox
                                 por factura. Solo visible si invoice_digital_tfhka está activo. -->
                            <div class="o_setting_box" invisible="not invoice_digital_tfhka">
                                <div class="o_setting_left_pane">
                                    <field name="multi_currency_invoice_tfhka"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="multi_currency_invoice_tfhka"/>
                                    <div class="text-muted">
                                        Allows marking individual invoices as multi-currency (mixed VES/USD) for digitalization.
                                    </div>
                                </div>
                            </div>
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="notify_email_tfhka"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="notify_email_tfhka"/>
                                    <div class="text-muted">
                                        When enabled, The Factory HKA will send the digitalized document to the customer by email. When disabled, the email will be sent directly from Odoo.
                                    </div>
                                </div>
                            </div>
                            <div class="o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="mix_invoicing_tfhka"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="mix_invoicing_tfhka"/>
                                </div>
                            </div>
                            <div class="o_setting_box">
                                <field name="mix_invoicing_type_tfhka" invisible="not mix_invoicing_tfhka"/>
                            </div>
                        </div>
                        <div class="col-6" style="border: 1px solid #ddd; padding: 15px; border-radius: 5px; background-color: #f9f9f9; margin: auto; text-align: center;">
                            <div class="form-group">
                                <label for="token_auth_tfhka" class="col-form-label">Token Auth</label>
                                <div class="col-sm-12" style="word-wrap: break-word;">
                                    <field name="token_auth_tfhka" readonly="True" password="True" style="width: 100%;"/>
                                </div>
                            </div>
                            <div class="form-group">
                                <button name="action_generate_token_tfhka" 
                                        type="object" 
                                        string="Generate Token" 
                                        class="btn-secondary ps-2 w-50" 
                                        icon="fa-refresh" 
                                        title="Generate Token for TFHKA."
                                />
                            </div>
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>
</odoo>