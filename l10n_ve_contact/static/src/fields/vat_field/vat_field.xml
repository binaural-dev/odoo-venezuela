<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Same input as the char field; inputmode shows the numeric keypad on
         tablets and phones, and onVatInput drops anything that is not a digit. -->
    <t t-name="l10n_ve_contact.VatField" t-inherit="web.CharField" t-inherit-mode="primary">
        <xpath expr="//input" position="attributes">
            <attribute name="inputmode">numeric</attribute>
            <attribute name="t-on-input">onVatInput</attribute>
        </xpath>
    </t>

</templates>
