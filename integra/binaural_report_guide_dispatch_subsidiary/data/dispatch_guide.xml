<?xml version="1.0" encoding="ISO-8859-1"?>
<odoo>

  <template id="template_subsidiary" inherit_id="binaural_report_guide_dispatch.tmp_header_invoice">
    <xpath expr="//t[@t-if]" position="before">
      <t t-call="binaural_report_guide_dispatch_subsidiary.field_subsidiary" />
    </xpath>
  </template>
  
  <!-- Importante -->
  <!-- Enviar el t-out de esta manera si lo quieres colocar en una linea en especifico
       sino tomara los saltos de linea, tabulaciones espacios 
  -->
  <template id="field_subsidiary"> <t t-out="docs.invoice_id.account_analytic_id.name.ljust(16)"/> </template> 

</odoo>