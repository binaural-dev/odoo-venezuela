<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_binaural_stock_sale_pos" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <field name="backorder_id" position="after">
                <field name="pos_order_id" invisible="1"/>
                <field name="pos_user_id" string="Comercial" attrs="{'invisible':[('pos_order_id' ,'=', False)]}"/>
                <field name="pos_invoice" string="Nº Factura" attrs="{'invisible':[('pos_order_id' ,'=', False)]}"/>
            </field>

        </field>
    </record>

</odoo>
