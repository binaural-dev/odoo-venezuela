<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_landed_cost_binaural_cost_advance" model="ir.ui.view">
        <field name="name">stock.landed.cost.binaural.cost.advance</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_stock_valuation_landed" string="Details" type="object" />
            </xpath>
            <field name="picking_ids" position="replace">

                <field name="picking_ids" widget="many2many_tags" 
                                        options="{'no_create_edit': True}" attrs="{'invisible': [('target_model', '!=', 'picking')]}"
                                        domain="[('company_id', '=', company_id), ('move_ids.stock_valuation_layer_ids', '!=', False),
                                                ('picking_type_code', '=', 'incoming'), ('purchase_id', '!=', False)]"/>
                    
            </field>
             <xpath expr="//page[@name='valuation_adjustments']/field/tree/field[@name='former_cost']" position="before">
                <field name="unit_cost" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='valuation_adjustments']/field/tree/field[@name='former_cost']" position="after">
                <field name="foreign_former_cost" optional="1"/>
                <field name="is_stock_advance" invisible="1" />
                <field name="cost_percentage" optional="show"/>
                <field name="cost_cif" />
                <field name="percentage_tariff_code" />
                <field name="tariff_value" />
            </xpath>
            <xpath expr="//page[@name='valuation_adjustments']/field/tree/field[@name='final_cost']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='valuation_adjustments']/field/tree/field[@name='additional_landed_cost']" position="after">
                <field name="final_cost"/>
                <field name="last_cost" />
                <field name="latest_standard_price" optional="1"/>
                <field name="update_latest_standard_price" optional="1"/> 
            </xpath>

            <xpath expr="//notebook/page[2]" position="after">
                <page string="Foreign Valuation Adjustments" name="foreign_valuation_adjustmnets">
                    <field name="foreign_valuation_adjustment_lines">
                        <tree string="Foreign Valuation Adjustments" editable="bottom" create="0">
                            <field name="cost_line_id" readonly="1"/>   
                            <field name="product_id" readonly="1"/>
                            <field name="weight" readonly="1" optional="hide"/>
                            <field name="volume" readonly="1" optional="hide"/>
                            <field name="quantity" readonly="1"/>
                            <field name="foreign_unit_cost" readonly="1" />
                            <field name="foreign_currency_id" invisible="1"/>
                            <field name="foreign_former_cost" readonly="1"/>
                            <field name="cost_percentage" optional="show" />
                            <field name="foreign_additional_landed_cost"/>
                            <field name="foreign_final_cost" readonly="1"/>
                            <field name="foreign_last_cost"/>
                        </tree>
                    </field>
                </page>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Foreign Currency" name="foreign_currency">
                    <group>
                        <field name="foreign_currency_id" />
                        <field
                            name="foreign_inverse_rate"
                            invisible="1"
                            string="Foreign inverse rate"
                        />
                        <t groups="base.group_no_one">
                        <field name="foreign_inverse_rate"/>
                        </t>
                        <field name="foreign_rate"/>
                    </group>
                </page>
            </xpath>
        
        </field>

    </record>

</odoo>
