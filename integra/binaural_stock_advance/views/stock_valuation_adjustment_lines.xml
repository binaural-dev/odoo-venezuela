<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_valuation_adjustment_lines_tree_binaural_stock_advance" model="ir.ui.view">
        <field name="name">stock.valuation.adjustment.lines.tree.binaural.stock.advance</field>
        <field name="model">stock.valuation.adjustment.lines</field>
        <field name="arch" type="xml">
            <tree string="Stock Valuation Adjustment Lines">
                <field name="cost_line_id" readonly="1"/>   
                <field name="product_id" readonly="1"/>
                <field name="weight" readonly="1" optional="hide"/>
                <field name="volume" readonly="1" optional="hide"/>
                <field name="quantity" readonly="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="unit_cost" readonly="1"/>
                <field name="former_cost" readonly="1"/>
                <field name="cost_percentage" optional="show" />
                <field name="additional_landed_cost"/>
                <field name="final_cost" readonly="1"/>
                <field name="last_cost" />
                <field name="total_amount_cost" />
            </tree>
        </field>
    </record>

    <record id="stock_valuation_adjustment_lines_search_binaural_stock_advance" model="ir.ui.view">
        <field name="name">stock.valuation.adjustment.lines.search.binaural.stock.advance</field>
        <field name="model">stock.valuation.adjustment.lines</field>
        <field name="arch" type="xml">
            <search string="Stock Valuation Adjustment">
                <field name="cost_line_id" string="cost id"/>
            </search>
        </field>
    </record>

    <record id='action_stock_valuation_adjustment' model='ir.actions.act_window'>
        <field name="name">Stock Valuation Adjustment Lines</field>
        <field name="res_model">stock.valuation.adjustment.lines</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
    </record>

     <!-- <menuitem action="action_stock_valuation_adjustment" name="Stock Valuation Adjustment Lines" parent="stock.menu_stock_warehouse_mgmt" id="menu_stock_landed_cost" sequence="117"/> -->

</odoo>
