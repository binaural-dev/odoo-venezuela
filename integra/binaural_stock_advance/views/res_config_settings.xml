<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_binaural_stock_advance" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.stock.advance</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                    <h2>Stock Advance</h2>
                    <div class="row mt16 o_settings_container" name="binaural_stock_advance_account_settings">
                        <div class="o_setting_right_pane">
                            <group colspan="4" col="4">
                                <field name="check_advance_stock" />
                                <field name="use_fee_percentage" />
                                <field name="apply_fob" attrs="{'invisible':[('use_fee_percentage', '=', False)]}" />
                                <field name="apply_cif" attrs="{'invisible':[('use_fee_percentage', '=', False)]}" />
                                <field name="service_products_ids" widget="many2many_tags" attrs="{'invisible':[('apply_cif', '=', False)]}"/>
                                <field name="check_calculate_taking_order_quantities" attrs="{'invisible': [('check_calculate_based_total_purchase_amount', '=', True)]}"/>
                                <field name="check_calculate_based_total_purchase_amount"  attrs="{'invisible': [('check_calculate_taking_order_quantities', '=', True)]}"/>
                            </group>
                        </div>
                        <div class="o_setting_right_pane">
                            <group colspan="4" col="4">
                                <field name="use_same_account_stock_valuation_to_category" />
                                <field name="category_cost_account_id" attrs="{'invisible': [('use_same_account_stock_valuation_to_category', '=', False)]}"/>
                            </group>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

</odoo>
