<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@class='payment-controls']" position="inside">
            <div class="button" t-on-click="selectSeller"
            t-att-class="{ highlight: currentOrder.get_seller() }" >
                <i class="fa fa-user" role="img" title="Seller" />
                <t t-set="seller" t-value="currentOrder.get_seller()" />
                <span>
                    <t t-if="seller">
                        <t t-out="seller.name" /> (Seller)
                    </t>
                    <t t-if="!seller">
                        Seller
                    </t>
                </span>
            </div>
        </xpath>
    </t>
</templates>