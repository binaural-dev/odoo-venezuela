<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="DeliveryCommand" owl="1">
        <div class="pos-receipt">
            <t t-if="receipt.company.logo">
                <img class="pos-receipt-logo" t-att-src="receipt.company.logo" alt="Logo"/>
                <br/>
            </t>

            <t t-if="!receipt.company.logo">
                <h2 class="pos-receipt-center-align">
                    <t t-out="receipt.company.name" />
                </h2>
                <br/>
            </t>

            <div class="pos-receipt-contact">
                <t t-if="receipt.company.contact_address">
                    <div class="company-text"><t t-out="receipt.company.contact_address"/></div>
                </t>
                <t t-if="receipt.company.vat">
                    <div class="company-text">VAT <t t-out="receipt.company.vat"/></div>
                </t>

                <t t-if="receipt.company.street">
                    <div><t t-out="'-'.repeat(receipt.company.street.length)"/></div>
                    <div><t t-out="receipt.company.street"/></div>
                </t>
                <t t-else="">
                    <div><t t-out="'-'.repeat(receipt.company.contact_address.length)"/></div>
                </t>
                <t t-if="receipt.company.phone">
                    <div>Tel: <t t-esc="receipt.company.phone" /></div>
                </t>

                <div class="pt_1">
                    <div t-if="isBodegon" class="right-align text-bold"><t t-out="receipt.name"/></div>
                    <div class="right-align"><span class="text-bold">Date: </span><t t-out="convert_to_date(order.validation_date)"/></div>
                    <t t-if="isBodegon">
                        <div class="left-align"><span class="text-bold">Terminal: </span><t t-out="env.pos.config.name"/></div>
                    </t>
                    <t t-else="">
                        <div class="left-align">
                            <div class="text-bold">Parnter Name</div>
                            <t t-out="partner.name"/>
                            <div><span class="text-bold">VAT: </span><t t-if="partner.vat" t-out="partner.vat"/></div>
                            <div><span class="text-bold">ADDRESS: </span><t t-if="partner.street" t-out="partner.street"/></div>
                            <div><span class="text-bold">PHONE: </span><t t-if="partner.phone" t-out="partner.phone"/></div>

                            <!-- Order Info -->
                            <div><span class="text-bold">Time: </span><t t-out="convert_to_time(order.validation_date)"/></div>
                            <span class="right-align text-bold"><t t-out="receipt.name"/></span>
                        </div>
                    </t>
                </div>
            </div>

            <div class="pos-receipt-center-align">--------------------------------</div>
                <div class="flex">
                    <div class="text-bold">DESCRIPTION</div>
                    <div class="text-bold">PRICE <t t-out="currency.symbol"/></div>
                </div>
            <div class="pos-receipt-center-align">--------------------------------</div>

            <div class="orderlines flex-container">
                <t t-call="OrderLinesCommand"/>
            </div>
            <div class="pos-receipt-center-align">--------------------------------</div>

            <div class="flex-container">
                <t t-call="CommandTotalLines"/>
            </div>

            <div class="pos-receipt-center-align">--------------------------------</div>

            <div class="flex">
                <div class="text-bold">Total Productos: <t t-out="order.get_qty_products()"/></div>
            </div>

            <div t-if="is_foreign_currency" class="pos-footer">
                <div>================================</div>
                <span class="text-bold font-80">
                    Total in 
                    <t t-out="receipt.currency.name + ' ' + env.pos.format_currency(receipt.total_with_tax)"/>
                    (BI <t t-out="env.pos.format_currency_no_symbol(receipt.total_without_tax, 'Product Price', currency)"/>).
                    Calculated using rate <t t-out="format_currency()"/> By <t t-out="receipt.currency.symbol"/>
                </span>
            </div>
        </div>
    </t>

    <t t-name="OrderLinesCommand" owl="1">
        <t t-foreach="receipt.orderlines" t-as="line" t-key="line.id">
            <div class="flex">
                <div>
                    <div>
                        <span>Qty </span>
                        <t t-out="Math.round(line.quantity * Math.pow(10, env.pos.dp['Product Unit of Measure'])) / Math.pow(10, env.pos.dp['Product Unit of Measure'])"/>
                        <t t-if="!line.is_in_unit" t-out="line.unit_name" />
                        x
                        <t t-out="format_currency(line.price_display_one)" />
                    </div>
                    <div t-out="line.product_name_wrapped[0]" />
                    <WrappedProductNameLines line="line" />
                </div>

                <div t-if="is_foreign_currency" class="price_display">
                    <t t-set="foreign_product_price" t-value="get_orderline(line.product_name).get_display_foreign_price()"/>
                    <t t-out="env.pos.format_currency_no_symbol(foreign_product_price, 'Product Price', currency)" />
                </div>
                <div t-else="" class="price_display">
                    <t t-out="env.pos.format_currency_no_symbol(line.price_display, 'Product Price', currency)" />
                </div>
            </div>
        </t>
    </t>

    <t t-name="CommandTotalLines" owl="1">
        <t t-if="is_foreign_currency">
            <div class="flex">
                <span class="text-bold">Subtotal <t t-out="currency.symbol"/></span>
                <span><t t-out="env.pos.format_currency_no_symbol(order.get_foreign_total_without_tax(), 'Product Price', currency)"/></span>
            </div>
            <t t-foreach="foreign_tax_details" t-as="tax" t-key="tax.name">
                <div class="flex">
                    <span class="text-bold">Total <t t-out="tax.name"/> <t t-out="currency.symbol"/></span>
                    <span><t t-out="env.pos.format_currency_no_symbol(get_taxed_products_total(tax.tax), 'Product Price', currency)"/></span>
                </div>
                <div class="flex">
                    <!-- <t t-set="amount_rounded" t-value="round_pr(tax.amount * currency.rate, currency.rounding)"/> -->
                    <span class="text-bold"><t t-out="tax.name"/> <t t-out="currency.symbol"/></span>
                    <span><t t-out="env.pos.format_currency_no_symbol(tax.amount, 'Product Price', currency)"/></span>
                    <!-- <span><t t-out="round_pr(tax.amount * currency.rate, currency.rounding)"/></span> -->
                </div>
            </t>
            <div class="flex">
                <span class="text-bold">Total <t t-out="currency.symbol"/></span>
                <span><t t-out="order.get_foreign_total_with_tax()"/></span>
            </div>
        </t>
        <t t-else="">
            <div class="flex">
                <span class="text-bold">Subtotal <t t-out="currency.symbol"/></span>
                <span><t t-out="env.pos.format_currency_no_symbol(receipt.total_without_tax, 'Product Price', currency)"/></span>
            </div>
            <t t-foreach="receipt.tax_details" t-as="tax" t-key="tax.name">
                <div class="flex">
                    <span class="text-bold">Total <t t-out="tax.name"/> <t t-out="currency.symbol"/></span>
                    <span><t t-out="env.pos.format_currency_no_symbol(get_taxed_products_total(tax.tax), 'Product Price', currency)"/></span>
                </div>
                <div class="flex">
                    <span class="text-bold"><t t-out="tax.name"/> <t t-out="currency.symbol"/></span>
                    <span><t t-out="env.pos.format_currency_no_symbol(tax.amount, 'Product Price', currency)"/></span>
                </div>
            </t>
            <div class="flex">
                <span class="text-bold">Total <t t-out="currency.symbol"/></span>
                <span><t t-out="env.pos.format_currency_no_symbol(receipt.total_with_tax, 'Product Price', currency)"/></span>
            </div>
        </t>
    </t>

</templates>
