<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

  <t t-name="DeliveryCommandScreen" owl="1">
      <div class="receipt-screen screen">
        <div class="screen-content">
            <div class="top-content">
                <span class="button back" t-on-click="goBack">
                    <i class="fa fa-angle-double-left"></i>
                    <span> </span>
                    <span>Back</span>
                </span>
            </div>

            <div class="centered-content">
                <div class="buttons">
                    <div class="button print" t-on-click="retryReport">
                        <i class="fa fa-print"></i>
                        <span> Print (<t t-out="currency.symbol"/>)</span>
                    </div>
                    <div class="button print" t-on-click="retryForeignReport">
                        <i class="fa fa-print"></i>
                        <span> Print (<t t-out="foreignCurrency.symbol"/>)</span>
                    </div>
                </div>

                <div class="receipt-handler">
                    <div class="pos-receipt-container" t-ref="delivery-command">
                        <DeliveryCommand currency="currency" order="currentOrder"/>
                    </div>
                    <div class="pos-receipt-container" t-ref="delivery-command-foreign">
                        <DeliveryCommand currency="foreignCurrency" order="currentOrder"/>
                    </div>
                </div>
            </div>
          </div>
      </div>
  </t>

</templates>