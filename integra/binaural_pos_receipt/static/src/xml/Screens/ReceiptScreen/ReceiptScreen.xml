<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" owl="1">
        <xpath expr="//div[hasclass('receipt-screen')]/div[hasclass('screen-content')]/div[hasclass('default-view')]/div[hasclass('actions')]/div[hasclass('buttons')]" position="replace">
            <div class="buttons">
                <t t-if="currentOrder.is_to_receipt()">
                    <div class="button print" t-on-click="printDeliveryCommand">
                        <i class="fa fa-print"/> Delivery Note
                    </div>
                </t>
                <t t-else="">
                    <div class="button print" t-on-click="printReceipt">
                        <i class="fa fa-print"></i> Print Receipt
                    </div>
                </t>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('receipt-screen')]/div[hasclass('screen-content')]/div[hasclass('default-view')]/div[hasclass('pos-receipt-container')]" position="replace">
            <div class="pos-receipt-container" t-ref="order-receipt" t-attf-style="{{ currentOrder.is_to_receipt() ? 'display: none;' : '' }}">
                <OrderReceipt order="currentOrder"/>
            </div>
        </xpath>
    </t>

</templates>