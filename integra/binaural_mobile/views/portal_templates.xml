<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ADD Menus in /my Portal -->
    <template id="portal_my_home_payments" name="Show payments" customize_show="True" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-if="request.env.user.employee_id.is_seller">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'"/>
                    <t t-set="title">Payments</t>
                    <t t-set="url" t-value="'/payment_list'"/>
                    <t t-set="text">Pagos pagos</t>
                    <t t-set="placeholder_count" t-value="'payments_count'"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
                    <t t-set="title">Shop</t>
                    <t t-set="url" t-value="'/shop'"/>
                    <t t-set="text">Product for Sale</t>
                    <t t-set="placeholder_count" t-value="'products_count'"/>
                </t>
            </t>
        </div>
    </template>

    
    <template id="portal_layout" inherit_id="portal.portal_layout">
        <xpath expr="//div[@id='accountOffCanvas'][1]"  position="replace">
            <t t-if="not request.env.user.employee_id.is_seller">
                <div class="offcanvas offcanvas-start d-lg-none" id="accountOffCanvas">
                    <t t-call="portal.side_content">
                        <t t-set="isOffcanvas" t-value="true"/>
                    </t>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[2]//div[2]//div[2]"  position="replace">
            <t t-if="not request.env.user.employee_id.is_seller">
                <div class="d-none d-lg-flex justify-content-end col-lg-4">
                    <t t-call="portal.side_content"/>
                </div>
            </t>
        </xpath>
    </template>
    

</odoo>
