<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="binaural_movil_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">binaural.movil.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='main_warehouse_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
