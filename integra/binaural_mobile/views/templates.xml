<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="product" inherit_id="website_sale.product">
        <xpath expr="//t[4]//div[2]//div[2]//div[2]//div[1]" position="replace">
            <t t-if="request.env.user.employee_id.is_seller == false">
                
            </t>
        </xpath>

        <xpath expr="//t[4]//div[2]//div[2]//div[2]//div" position="replace">
            <t t-if="request.env.user.employee_id.is_seller == false">
                <div t-attf-class="css_quantity input-group {{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-flex'}} me-2 mb-2 align-middle #{'input-group-lg' if ctaSizeBig else ''}" contenteditable="false">
                    <a t-attf-href="#" class="btn btn-link js_add_cart_json" aria-label="Remove one" title="Remove one">
                        <i class="fa fa-minus"></i>
                    </a>
                    <input type="text" class="form-control quantity text-center" data-min="1" name="add_qty" t-att-value="add_qty or 1"/>
                    <a t-attf-href="#" class="btn btn-link float_left js_add_cart_json" aria-label="Add one" title="Add one">
                        <i class="fa fa-plus"></i>
                    </a>
                </div>
                <div id="add_to_cart_wrap" t-attf-class="{{'d-none' if combination_info['prevent_zero_price_sale'] else 'd-inline-flex'}} align-items-center mb-2 me-auto">
                    <a data-animation-selector=".o_wsale_product_images" role="button" id="add_to_cart" t-attf-class="btn btn-primary js_check_product a-submit flex-grow-1 #{'btn-lg' if ctaSizeBig else ''}" href="#">
                        <i class="fa fa-shopping-cart me-2"/>
                        <span style="font-weight: bold">ADD TO CART</span>
                    </a>
                </div>
            </t>
        </xpath>

        <xpath expr="//t[4]//div[2]//div[2]//div[2]" position="before">
            <t t-if="request.env.user.employee_id.is_seller">
                <div class="row">
                    <t t-if="product.default_code">
                        <label class="form-text col-sm-2">Default code</label>
                        <h5 class="form-label col-sm-4">[<t t-out="product.default_code"/>]</h5>
                    </t>
                    <t t-if="product.alternate_code">
                        <label class="form-text col-sm-2">Alternate code</label>
                        <h5 class="form-label col-sm-3" t-out="product.alternate_code"></h5>
                    </t>
                    <t t-if="product.type == 'product'">
                        <t t-if="product.quantity and product.quantity > 0">
                            <h5 class="form-label col-sm-5"><t t-out="'%.2f'% product.quantity"/><t t-out="product.uom_id.name"/></h5>
                        </t>
                        <t t-else="">
                            <h5 class="text-danger col-sm-3">Out of stock</h5>
                        </t>
                    </t>
                    <t t-if="product.type == 'service'">
                        <h5 class="form-label col-sm-5 text-success">Service</h5>
                    </t>
                    <t t-if="product.brand_id.name">
                        <label class="form-text col-sm-2">Brand</label>
                        <h5 class="form-label col-sm-3" t-out="product.brand_id.name"></h5>
                    </t>
                    <t t-if="product.barcode">
                        <div class="col-sm-5">
                            <label class="form-text">Barcode</label>
                            <h5 class="form-label" t-out="product.barcode"/>
                        </div>
                    </t>   
                </div>
            </t>
        </xpath>

    </template>

    <template id="products_item" inherit_id="website_sale.products_item">
        <xpath expr="//div[2]//h6/a[1]" position="replace">
            <t t-if="request.env.user.employee_id.is_seller">
                <div class="d-flex justify-content-between">
                    <a class="text-primary text-decoration-none" style="font-weight: bolder;" itemprop="name" t-att-href="product_href" t-att-content="product.name" t-field="product.display_name" />
                </div>
                <div class="d-flex justify-content-between">
                    <t t-if="product.brand_id.name">
                        <label class="small badge text-bg-info orders_label_text_align" t-out="product.brand_id.name"/>
                    </t>
                    <t t-if="product.alternate_code">
                        <label class="form-text" t-out="product.alternate_code"/>
                    </t>
                </div>
                <div class="d-flex justify-content-between">
                    <t t-if="product.type == 'product'">
                        <t t-if="product.quantity and product.quantity > 0">
                            <label class="form-text">
                                <t t-out="'%.2f'% product.quantity"/>
                                <t t-out="product.uom_id.name"/>
                            </label>
                        </t>
                        <t t-else="">
                            <label class="text-danger form-text">Out of stock</label>
                        </t>
                    </t>
                    <t t-if="product.type == 'service'">
                        <label class="text-success form-text">Service</label>
                    </t>
                </div>
            </t>
            <t t-else="">
                <a class="text-primary text-decoration-none" itemprop="name" t-att-href="product_href" t-att-content="product.name" t-field="product.name" />
            </t>
        </xpath>
    </template>


</odoo>
