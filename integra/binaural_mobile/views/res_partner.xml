<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="binaural_mobile_partner_inherit_view_form" model="ir.ui.view">
        <field name="name">binaural.mobile.partner.inherit.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group/div/div[@name='partner_address_country']" position="after">
                <field name="plus_code" widget="url" string="Plus Code" placeholder="Plus Code"/>
            </xpath>
        </field>
    </record>
</odoo>
