<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_movil_sale_order_view_form" model="ir.ui.view">
        <field name="name">binaural.movil.sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="company_mobile" invisible="1"/>
                <field name="tax_included" invisible="not company_mobile" readonly="state in ['sale', 'done']"/>
            </xpath>
        </field>
    </record>

</odoo>
