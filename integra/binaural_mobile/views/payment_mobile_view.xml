<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="binaural_payment_mobile_view_tree" model="ir.ui.view">
            <field name="name">binaural.payment.mobile.view.tree</field>
            <field name="model">payment.mobile</field>
            <field name="arch" type="xml">
                <tree create="false" edit="false">
					<field name="id" />
					<field name="seller_id" />
					<field name="partner_id"/>
					<field name="amount"/>
					<field name="currency_id" column_invisible="True"/>
					<field name="state" widget="badge"/>
					<field name="create_date" />
					<field name="company_id" groups="base.group_multi_company"/>
				</tree>
            </field>
        </record>

        <record id="binaural_payment_mobile_view_form" model="ir.ui.view">
            <field name="name">binaural.payment.mobile.view.form</field>
            <field name="model">payment.mobile</field>
            <field name="arch" type="xml">
                <form string="Paids">
                    <header>
						<!-- <button string="Test Decimal" name="compute_test" type="object" class="oe_highlight"/> -->
						<button string="Cancelar" name="cancel_payment" type="object" class="oe_highlight"  invisible="state == 'cancel' or verified_payment"/>
						<field name="state" widget="statusbar" statusbar_colors='{"draft":"red","process":"blue"}'/>
					</header>
                    <sheet>
                        <group>
							<group>
								<field name="partner_id" readonly="state == 'process'"/>
								<field name="seller_id" readonly="state == 'process'"/>
								<field name="proof_payment_id" domain="[('id','=', proof_payment_domain)]" invisible="proof_payment_id"/>
								<field name="proof_payment_domain" invisible="1"/>
								<field name="proof_file" widget="binary" filename="proof_name" invisible="not proof_payment_id"/>
								<field name="proof_name" invisible="1"/>
							</group>
							<group>
								<field name="verified_payment" />
								<field name="amount"/>
								<button string="Delete File" name="delete_file" type="object" class="oe_highlight" invisible="state == 'cancel' or not proof_payment_id"/>
								<field name="currency_id" invisible="1"/>
							</group>
                        </group>
                        
                        <notebook>
							<page name="mobile_lines" string="Lineas de pagos">
								<field name="payment_mobile_line" readonly="state == 'process'">
									<tree name="mobile_lines_tree">
										<field name="name"/>
										<field name="invoice_id"/>
										<field name="partner_id"/>
										<field name="amount"/>
										<field name="foreign_amount"/>
										<field name="journal_id"/>
										<field name="payment_related"/>
										<field name="amount_payment_total"/>
										<field name="foreign_amount_payment_total"/>
										<field name="use_balance"/>
										<field name="memo"/>
										<field name="invoice_number"/>
										<field name="foreign_rate"/>
										<field name="amount_residual"/>
										<field name="subtotal"/>
										<field name="iva"/>
										<field name="total_invoice"/>
										<field name="currency_id" column_invisible="True"/>
										<field name="foreign_currency_id" column_invisible="True"/>
									</tree>
								</field>
							</page>
							<page name="payment_mobile_methods_page" string="Payment methods">
								<field name="payment_mobile_methods" readonly="state == 'process'">
									<tree name="methods_lines_tree" editable="top" create="1" delete="1" multi_edit="1">
										<field name="residual_payment"/>
										<field name="journal_id"/>
										<field name="amount"/>
										<field name="currency_id" column_invisible="True"/>
									</tree>
								</field>
							</page>
						</notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="binaural_payment_mobile_action" model="ir.actions.act_window">
            <field name="name">Payment mobile</field>
            <field name="res_model">payment.mobile</field>
            <field name="view_mode">tree,form</field>
        </record>

		<record id="binaural_payment_mobile_proof_action" model="ir.actions.act_window">
			<field name="name">Payment Proof</field>
			<field name="res_model">payment.mobile.proof</field>
			<field name="view_mode">tree</field>
		</record>

		<record id="payment_mobile_proof_view_tree" model="ir.ui.view">
			<field name="name">payment.mobile.proof.view.tree</field>
			<field name="model">payment.mobile.proof</field>
			<field name="arch" type="xml">
				<tree string="Proof of Payment">
					<field name="proof_file"/>
					<field name="name"/>
				</tree>
			</field>
		</record>

    </data>
</odoo>
