    <template id="budget_link" name="Budget">
        <t t-nocache="The number of products is dynamic, this rendering cannot be cached." 
        t-nocache-_text="_text"
        t-nocache-_item_class="_item_class"
        t-nocache-_link_class="_link_class"
        t-if="request.env.user.employee_id.is_seller">
            <li t-attf-class="#{_item_class}">
                <a href="/budget" t-attf-class="#{_link_class} create_budget_link_menuitem">
                    <span t-if="_text">Create budget</span>
                </a>
            </li>
        </t>
    </template>

    <template id="create_payment_link" name="create_payment">
        <t t-nocache="The number of products is dynamic, this rendering cannot be cached." 
        t-nocache-_text="_text"
        t-nocache-_item_class="_item_class"
        t-nocache-_link_class="_link_class"
        t-if="request.env.user.employee_id.is_seller">
            <li t-attf-class="#{_item_class}">
                <t t-set="user" t-value="request.env.user"/>
                <t t-if="not user.has_group('binaural_mobile.group_sellers_cant_create_payments')">
                    <a href="/payments" t-attf-class="#{_link_class} create_payment_link_menuitem">
                        <span t-if="_text">Create payment</span>
                    </a>
                </t>
            </li>
        </t>
    </template>

