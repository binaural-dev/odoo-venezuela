<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="product_add_to_wishlist" inherit_id="website_sale_wishlist.product_add_to_wishlist" name="Wishlist Button">
    <xpath expr="//button[hasclass('o_add_wishlist_dyn')]" position="replace">
      <t t-set="is_seller" t-value="request.env.user.employee_id.is_seller"/>
      <button t-if="product_variant and not is_seller" type="button" role="button" class="btn btn-link px-0 pe-3 o_add_wishlist_dyn" t-att-disabled='in_wish or None' t-att-data-product-template-id="product.id" t-att-data-product-product-id="product_variant.id" data-action="o_wishlist" title="Add to wishlist"><i class="fa fa-heart-o me-2" role="img" aria-label="Add to wishlist"/>Add to wishlist</button>
    </xpath>
  </template>

  <template id="add_to_wishlist" inherit_id="website_sale_wishlist.add_to_wishlist" name="Wishlist Button2">
    <xpath expr="//button[hasclass('o_add_wishlist')]" position="replace">
      <t t-set="is_seller" t-value="request.env.user.employee_id.is_seller"/>
      <button t-if="product_variant_id and not is_seller" type="button" role="button" class="btn btn-outline-primary bg-white o_add_wishlist" t-att-disabled='in_wish or None' title="Add to Wishlist" t-att-data-product-template-id="product.id" t-att-data-product-product-id="product_variant_id" data-action="o_wishlist"><span class="fa fa-heart" role="img" aria-label="Add to wishlist"></span></button>
    </xpath>
  </template>

  <template id="header_wishlist_link" inherit_id="website_sale_wishlist.header_wishlist_link" name="Wishlist header_wishlist_link">
    <xpath expr="//li[contains(@t-attf-class, 'o_wsale_my_wish')]" position="replace">
      <t t-set="is_seller" t-value="request.env.user.employee_id.is_seller"/>
      
      <li t-attf-class="o_wsale_my_wish #{not show_wishes and 'd-none'} #{_item_class}" t-if="not is_seller">
          <a href="/shop/wishlist" t-attf-class="#{_link_class}">
              <i t-if="_icon" class="fa fa-1x fa-heart"/>
              <span t-if="_text">Wishlist</span>
              <sup t-esc="wishcount" t-attf-class="my_wish_quantity o_animate_blink badge text-bg-primary"/>
          </a>
      </li>
    </xpath>
  </template>

</odoo>