<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="portal_my_home_menu_invoices_seller" inherit_id="account.portal_my_home_menu_invoice" priority="30">
		<xpath expr="//li[2]" position="replace">
			<t t-if="request.env.user.employee_id.is_seller">
				<li t-if="invoice" class="breadcrumb-item active">
					<a t-if="invoice" t-attf-href="/my/invoices?{{ keep_query() }}">Invoices</a>
				</li>
			</t>
		</xpath>
	</template>

	<!-- Codicionar y agregar items en /my Portal -->
	<template id="portal_my_home_invoice" name="Show Invoices &amp; Bills" inherit_id="account.portal_my_home_invoice" customize_show="True" priority="30">
		<xpath expr="//div[2]/t[1]" position="replace">
			<t t-if="not request.env.user.employee_id.is_seller">
				<t t-call="portal.portal_docs_entry">
					<t t-set="icon" t-value="'/account/static/src/img/Bill.svg'"/>
					<t t-set="title">Our Invoices</t>
					<t t-set="url" t-value="'/my/invoices?filterby=bills'"/>
					<t t-set="text">Follow, download or pay our invoices</t>
					<t t-set="placeholder_count" t-value="'bill_count'"/>
				</t>
			</t>
		</xpath>
		<xpath expr="//div[1]/t[1]" position="replace">
			<t t-call="portal.portal_docs_entry" t-if="request.env.user.employee_id.is_seller">
                <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'"/>
                <t t-set="title">Your Invoices</t>
                <t t-set="url" t-value="'/my/invoices'"/>
                <t t-set="text">Invoices for Seller</t>
                <t t-set="placeholder_count" t-value="'invoice_count'"/>
            </t>
			<t t-call="portal.portal_docs_entry" t-else="">
                <t t-set="icon" t-value="'/account/static/src/img/Bill.svg'"/>
                <t t-set="title">Your Invoices</t>
                <t t-set="url" t-value="'/my/invoices?filterby=invoices'"/>
                <t t-set="text">Follow, download or pay your invoices</t>
                <t t-set="placeholder_count" t-value="'invoice_count'"/>
            </t>
		</xpath>
	</template>

	<template id="portal_invoices_seller" name="Invoice">
		<t t-call="portal.portal_layout">
			<t t-set="breadcrumbs_searchbar" t-value="True"/>
			<t t-call="portal.portal_searchbar">
				<t t-set="title"></t>
			</t>
			<div class="container o_portal_invoices_seller">
				<div class="row mb-3">
					<div class="d-flex justify-content-center">
						<a id="dowload-invoice" class="btn btn-info col-10 mx-auto">
							<i class="fa fa-download"/> Download PDF                        
						</a>
						<input class="d-none" type="checkbox" id="invoice" checked="True" t-if="invoice.journal_id.fiscal"/>
						<input class="d-none" type="checkbox" id="invoice" t-else=""/>
					</div>
				</div>
				<hr width="100%" />
				<div class="row mb-4">
					<h1 class="col-sm-8" t-out="invoice.name" id="invoice_name"/>
					<input type="hidden" id="invoice_id" t-att-value="invoice.id"/>
					<h3 class="col-sm-4 bg-secondary text-center rounded-pill" t-field="invoice.payment_state"/>
				</div>
				<div class="row mb-1">
					<h4 class="col-sm-3 fw-light">Client:</h4>
					<h6 class="col-sm-3 fw-bolder" t-out="invoice.partner_id.display_name"/>
					<h4 class="col-sm-3 fw-light">Invoice number:</h4>
					<h6 class="col-sm-3 fw-bolder" t-out="invoice.name"/>
				</div>
				<div class="row mb-1">
					<h4 class="col-sm-3 fw-light">Invoice date:</h4>
					<h6 class="col-sm-3 fw-bolder" t-out="invoice.invoice_date"/>
					<h4 class="col-sm-3 fw-light">Valid date:</h4>
					<h6 class="col-sm-3 fw-bolder" t-out="invoice.invoice_date_due"/>
				</div>
				<div class="row mb-1">
					<h4 class="col-sm-3 fw-light">Reception date:</h4>
					<h6 class="col-sm-3 fw-bolder">
						<t t-if="invoice.invoice_reception_date">
							<t t-out="invoice.invoice_reception_date"/></t>
						<t t-else="">
                            No reception date
                        </t>
					</h6>
					<h4 class="col-sm-3 fw-light">Origin document:</h4>
					<h6 class="col-sm-3 fw-bolder" t-out="invoice.invoice_origin"/>
				</div>
				<hr width="100%" />
				<div>
					<div class="d-flex justify-content-end" t-if="invoice.journal_id.fiscal">
						<label class="form-label" style="padding-right:3px;">Taxable Base:</label>
						<label class="form-label fw-bolder" t-field="invoice.amount_untaxed"></label>
					</div>
					<div id="taxes-invoices-budgets"></div>
					<div class="d-flex justify-content-end">
						<hr width="50%" />
					</div>
					<div class="d-flex justify-content-end">
						<label class="form-label">Total:    </label>
						<label class="form-label fw-bolder">
							<span t-field="invoice.amount_total_signed" t-if="invoice.journal_id.fiscal"/>
							<span t-field="invoice.amount_untaxed" t-else=""/>
						</label>
					</div>
					<div>
						<label>Payment Term: </label>
						<span t-field="invoice.invoice_payment_term_id"/>
					</div>
					<t t-if="invoice.payment_term_details">
						<div t-if='invoice.show_payment_term_details' id="total_payment_term_details_table" class="row">
							<div t-attf-class="#{'col-7' if report_type != 'html' else 'col-sm-7 col-md-6'} mt-2 mb-2">
								<table class="table table-sm" style="page-break-inside: avoid;">
									<th class="border-black text-start">
                                        Due Date
                                    </th>
									<th class="border-black text-end">
                                        Amount Due
                                    </th>
									<th t-if="invoice.show_discount_details" class="border-black text-end">
                                        Discount
                                    </th>
									<t t-foreach="invoice.payment_term_details" t-as="term">
										<tr>
											<td t-out="term.get('date')" class="text-start"/>
											<td t-options='{"widget": "monetary", "display_currency": invoice.currency_id}' t-out="term.get('amount')" class="text-end"/>
											<td t-if="term.get('discount_date')" class="text-end">
												<span t-options='{"widget": "monetary", "display_currency": invoice.currency_id}' t-out="term.get('discount_amount_currency')"/> if paid before                                                
												<span t-out="term.get('discount_date')"/>
											</td>
										</tr>
									</t>
								</table>
							</div>
						</div>
					</t>
				</div>
				<input type="hidden" id="symbolB" t-att-value="currency.symbol"/>
				<input type="hidden" id="positionS" t-att-value="currency.position"/>
				<input type="hidden" id="decimal" t-att-value="currency.decimal_places"/>
			</div>
		</t>
	</template>
</odoo>
