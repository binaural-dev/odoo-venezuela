<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_payment_mobile_igtf_view_tree" model="ir.ui.view">
        <field name="name">payment.mobile.igtf.view.tree</field>
        <field name="model">payment.mobile.igtf</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="id" />
                <field name="seller_id"/>
                <field name="partner_id" />
                <field name="amount_igtf"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="binaural_payment_mobile_igtf_view_form" model="ir.ui.view">
        <field name="name">payment.mobile.igtf.view.form</field>
        <field name="model">payment.mobile.igtf</field>
        <field name="arch" type="xml">
            <form edit="false">
                <header>
                    <button string="Mark as posted" name="posted_igtf" type="object" class="oe_highlight" invisible="state in ['posted', 'cancel']"/>
                    <button string="Cancel" name="cancel_igtf" type="object" class="oe_highlight" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_colors='{"to_posted":"red","posted":"blue"}'/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="seller_id"/>
                            <field name="payment_id"/>
                            <field name="journal_id" />
                            <field name="payment_mobile_id" />
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="amount"/>
                            <field name="amount_igtf"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="binaural_payment_mobile_igtf_view_search" model="ir.ui.view">
        <field name="name">payment.mobile.igtf.view.search</field>
        <field name="model">payment.mobile.igtf</field>
        <field name="arch" type="xml">
            <search>
                <group string="Group By">
                    <filter name="state" string="State" context="{'group_by': 'state'}" />
                    <filter name="partner_id" string="Client" context="{'group_by': 'partner_id'}"/>
                    <filter name="seller_id" string="Seller" context="{'group_by': 'seller_id'}"/>
                    <filter name="journal_id" string="Journal" context="{'group_by': 'journal_id'}" />
                </group>
                <filter name="state" string="To be posted" domain="[('state', '=', 'to_posted')]"/>
                <filter name="state" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="state" string="Cancelado" domain="[('state', '=', 'cancel')]"/>
            </search>
        </field>
    </record>

    <record id="binaural_payment_mobile_igtf_action" model="ir.actions.act_window">
        <field name="name">IGTF Suggested App</field>
        <field name="res_model">payment.mobile.igtf</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
