<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_menu_payment" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="payments and not payment_registered" class="breadcrumb-item active">
                Payments
            </li>
            <li t-if="payments and payment_registered or dairy_sale and currency" class="breadcrumb-item active">
                <a t-if="payments or dairy_sale" t-attf-href="/payment_list?{{ keep_query() }}">Payments</a>
                / <t t-out="payments.id" t-if="payments"/><span t-else="">Creating payments</span>
            </li>
        </xpath>
    </template>

    <template id="payments_list_portal" name="Payments list">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <div class="px-2">
                    <a t-attf-href="/payments" class="btn btn-primary btn-sm">Create Payment</a>
                </div>
                <div class="px-2" t-if="search">
                    <a t-attf-href="/payment_list" class="btn btn-secondary btn-sm gap-2">Clean search</a>
                </div>
            </t>
            <div class="container">
                <t t-if="payments" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Payment Date</th>
                            <th>Customer</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="payments" t-as="payment">
                            <tr>
                                <td><span t-field="payment.create_date" t-options="{'widget': 'date'}"/></td>
                                <td><a t-attf-href="/payment_list/{{payment.id}}"><span t-field="payment.partner_id.name"/></a></td>
                                <td class="text-end">
                                    <span t-field="payment.amount"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
                <t t-else="">
                    <p>There are no payments made to the company.</p>
                </t>
            </div>
        </t>
    </template>

    <template id="payments_info_portal" name="Payment Info">
        <t t-call="portal.portal_layout">
            <div class="container payments_info_portal">
                <t t-if="payments">
                    <div class="row mb-3">
                        <input type="hidden" t-att-value="payments.id" id="payment_id"/>
                        <h2 class="col-sm-3" style="font-weight: lighter;">Client</h2>
                        <h4 class="col-sm-3" style="font-weight: bolder;" t-out="payments.partner_id.name"></h4>
                    </div>
                    <div class="d-grid gap-2 mx-auto">
                        <t t-if="payments.state not in 'cancel'">
                            <t t-if="payments.verified_payment">
                                <h2 class="badge bg-success">Confirmed</h2>
                            </t>
                            <t t-else="">
                                <h2 class="badge bg-warning">To validate</h2>
                            </t>
                        </t>
                        <t t-else="">
                            <t t-if="payments.state == 'cancel'">
                                <h2 class="badge bg-danger">Cancelled</h2>
                            </t>
                        </t>
                    </div>
                    <h4 style="font-weight: bolder;">Paids:</h4>
                    <br />
                    <div class="row mb-2">
                        <table class="table table-primary table-striped">
                            <tbody>
                                <t t-set="retention_conf" t-value="request.env.company.iva_customer_retention_journal_id"/>
                                <t t-set="company_currency" t-value="request.env.company.currency_id"/>
                                <t t-foreach="payments.payment_mobile_line" t-as="line">
                                    <tr>
                                        <td colspan="4">
                                            <label style="font-weight: bolder;" t-out="line.invoice_id.name"></label><br/>
                                            <label style="font-weight: bolder;" t-out="line.journal_id.name"></label><br/>
                                            <label style="font-weight: bolder;" t-out="line.payment_date"></label><br/>
                                        </td>
                                        <td colspan="2" class="text-end">
                                            <t t-if="line.payment_related.journal_id.id == retention_conf.id">
                                                <t t-if="line.payment_related.currency_id != company_currency.id">
                                                    <label t-field="line.foreign_amount"/><br/>
                                                </t>
                                                <label t-field="line.amount"/><br/>
                                                <label t-out="line.payment_related.name"/><br/>
                                            </t>
                                            <t t-else="">
                                                <label t-field="line.amount"/><br/>
                                                <t t-if="line.payment_related.currency_id.id != company_currency.id">
                                                    <label t-field="line.foreign_amount"/><br/>
                                                </t>
                                                <label t-out="line.payment_related.name"/><br/>
                                                <label class="form-text" t-if="line.use_balance" t-out="line.payment_related.destination_account_id.name"/>
                                                <t t-if="line.payment_related.currency_id.symbol == '$'">
                                                    <t t-foreach="pay_igtf" t-as="igtf">
                                                        <t t-if="igtf.payment_id.id == line.payment_related.id">
                                                            <label class="form-text" style="padding-right:3px;">IGTF 3%:</label>
                                                            <label class="form-text" t-field="igtf.amount_igtf"/>
                                                        </t>                                                        
                                                    </t>
                                                </t>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end">
                        <h4  style="font-weight: lighter;">Total: </h4>
                        <h4  style="font-weight: bolder;" t-field="payments.amount"></h4>
                    </div>
                    <div class="row mb-3 mx-auto gap-2 justify-content-around">
                        <t t-if="payments.state not in 'cancel'">
                            <button type="button" t-if="not payments.verified_payment" class="btn btn-secondary col-sm-5" id="cancel_payment">Cancel Paid</button>
                        </t>
                        <button type="button" class="btn btn-primary col-sm-5 confirm-btn">Dowload PDF</button>
                    </div>
                </t>
                <t t-else="">

                </t>
                
            </div>
        </t>
    </template>


    <template id="payments_portal_form" name="Payments">
        <t t-call="website.layout">
            <div class="container payments_portal_form">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title"></t>
                </t>
                <br/>
                <form role="form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" id="csrf_token" />
                    <div class="row mb-3">
                        <label class="form-text col-sm-2">Clients</label>
                        <div class="col-sm-4">
                            <input type="text" placeholder="Clients" class="form-control js_select2" id="clients"/>
                            <input type="hidden" id="withholding" t-att-value="request.env.company.condition_withholding_id.value"/>
                        </div>
                        <label class="form-text col-sm-2">Dairy</label>
                        <div class="col-sm-4">
                            <select class="form-control disabled-input" id="diary" disabled="disabled">
                                <option value="">Select dairy</option>
                                <t t-foreach="dairy_sale" t-as="dairy">
                                    <option t-att-value="dairy.id" t-out="dairy.name"/>
                                </t>
                            </select>
                        </div>
                        <input type="hidden" id="requireReceipt"/>
                    </div>
                    <div class="row mb-3">
                        <label class="form-text col-sm-2">Positive balance:</label>
                        <div class="col-sm-2">
                            <t t-out="currency.symbol" t-if="currency.position == 'before'" t-attf-class="form-label"/>
                            <label class="form-label label-clear" id="positive_balance_l">0.0</label>
                            <t t-out="currency.symbol" t-if="currency.position == 'after'" t-attf-class="form-label"/>
                            <input type="hidden" class="value-clear" id="positive_balance"/>
                        </div>
                        <div class="col-sm-3">
                            <div class="form-check">
                                <input class="form-check-input disabled-input" type="checkbox" id="use_credit" disabled="disabled"/>
                                <label class="form-check-label" style="font-weight: bolder;">
                                    Use credit balance
                                </label>
                            </div>
                        </div>
                        <label class="form-text col-sm-2" >Amount to pay:</label>
                        <div class="col-sm-2">
                            <t t-out="currency.symbol" t-if="currency.position == 'before'" t-attf-class="form-label"/>
                            <label class="form-label label-clear clear-total-retention-l" id="amount_total_l">0.00</label>
                            <t t-out="currency.symbol" t-if="currency.position == 'after'" t-attf-class="form-label"/>
                            <input type="hidden" class="value-clear clear-total-retention" id="amount_total_pay"/>
                        </div>
                    </div>
                    <div class="d-grid gap-2 mx-auto">
                        <div class="row mb-2">
                            <table class="table table-light table-striped">
                                <tbody id="pay_methods" class="col-sm-10 table-clear">
                                    
                                </tbody>
                            </table>
                            <hr width="100%" class="hidden_pay" id="separador" style="display:none;"/>
                            <div class="d-flex justify-content-between hidden_retention">
                                <label class="form-text hidden_retention" style="display:none;">
                                    Retentions
                                </label>
                                <div>
                                    <label class="form-text text-primary hidden_retention" t-out="currency.symbol" t-if="currency.position == 'before'" style="display:none;"/>
                                    <label class="form-text text-primary hidden_retention label-clear clear-total-retention-l" id="total_retention_l" style="display:none;"></label>
                                    <label class="form-text text-primary hidden_retention" t-out="currency.symbol" t-if="currency.position == 'after'" style="display:none;"/>
                                    <input type="hidden" class="value-clear clear-total-retention" id="total_retention" value="0"/>
                                </div>
                            </div>
                            <t t-set="currency_vef" t-value="request.env['res.currency'].search([('name', '=', 'VEF')])"/>
                            <div class="d-flex justify-content-end hidden_retention" t-if="currency_vef.id != currency.id">
                                <div>
                                    <label class="form-text text-secondary hidden_retention label-clear clear-total-retention-l" id="total_retention_l_vef" style="display:none;"></label>
                                    <label class="form-text text-secondary hidden_retention" t-out="currency_vef.symbol" style="display:none;"/>
                                    <input type="hidden" class="value-clear clear-total-retention" id="total_retention_vef" value="0"/>
                                </div>
                            </div>
                            <hr class="hidden_pay" width="100%" />
                            <div class="d-flex justify-content-between hidden_pay">
                                <label class="form-text hidden_pay" style="display:none;" id="total_t">
                                    Total <label class="form-text text-secondary" style="display:none; font-style: italic;" id="credit_apply">( + Saldo a favor)</label>
                                </label>
                                <div>
                                    <label class="form-text text-primary hidden_pay" t-out="currency.symbol" t-if="currency.position == 'before'" style="display:none;"/>
                                    <label class="form-text text-primary hidden_pay label-clear" id="total_payment_l" style="display:none;"></label>
                                    <label class="form-text text-primary hidden_pay" t-out="currency.symbol" t-if="currency.position == 'after'" style="display:none;"/>
                                    <input type="hidden" class="value-clear" id="total_payment" value="0"/>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary disabled-input" type="button" data-bs-toggle="modal" data-bs-target="#payment_method" id="open_pay"  disabled="disabled">Add payment methods</button>
                    </div>
                    <hr width="100%" />
                    <label class="form-text col-sm-auto" id="notes_invoices"></label>
                    <div class="row mb-2">
                        <table class="table table-primary table-striped">
                            <tbody id="notes_invoices_results" class="table-clear">

                            </tbody>
                        </table>
                    </div>
                    <hr width="100%" />
                    <div class="row mb-3 mx-auto gap-2 justify-content-around">
                        <div class="col-sm-5" id="remove-proof">
                            <div class="input-group">
                                <input class="btn btn-primary disabled-input-pay" required="required" type="file" id="attach_input" accept=".pdf" name="file" disabled="disabled"/>
                                <button type="button" class="btn btn-danger" id="remove_attach" disabled="disabled">Remove</button>
                            </div>
                            <input type='hidden' class="value-clear" id="attach_id"/>
                        </div>
                        <button type="button" class="btn btn-secondary col-sm-5 disabled-input-pay"  disabled="disabled" id="process_payment">Process</button>
                    </div>
                    <input type="hidden" id="symbol" t-att-value="currency.symbol"/>
                    <input type="hidden" id="decimal" t-att-value="currency.decimal_places"/>
                    <input type="hidden" id="position" t-att-value="currency.position"/>
                    <input type="hidden" id="currency_id" t-att-value="currency.id"/>
                    <input type="hidden" id="currency_foreign_id" t-att-value="foreign_currency.decimal_places"/>
                    <input type="hidden" id="currency_foreign_rate" t-att-value="foreign_currency.rate"/>
                </form>

                <div class="modal fade" id="payment_method" tabindex="-1" aria-labelledby="payment_methodLabel"  aria-modal="true" role="dialog">
                    <div class="modal-dialog modal-fullscreen">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="btn btn-primary col-5 disabled-pay" id="save_payment" disabled="disabled">Save</button>
                                <button type="button" class="btn btn-secondary col-5" data-bs-dismiss="modal" id="exit_payment">Cancel</button>
                            </div>
                            <div class="modal-body">
                                <div class="row mb-2">
                                    <label class="form-text col-sm-2">Daily (payment method)</label>
                                    <div class="col-sm-4">
                                        <select class="form-control" id="diary_pay" >
                                            <option value="">Select dairy</option>
                                            <t t-foreach="dairy_payments" t-as="dairy">
                                                <option t-att-value="dairy.id" t-out="dairy.name"/>
                                            </t>
                                        </select>
                                    </div>
                                    <label class="form-text col-sm-2">Payday</label>
                                    <div class="col-sm-4">
                                        <input class="form-control disabled-pay" type="date" id="payday" disabled="disabled"/>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="form-text col-sm-2">Amount to pay</label>
                                    <div class="col-sm-4">
                                        <div class="input-group">
                                            <span class="input-group-text" id="symbol-dairy">-</span>
                                            <input type="text" class="form-control disabled-pay" id="amount_to_payment" disabled="disabled"/>
                                        </div>
                                    </div>
                                    <label class="form-text col-sm-2">Rate of the day</label>
                                    <div class="col-sm-4">
                                        <input type="text" class="form-control" id="rate-day" disabled="disabled"/>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <t t-if="request.env.company.module_binaural_igtf">
                                        <label class="form-text col-sm-2 igtf_input" style="display:none;">IGTF suggested</label>
                                        <div class="col-sm-4 igtf_input" style="display:none;">
                                            <input type="text" class="form-control" id="igtf_pay"  disabled="disabled"/>
                                        </div>
                                        <input type="hidden" id="required_igtf"/>
                                    </t>
                                    <label class="form-text col-sm-2">Reference number</label>
                                    <div class="col-sm-4">
                                        <input type="text" class="form-control disabled-pay" id="reference_number" disabled="disabled"/>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="form-text col-sm-2">Remaining amount payable</label>
                                    <div class="col-sm-4">
                                        <t t-out="currency.symbol" style="font-weight: bolder;" t-if="currency.position == 'before'" t-attf-class="form-label"/>
                                        <label class="form-label" style="font-weight: bolder;" id="remainingAmount">0.00</label>
                                        <t t-out="currency.symbol" style="font-weight: bolder;" t-if="currency.position == 'after'" t-attf-class="form-label"/>
                                    </div>
                                    <div class="col-sm-4">
                                        <t t-out="foreign_currency.symbol" style="font-weight: bolder;" t-if="foreign_currency.position == 'before'" t-attf-class="form-label"/>
                                        <label class="form-label" style="font-weight: bolder;" id="remainingAmountForeign">0.00</label>
                                        <t t-out="foreign_currency.symbol" style="font-weight: bolder;" t-if="foreign_currency.position == 'after'" t-attf-class="form-label"/>
                                    </div>
                                </div>
                            </div>
                            <input type="hidden" id="currency"/>
                            <input type="hidden" id="position_symbol"/>
                            <input type="hidden" id="pay_edit"/>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="error_success_in_pay" tabindex="-1" aria-labelledby="error_in_payLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-body" id="error_success_info">
                                
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
