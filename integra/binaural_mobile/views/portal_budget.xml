<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Breadcrumbs de Portal-Presupuesto -->
    <template id="portal_my_home_menu_budget" name="Portal layout : budget menu entries" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="budget or quotation" class="breadcrumb-item active">
                <t t-if="budget">
                    <t t-if="budget.state == 'sale'">
                        <a t-if="budget" t-attf-href="/my/orders?{{ keep_query() }}">Sales orders</a>
                    </t>
                    <t t-else="">
                        <a t-if="budget" t-attf-href="/my/quotes?{{ keep_query() }}">Quotations</a>
                    </t>
                </t>
                <t t-else=""><a t-attf-href="/my/quotes?{{ keep_query() }}">Quotations</a></t>
                / <t t-if="budget" t-out="budget.name"/><span t-else="">Creating Quotation</span>
            </li>
        </xpath>
    </template>

    <template id="portal_budget_form" name="Budget">
        <t t-call="website.layout">
            
            <div class="container o_portal_budget_form">
                
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar"></t>
                <br/>
                <form role="form" >
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" id="csrf_token" />
                    <t t-if="budget">
                        <t t-if="budget.state == 'draft'">
                            <div class="d-flex justify-content-center" t-if="not not_confirm_quotes">
                                <button type="button" class="btn btn-secondary col-5 mx-auto cancel-btn">Cancel</button>
                                <button type="button" class="btn btn-primary col-5 mx-auto confirm-btn">Confirm</button>
                            </div>
                        </t>
                        <t t-else="">
                            
                        </t>
                    </t>
                    <t t-else="">
                        <div class="d-flex justify-content-center" t-if="not not_confirm_quotes">
                            <button type="button" class="btn btn-secondary col-5 mx-auto cancel-btn">Cancel</button>
                            <button type="button" class="btn btn-primary col-5 mx-auto confirm-btn">Confirm</button>
                        </div>
                    </t>
                    <div class="d-grid gap-2 mx-auto" id="status">
                        <t t-if="budget">
                            <t t-if="budget.state == 'sale'">
                                <h2 class="badge bg-success">Confirmed</h2>
                                <input type="hidden" id="status-val" t-att-value="budget.state"/>
                            </t>
                            <t t-elif="budget.state == 'cancel'">
                                <h2 class="badge bg-danger">Cancelled</h2>
                                <input type="hidden" id="status-val" t-att-value="budget.state"/>
                            </t>
                        </t>
                    </div>
                    <hr width="100%" />
                    <div class="d-flex justify-content-center">
                        <button type="button" class="btn btn-info col-12 mx-auto" id="dowload_pdf">Dowload PDF</button>
                    </div>
                    <hr width="100%" />
                    <div class="row mb-3">
                        <label class="form-label" style="font-weight: bolder;" id="number" t-attf-style="display: {{ 'block' if budget else 'none' }};">Number: 
                            <label id="number_order">
                                <t t-if="budget">
                                    <t t-out="budget.name"/>
                                </t>
                            </label>
                        </label>
                        <input type="hidden" id="number_order_value" t-attf-value="{{ budget.id if budget else '' }}" />
                        <label class="col-sm-2 form-text">Client</label>
                        <div class="col-sm-4">
                            <t t-if="budget">
                                <input type="text" class="form-control" t-att-value="budget.partner_id.display_name" disabled="disabled"/>
                                <input type="hidden" id='client' class="d-none" t-att-value="budget.partner_id.id" />
                            </t>
                            <t t-else="">
                                <div class="input-group">
                                    <input type="text" placeholder="Clients" class="form-control js_select2" id="client"/>
                                    <button type="button" class="fa fa-plus" style="background-color: transparent;border: none; color:green;"
                                    data-bs-toggle="modal" data-bs-target="#createClient" id="openClient" t-if="create_client"/>
                                </div>
                            </t>
                        </div>
                        <label class="col-sm-2 form-text">Billing address</label>
                        <div class="col-sm-4">
                            <t t-if="budget and budget.state in ['cancel', 'sale']">
                                <label class="form-label" t-out="budget.partner_invoice_id.name"/>
                            </t>
                            <t t-else="">
                                <select class="form-control address_selection cancel_confirmed_input" t-attf-data-address="invoice" id="billing_address">
                                    <t t-if="budget">
                                        <option t-att-value="budget.partner_invoice_id.id" t-out="budget.partner_invoice_id.name"/>
                                    </t>
                                    <t t-else="">
                                        <option value="">Select a billing address</option>
                                    </t>
                                </select>
                            </t>
                        </div>

                        <label class="col-sm-2 form-text">Plus Code:</label>
                        <div class="col-sm-4">
                            <t t-if="budget">
                                <a class="form-label cancel_confirmed_input" id="plus_code_label" disabled="disabled" t-attf-href="{{budget.partner_id.plus_code}}" target="_blank">
                                  <t t-out="budget.partner_id.plus_code"/>  
                                </a>
                            </t>
                            <t t-else="">
                                <a class="form-label cancel_confirmed_input" id="plus_code_label" target="_blank"/>
                            </t>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <t t-if="budget and budget.state in ['cancel', 'sale']">
                        </t>
                        <t t-else="">
                            <div class="col-sm-6">
                                <div class="form-check">     
                                    <input class="form-check-input cancel_confirmed_input" type="checkbox" id="same_address" checked="checked"/>
                                    <label class="form-check-label" style="font-weight: bolder;">
                                        Billing address the same as the shipping address
                                    </label>
                                </div>
                            </div>
                        </t>
                        <label class="col-sm-2 form-text div_shipping">Shipping Address</label>
                        <div class="col-sm-4 div_shipping">
                            <t t-if="budget and budget.state in ['cancel', 'sale']">
                                <label class="form-label" t-out="budget.partner_shipping_id.name"/>
                            </t>
                            <t t-else="">
                                <div class="input-group">

                                    <select class="form-control address_selection cancel_confirmed_input" t-attf-data-address="delivery" id="project">
                                        <t t-if="budget">
                                            <t t-foreach="budget.partner_invoice_id.child_ids" t-as="budget_partner">
                                                <option selected="1" t-if="budget.partner_shipping_id.id == budget_partner.id" t-att-value="budget_partner.id"> <t t-out="budget_partner.name" /></option>
                                                <option t-if="budget.partner_shipping_id.id != budget_partner.id" t-att-value="budget_partner.id"> <t t-out="budget_partner.name" /></option>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <option value="">Select a shipping address</option>
                                        </t>
                                    </select>

                                    <t t-if="not budget">
                                        <button type="button" class="fa fa-plus d-none" disabled="true" style="background-color: transparent;border: none; color:green;"
                                        data-bs-toggle="modal" data-bs-target="#createClient" id="openCreateAddressContact" t-if="create_client_address" />
                                    </t>

                                </div>
                            </t>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-text">Rate:</label><br/>
                            <t t-if="edit_fee">
                                <t t-if="budget and budget.state in ['cancel', 'sale']">
                                    <label class="form-label" id="fee">
                                        <t t-out="budget.partner_id.property_product_pricelist.name"/>
                                    </label>
                                </t>
                                <t t-else="">
                                    <select class="form-control cancel_confirmed_input" id="fee_value">
                                        <t t-if="budget">
                                            <option t-att-value="budget.partner_id.property_product_pricelist.id" 
                                            t-out="budget.partner_id.property_product_pricelist.name"/>
                                        </t>
                                        <t t-else="">
                                            <option value="">No fee</option>
                                        </t>
                                        <t t-foreach="pricelists" t-as="pricelists">
                                            <option t-att-value="pricelists.id" t-out="pricelists.name"/>
                                        </t>
                                    </select>
                                </t>
                            </t>
                            <t t-else="">
                                <label class="form-label" id="fee">
                                    <t t-if="budget">
                                        <t t-out="budget.partner_id.property_product_pricelist.name"/>
                                    </t>
                                    <t t-else="">
                                        No fee
                                    </t>
                                </label>
                                <input type="hidden" id="fee_value" t-attf-value="{{ budget.partner_id.property_product_pricelist.id if budget else '' }}"/>
                            </t>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-text ">Payment terms:</label><br/>
                            <label class="form-label" for="payment_terms_value" id="payment_terms">
                                <t t-if="budget">
                                    <t t-out="budget.partner_id.property_payment_term_id.name"/>
                                </t>
                                <t t-else="">
                                    No payment terms
                                </t>
                            </label>
                            <input type="hidden" id="payment_terms_value" t-attf-value="{{ budget.partner_id.property_payment_term_id.id if budget else '' }}"/>
                        </div>
                        <div class="col-sm-2">
                            <div class="form-check">

                                <t t-if="budget and is_optional_tax_included">
                                    <t t-if="budget.state in ['cancel', 'sale']">
                                        <input class="form-check-input cancel_confirmed_input" type="checkbox" id="invoice" t-if="budget.tax_included" checked="True" disabled="disabled"/>
                                        <input class="form-check-input cancel_confirmed_input" type="checkbox" id="invoice" t-else="" disabled="disabled"/>
                                    </t>
                                    <t t-else="">
                                        <input class="form-check-input cancel_confirmed_input" type="checkbox" id="invoice" t-if="budget.tax_included" checked="True"/>
                                        <input class="form-check-input cancel_confirmed_input" type="checkbox" id="invoice" t-else=""/>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div t-attf-style="{{'' if is_optional_tax_included else  'display: none'}}">
                                        <input 
                                            class="form-check-input cancel_confirmed_input" 
                                            type="checkbox" 
                                            id="invoice" 
                                            disabled="disabled"
                                            t-if="tax_included"
                                            checked="true"
                                        />
                                        <input 
                                            class="form-check-input cancel_confirmed_input" 
                                            type="checkbox" 
                                            id="invoice" 
                                            disabled="disabled" 
                                            t-else=""
                                        />
                                    </div>
                                </t>
                                <label class="form-check-label" style="font-weight: bolder;" t-if="is_optional_tax_included">
                                    Invoice required
                                </label>

                            </div>
                        </div>
                        <label class="col-sm-2 form-text">Note</label>
                        <div class="col-sm-4">
                            <t t-if="budget and budget.state in ['cancel', 'sale']">
                                <input type="text" class="form-control cancel_confirmed_input" id="note" t-att-value="budget.note" disabled="disabled"/>
                            </t>
                            <t t-else="">
                                <input type="text" class="form-control cancel_confirmed_input" id="note" t-attf-value="{{ budget.note if budget else '' }}"/>
                            </t>
                        </div>
                    </div>
                    <hr width="100%" />
                    <input type="hidden" id="decimal" t-att-value="currency.decimal_places"/>
                    <br />
                    <div class="d-grid gap-2 mx-auto">
                        <label class="form-text" style="color: #35979c ">Order lines</label>
                        <t t-if="budget and budget.state in ['cancel', 'sale']">
                                                    
                        </t>
                        <t t-else="">
                            <button class="btn btn-primary cancel_confirmed_input" type="button" data-bs-toggle="modal" data-bs-target="#addProduct" id="openProduct" t-attributes="disabled: budget and 'disabled' or None" >Add</button>
                        </t>
                    </div>
                    <br />
                    <div class="row mb-2">
                        <label id="product-table-note" class="text-secondary form-text mb-3"></label>
                        <table class="table table-primary table-striped">
                            <thead id="product_head" style="display: none;">
                            <tr>
                                <td class="text-center" style="font-weight: bolder;">Product</td>
                                <td></td>
                                <td></td>
                                <td class="text-center"></td>
                                <td class="text-center" style="font-weight: bolder;">Price</td>
                                <td></td>
                            </tr>
                            </thead>
                            <tbody id="product_list">
                                <t t-if="budget">
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div id="total_invoice">
                        <div class="d-flex justify-content-end">
                            <label class="form-label invoice_end" t-attf-style="display: {{ 'block' if budget else 'none' }}; padding-right:5px;" id="subtotal_base">
                                Taxable Base:
                            </label>
                            <label class="invoice_end subtotal" t-out="currency.symbol" t-if="currency.position == 'before'" 
                                t-attf-style="display: {{ 'block' if budget else 'none' }}; padding-right:3px;"/>
                            <label class="form-label subtotal" style="font-weight: bolder; padding-right:3px;" id="subtotal">
                            <t t-if="budget">
                                <t t-out="budget.amount_untaxed"/>
                            </t>
                            </label>
                            <label class="invoice_end subtotal" t-out="currency.symbol" t-if="currency.position == 'after'" t-attf-style="display: {{ 'block' if budget else 'none' }};"/>
                        </div>
                        <div id="taxes-invoices-budget">
                        </div>
                        <div class="d-flex justify-content-end">
                            <label class="form-label invoice_end" t-attf-style="display: {{ 'block' if budget else 'none' }}; padding-right:5px;" id="total_base">
                                Total:
                            </label>
                            <label class="invoice_end total" t-out="currency.symbol" t-if="currency.position == 'before'" t-attf-style="display: {{ 'block' if budget else 'none' }}; padding-right:3px;"/>
                            <label class="form-label total" style="font-weight: bolder; padding-right:3px;" id="total">
                            <t t-if="budget">
                                <t t-out="budget.amount_total"/> 
                            </t>
                            </label>
                            <label class="invoice_end total" t-out="currency.symbol" t-if="currency.position == 'after'" t-attf-style="display: {{ 'block' if budget else 'none' }};"/>
                        </div>
                        <input type="hidden" id="symbolB" t-att-value="currency.symbol"/>
                        <input type="hidden" id="positionS" t-att-value="currency.position"/>
                        <input type="hidden" id="status" t-if="budget" t-att-value="budget.state"/>
                    </div>
                    <br />
                    <t t-if="budget">
                        <t t-if="budget.state == 'draft'">
                            <div class="d-flex justify-content-center" t-if="not not_confirm_quotes">
                                <button type="button" class="btn btn-secondary col-5 mx-auto cancel-btn">Cancel</button>
                                <button type="button" class="btn btn-primary col-5 mx-auto confirm-btn">Confirm</button>
                            </div>
                        </t>
                        <t t-else="">

                        </t>
                    </t>
                    <t t-else="">
                        <div class="d-flex justify-content-center" t-if="not not_confirm_quotes">
                            <button type="button" class="btn btn-secondary col-5 mx-auto cancel-btn">Cancel</button>
                            <button type="button" class="btn btn-primary col-5 mx-auto confirm-btn">Confirm</button>
                        </div>
                    </t>
                    <br />
                    <div class="modal fade" id="addProduct" tabindex="-1" aria-labelledby="addProductLabel"  aria-modal="true" role="dialog">
                        <div class="modal-dialog modal-fullscreen">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" placeholder="Write the name or code" 
                                        aria-label="Write the name or code" aria-describedby="search_product"
                                        id="search_text"/>
                                        <button class="btn btn-primary" type="button" id="search_product">Search</button>
                                    </div>
                                </div>
                                <div class="modal-header">
                                    <button type="button" class="btn btn-primary col-5" id="save_products" disabled="disabled">Save</button>
                                    <button type="button" class="btn btn-secondary col-5" id="exit_products">Cancel</button>
                                </div>
                                <div class="modal-body">
                                    <table class="table table-primary table-striped">
                                        <tbody id="table_inside">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-if="not budget and create_client">
                        <div class="modal fade" id="createClient" tabindex="-1" aria-labelledby="createClientLabel"  aria-modal="true" role="dialog">
                            <div class="modal-dialog modal-fullscreen">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h3>Creating Client</h3>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row mb-2">
                                            <label class="form-text col-sm-2">Fiscal Identification *</label>
                                            <div class="col-sm-1">
                                                <select class="form-control register-client" id="prefixClient">
                                                    <option value="">-</option>
                                                    <t t-foreach="type_document" t-as="document">
                                                        <option t-out="document[1]" t-att-value="document[0]"/>
                                                    </t>
                                                </select>
                                            </div>
                                            <div class="col-sm-3">
                                                <input type="text" class="form-control register-client" id="identification" placeholder="123123433"/>
                                            </div>
                                            <label class="form-text col-sm-2">Name *</label>
                                            <div class="col-sm-4">
                                                <input type="text" class="form-control register-client" id="nameClient" placeholder="Odoo Odoo"/>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <label class="form-text col-sm-2">Direction *</label>
                                            <div class="col-sm-4">
                                                <textarea rows="2" class="register-client form-control" placeholder="your City" id="streetDirection"/>
                                            </div>
                                            <label class="form-text col-sm-2">Country *</label>
                                            <div class="col-sm-4">
                                                <select class="form-control register-client" id="countryClient">
                                                    <option value="">Select country</option>
                                                    <t t-foreach="countries" t-as="country">
                                                        <option t-out="country.name" t-att-value="country.id"/>
                                                    </t>
                                                </select>
                                            </div>                                            
                                        </div>
                                        <div class="row mb-2">
                                            <label class="form-text col-sm-2">State *</label>
                                            <div class="col-sm-4">
                                                <select class="form-control register-client" id="stateClient">
                                                    <option value="">Select State</option>
                                                </select>
                                            </div>
                                            <label class="form-text col-sm-2">City</label>
                                            <div class="col-sm-4">
                                                <select class="form-control register-client" id="cityClient">
                                                    <option value="">Select City</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <label class="form-text col-sm-2">Municipality</label>
                                            <div class="col-sm-4">
                                                <select class="form-control register-client" id="municipalityClient">
                                                    <option value="">Select Municipality</option>
                                                </select>
                                            </div>
                                            <label class="form-text col-sm-2">Parish</label>
                                            <div class="col-sm-4">
                                                <select class="form-control register-client" id="parishClient">
                                                    <option value="">Select Parish</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            
                                            <label class="form-text col-sm-2">Email</label>
                                            <div class="col-sm-4 igtf_input">
                                                <input type="email" class="register-client form-control" id="emailClient" placeholder="test@gmail.com"/>
                                            </div>
                                            <label class="form-text col-sm-2">Number phone</label>
                                            <div class="col-sm-4">
                                                <input type="text" class="register-client form-control" id="numberPhone" placeholder="0426-123-1234"/>
                                            </div>
                                        </div>
                                        <div class="row mb-2">
                                            <label class="form-text col-sm-2">Plus Code</label>
                                            <div class="col-sm-4">
                                                <input type="text" class="register-client form-control" id="plus_code" placeholder="Plus Code"/>
                                            </div>
                                        </div>

                                        <input type="hidden" value="contact" id="typeContactCreateClientModal" />
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        <button type="button" class="btn btn-primary" id="registerClient">Register Client</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="errorMsg" tabindex="-1" aria-labelledby="errorMsgLabel"  aria-modal="true" role="dialog">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                    </div>
                                    <div class="modal-body">
                                        <div class="alert alert-danger" role="alert">
                                            <label id="labelMsg"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    
                    
                    <div class="modal fade" id="errorQty" tabindex="-1" aria-labelledby="errorQtyLabel"  aria-modal="true" role="dialog" style="z-index:1500;">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-danger" role="alert" id="errorQtyMsg">
                                        Check the units of the product
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="error_confirm_cancel" tabindex="-1" aria-labelledby="errorQtyLabel"  aria-modal="true" role="dialog">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                </div>
                                <div class="modal-body">
                                    <div class="alert alert-danger" role="alert">
                                        <label id="error_msg"/>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </form>
            </div>
        </t>
    </template>

</odoo>
