<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_budget_form" name="Budget">
        <t t-call="website.layout">
            <div class="container o_portal_budget_form">
                <br/>
                <form role="form" action="/pitagoras_recruitment/recruit" method="POST" class="recruit_form" id="form_recruit">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" id="csrf_token" />
                    <div class="d-flex justify-content-center">
                        <button type="button" class="btn btn-secondary col-5 mx-auto">Cancel</button>
                        <button type="button" class="btn btn-primary col-5 mx-auto">Confirm</button>
                    </div>
                                
                    <hr width="100%" />
                    <div class="row mb-3">
                        <label class="form-label" style="font-weight: bolder;">Number: S0010203</label>
                        <label class="col-sm-2 form-text">Client</label>
                        <div class="col-sm-4">
                            <input type="text" placeholder="Clients" class="form-control js_select2" id="client"/>
                        </div>
                        <label class="col-sm-2 form-text">Billing address</label>
                        <div class="col-sm-4">
                            <select class="form-control" id="billing_address">
                                <option value="">Select a billing address</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-1">
                        <label class="col-sm-2 form-text">Shipping Address</label>
                        <div class="col-sm-4">
                            <select class="form-control" id="delivery_address">
                                <option value="">Select a shipping address</option>
                            </select>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-text">Rate:</label><br/>
                            <label class="form-label">Usd</label>
                        </div>
                        <div class="col-sm-2">
                            <label class="form-text ">Payment terms:</label><br/>
                            <label class="form-label">10 days</label>
                        </div>
                        <div class="col-sm-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="invoice"/>
                                <label class="form-check-label" style="font-weight: bolder;">
                                    Invoice required
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-1">
                        <label class="col-sm-2 form-text">Note</label>
                        <div class="col-sm-4">
                            <input type="text" class="form-control" id="note"/>
                        </div>
                    </div>
                    <hr width="100%" />
                    <br />
                    <div class="d-grid gap-2 mx-auto">
                        <label class="form-text" style="color: #35979c ">Order lines</label>
                        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#exampleModalFullscreen">Add</button>
                    </div>
                    <br />
                    <div class="row mb-2">
                        <table class="table table-primary table-striped">
                            <thead>
                            <tr>
                                <td class="text-center" style="font-weight: bolder;">Product</td>
                                <td></td>
                                <td></td>
                                <td class="text-center" style="font-weight: bolder;">Tax</td>
                                <td class="text-center" style="font-weight: bolder;">Price</td>
                                <td></td>
                            </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="3">
                                        <label style="font-weight: bolder;">[A0393929] PRODUCT NAME</label><br/>
                                        <label class="form-label">Cantidad:</label><label class="form-label" style="font-weight: bolder;">10</label><br/>
                                        <label class="form-text">Unit price:</label><label class="form-text" style="font-weight: bolder;">5</label>
                                    </td>
                                    <td class="text-center">
                                    10%
                                    </td>
                                    <td class="text-center">
                                    <div  style="display:flex;">
                                        <span>1000</span>
                                    </div>
                                    </td>
                                    <td style="width: 50px;"><button type="button" class="btn-close btn-danger"></button></td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <label style="font-weight: bolder;">[A0393929] PRODUCT NAME</label><br/>
                                        <label class="form-label">Cantidad:</label><label class="form-label" style="font-weight: bolder;">10</label><br/>
                                        <label class="form-text">Unit price:</label><label class="form-text" style="font-weight: bolder;">5</label>
                                    </td>
                                    <td class="text-center">
                                    10%
                                    </td>
                                    <td class="text-center">
                                    <div  style="display:flex;">
                                        <span>1000</span>
                                    </div>
                                    </td>
                                    <td style="width: 50px;"><button type="button" class="btn-close btn-danger"></button></td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        <label style="font-weight: bolder;">[A0393929] PRODUCT NAME</label><br/>
                                        <label class="form-label">Cantidad:</label><label class="form-label" style="font-weight: bolder;">10</label><br/>
                                        <label class="form-text">Unit price:</label><label class="form-text" style="font-weight: bolder;">5</label>
                                    </td>
                                    <td class="text-center">
                                    10%
                                    </td>
                                    <td class="text-center">
                                    <div  style="display:flex;">
                                        <span>1000</span>
                                    </div>
                                    </td>
                                    <td style="width: 50px;"><button type="button" class="btn-close btn-danger"></button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-end">
                        <label class="form-label">Taxable Base: </label><label class="form-label" style="font-weight: bolder;">10000</label>
                    </div>
                    <div class="d-flex justify-content-end">
                        <label class="form-label">Tax: </label><label class="form-label" style="font-weight: bolder;">1000</label>
                    </div>
                    <div class="d-flex justify-content-end">
                        <label class="form-label">Total: </label><label class="form-label" style="font-weight: bolder;">11000</label>
                    </div>
                    <br />
                    <div class="d-flex justify-content-center">
                        <button type="button" class="btn btn-secondary col-5 mx-auto">Cancel</button>
                        <button type="button" class="btn btn-primary col-5 mx-auto">Confirm</button>
                    </div>
                    <br />

                    <div class="modal fade" id="exampleModalFullscreen" tabindex="-1" aria-labelledby="exampleModalFullscreenLabel"  aria-modal="true" role="dialog">
                        <div class="modal-dialog modal-fullscreen">
                            <div class="modal-content">
                            <div class="modal-header">
                                <div class="input-group mb-3">
                                    <input type="text" class="form-control" placeholder="Write the name or code" aria-label="Write the name or code" aria-describedby="button-addon2"/>
                                    <button class="btn btn-primary" type="button" id="button-addon2">Search</button>
                                </div>
                            </div>
                            <div class="modal-header">
                                <button type="button" class="btn btn-primary col-5" data-bs-dismiss="modal" disabled="disabled">Save</button>
                                <button type="button" class="btn btn-secondary col-5" data-bs-dismiss="modal">Cancel</button>
                            </div>
                            <div class="modal-body">
                                <table class="table table-primary table-striped">
                                <thead>
                                    <tr>
                                        <td class="text-center" style="font-weight: bolder;">Product</td>
                                        <td class="text-center" style="font-weight: bolder;">Quantity</td>
                                        <td class="text-center" style="font-weight: bolder;">Price</td>
                                        <td class="text-center" style="font-weight: bolder;">Subtotal</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="text-center">image</td>
                                        <td colspan="2">
                                            <label style="font-weight: bolder;">[A0393929] PRODUCT NAME</label><br/>
                                            <label class="form-text">Price:</label><label class="form-text" style="font-weight: bolder;">10</label><br/>
                                            <label class="form-text">Available:</label><label class="form-text" style="font-weight: bolder;">100</label>
                                        </td>
                                        <td style="width: 150px;">
                                            <input type="text" class="form-control" placeholder="quantity"/>
                                            <label class="form-text">Only valid multiples of 1</label>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            </div>
                            <!-- <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <button type="button" class="btn btn-primary">Save changes</button>
                            </div> -->
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>

</odoo>
