<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_payment_view_form_binaural_payment_mobile" model="ir.ui.view">
            <field name="name">account_payment_view_form_binaural_payment_mobile</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_bank_id']" position="after">
                    <field name="payment_from_app" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
