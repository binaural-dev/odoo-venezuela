<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_mobile_restricted_multi_company" model="ir.rule">
        <field name="name">payment_mobile multi-company</field>
        <field name="model_id" ref="model_payment_mobile"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>

