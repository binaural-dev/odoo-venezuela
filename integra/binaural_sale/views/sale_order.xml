<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_sale_order_form_binaural_sales" model="ir.ui.view">
            <field name="name">view.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="replace">
                    <field name="partner_id" context="{'res_partner_search_mode': 'customer', 'show_address': 1}" options="{&quot;always_reload&quot;: True}"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="vat"/>
                </xpath>
            </field>
        </record>
        
    </data>

</odoo>
