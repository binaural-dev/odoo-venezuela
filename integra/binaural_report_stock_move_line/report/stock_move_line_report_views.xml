<odoo>
    <record id="view_stock_move_line_report_tree" model="ir.ui.view">
        <field name="name">stock.move.line.report.tree</field>
        <field name="model">stock.move.line.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="company_id" />
                <field name="product_id"/>
                <field name="reference"/>
                <field name="origin"/>
                <field name="move_type"/>
                <field name="qty_in"/>
                <field name="qty_out"/>
                <field name="balance"/>
            </tree>
        </field>
    </record>
    <record id="view_stock_move_line_report_filter" model="ir.ui.view">
        <field name="name">stock.move.line.report.list.select</field>
        <field name="model">stock.move.line.report</field>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" string="product"/>
                <separator/>
                <filter
                string="Current Month"
                name="current_month"
                domain="[('date','&lt;',(context_today()+relativedelta(months=1)).strftime('%%Y-%%m-01')), ('date','&gt;=',time.strftime('%%Y-%%m-01'))]"
                />
                <filter
			string="Prev Month"
			name="prev_month"
			domain="[('date','&gt;=',(context_today()-relativedelta(months=1)).strftime('%%Y-%%m-01')),('date','&lt;',time.strftime('%%Y-%%m-01'))]"
		    />
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" domain="[]" context="{'group_by': 'company_id'}"/>
                    <filter string="Product" name="group_product_id" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter string="Month" name="group_date_month" domain="[]" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="stock_move_line_report_action" model="ir.actions.act_window">
        <field name="name">Stock Move Line Report</field>
        <field name="res_model">stock.move.line.report</field>
        <field name="view_mode">tree</field>
        <field name="context">{
                'search_default_group_company': 1,
                'search_default_group_product_id': 1,
                'search_default_group_date_month': 1,
        }</field>
    </record>
    <menuitem
            id="stock_move_line_report_menu"
            name="Stock Move Line Report"
            groups="stock.group_stock_manager"
            parent="stock.menu_warehouse_report"
            action="stock_move_line_report_action"
        />
</odoo>