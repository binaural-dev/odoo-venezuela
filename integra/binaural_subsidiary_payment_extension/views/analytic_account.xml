<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_subsidiary_form" model="ir.ui.view">
        <field name="name">binaural.subsidiary.payment.extension.view.account.analytic.account.subisidiary.form</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="binaural_subsidiary.view_account_analytic_account_subsidiary_form"/>
        <field name="arch" type="xml">
	    <sheet position="inside">
		<notebook>
		    <page name="tax_authorities_data" string="Tax Authorities Data">
			<group>
			    <group>
                            	<field name="tax_authorities_name" required="1"/>
                            	<field name="economic_activity_number" required="1"/>
		    	    </group>
			    <group>
				<field name="tax_authorities_logo" widget="image" class="oe_avatar" required="1"/>
			    </group>
                    	</group>
		    </page>
		</notebook>
	    </sheet>
        </field>
    </record>
</odoo>
