<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_integra_website" model="ir.ui.view">
            <field name="name">res.config.settings.onprotec_pos</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="binaural_pos.res_config_settings_binaural_pos"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='binaural_igtf_settings']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box" id="integra_website_pos_setting">
                        <div class="o_setting_left_pane">
                            <field name="pos_only_website"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_only_website"/>
                            <div class="text-muted">
                                Show only the sales orders that are from the website or mercadolibre
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
