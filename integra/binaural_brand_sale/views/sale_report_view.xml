<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="view_search_group_by_brand_sale_report" model="ir.ui.view">
        <field name="name">view.search.group.by.marca.sale.report</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <filter name="brand_name" string="Marca" context="{'group_by':'brand_name'}"/>
            </field>
        </field>
    </record>
</odoo>