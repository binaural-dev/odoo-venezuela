<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_incomplete_form_wizard" model="ir.ui.view">
        <field name="name">verify.os.view.form.wizard</field>
        <field name="model">stock.picking.incomplete</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <div colspan="2"><p name="explanation-text">
                            You have processed less products than the initial demand.
                        </p></div>
                    </group>
                </group>
                <field name="pick_id" invisible="1"/>
                <field name="move_ids" readonly="1">
                    <tree decoration-danger="1">
                        <field name="product_id"/>
                        <field name="product_uom_qty" readonly="1"/>
                        <field name="quantity_done"/>
                    </tree>
                </field>
                <footer>
                    <button name="process" string="Confirm" type="object" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
