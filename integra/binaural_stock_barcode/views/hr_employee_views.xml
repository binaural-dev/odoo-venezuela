<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coach_id']" position="after">
                <field name="role_picking" />
            </xpath>
            <xpath expr="//field[@name='pin']" position="attributes">
                <attribute name="password">True</attribute>
            </xpath>
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="password">True</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Pick Information" attrs="{'invisible': [('role_picking', 'in', [False, 'supervisor'])]}">
                    <field 
                        name="pick_ids" 
                        editable="bottom" 
                        domain="[('operation_state','!=','ready')]">
                        <tree>
                            <field name="operation_state"/>
                            <field name="name"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- OUT OPERATION -->
    <record id="view_tree_stock_picking_hr_employee_out_tree_waiting" model="ir.ui.view">
        <field name="name">hr.employee.picking.tree.waiting</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <tree create="0" editable="bottom" string="Stock Picking (Waiting)">
                <field name="name" readonly="1"/>
                <field name="available_picks_ids" invisible="1"/>
                <field name="cart_active_id"/>
                <button name="pause_operation" 
                    type="object" 
                    string="Pause Operation" 
                    class="oe_highlight" 
                    icon="fa-pause" 
                    attrs="{'invisible': [('active_pick_id','=',False)]}"/>
                <field name="active_pick_id"/>
                <field name="paused_pick_ids" widget="many2many_tags"/>
                <field name="pending_pick_id" />
                <field name="pick_ids" widget="many2many_tags" optional="hide" groups="base.group_no_one"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_picking_hr_employee_tree_waiting_out" model="ir.actions.act_window">
        <field name="name">Out Assignation</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="binaural_stock_barcode.view_tree_stock_picking_hr_employee_out_tree_waiting"/>
        <field name="domain">[('role_picking','=','out')]</field>
    </record>

    <menuitem 
        id="menu_picking_waiting_hr_employee_out" 
        name="Out Assignation" 
        parent="stock.menu_stock_warehouse_mgmt"
        groups="binaural_stock_barcode.out_transfer_manager"
        action="view_stock_picking_hr_employee_tree_waiting_out"/>

    <!-- PICK OPERATION -->
    <record id="view_tree_stock_picking_hr_employee_tree_waiting" model="ir.ui.view">
        <field name="name">hr.employee.picking.tree.waiting</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <tree create="0" editable="bottom" string="Stock Picking (Waiting)">
                <field name="name" readonly="1"/>
                <field name="cart_active_id"/>
                <field name="available_picks_ids" invisible="1"/>
                <button name="pause_operation" 
                    type="object" 
                    string="Pause Operation" 
                    class="oe_highlight" 
                    icon="fa-pause" 
                    attrs="{'invisible': [('active_pick_id','=',False)]}"/>
                <field name="active_pick_id"/>
                <field name="paused_pick_ids" widget="many2many_tags"/>
                <field name="pending_pick_id" />
                <field name="pick_ids" widget="many2many_tags" optional="hide" groups="base.group_no_one"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_picking_hr_employee_tree_waiting_picker" model="ir.actions.act_window">
        <field name="name">Pick Assignation</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="binaural_stock_barcode.view_tree_stock_picking_hr_employee_tree_waiting"/>
        <field name="domain">[('role_picking','=','picker')]</field>
    </record>


    <menuitem 
        id="menu_picking_waiting_hr_employee_picker" 
        name="Pick Assignation" 
        parent="stock.menu_stock_warehouse_mgmt"
        groups="binaural_stock_barcode.pick_transfer_manager"
        action="view_stock_picking_hr_employee_tree_waiting_picker"/>

</odoo>
