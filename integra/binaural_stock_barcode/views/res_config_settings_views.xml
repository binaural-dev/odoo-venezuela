<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_stock_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.binaural.rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                <h2>Stock Barcode</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="restrict_add_exceeding_quantity"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="restrict_add_exceeding_quantity"/>
                            <div class="text-muted">
                                Does not allow adding more lines than required
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

