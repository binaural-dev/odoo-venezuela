<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.binaural.stock</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
        <field name="arch" type="xml">
	        <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                <h2>Stock Barcode Settings</h2>
                <div class="row mt16 o_settings_container" >
                    <div class="col-12 col-lg-6 o_setting_box" name="binaural_stock_barcode_invoice">
                        <div class="o_setting_left_pane">
                            <field name="create_invoice_after_validate_out" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="create_invoice_after_validate_out"/>
                            <div class="text-muted">
                                Create invoice after validate Picking OUT
                            </div>
                        </div>
                    </div>
                </div>
                
            </xpath>
        </field>
    </record>
</odoo>
