<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="picker_id" />
                <field name="cart_id"/>
                <field name="operation_start_date" attrs="{'invisible': [('cart_id', '=', False)]}"/>
                <field name="operation_end_date" attrs="{'invisible': [('cart_id', '=', False)]}"/>
                <field name="total_time_elapsed" attrs="{'invisible': [('cart_id', '=', False)]}" widget="float_time" />
            </xpath>

            <xpath expr="//field[@name='origin']" position="after">
                <field name="supervisor_approve_for_incomplete_qty_id" invisible="1" />
                <field name="supervisor_approve_for_incomplete_qty_id" readonly="1" attrs="{'invisible': ['|',('type_delivery_step','not in',['pick','out','pack']),('supervisor_approve_for_incomplete_qty_id','=', False)]}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']/button[@name='action_view_stock_valuation_layers']"
                   position="before">
                <field name="type_delivery_step" invisible="1"/>
                <button class="oe_stat_button" attrs="{'invisible': [('type_delivery_step', '!=', 'pick')]}">
                    <div role="img" class="fa fa-fw fa-circle text-secondary o_button_icon"
                         attrs="{'invisible': [('operation_state', '!=', 'ready')]}" title="Ready"/>
                    <div role="img" class="fa fa-fw fa-circle text-primary o_button_icon"
                         attrs="{'invisible': [('operation_state', '!=', 'in_process')]}" title="In Process"/>
                    <div role="img" class="fa fa-fw fa-circle text-warning o_button_icon"
                         attrs="{'invisible': [('operation_state', '!=', 'paused')]}" title="Paused"/>
                    <div role="img" class="fa fa-fw fa-circle text-success o_button_icon"
                         attrs="{'invisible': [('operation_state', '!=', 'finished')]}" title="Finished"/>
                    <div role="img" class="fa fa-fw fa-circle text-danger o_button_icon"
                         attrs="{'invisible': [('operation_state', '!=', 'cancel')]}" title="Cancel"/>
                    <div class="o_stat_info">
                        <field name="operation_state" class="o_stat_text"/>
                    </div>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Timelapse Picking">
                    <field name="picking_time_ids" mode="tree">
                        <tree delete="0" create="0" edit="0">
                            <field name="create_date" />
                            <field name="employee_id" />
                            <field name="type"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_tree_stock_picking_tree_waiting" model="ir.ui.view">
        <field name="name">stock.picking.tree.waiting</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <tree create="0" editable="bottom" string="Stock Picking (Waiting)">
                <field name="name"/>
                <field name="state"/>
                <field name="picker_id"/>
                <field name="cart_id"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_picking_tree_waiting" model="ir.actions.act_window">
        <field name="name">Stock Picking (Waiting)</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="binaural_stock_barcode.view_tree_stock_picking_tree_waiting"/>
        <field name="domain">['&amp;',('state', 'in', ['confirmed','assigned']), ('type_delivery_step', '=','pick')]</field>
        <field name="help">Select stock pickings with status "waiting"</field>
    </record>

    <record id="view_tree_stock_picking_tree_operation" model="ir.ui.view">
        <field name="name">stock.picking.tree.waiting</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <tree create="0" string="Operation Report">
                <field name="picker_id"/>
                <field name="name"/>
                <field name="cart_id"/>
                <field name="operation_state" 
                    widget="badge" 
                    decoration-warning="operation_state=='in_process'" 
                    decoration-success="operation_state=='finished'" />
                <field name="operation_start_date"/>
                <field name="operation_end_date"/>
                <field name="total_time_elapsed"/>
                <field name="total_lines"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_picking_tree_operation" model="ir.actions.act_window">
        <field name="name">Operation Report</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="binaural_stock_barcode.view_tree_stock_picking_tree_operation"/>
        <field name="domain">['&amp;',('operation_state', 'in', ['paused','in_process','finished']),('type_delivery_step','in', ['pick','pack','out'])]</field>
    </record>

    <menuitem 
        id="menu_picking_operation" 
        name="Operation Report" 
        parent="stock.menu_warehouse_report"
        action="view_stock_picking_tree_operation"/>


</odoo>
