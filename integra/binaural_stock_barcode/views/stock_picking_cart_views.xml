<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_cart_tree" model="ir.ui.view">
        <field name="name">stock.picking.cart.tree</field>
        <field name="model">stock.picking.cart</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="barcode"/>
                <field name="warehouse_id" invisible="1"/>
                <field name="delivery_steps" invisible="1"/>
                <field name="pick_id" attrs="{'invisible':[('delivery_steps', 'in',['ship_only'])]}"/>
                <field name="pack_id" attrs="{'invisible':[('delivery_steps', 'in',['ship_only','pick_ship'])]}"/>
                <field name="out_id"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_picking_cart_form" model="ir.ui.view">
        <field name="name">stock.picking.cart.form</field>
        <field name="model">stock.picking.cart</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="CART001"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="barcode"/>
                            <button name="%(binaural_stock_barcode.picking_cart_print_barcode)d" string="Print Barcode Cart" class="btn btn-link" type="action" attrs="{'invisible': [('barcode','=',False)]}" />
                        </group>
                        <group>
                            <field name="warehouse_id" invisible="1"/>
                            <field name="delivery_steps" invisible="1"/>
                            <field name="pick_id" attrs="{'invisible':[('delivery_steps', 'in',['ship_only'])]}"/>
                            <field name="pack_id" attrs="{'invisible':[('delivery_steps', 'in',['ship_only','pick_ship'])]}"/>
                            <field name="out_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_cart_list" model="ir.actions.act_window">
        <field name="name">Stock Picking Cart</field>
        <field name="res_model">stock.picking.cart</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem 
        id="menu_stock_picking_cart_list" 
        name="Carts" 
        parent="stock.menu_warehouse_config"
        groups="binaural_stock_barcode.show_stock_carts"
        action="action_stock_picking_cart_list"/>
</odoo>
