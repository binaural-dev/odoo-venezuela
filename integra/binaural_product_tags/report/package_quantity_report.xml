<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="package_quantity_report_action" model="ir.actions.report">
            <field name="name">Package Label</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">binaural_product_tags.stock_picking_package_quantity</field>
            <field name="report_file">binaural_product_tags.stock_picking_package_quantity</field>
            <field name="print_report_name">'Label - %s', object.name</field>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="paperformat_id" ref="binaural_product_tags.paperformat_package_quantity_report"/>
        </record>

        <template id="stock_picking_package_quantity">
            <t t-foreach="range(1, stock_picking_data['package_qty'] + 1)" t-as="i">
                <t t-call="web.html_container">
                    <t t-call="web.basic_layout" t-lang="es_VE">
                        <div class="page m-0 p-0 w-100 d-block" style="min-width:calc(100% - 4px) !important; height: 100%;" >
                            <div class="container m-0 p-0" style="font-size:14px;">
                                <div class="row" style="border: 1px solid #000 !important; height:calc(100% - 4px) !important; border-radius:5px;">
                                    <div class="col-6 m-0 p-3">
                                        <div class="row">
                                            <div class="col-12">
                                                <img 
                                                    t-att-src="image_data_uri(res_company.logo)" 
                                                    width="100%" 
                                                    height="110px" 
                                                    style="object-fit: contain;filter: grayscale(100%) !important;"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <span style="text-transfor:uppercase; font-weight:bold; line-height:1rem;"><t t-esc="stock_picking_data['partner_name']"/></span><br/>
                                                <p style="font-size:.7rem; line-height:.9rem;"><t t-esc="stock_picking_data['partner_shipping']"/></p>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 my-1">
                                                <p class="m-0" style="font-size:.6rem;">SCHEDULED DATE:</p>
                                                <span style="font-size:0.8rem; line-height:1rem;"><t t-esc="stock_picking_data['scheduled_date']"/></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-6 p-3" style="border-left: 1px solid #000 !important;">
                                        <div class="row py-1">
                                            <div class="col-12 text-center">
                                                <h2>
                                                    <span><strong><t t-esc="stock_picking_data['shipping_city']"/></strong></span>
                                                </h2>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 text-center">
                                                <p class="m-0 p-1" style="font-size:.6rem;">ORDER No: <strong><span t-esc="stock_picking_data['origin']"/></strong></p>
                                                <img t-if="stock_picking_data['origin']" t-att-src="'/report/barcode/Code128/%s' % stock_picking_data['origin']" style="width:100%;height:40px;"/>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12 text-center mt-2">
                                                <h2 class="font-weight-bold">
                                                    <span>PACKAGE <t t-esc="i"/>/<t t-esc="stock_picking_data['package_qty']"/></span>
                                                </h2>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>

</odoo>
