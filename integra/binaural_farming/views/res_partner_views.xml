<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="binaural_farming_inherited_from_res_partner_form" model="ir.ui.view">
        <field name="name">Extension de cliente</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="is_owner" groups="binaural_farming.group_res_partner_owner_farming"/>
                <field name="proprietary_acronym" groups="binaural_farming.group_res_partner_owner_farming"/>
            </field>
        </field>
    </record>

    <record id="binaural_farming_from_res_partner_tree" model="ir.ui.view">
        <field name="name">Owners Tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Owners">
                <field name="display_name" string="owner"/>
                <field name="proprietary_acronym" />
            </tree>
        </field>
    </record>
    
    <record id="res_partner_owner_action" model="ir.actions.act_window">
        <field name="name">Owners</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" 
               eval="[(5, 0, 0), 
                     (0, 0, {'view_mode': 'tree', 'view_id': ref('binaural_farming_from_res_partner_tree')})]"/>
        <field name="domain">[('is_owner','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Owner for stock lot!
            </p>
        </field>
    </record> 

    <menuitem 
        id="res_partner_owner_menu" 
        name="Farming Owners" 
        parent="stock.menu_product_in_config_stock" 
        action="res_partner_owner_action" 
        sequence="4"
    />

</odoo>
