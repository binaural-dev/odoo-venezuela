<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_lot_race_tree_view" model="ir.ui.view">
        <field name="name">Stock Lot Race Tree</field>
        <field name="model">stock.lot.race</field>
        <field name="arch" type="xml">
            <tree string="Stock Lot Race" editable="bottom">
                <field name="description" />
                <field name="specie_id" required="1"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="stock_lot_race_action" model="ir.actions.act_window">
        <field name="name">Stock Lot Race</field>
        <field name="res_model">stock.lot.race</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new race for stock lot!
            </p>
        </field>
    </record>

    <menuitem 
        id="stock_lot_race_menu" 
        name="Stock Lot Race" 
        parent="stock.menu_product_in_config_stock" 
        action="stock_lot_race_action" 
        sequence="3"
    />

</odoo>
