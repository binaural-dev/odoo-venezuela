<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_lot_qualitative_valuation_tree_view" model="ir.ui.view">
        <field name="name">Stock Lot Qualitative Valuation Tree</field>
        <field name="model">stock.lot.qualitative.valuation</field>
        <field name="arch" type="xml">
            <tree string="Stock Lot Qualitative Valuation" editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="stock_lot_qualitative_valuation_action" model="ir.actions.act_window">
        <field name="name">Stock Lot Qualitative Valuation</field>
        <field name="res_model">stock.lot.qualitative.valuation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new qualitative valuation for stock lot!
            </p>
        </field>
    </record> 

    <menuitem 
        id="stock_lot_qualitative_valuation_menu" 
        name="Stock Lot Qualitative Valuation" 
        parent="stock.menu_product_in_config_stock" 
        action="stock_lot_qualitative_valuation_action" 
        sequence="6"
    />

</odoo>
