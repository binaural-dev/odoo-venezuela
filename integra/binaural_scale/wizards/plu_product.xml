<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_plu_product" model="ir.ui.view">
        <field name="name">wizard.plu.product</field>
        <field name="model">plu.product</field>
        <field name="arch" type="xml">
            <form string="Lista de productos PLU">
                <sheet>
                    <group>
                        <group>
                            <field name="scale_model"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="download_plu_file" type="object" string="Generar lista de productos PLU"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_plu" model="ir.actions.act_window">
        <field name="name">Obtener productos en PLU</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">plu.product</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem action="action_wizard_plu" 
        id="menu_product_in_config_stock" 
        name="Products PLU" 
        parent="stock.menu_stock_inventory_control" 
        sequence="4"/>

</odoo>
