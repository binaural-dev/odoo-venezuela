<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.scale</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                    <h2>Scale Settings</h2>
                    <div class="row mt16 o_settings_container" name="binaural_scale_settings">
                        <div class="col-12 col-lg-6 o_setting_box"> 
                            <div class="o_setting_left_pane">
                                <field name="scan_barcode_scale_by_price"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="scan_barcode_scale_by_price"/>
                                <div class="text-muted">
                                    Scan the product with the price nomenclature
                                </div>
                            </div>
                            <div class="o_setting_left_pane" attrs="{'invisible': [('scan_barcode_scale_by_price', '=',False)]}">
                                <field name="scan_barcode_scale_by_price_with_tax"/>
                            </div>
                            <div class="o_setting_right_pane" attrs="{'invisible': [('scan_barcode_scale_by_price', '=',False)]}">
                                <label for="scan_barcode_scale_by_price_with_tax"/>
                                <div class="text-muted">
                                    When a product with a barcode with taxes is scanned, the tax is not recalculated
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
