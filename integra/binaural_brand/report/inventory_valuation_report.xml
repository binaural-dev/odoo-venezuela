<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_inventory_valuation_template" inherit_id="binaural_brand.report_inventory_valuation_template">
        <xpath expr="//t[2]/t[1]/div[1]/section[1]/table[1]/thead[1]/tr[1]/th[2]" position="after">
           <th style="width:140px;text-align:center;">Marca</th>
        </xpath>
        <xpath expr="//t[2]/t[1]/div[1]/section[1]/table[1]/tbody[1]/t[4]/t[1]/tr[1]/td[2]" position="after">
            <td style="text-align:center"><label t-out="product['brand_id'][1] if product['brand_id'] else ''"/></td>
        </xpath>
    </template>
</odoo>
