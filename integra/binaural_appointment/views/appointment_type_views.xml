<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="appointment_type_view_form_binaural_appointment" model="ir.ui.view">
        <field name="name">appointment.type.view.form.binaural.appointment</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <label for="product_id"/>
                <div>
                    <field name="product_id"/>
                </div>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Product Settings" attrs="{'invisible': [('product_id', '=', False)]}">
                    <group>
                        <field name="time_limit" widget="float_time"/>
                        <field name="block_appointment"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
