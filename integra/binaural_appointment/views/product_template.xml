<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_appointment_product_template" model="ir.ui.view">
        <field name="name">binaural.appointment.product.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <div>
                    <field name="is_appointment"/>
                    <label for="is_appointment"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Appointment Settings" attrs="{'invisible': [('is_appointment', '=', False)]}">
                    <group>
                        <field name="time_limit" widget="float_time"/>
                        <field name="block_appointment"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
