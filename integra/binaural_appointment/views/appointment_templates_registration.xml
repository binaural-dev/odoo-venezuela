<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="appointment_form_inherit" inherit_id="appointment.appointment_form" name="Website Appointment: Your Data Extended">
        <xpath expr="//form/div[1]" position="before">
            <!-- El campo solo se mostrará si 'is_appointment' es True -->
            <div class="mb-3 mt-1">
                <label class="pb-2" for="product_id">Product</label>
                <div>
                    <select name="product_id" class="form-control">
                        <t t-foreach="appointment_type['product_id']" t-as="product">
                            <option t-att-value="product.id"><t t-out="product.name"/></option>
                        </t>
                    </select>
                </div>
                <t t-if="is_internal_user">
                    <div class="mb-3 mt-1 appointment_form">
                        <label class="pb-2" for="customer_id">Customers</label>
                        <div>
                            <select id="customer_id" name="customer_id" class="form-control">
                                <option value="">Seleccione un socio</option>
                                <t t-foreach="customer_id" t-as="customer">
                                    <option t-att-value="customer.id">
                                        <t t-esc="customer.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                </t>
                <t t-if="partner_data">
                    <div class="mb-3 mt-1">
                        <label class="pb-2" for="prefix_vat">Your Prefix Vat</label>
                        <div>
                            <select id="prefix_vat" name="prefix_vat" class="form-control" required='1'>
                                    <option value="">Select Prefix Vat</option>
                                    <t t-foreach="prefix_vat" t-as="prefix">
                                        <option t-out="prefix[1]" t-att-value="prefix[0]"/>
                                    </t>
                            </select>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="mb-3 mt-1">
                        <label class="pb-2" for="prefix_vat">Your Prefix Vat</label>
                        <div>
                            <select name="prefix_vat" class="form-control" required='1'>
                                    <option value="">Select Prefix Vat</option>
                                    <t t-foreach="prefix_vat" t-as="prefix">
                                        <option id="prefix_vat" t-out="prefix[1]" t-att-value="prefix[0]"/>
                                    </t>
                            </select>
                        </div>
                    </div>
                </t>
               
                <div class="mb-3 mt-1">
                    <label class="pb-2" for="vat">Your Vat</label>
                    <div>
                        <input type="text" id="vat" class="form-control" name="vat" required="1"
                                t-att-value="'vat' in partner_data and partner_data['vat']"
                                placeholder="28966855"/>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
