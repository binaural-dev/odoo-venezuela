<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_payslip_form" model="ir.ui.view">
            <field name="name">hr.payslip.form.view.binaural.hr.payroll.benefits</field>
            <field name="model">hr.payslip</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
		<field name="foreign_rate" position="before">
            	    <field name="benefits_advance"
                   	   attrs="{'invisible': [('is_benefits','=',False)]}"/>
            	    <field name="foreign_benefits_advance"
                   	   attrs="{'invisible': [('is_benefits','=',False)]}"/>
            	    <field name="benefits_advance_percentage"
                   	   attrs="{'invisible': [('is_benefits','=',False)]}"/>
            	    <field name="is_benefits" invisible="1"/>
          	</field>
	    </field>
    	</record>
    </data>
</odoo>
