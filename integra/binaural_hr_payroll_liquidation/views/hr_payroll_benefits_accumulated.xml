<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

	<record id="hr_payroll_benefits_accumulated_view_search" model="ir.ui.view">
	    <field name="name">hr.payroll.benefits.accumulated.view.search</field>
	    <field name="model">hr.payroll.benefits.accumulated</field>
	    <field name="arch" type="xml">
		<search string="Benefits Accumulated">
		    <field name="employee_id"/>
		    <field name="employee_vat"/>
		    <field name="employee_department_id"/>
		    <field name="employee_job_id"/>
		    <separator/>
		    <group>
			<filter name="group_employee" string="Employee"
				domain="[]" context="{'group_by': 'employee_id'}"/>
			<filter name="group_date" string="Date"
				domain="[]" context="{'group_by': 'date'}"/>
		    </group>
		</search>
	    </field>
	</record>

	<record id="hr_payroll_benefits_accumulated_view_tree" model="ir.ui.view">
	    <field name="name">hr.payroll.benefits.accumulated.view.tree</field>
	    <field name="model">hr.payroll.benefits.accumulated</field>
	    <field name="arch" type="xml">
		<tree string="Benefits Accumulated" editable="bottom">
		    <field name="type"/>
		    <field name="employee_id"/>
		    <field name="employee_vat"/>
		    <field name="employee_department_id"/>
		    <field name="employee_job_id"/>
		    <field name="date"/>
		    <field name="monthly_or_quarterly_accumulated_benefits"/>
		    <field name="foreign_monthly_or_quarterly_accumulated_benefits"/>
		    <field name="annual_accumulated_benefits"/>
		    <field name="foreign_annual_accumulated_benefits"/>
		    <field name="accumulated_benefits"/>
		    <field name="foreign_accumulated_benefits"/>
		    <field name="accumulated_benefits_advance"/>
		    <field name="foreign_accumulated_benefits_advance"/>
		    <field name="available_benefits"/>
		    <field name="foreign_available_benefits"/>
		    <field name="accumulated_interest"/>
		    <field name="foreign_accumulated_interest"/>
		</tree>
	    </field>
	</record>

	<record id="hr_payroll_benefits_accumulated_action" model="ir.actions.act_window">
	    <field name="name">Benefits Accumulated</field>
	    <field name="res_model">hr.payroll.benefits.accumulated</field>
	    <field name="view_mode">tree,form</field>
	</record>

    </data>
</odoo>
