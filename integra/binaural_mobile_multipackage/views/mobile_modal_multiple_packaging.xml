<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="mobile_modal_multiple_packaging">
        <style>
            .cursor-pointer {
                cursor: pointer;
            }
        </style>
        <div class="row py-2 modal fade" id="multiple-packaging-modal" tabindex="-1" aria-labelledby="multiple-packaging-modal"  aria-modal="true" role="dialog">
            <div class="modal-dialog  w-75">
                <div class="modal-content px-4 p-2 rounded overflow-auto">
                    <div class="py-3 d-flex align-items-center justify-content-between">
                        <h3 id="product-name" class="text-capitalize">producto x</h3>
                        <span class="close-modal h1 cursor-pointer">×</span>
                    </div>
                    <table class="table table-hover" id="table">
                        <tr>
                            <th></th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-center">Unds. Total</th>
                        </tr>
                        <tbody id="body">
                        </tbody>
                    </table>
                    <div class="mt-4 input-group">
                        <select 
                            class="custom-select text-capitalize w-100 border rounded p-1 bg-white shadow-none" 
                            id="package-select"
                            style="margin-right: 15px; outline:0; color: #685563;"
                        >
                        </select>
                        <div class="input-group-append">
                          <button id="package-select-btn" class="btn btn-outline-secondary" type="button" style="min-width: max-content;">Añadir / Remover</button>
                        </div>
                      </div>
                    <button type="button" class="my-4 btn btn-primary" id="save-multipackage-btn">Guardar</button>
                </div>
            </div>
        </div>
    </template>
</odoo>