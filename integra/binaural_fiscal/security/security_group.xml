<!-- Ver Asientos Contables que tenga Diario Fiscal -->

        <record id="access_fiscal_inspection_res_partner" model="ir.rule">
            <field name="name">Fiscal Inspection Access Rights</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('journal_id.fiscal', '=', True)]</field>
            <field name="groups" eval="[(4, ref('binaural_fiscal.group_can_see_fiscal'))]"/>
        </record>

<!-- Ver Asientos Contables que no tengan Diario Fiscal -->

        <record id="access_no_fiscal_inspection_res_partner" model="ir.rule">
            <field name="name">No Fiscal Inspection Access Rights</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('journal_id.fiscal', '=', False)]</field>
            <field name="groups" eval="[(4, ref('binaural_fiscal.group_cannot_see_fiscal'))]"/>
        </record>

