<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_remove_suspend_auto" model="ir.cron">
        <field name="name">Remover suspensión automaticamente</field>
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall">1</field>
        <field name="model_id" ref="model_remove_suspend_partner"/>
        <field name="state">code</field>
        <field name="code">model.remove_suspend_auto()</field>
    </record>

    <record id="cron_resolve_ownership_action_number" model="ir.cron">
        <field name="name">Resolver Propietaridad de Acciones En los Contactos</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="active" eval="False" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="state">code</field>
        <field name="code">model.cron_resolve_ownership_action_number()</field>
    </record>


</odoo>
