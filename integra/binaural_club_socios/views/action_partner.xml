<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_club_socios_view_tree_action_partner" model="ir.ui.view">
        <field name="name">binaural.club.socios.view.tree.action.partner</field>
        <field name="model">action.partner</field>
        <field name="arch" type="xml">
            <tree string="Action Partner">
                <field name="type_action"/>
                <field name="number" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="binaural_club_socios_view_form_action_partner" model="ir.ui.view">
        <field name="name">binaural.club.socios.view.form.action.partner</field>
        <field name="model">action.partner</field>
        <field name="arch" type="xml">
            <form string="Action Partner Form">
                    <header>
                        <field name="state" widget="statusbar" nolabel="1" options="{'clickable': '1', 'fold_field': 'fold'}" class="ms-2" on_change="1" can_create="false" can_write="false"/>
                    </header>
                    <sheet>
                        <group>
	                        <group>
		                        <field name="type_action"/>
                                <field name="number"/>
                                <field name="owner_id" readonly="1"/>
                            </group>
                        </group>
	                    <notebook>
                            <page string="Other Beneficiaries">
	                            <field 
                                    name="beneficiary_partner_ids" 
                                    nolabel="1"
                                    readonly="1"
                                >
			                        <tree editable="bottom">
			                            <field name="name"/>
                                        <field name="vat" string="Identification"/>
                                        <field name="type_relation"/>
			                        </tree>
			                    </field>
                            </page>
                            <page string="Previous Partners">
	                            <field name="partners_previous_ids" nolabel="1">
			                        <tree editable="bottom">
			                            <field name="name"/>
                                        <field name="identification"/>
			                            <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="name_exec"/>
                                        <field name="company_id" />
			                        </tree>
			                    </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
                </form>
        </field>
    </record>

    <record id="binaural_club_socios_view_searh_action_partner" model="ir.ui.view">
            <field name="name">binaural.club.socios.view.search.action.partner</field>
            <field name="model">action.partner</field>
            <field name="arch" type="xml">
                <search string="Search Action">
                    
	                <field name="number" string="Action Number" filter_domain="[('number','=',self)]"/>

                    <separator/>
                    <filter name="active_action" domain="[ ('state', '=', 'active')]"/>
                    <filter name="special_action" domain="[('state', '=', 'special')]"/>
                    <filter name="honorary_action" domain="[('state', '=', 'honorary')]"/>
                    <filter name="treasury_action" domain="[('state', '=', 'treasury')]"/>
                </search>
            </field>
        </record>

	    <record id="action_action_partner"  model="ir.actions.act_window">
            <field name="name">Actions partner</field>
            <field name="res_model">action.partner</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="binaural_club_socios_view_searh_action_partner"/>
        </record>

	    <record id="action_partner_form" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{'res_partner_search_mode': 'customer', 'default_customer_rank': 1}</field>
            <field name="search_view_id" ref="base.view_res_partner_filter"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new customer in your address book
              </p><p>
                Odoo helps you easily track all activities related to a customer.
              </p>
            </field>
        </record>

	    <menuitem name="Partner Club" id="binaural_club_socios.menu_root" />

	    <menuitem name="Partners" id="binaural_club_socios.partners_club" parent="binaural_club_socios.menu_root" />
        <menuitem name="Partner List" id="binaural_club_socios.partners_list" parent="binaural_club_socios.partners_club" action="action_partner_form"/>

	    <menuitem name="Acciones" id="binaural_club_socios.actions" parent="binaural_club_socios.menu_root" />
        <menuitem name="Listado de Acciones" id="binaural_club_socios.actions_list" parent="binaural_club_socios.actions" action="action_action_partner"/>

</odoo>
