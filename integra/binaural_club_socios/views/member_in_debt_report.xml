<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_club_socios_member_in_debt_report_view_search" model="ir.ui.view">
            <field name="name">member.in.debt.report.view.search</field>
            <field name="model">member.in.debt.report</field>
            <field name="arch" type="xml">
                <search string="">
                    <filter name="action_number" string="Numero de Acción" context="{'group_by': 'action_number'}" />
                    <filter name="partner_id" string="Socio" context="{'group_by': 'partner_id'}" />
                    <field name="partner_id"/>
                    <field name="action_number"/>
                </search>
            </field>
        </record>

        <record id="binaural_club_socios_member_in_debt_report_view_tree" model="ir.ui.view">
            <field name="name">member.in.debt.report.view.tree</field>
            <field name="model">member.in.debt.report</field>
            <field name="arch" type="xml">
                <tree string="Socios con Mora">
                    <field name="partner_id"/>
                    <field name="action_number"/>
                    <field name="quota_period" invisible="1"/>
                    <field name="quota_period_str"/>
                    <field name="amount" sum="Total de Socios en Mora"/>
                </tree>
            </field>
        </record>

        <record id="action_member_in_debt_report" model="ir.actions.act_window">
            <field name="name">Socios con Mora</field>
            <field name="res_model">member.in.debt.report</field>
            <field name="view_mode">tree</field>
            <field name="context">{'search_default_partner_id': 1}</field>
        </record>

        <menuitem
            id="binaural_club_socios_member_in_debt_report_menu"
            name="Reporte de Socios con Mora"
            action="action_member_in_debt_report"
            parent="binaural_club_socios.menu_root"
            sequence="15"/>

</odoo>
