<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_club_socios_family_member_list" model="ir.ui.view">
        <field name="name">binaural.club.socios.family.member.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree edit="false" string="Listado de socios y Familiares" create="false" delete="false">
                <field name="image_medium" string="Foto" widget="image" class="oe_avatar"/>
                <field name="action_number"/>
                <field name="name"/>
	            <field name="prefix_vat" string="Tipo de doc"/>
                <field name="vat" string="Cédula"/>
                <field name="type_relation" string="Parentesco"/>
                <field name="can_access_club" string="Acceso al club"/>
                <field name="associate_parent" string="Socio"/>
                <field name="is_solvent_related"/>
            </tree>
        </field>
    </record>

	<record id="binaural_club_socios_family_member_action" model="ir.actions.act_window">
        <field name="name">Listado de socios y Familiares</field>
        <field name="res_model">res.partner</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="binaural_club_socios_family_member_list"/>
		<field name="domain">['|', ('action_number', '!=', False), ('parent_id', '!=', False)]</field>
    </record>

	<menuitem name="Family and members list" action="binaural_club_socios_family_member_action"
            id="menu_partnert_list"
            parent="binaural_club_socios.menu_root"/>

</odoo>
