<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_club_socios_pending_debt_list_tree" model="ir.ui.view">
        <field name="name">binaural.club.socios.pending.debt.list.tree</field>
        <field name="model">pending.debt.list</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="date_end" />
                <field name="amount" />
            </tree>
        </field>
    </record>

    <record id="binaural_club_socios_pending_debt_list_action" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">pending.debt.list</field>
        <field name="view_mode">tree</field>                
    </record>

    <menuitem
        id="config_socios_menu"
        name="Configuration"                
        parent="binaural_club_socios.menu_root"
        />

    <menuitem
        id="list_pending_debt_menu"
        name="Pending Debt List"
        action="binaural_club_socios_pending_debt_list_action"        
        parent="binaural_club_socios.config_socios_menu"
        sequence="10"/>

</odoo>
