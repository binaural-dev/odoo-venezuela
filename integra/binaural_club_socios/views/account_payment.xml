<?xml version="1.0" encoding="utf-8"?>
<odoo>

	    <record id="binaural_club_socios_view_account_payment_tree" model="ir.ui.view">
            <field name="name">binaural.club.socios.view.account.payment.tree</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="action_number" readonly="1"/>
                </field>
            </field>
        </record>

	    <record id="binaural_club_socios_view_account_payment_search" model="ir.ui.view">
            <field name="name">binaural.club.socios.view.account.payment.tree</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="action_number" string="Número de Acción" filter_domain="[('action_number','=',self)]"/>
                </field>
            </field>
        </record>

	    <record id="binaural_club_socios_view_account_payment_form" model="ir.ui.view">
            <field name="name">binaural.club.socios.view.account.payment.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <field name="journal_id" position="after">
                    <field name="action_number" readonly="1" force_save="1"/>
                </field>
            </field>
        </record>

</odoo>
