<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
	    <record id="binaural_club_socios_partner_config_view_tree" model="ir.ui.view">
            <field name="name">Partner Configs</field>
            <field name="model">partner.config</field>
            <field name="arch" type="xml">
                <tree string="Partner Configs">
                    <field name="years_of_membership"/>
                    <field name="age_limit_for_associated_children"/>
                    <field name="day_end_date_payment" />
                    <field name="previous_days_alert_associates"/>
                    <field name="out_email_alert_associates" />
                    <field name="is_postpaid" />
                    <field name="active" />
                    <field name="company_id" />
                </tree>
            </field>
        </record>

		<record id="binaural_club_socios_partner_config_view_form" model="ir.ui.view">
            <field name="name">Partner Configs</field>
            <field name="model">partner.config</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Partner Config">
                    <sheet>
                        <group>
	                        <group>
		                    <field name="years_of_membership"/>
                            <field name="age_limit_for_associated_children"/>
                            <field name="day_end_date_payment" />
                            <field name="previous_days_alert_associates"/>
                        </group>
                        <group>
                            <field name="out_email_alert_associates" />
                            <field name="is_postpaid" />
                            <field name="active" />
                            <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        
	                    <notebook >
                            <page invisible="1" string="Expiration alert" name="expiration_alert_config">
                                <group>
	                                <field name="expiration_alert_subject" />
                                    <field name="expiration_alert_body" widget="html"/>
                                   
	                            </group>
                            </page>
                            <page  invisible="1" name="extension_alert_config" string="Extension alert">
                                <group>
                                <field name="extension_alert_subject" />
                                <field name="extension_alert_body" widget="html"/>
                              
                                </group>
                            </page>
                            <page name="signature_mail" string="Email signature">
                                <field name="signature" widget="image"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

	    <record id="action_members_config"  model="ir.actions.act_window">
            <field name="name">Configuraciones</field>
            <field name="res_model">partner.config</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">tree,form</field>
        </record>

	    <menuitem name="Partner Config" id="binaural_club_socios.partner_config" parent="binaural_club_socios.menu_root" action="action_members_config"/>
    </data>
</odoo>