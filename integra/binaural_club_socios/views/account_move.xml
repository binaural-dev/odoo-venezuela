<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_club_socios_view_account_move_form" model="ir.ui.view">
            <field name="name">binaural.club.socios.view.account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="action_number" force_save="1" invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund','out_receipt')"/>
                </field>
				<xpath expr="//notebook/page/field[@name='line_ids']/tree//field[@name='partner_id']" position="before">
	                <field name="action_number"/>
                </xpath>
            </field>
        </record>

	    <!-- <record id="binaural_club_socios_view_account_move_tree" model="ir.ui.view">
            <field name="name">binaural.club.socios.view.account.move.tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
	                <field name="action_number" />
                </field>
            </field>
        </record> -->

	    <record id="binaural_club_socios_view_account_move_search" model="ir.ui.view">
            <field name="name">binaural.club.socios.view.account.move.search</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="action_number" string="Número de Acción" filter_domain="[('action_number','=',self)]"/>
                </field>
            </field>
        </record>

</odoo>
