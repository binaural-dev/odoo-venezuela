<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="binaural_club_socios_form_remove_suspend_partner" model="ir.ui.view">
        <field name="name">Remove suspension</field>
        <field name="model">remove.suspend.partner</field>
        <field name="arch" type="xml">
            <form string="Remove suspension">
                
                    <group>
                        <group>
                            <div>Are you sure to remove the membership suspension?</div>
                            <field name="partner_to_remove_suspend" invisible="1"/>
                        </group>
                    </group>
                                      
                <footer>
                    <button name="remove_suspend_partner" string="Remove suspension" type="object" class="oe_highlight" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
