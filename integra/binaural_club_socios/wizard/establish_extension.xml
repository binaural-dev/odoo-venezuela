<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_club_socios_form_establish_extension" model="ir.ui.view">
        <field name="name">Establish Extension</field>
        <field name="model">establish.extension</field>
        <field name="arch" type="xml">
            <form string="Establish Extension">
                
                    <group>
                        <group>
                            <field name="reason" />
                            <field name="new_end_date" />
                            <field name="partner_to_establish" invisible="1"/>
                        </group>
                    </group>
                                      
                <footer>
                    <button name="establish_extension" string="Establish Extension" type="object" class="oe_highlight" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
