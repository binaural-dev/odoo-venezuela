<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_club_socios_form_suspend_partner" model="ir.ui.view">
        <field name="name">Suspend</field>
        <field name="model">suspend.partner</field>
        <field name="arch" type="xml">
            <form string="Suspend">
                
                    <group>
                        <group>
                            <field name="reason" />
                            <field name="end_date_suspend" />
                            <field name="partner_to_suspend" invisible="1"/>
                        </group>
                    </group>
                                      
                <footer>
                    <button name="suspend_partner" string="Suspend" type="object" class="oe_highlight" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
