<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_club_socios_form_status_batch_wizard_action" model="ir.ui.view">
        <field name="name">binaural.club.socios.form.status.batch.wizard.action</field>
        <field name="model">status.action.batch</field>
        <field name="arch" type="xml">
            <form string="Change statement actions">
                
                    <group>
                        <group>
                            <field name="status" />
                        </group>
                    </group>

                
                <notebook>
                    <page name="acciones" string="Acciones">
                            <field name="actions_ids" options="{'no_create': True}"/>
                    </page>
                </notebook>
                                      
                <footer>
                    <button name="change_status" string="Cambiar estado" type="object" class="oe_highlight" />
                    <button string="Cancelar" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_status_batch_wizard_action" model="ir.actions.act_window" >
        <field name="name">Cambiar estado de acciones en lote</field>
        <field name="res_model">status.action.batch</field>
        <field name="type">ir.actions.act_window</field>
        <field name="binding_view_types">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field><!--inline-->
    </record>

    <menuitem name="Statements of shares in batches" id="binaural_club_socios.action_status_batch_wizard_id_action" parent="binaural_club_socios.actions" action="action_status_batch_wizard_action"/>

</odoo>
