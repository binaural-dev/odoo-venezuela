<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_distribution_tree_view" model="ir.ui.view">
        <field name="name">stock.picking.distribution.tree.view</field>
        <field name="model">stock.picking.distribution</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="expected_date"/>
            </tree>
        </field>
    </record>

    <record id="stock_picking_distribution_form_view" model="ir.ui.view">
        <field name="name">stock.picking.distribution.form.view</field>
        <field name="model">stock.picking.distribution</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button 
                        name="action_confirm" 
                        type="object" 
                        string="Confirm" 
                        attrs="{'invisible': [('state','=', 'done')]}"
                        class="btn btn-primary" />
                    <button 
                        name="action_draft" 
                        type="object" 
                        string="Draft" 
                        attrs="{'invisible': [('state','=', 'draft')]}"
                        class="btn btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="BATCH/00000"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="warehouse_id" invisible="1"/>
                            <field name="vehicle_id" 
                                required="1" 
                                options="{'no_create': True, 'no_create_edit': True}"
                                attrs="{'readonly': [('state','=', 'done')]}"/>
                            <field name="driver_id"
                                required="1" 
                                options="{'no_create': True, 'no_create_edit': True}"
                                attrs="{'readonly': [('state','=', 'done')]}"/>
                            <field name="stock_picking_type_id" 
                                domain="[('code','=','outgoing')]" 
                                required="1" 
                                options="{'no_create': True, 'no_create_edit': True}"
                                attrs="{'readonly': [('state','=', 'done')]}"/>
                        </group>
                        <group>
                            <field name="expected_date" attrs="{'readonly': [('state','=', 'done')]}"/>
                        </group>
                    </group>
                    <notebook attrs="{'invisible': [('stock_picking_type_id','=', False)]}">
                        <page string="Stock Picking">
                            <field 
                                name="picking_ids" 
                                id="picking_ids"
                                widget="many2many" 
                                attrs="{'readonly': [('state','=', 'done')]}"
                                domain="[('picking_type_id','=',stock_picking_type_id),('state','=','done'),('is_invoiced','=',True),('distribution_id','=',False)]">
                                <tree>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="scheduled_date"/>
                                    <field name="package_qty"/>
                                    <field name="amount_invoiced"/>
                                    <field name="origin"/>
                                </tree>
                            </field>
                            <group colspan="4">
                                <group class="oe_subtotal_footer oe_right">
                                    <field name="package_qty_total"/>
                                    <field name="partner_count" />
                                    <field name="amount_total" />
                                </group>
                            </group>
                        </page>
                        <page string="Stock Moves">
                            <field 
                                name="picking_move_ids" 
                                readonly="1"/>
                        </page>
                        <page string="Stock Moves Lines">
                            <field 
                                name="picking_move_line_ids" 
                                readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_distribution" model="ir.actions.act_window">
        <field name="name">Stock Picking Distribution</field>
        <field name="res_model">stock.picking.distribution</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
    </record>

    <menuitem 
        id="menu_stock_picking_distribution" 
        action="action_stock_picking_distribution" 
        name="Stock Picking Distribution" 
        parent="stock.menu_stock_warehouse_mgmt" 
        sequence="10"/>

</odoo>
