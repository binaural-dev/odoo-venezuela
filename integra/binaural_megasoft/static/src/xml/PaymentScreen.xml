<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('payment-controls')]" position="inside">
            <!-- <div class="button js_invoice" t-on-click="megasoftPing">
                    <i class="fa fa-compress" /> 
                        Comprobar Conexión
            </div> -->
            <div class="button js_invoice" t-on-click="megasoftCambio">
                    <i class="fa fa-money" /> 
                        Vuelto
            </div>
            <div class="button js_invoice" t-on-click="megasoftPaymentPdv">
                    <i class="fa fa-credit-card" />
                        Punto de venta
            </div>
            <div class="button js_invoice" t-on-click="megasoftPaymentP2c">
                    <i class="fa fa-mobile" />
                        Pago Movil
            </div>
            <div class="button js_invoice" t-on-click="megasoftUltimaTransaccionAprobada">
                    <i class="fa fa-file-text" />
                        Imprimir ultima transaccion aprobada
            </div>
            <div class="button js_invoice" t-on-click="megasoftUltimaTransaccionProcesada">
                    <i class="fa fa-file-text" />
                        Imprimir ultima transaccion procesada
            </div>
        </xpath>

    </t>
</templates>