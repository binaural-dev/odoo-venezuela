<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_megasoft" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.megasoft</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="pos_iot.pos_iot_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='row_scale']" position="after">
                <div class="row">
                    <label string="Device" for="megasoft_iot_id" class="col-lg-4 o_light_label"/>
                    <field name="megasoft_iot_id"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
