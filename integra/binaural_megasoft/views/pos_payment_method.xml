<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_view_form_megasoft" model="ir.ui.view">
        <field name="name">binaural.pos.payment.method.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='split_transactions']" position="after">
                <field name="is_change_method" invisible="1" />
                <field name="confirm_payment_p2c" invisible="1"/>
                <field name="confirm_payment_pdv" invisible="1" />
                <field name="is_change" attrs="{'invisible' : [('is_change_method', '=', False)]}"/>
                <field name="is_payment_p2c" attrs="{'invisible' : [('confirm_payment_p2c', '=', False)]} "/>
                <field name="is_payment_pdv" attrs="{'invisible' : [('confirm_payment_pdv', '=', False)]}" />
            </xpath>
        </field>
    </record>

</odoo>
