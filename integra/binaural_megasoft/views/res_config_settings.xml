<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_binaural_megasoft" model="ir.ui.view">
        <field name="name">res_config.settings.binaural.megasoft</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="150"/>
        <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                <div class="app_settings_block mt-6" data-string="Megasoft" string="Megasoft" data-key="binaural_megasoft">
                    <h2>Megasoft configurations</h2>
                    <div class="row mt16 o_settings_container" name="binaural_megasoft_settings">
                        <div class="o_setting_right_pane">
                            <group>
                            <field name="url_megasoft" />
                            <field name="port_megasoft" />
                            </group>
                            <group colspan="2" col="4">
                            <field name="change_p2c" />
                            </group>
                            <group>
                            <field name="verificate_p2c" />
                            </group>
                            <group>
                            <field name="pdv_option" />
                            </group>
                            <group>
                                <field name="pre_close_megasoft" attrs="{'invisible': [('pdv_option', '!=', True)]}"/>
                            </group>
                        </div>    
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form_megasfot" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_megasoft</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@class='content-group pos_iot_config']/div[@class='row'][3]" position="after">
                <div class="row">
                    <label string="Device Megasoft" for="megasoft_iot_id" class="col-lg-4 o_light_label"/>
                    <field name="megasoft_iot_id"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
 
