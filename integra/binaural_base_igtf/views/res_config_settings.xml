<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_binaural_rate" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.rate</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="binaural_tax.res_config_settings_binaural_taxes"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='base_igtf_setting']/div[2]" position="inside">
                    <br/>
                    <field name="module_binaural_igtf" invisible="1"/>
                    <group colspan="2" col="1" attrs="{'invisible': [('module_binaural_igtf', '=', False)]}">
                        <field name="customer_account_igtf_id"/>
                        <field name="supplier_account_igtf_id"/>
                        <field name="igtf_percentage" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
