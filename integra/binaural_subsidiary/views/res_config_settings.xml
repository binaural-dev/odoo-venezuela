<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_config_settings_binaural_subsidiary" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.subsidiary</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="101"/>
            <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                    <h2>Subsidiary Configuration</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" name="Binaural_subsidiary_settings">
                                <div class="o_setting_left_pane">
                                    <field name="subsidiary" widget="upgrade_boolean"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="subsidiary"/>
                                    <div class="text-muted">
                                        Subsidiary (Orders and Invoices)
                                    </div>

                                    <div class="row mt-2" attrs="{'invisible': [('subsidiary','=',False)]}">
                                        <field name="analytical_accounts_subsidiary" widget="upgrade_boolean" class="col flex-grow-0 ml16 mr0 pe-2"/>
                                        <div class="col ps-0">
                                            <label for="analytical_accounts_subsidiary"/>
                                            <!-- <div class="text-muted">
                                                Use Analytical Accounts as Subsidiary
                                            </div> -->
                                        </div>
                                    </div>

                                    <div class="row mt-2" attrs="{'invisible': [('subsidiary','=',False)]}">
                                        <field name="analytical_accounts_cost_subsidiary" widget="upgrade_boolean" class="col flex-grow-0 ml16 mr0 pe-2"/>
                                        <div class="col ps-0">
                                            <label for="analytical_accounts_cost_subsidiary"/>
                                            <!-- <div class="text-muted">
                                                Using Analytical Accounts as Cost Center and Subsidiary
                                            </div> -->
                                        </div>
                                    </div>

                                </div>
                        </div>
                        
                        
                        
                    </div>
                </xpath>
            </field>
        </record>
    </data>

</odoo>
