<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SUBSIDIARY FIELD -->
        <record id="binaural_subsidiary_account_move_form" model="ir.ui.view">
            <field name="name">binaural.subsidiary.account_move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- <xpath expr="//group[@id='header_right_group']/div[3]" position="after">
                    <field name="subsidiary"/>
                </xpath> -->
                <xpath expr="//group[@id='header_right_group']/div[3]" position="after">
                    <field name="account_analytic_id" attrs="{'invisible':[('move_type','not in',['out_refund','out_invoice','in_invoice', 'in_refund'])]}"/>
                    
                </xpath>
                
            </field>
        </record>



</odoo>
