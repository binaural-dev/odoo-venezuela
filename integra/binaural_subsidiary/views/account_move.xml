<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="binaural_subsidiary_account_move_form" model="ir.ui.view">
            <field name="name">binaural.subsidiary.account_move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@id='header_right_group']/div[3]" position="after">
                    <field name="account_analytic_id" attrs="{'readonly': ['|',('invoice_origin','!=', False), ('ref','!=', False)]}" required="1"/>
                </xpath>
            </field>
        </record>


        <record id="binaural_subsidiary_account_move_view_tree" model="ir.ui.view">
            <field name="name">binaural.subsidiary.account.move.view.tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_total_signed']" position="after">
                <field name="account_analytic_id" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="binaural_subsidiary_account_move_view_search" model="ir.ui.view">
        <field name="name">binaural.subsidiary.account.move.view.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <search>
                <field name="account_analytic_id" string="Cuenta Analitica"/>
                <group string="Group by">
                    <filter name="account_analytic_id" string="Cuenta Analitica" context="{'group_by': 'account_analytic_id'}"/>
                </group>
                <filter name="account_analytic_id" string="Cuenta Analitica" domain="[('account_analytic_id', '!=' , False)]"/>
            </search>
        </field>
    </record>

</odoo>
