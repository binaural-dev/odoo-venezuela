<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form" model="ir.ui.view">
        <field name="name">binaural.subsidiary.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="payment_term_id" position="after">
                <field name="company_subsidiary" invisible='1'/>   
                <field name="subsidiary_id" 
                    attrs="{'invisible': [('company_subsidiary', '=', False)],
                            'required': [('company_subsidiary', '=', True)],
                            'readonly': [('state', '!=', 'draft')]}"/>
            </field>
        </field>
    </record>

    <record id="sale_order_view_search_inherit_quotation_inherit_binaural_subsidiary" model="ir.ui.view">
        <field name="name">sale.order.view.search.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <search>
                <field name="subsidiary_id" string="Sucursal"/>
                <group string="Group by">
                    <filter name="subsidiary_id" string="Sucursal" context="{'group_by': 'subsidiary_id'}"/>
                </group>
                <filter name="subsidiary_id" string="Sucursal" domain="[('subsidiary_id', '!=' , False)]"/>
            </search>
        </field>
    </record>
</odoo>
