<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="res_config_settings_binaural_advance_payment_igtf" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.advance.payment.igtf</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="101"/>
            <field name="inherit_id" ref="binaural_base.res_config_settings_view_form_binaural_base"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='binaural_setting_container']" position="inside">
                    <h2>Advance Payment IGTF</h2>
                    <div class="row mt16 o_settings_container" name="binaural_advance_payment_account_settings">
                        <div class="o_setting_right_pane">
                            <group colspan="4" col="4">
                                <field name="advance_payment_igtf_journal_id" />
                            </group>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>

</odoo>
