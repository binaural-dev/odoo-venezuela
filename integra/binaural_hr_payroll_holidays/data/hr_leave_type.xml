<odoo>
  <data noupdate="1">

    <!-- Find the records that we're going to update and set the noupdate field to false -->
    <function name="write" model="ir.model.data">
      <value model="ir.model.data" search="[('module', '=', 'hr_holidays'), ('name', '=','holiday_status_cl')]"/>
      <value eval="{'noupdate': False}"/>
    </function>
    
    <record id="hr_holidays.holiday_status_cl" model="hr.leave.type">
      <field name="work_entry_type_id" ref="binaural_hr_payroll.hr_work_entry_binaural_vacation"/>
      <field name="holiday_work_entry_type_id" ref="binaural_hr_payroll.hr_work_entry_binaural_vacation_holiday"/>
      <field name="break_day_work_entry_type_id" ref="binaural_hr_payroll.hr_work_entry_binaural_vacation_weekend"/>
    </record>

    <!-- Set the noupdate field to True again on the updated records -->
    <function name="write" model="ir.model.data">
      <value model="ir.model.data" search="[('module', '=', 'hr_holidays'), ('name', '=', 'holiday_status_cl')]"/>
      <value eval="{'noupdate': True}"/>
    </function>

  </data>
</odoo>
