<odoo>
  <data noupdate="1">

    <!-- Find the records that we're going to update and set the noupdate field to false -->
    <function name="write" model="ir.model.data">
      <value model="ir.model.data"
        search="[
          ('module', '=', 'binaural_hr_payroll'),
          ('name', 'in',
            (
              'hr_work_entry_binaural_extra_hours',
              'hr_work_entry_binaural_extra_hours_day',
              'hr_work_entry_binaural_extra_hours_night',
              'hr_work_entry_binaural_holiday',
              'hr_work_entry_binaural_holiday_not_worked',
              'hr_work_entry_binaural_break_day',
              'hr_work_entry_binaural_vacation',
            )
          )
        ]"
      />
      <value eval="{'noupdate': False}" />
    </function>

    <!-- Update the records -->
    <record id="binaural_hr_payroll.hr_work_entry_binaural_extra_hours" model="hr.work.entry.type">
      <field name="leave_type_ids" eval="[(6,0,[ref('hr_holidays.holiday_status_cl')])]" />
    </record>

    <record id="binaural_hr_payroll.hr_work_entry_binaural_extra_hours_day" model="hr.work.entry.type">
      <field name="leave_type_ids" eval="[(6,0,[ref('hr_holidays.holiday_status_cl')])]" />
    </record>

    <record id="binaural_hr_payroll.hr_work_entry_binaural_extra_hours_night" model="hr.work.entry.type">
      <field name="leave_type_ids" eval="[(6,0,[ref('hr_holidays.holiday_status_cl')])]" />
    </record>

    <record id="binaural_hr_payroll.hr_work_entry_binaural_holiday" model="hr.work.entry.type">
      <field name="leave_type_ids" eval="[(6,0,[ref('hr_holidays.holiday_status_cl')])]" />
    </record>

    <record id="binaural_hr_payroll.hr_work_entry_binaural_holiday_not_worked" model="hr.work.entry.type">
      <field name="leave_type_ids" eval="[(6,0,[ref('hr_holidays.holiday_status_cl')])]" />
    </record>

    <record id="binaural_hr_payroll.hr_work_entry_binaural_break_day" model="hr.work.entry.type">
      <field name="leave_type_ids" eval="[(6,0,[ref('hr_holidays.holiday_status_cl')])]" />
    </record>

    <record id="binaural_hr_payroll.hr_work_entry_binaural_vacation" model="hr.work.entry.type">
      <field name="leave_type_ids" eval="[(6,0,[ref('hr_holidays.holiday_status_cl')])]" />
    </record>

    <!-- Set the noupdate field to True again on the updated records -->
    <function name="write" model="ir.model.data">
      <value model="ir.model.data"
        search="[
          ('module', '=', 'binaural_hr_payroll'),
          ('name', 'in',
            (
              'hr_work_entry_binaural_extra_hours',
              'hr_work_entry_binaural_extra_hours_day',
              'hr_work_entry_binaural_extra_hours_night',
              'hr_work_entry_binaural_holiday',
              'hr_work_entry_binaural_holiday_not_worked',
              'hr_work_entry_binaural_break_day',
              'hr_work_entry_binaural_vacation',
            )
          )
        ]"
      />
      <value eval="{'noupdate': True}" />
    </function>

  </data>
</odoo>
