<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

    <template id="account_report_document">

        <style>

            @font-face {
                font-family: 'Courier';
                src: url('/binaural_accountant/static/fonts/CourierPrime-Regular.ttf') format('truetype');
            }

            * {
                font-family: Courier;
                font-size: 19px !important;
                word-spacing: -5px !important;
            }

            h1 {
                font-size: 20px;
            }

            h2 {
                font-size: 16px;
            }

            .page {
                font-size: 13px;
                padding: 25px;

            }

            .table {
                width: 100%;
                margin-top: 30px;
            }

            tr, th, td {
                border 0px;
                font-size: 13px;
            }

            .table tr, .table td, .table th {
                padding: 5px 15px;
            }

            .table thead th {
                
                font-size: 12px;
                text-transform: uppercase;
            }

            .table thead tr {
                border: 1px solid black !important;
                border-right:0px !important;
                border-left:0px !important;
            }

            .table tfoot .total_debit, .table tfoot .total_credit {
                font-weight: bold;
                font-size: 13px;
            }
            

            .ml-6 {
                margin-left: 20px;
            }

            .text-center {
                text-align: center;
            }

            .header {
                background: blue !important;
            }

            .main_table tbody tr td {
                padding-top:5px;
                padding-bottom:5px;
            }

            .main_table tbody tr td{ 
                border-top: 1px solid black !important;
            }

            .main_table tbody tr:nth-child(1) td {
                border-top: none !important;
            }

            <!-- .main_table tbody tr:last-child td {
                border-top: none !important;
            } -->

            .total_table {
                margin-top: 10px;
            }

            .total_table td {
                border-top: 1px black solid;
            }

            .row {
                padding: 0px;
                margin: 0px;
            }
        </style>
        <div class="page" style="position: relative; padding:0px; margin:0px;border-top:white 1px solid;">

            <t t-set="items_by_page" t-value="100"/>
            <t t-set="docs_paginated" t-value="[docs[i:i+items_by_page] for i in range(0, len(docs), items_by_page)]"/>
            <t t-set="paginate_count" t-value="len(docs_paginated)"/>
            <t t-set="idx" t-value="0"/>
            <t t-set="current_page" t-value="1"/>
            <t t-set="current_month_name" t-value="time.strftime('%%m')
                .replace('01','Enero')
                .replace('02','Febrero')
                .replace('03','Marzo')
                .replace('04','Abril')
                .replace('05','Mayo')
                .replace('06','Junio')
                .replace('07','Julio')
                .replace('08','Agosto')
                .replace('09','Septiembre')
                .replace('10','Octubre')
                .replace('11','Noviembre')
                .replace('12','Diciembre')"
            />
            <t t-set="total_debit" t-value="0"/>
            <t t-set="total_credit" t-value="0"/>

            <div class="header" style="padding:0px; margin:0px;">
                <style>
                    .table_header {
                        width: 100%;
                        border: 0px white solid;
                    }

                    .table_header td {
                        padding: 0px 10px;
                        font-size: 12px !important;
                    }

                    .table_header tr:nth-child(n+2) td {
                        border: 2px solid black;
                        border-radius: 1x;
                        border-bottom: none;
                    }

                    .table_header tr:last-child td{
                        border-bottom: 2px solid black;
                    }

                    .table_header tr:nth-child(n+2) td {
                        text-transform: uppercase;
                    }

                    .table_main_header thead tr th{ 
                        font-weigth: bold;
                        border-top: 1px solid black;
                        border-bottom: 1px solid black;
                    }

                    .table_main_header {
                        width: 100%;
                    }

                    .table_main_header th{
                        font-size: 10px;
                        font-weight: bold;
                        text-transform: uppercase;
                        padding: 10px 0px;
                    } 

                    .text-center {
                        text-align: center;
                    }

                    .text-start {
                        text-align: left;
                    }

                    .text-end {
                        text-align: right;
                    }

                </style>

                <div class="row" style="padding:0px; margin:0px;">
                    <div class="col-12 doc-header">
                        <table class="table table_header">
                            <tr>
                                <td style="border-top:white 1px solid;">
                                    <h1 class="text-center" style="font-size: 13px;"><strong><span t-out="res_company.name" /></strong></h1>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <h2 class="text-center" style="font-size: 14px;" t-if="doc_title == ''"><span t-out="current_month_name + time.strftime(' del %%Y')" /></h2>
                                    <h2 class="text-center" style="font-size: 14px;" t-if="not doc_title == ''">
                                        COMPROBANTE CONTABLE No. <span class="font-weight-bold" t-out="doc_title" />
                                    <span style="margin-left:45px;">FECHA: <span class="font-weight-bold" t-out="doc_date" t-options='{"widget": "date","format": "dd/MM/yyyy"}' /></span></h2> 
                                </td>
                            </tr>
                            <tr>
                                <td style="height: 60px;max-height: 60px;">
                                    <span style="position: relative; top: -10px;">
                                        <strong>Concepto:</strong> <span t-if="main_move_concept"><t t-out="(main_move_concept[:217] + '...') if len(main_move_concept) > 220 else main_move_concept"/></span>
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td style="height: 60px;max-height: 60px;">
                                    <span style="position: relative; top: -10px;">
                                        <strong>Concepto pago:</strong> <span t-if="main_move_payment_concept"><t t-out="(main_move_payment_concept[:217] + '...') if len(main_move_payment_concept) > 220 else main_move_payment_concept"/></span>
                                    </span>
                                </td>
                            </tr>
                        </table>
                        <div style="max-width: 100%;margin-top:10px;">
                            <table class="table table_main_header" name="table" t-att-style="'margin-top: 50px' if current_page > 1 else ''">
                                <thead>
                                    <tr>
                                        <th name="th_date" class="text-start" style="min-width: 8px !important;max-width: 8px !important;width: 8px !important;">fecha</th>
                                        <th name="th_account" class="text-center" style="min-width: 9px !important;max-width: 9px !important;width: 9px !important;">cuenta</th>
                                        <th name="th_ref" class="text-center" style="min-width: 10px !important;max-width: 10px !important;width: 10px !important;">ref</th>
                                        <th name="th_analytic_account" class="text-center" t-if="group_analytic_accounting" style="min-width: 8px!important;max-width: 8px!important;width: 8px!important;">dpto</th>

                                        <th name="th_account_name" class="text-center" style="min-width: 10px !important;max-width: 10px !important;width: 10px !important;">nombre</th>
                                        <th name="th_vat" class="text-center" style="min-width: 7px !important;max-width: 7px !important;width: 7px !important;">ci/rif</th>

                                        <th name="th_move_name" class="text-center" style="min-width: 8px !important;max-width: 8px !important;width: 8px !important;">documento</th>
                                        <th name="th_debit" class="text-end" style="min-width: 10px !important;max-width: 10px !important;width: 10px !important;">débitos</th>
                                        <th name="th_credit" class="text-end" style="min-width: 10px !important;max-width: 10px !important;width: 10px !important;">créditos</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>

                    </div>
                </div>

            </div>
            <t t-foreach="docs_paginated" t-as="docs_by_page">


                <div class="row" style="padding: 0px;margin: 0px;">

                    <table class="table main_table" name="table" style="position:relative;left:0px;padding: 0px;margin: 0px; max-width:100%;">
                        <tbody class="tbody">

                            <t t-foreach="docs_by_page" t-as="line">

                                <t t-set="line" t-value="line.with_context(lang=lang)" />

                                <tr>
                                    <td class="text-left" style="padding: 0px;min-width: 7px !important;max-width: 7px !important;width: 7px !important; font-size: 9px !important;border-top: 0px solid black;"><t t-out="line.move_id.date.strftime('%d/%m/%Y')"/></td>
                                    <td class="text-center" style="padding: 0px;min-width: 9px !important;max-width: 9px !important;width: 9px !important; font-size: 9px !important;border-top: 0px solid black;"><t t-out="line.account_id.code"/></td>
                                    <td class="text-center" style="padding: 0px;min-width: 10px !important;max-width: 10px !important;width: 10px !important; font-size: 9px !important;border-top: 0px solid black;"><t t-out="line.move_id.ref" t-if="line.move_id.ref != main_move_concept"/></td>
                                    <td class="text-center" style="padding: 0px;min-width: 7px !important;max-width: 7px !important;width: 7px !important; font-size: 9px !important;border-top: 0px solid black;" t-if="group_analytic_accounting">
                                        <t t-out="account_analytic_by_line_id[str(line.id)]"/>
                                    </td>

                                    <td class="text-left" style="padding: 0px;min-width: 10px !important;max-width: 10px !important;width: 10px !important; font-size: 9px !important;border-top: 0px solid black;"><t t-out="(line.account_id.name[:26] + '...') if len(line.account_id.name) > 25 else line.account_id.name"/></td>
                                    <td class="text-center" style="padding: 0px;min-width: 6px !important;max-width: 6px !important;width: 6px !important; font-size: 9px !important;border-top: 0px solid black;"><t t-out="line.move_id.vat if line.move_id.vat != 'FALSE' else line.partner_id.prefix_vat + line.partner_id.vat"/></td>
                                    
                                    <td class="text-center" style="padding: 0px;min-width: 7px !important;max-width: 7px !important;width: 7px !important; font-size: 9px !important;border-top: 0px solid black;"><t t-out="line.move_id.name + '-' + main_move.get('name', '') if line.move_id.id in payment_related_move_ids else line.move_id.name"/></td>
                                    <td style="text-align: right; padding: 0px;min-width: 10px !important;max-width: 10px !important;width: 10px !important; font-size: 9px !important;border-top: 0px solid black;"><t t-out="'{0:,.2f}'.format(float(line.debit)).replace(',', ' ').replace('.', ',').replace(' ', '.')"/></td>
                                    <td style="text-align: right; padding: 0px;min-width: 10px !important;max-width: 10px !important;width: 10px !important; font-size: 9px !important;border-top: 0px solid black;"><t t-out="'{0:,.2f}'.format(float(line.credit)).replace(',', ' ').replace('.', ',').replace(' ', '.')" /></td>
                                </tr>

                                <t t-set="total_debit" t-value="total_debit + line.debit"/>
                                <t t-set="total_credit" t-value="total_credit + line.credit"/>

                            </t>

                        </tbody>
                    </table>
                </div>

                <t t-if="current_page &lt; paginate_count">
                    <p style="page-break-before: always;" ></p>
                </t>
                <t t-set="current_page" t-value="current_page + 1"/>
            </t>

            <!-- top:-176px; -->
            <!-- style="position:absolute;" -->
            <div class="row" style="padding:0px; margin:0px;">
                <table class="table total_table" name="table">
                    <tfoot style="border-top: 1px black solid;">
                        <tr style="border-top: 0px white solid;">
                            <td style="min-width:550px;"></td>
                            <td><strong style="font-size: 11px !important;">Total</strong></td>
                            <td style="min-width: 40px;"></td>
                            <td class="total_debit" style="min-width: 40px; text-align: right; padding:0; margin:0;"><strong style="font-size: 11px !important;t"><t t-out="'{0:,.2f}'.format(float(total_debit)).replace(',', ' ').replace('.', ',').replace(' ', '.')" /></strong></td>
                            <td style="min-width: 35px;"></td>
                            <td class="total_credit" style="min-width: 40px; text-align: right; padding:0; margin:0;"><strong style="font-size: 11px !important;"><t t-out="'{0:,.2f}'.format(float(total_credit)).replace(',', ' ').replace('.', ',').replace(' ', '.')" /></strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="footer">
                <style>
                    .table-footer {
                        border: solid 1px black;
                    }

                    .table-footer tr td {
                        border-right: solid 1px black !important;
                    }

                    .table-footer td {
                        width: 25%;
                        font-size: 13px;
                        text-align: center;
                        vertical-align: top;
                    }

                    .table-footer tr:nth-child(1) td {
                        padding-top: 8px;
                    }

                    .table-footer tr:nth-child(2) td {
                        height: 35px;
                        padding-bottom: 8px;
                        vertical-align: middle;
                    }

                    .table-footer tr td:nth-child(4) {
                        border-right: none !important;
                    }
                </style>
                <div class="row">
                    <ul class="list-inline" style="position: absolute; top: 80px; right: 21px; ">
                        <li style="display: inline-block;font-size:13px;">Pag:</li>
                        <li style="display: inline-block;font-size:13px;"><span class="page"/></li>
                        <li style="display: inline-block;font-size:13px;">/</li>
                        <li style="display: inline-block;font-size:13px;"><span class="topage"/></li>
                    </ul>
                    <table class="table table-footer" style="position: relative;left:0px;width: 910px;">
                        <tbody>
                            <tr class="table-bordered">
                                <td><strong>Contabilizado por</strong></td>
                                <td><strong>Revisado por</strong></td>
                                <td><strong>Emitido por</strong></td>
                                <td><strong>Emitido el</strong></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td></td>
                                <td><span t-out="user.name"/> <br/> (<span t-out="user.prefix_vat" /><span t-out="user.vat" />)</td>
                                <td><span t-out="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %I:%M:%S%P')"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

    </template>

    <template id="account_report_call">
        <t t-call="web.basic_layout">

            <t t-if="docs">
                <t t-set="lang" t-value="docs[0].partner_id.lang"/>
                <t t-call="binaural_accountant.account_report_document" t-lang="lang"/>
            </t>

        </t>
    </template>

</data>

</odoo>
