<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="view_account_invoice_report_pivot_binaural_invoice" model="ir.ui.view">
            <field name="name">view.account.invoice.report.pivot.binaural.invoice</field>
            <field name="model">account.invoice.report</field>
            <field name="inherit_id" ref="account.view_account_invoice_report_pivot"/>
            <field name="arch" type="xml">
		        <pivot position="inside">
                    <field name="foreign_total_billed" />
                    <field name="foreign_rate" />
                </pivot>
            </field>
        </record>

        <record id="view_account_invoice_report_graph_binaural_invoice" model="ir.ui.view">
            <field name="name">view.account.invoice.report.pivot.binaural.invoice</field>
            <field name="model">account.invoice.report</field>
            <field name="inherit_id" ref="account.view_account_invoice_report_graph"/>
            <field name="arch" type="xml">
                <graph position="inside">
                    <field name="foreign_total_billed" />
                    <field name="foreign_rate" />
                </graph>
            </field>
        </record>

        <record id="view_account_invoice_report_search_binaural_invoice" model="ir.ui.view">
            <field name="name">view.account.invoice.report.pivot.binaural.invoice</field>
            <field name="model">account.invoice.report</field>
            <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
            <field name="arch" type="xml">
                <search position="inside">
                    <field name="foreign_total_billed" />
                    <field name="foreign_rate" />
                </search>
                <group position="inside">
                    <filter name="foreign_total_billed" string="Foreign Total Billed" domain="[]" context="{'group_by':'foreign_total_billed'}"/>
                    <filter name="foreign_rate" string="Foreign Rate" domain="[]" context="{'group_by':'foreign_rate'}"/>
                </group>

            </field>

        </record>
    </data>
    

</odoo>
