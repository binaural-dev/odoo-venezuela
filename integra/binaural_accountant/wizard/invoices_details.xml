<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_invoices_details_view" model="ir.ui.view">
        <field name="name">account.invoices.details.view</field>
        <field name="model">account.invoices.details</field>
        <field name="arch" type="xml">
            <form string="Sales Details">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from" widget="date"/>
                            <field name="date_to" widget="date"/>
                        </group>
                    </group>
                </sheet>
            </form>
            <footer>
                <button name="%(binaural_accountant.action_account_invoices_details_report)d" type="action" string="Print"/>
            </footer>
        </field>
    </record>

    <record id="action_account_invoices_details" model="ir.actions.act_window">
        <field name="name">Sales Details</field>
        <field name="res_model">account.invoices.details</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="account_invoices_details_view"/>
    </record>

    <menuitem action="action_account_invoices_details" id="account_report_sale_menu" parent="account.menu_finance_reports" sequence="5"/>
</odoo>
