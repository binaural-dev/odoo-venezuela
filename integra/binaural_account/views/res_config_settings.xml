<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="res_config_settings_binaural_account" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.account</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block mt-6" data-string="Binaural" string="Binaural Venezuelan location" data-key="binaural_account">
                        <h2>Binaural Venezuelan location</h2>
                        <div class="row mt16 o_settings_container" name="binaural_account_settings">
                            <div class="o_setting_right_pane">
                                <group colspan="2" col="4">
                                    <field name="currency_foreign_id" />
                                    <span>Select alternate currency</span>
                                </group>
                            </div>    
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    
    </data>
    

</odoo>
