<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_binaural_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.binaural.stock</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
        <field name="arch" type="xml">
	        <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                <h2>Configuraciones Binaural</h2>
                <div class="row mt16 o_settings_container" name="Binaural_warehouse_settings">
                    
                    <div class="col-6 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="use_main_warehouse"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="use_main_warehouse"/>
                            <div class="text-muted">
                                Establece un almacén de ventas principal.
                            </div>
                            <div class="content-group">
                                <div class="mt16" attrs="{'invisible': [('use_main_warehouse', '=', False)]}">
                                    <field name="main_warehouse_id" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
			</xpath>
        </field>
    </record>
</odoo>
