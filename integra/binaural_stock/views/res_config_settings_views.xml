<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_binaural_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.binaural.stock</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
        <field name="arch" type="xml">
	        <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                <h2>Stock Settings</h2>
                <div class="row mt16 o_settings_container" name="Binaural_warehouse_settings">
                    <div class="col-5 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="group_product_available_quantity_on_sale" class="oe_inline" required="1"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="group_product_available_quantity_on_sale" />
                            <div class="text-muted">Allows to show the available quantity (Total minus reserved) in both product template and variant of it.</div>
                        </div>
                    </div>

                    <div class="col-5 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="use_physical_location" class="oe_inline"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="use_physical_location" />
                            <div class="text-muted">By turning on this option, when carrying out an inventory movement where you check the availability of the product for sale, it will be reserved from a single negative location in case they are found in other locations..</div>
                        </div>
                    </div>

                    <div class="col-6 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="use_main_warehouse"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="use_main_warehouse"/>
                            <div class="text-muted">
                                Define a main sell's warehouse.
                            </div>
                            <div class="content-group">
                                <div class="mt16" invisible="not use_main_warehouse">
                                    <field name="main_warehouse_id" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt16 o_settings_container" >
                    <div class="col-12 col-lg-6 o_setting_box" name="Binaural_mobile_app_settings">
                        <div class="o_setting_left_pane">
                            <field name="change_weight" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="change_weight"/>
                            <div class="text-muted">
                                Allow changing weight during picking
                            </div>
                        </div>
                    </div>
                </div>
                
            </xpath>
        </field>
    </record>
</odoo>
