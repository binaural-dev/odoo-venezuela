<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_view_tree_product_catalogue" model="ir.ui.view">
        <field name="name">product.product.view.tree</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/header" position="inside">
                <button name="sale_order_line_create" string="Create Sale Order Line" type="object" class="oe_highlight"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_view_kanban_product_catalogue" model="ir.ui.view">
        <field name="name">product.product.view.kanban</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <kanban edit="0" class="o_kanban_mobile o_cart_kanban">
                <field name="id" />
                <field name="name" />
                <field name="product_template_attribute_value_ids" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_product_quantity d-flex flex-column justify-content-between" style="min-height: 100px">
                            <div class="o_dropdown_kanban dropdown" t-if="!selection_mode">
                                <a role="button" class="dropdown-toggle o-no-caret btn" data-bs-toggle="dropdown" data-bs-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v" />
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <button class="dropdown-item" name="open_product_edit" role="menuitem" type="object" groups="sales_team.group_sale_manager">Edit</button>
                                </div>
                            </div>
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('product.product', 'image_1920', record.id.raw_value)" alt="Product" class="o_image_256_contain" />
                            </div>
                            <div class="oe_kanban_details p-2 d-flex">
                                <div class="o_kanban_record_top flex-column w-100 " style="justify-content: space-between;">
                                    <div class="o_kanban_record_title">
                                        <field class="me-1" name="priority" widget="priority" />
                                        <strong>
                                            <span t-out="record.name.value" />
                                        </strong>
                                    </div>
                                    <div class="o_kanban_tags_section">
                                        <field name="product_template_attribute_value_ids" groups="product.group_product_variant" />
                                    </div>
                                    <div class="d-flex w-100 justify-content-between">
                                        <ul>
                                            <li>
                                                <strong>Price: <field name="list_price" widget="monetary" options="{'currency_field': 'currency_id'}"></field>
                                                <field name="currency_id" invisible="1"></field>
                                                </strong>
                                            </li>
                                            <strong>Quantity: <field name="quantity"/></strong>
                                        </ul>
                                    </div>
                                    <div name="_quantity" class="h-100 ml-2 d-flex align-items-center o_product_quantity o_field_widget o_quick_editable" style="z-index:1;align-items: center;">
                                        <button id="add_quantity" class="btn d-flex align-items-center justify-content-center o_qty_button btn-light text-muted" type="object" name="remove_quantity_button">
                                            <i class="fa fa-minus center" />
                                        </button>
                                        <field name="_quantity" class="o_product_quantity w-100" widget="sale_cart_product_quantity"></field>
                                        <button id="remove_quantity" class="btn d-flex align-items-center justify-content-center o_qty_button btn-light text-muted" type="object" name="add_quantity_button">
                                            <i class="fa fa-plus" />
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>