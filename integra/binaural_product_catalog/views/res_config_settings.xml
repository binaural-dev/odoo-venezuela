<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form_binaural_product_catalog" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.binaural.product.catalog</field>
      <field name="model">res.config.settings</field>
      <field name="priority" eval="100"/>
      <field name="inherit_id" ref="base.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//div[@name='operations_setting_container']" position="after">

          <h2>Catálogo de producto</h2>

          <div class="row mt16 o_settings_container" name="operations_setting_container_product_catalog">
            <div class="col-3 col-lg-3 o_setting_box">
              <div>
                <div class="mt16 row">
                  <span class="o_form_label">Productos por página</span>
                  <field name="products_by_page" class="oe_inline" />
                </div>
              </div>
            </div>

            <div class="col-3 col-lg-3 o_setting_box">
              <div>
                <div class="mt16 row">
                  <span class="o_form_label">Margen superior</span>
                  <field name="padding_top" class="oe_inline" />
                </div>
              </div>
            </div>

            <div class="col-3 col-lg-3 o_setting_box">
              <div>
                <div class="mt16 row">
                  <span class="o_form_label">Margenes laterales</span>
                  <field name="padding_sides" class="oe_inline" />
                </div>
              </div>
            </div>

            <div class="col-3 col-lg-3 o_setting_box">
              <div>
                <div class="mt16 row">
                  <span class="o_form_label">Color principal</span>
                  <field name="primary_color" class="oe_inline" />
                </div>
              </div>
            </div>

          </div>

          <div class="row mt16 o_settings_container" name="operations_setting_product_catalog_images">

            <div class="col-3 col-lg-3 o_setting_box">
              <div class="o_setting_left_pane">
                <div class="mt16 row">
                  <span class="o_form_label">Portada</span>
                  <field name="entry_page" widget="image" class="oe_inline" required="1"/>
                </div>
              </div>
            </div>

            <div class="col-3 col-lg-3 o_setting_box">
              <div class="o_setting_left_pane">
                <div class="mt16 row">
                  <span class="o_form_label">Fondo</span>
                  <field name="background" widget="image" class="oe_inline" />
                </div>
              </div>
            </div>

            <div class="col-3 col-lg-3 o_setting_box">
              <div class="o_setting_left_pane">
                <div class="mt16 row">
                  <span class="o_form_label">Contraportada</span>
                  <field name="back_over" widget="image" class="oe_inline" required="1"/>
                </div>
              </div>
            </div>

          </div>

        </xpath>
      </field>
    </record>
</odoo>