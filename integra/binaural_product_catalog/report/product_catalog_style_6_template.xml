<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <template id="style_6">
    <!-- <t t-set="data_report_margin_top" t-value="50"/>
    <t t-set="data_report_margin_bottom" t-value="0"/>
    <t t-set="data_report_margin_right" t-value="0"/>
    <t t-set="data_report_margin_left" t-value="0"/>
    <t t-set="data_report_header_spacing" t-value="0"/> -->

    <div class="page" style="padding-top: 0px; margin:0px;margin-top: -10px; border:0px;">
      <style>
        @font-face
        {
          font-family: 'Helvetica LT Std Black';
          src: url('/binaural_product_catalog/static/fonts/HelveticaLTStd_Blk.otf');
        }

        @font-face 
        {
          font-family: 'Helvetica LT Std Bold';
          src: url('/binaural_product_catalog/static/fonts/HelveticaLTStd-Bold.otf');
        }

        @font-face
        {
          font-family: 'Helvetica LT Std Light';
          src: url('/binaural_product_catalog/static/fonts/HelveticaLTStd-Light.otf');
        }

        .helvetica-light {
          font-family: 'Helvetica LT Std Light';
        }

        .helvetica-black {
          font-family: 'Helvetica LT Std Black';
        }

        .helvetica-bold {
          font-family: 'Helvetica LT Std Bold';
          font-weight: bolder;
        }

        h1 {
          color: #1D1E1C;
        }

        h2 {
          color: #1D1E1C;
        }

        img {
          max-width:100%;
        }

        .black {
          color: #1D1E1C !important;
        }

        .white {
          color: #fff !important;
        }

        .medium, p {
          color: #1D1E1C;
        }

        .custom-primary {
          color: #1D1E1C;
        }

        .custom-bg-primary {
          background: #2c3c9c;
        }

        .w100{
          width: 100% !important;
          border: none !important;
        }

        .container-report {
          width: 929px;
          height:1315px !important;
          margin: 0;
          padding: 0;

          overflow:hidden;

          display: table;

          position: relative;
          left:-15px;

        }

        .container-background {
          width: 929px;
          height:1315px !important;
          margin: 0;
          padding: 0;

          position: absolute;
          top: 0;
          right: 0;
        }

        .container-background img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        .grid-catalog {
          padding: 0px 100px;
          padding-top: 110px;
        }

        .card-catalog-container {
          width:260px;
          margin: 0;
          vertical-align: top;

          display: inline-table;

          margin-right: -20px;
          margin-bottom: 40px;

        }

        .card-catalog {
          width:220px;
          height: 320px !important;
          position: relative;

          border: 1px solid #2c3c9c;
        }

        .image-block {
          height: 180px;
          border-top: 0px;
          overflow: hidden;

          display: table;

        }

        .itemImg{
          width: 100%;
          height: 180px;
          max-height: 170px;
          overflow: hidden;
          vertical-align:middle;
          display:table-cell;
        }

        .itemImg img {
          max-height: 180px !important;
          height: 180px !important;
          object-fit: cover;

        }

        .card-catalog__body {
          padding: 0px 5px;
          padding-bottom: 8px;
        }

        .card-catalog__title {
          color: #1D1E1C;
          font-size: 14px !important;
          font-weight: bolder;
          line-height: 16px;
          margin: 0px;
          padding: 0px;
        }

        .card-catalog__strip {
          width: 100%;
          height: 20px;
          margin-top: 3px;
          padding: 0px 5px;
        }

        .card-catalog__strip--header {
          border-bottom: 0px;
        }

        .card-catalog__strip .card-catalog__title {
          vertical-align: middle;
        }

        .card-catalog__strip--footer {
          margin-bottom: 6px;
        }

        .card-catalog__container__product-name {
          max-height: 43px;
          overflow: hidden;
        }

        .first-letter--uppercase {
          text-transform: lowercase;
        }

        .first-letter--uppercase:first-letter {
          text-transform: uppercase;
        }

        .card-catalog__specifications {
          margin-top: 2px;
        }

        .card-catalog__specifications p {
          color: #1D1E1C;
          font-size: 13px !important;
          line-height: 13px;
          list-decoration: none !important;
          margin: 0px !important;
          padding: 0px;
          margin-top: 0px !important;
        }

        .card-catalog__brand-title {
          margin: 0px;
          padding: 0px;
          font-weight: bold;
          font-size:14px;

        }

        .block{
          width:100%;
        }

        .portada {
          width: 100%;
          height: 700px;
          background: #1D1E1C;
        }

      </style>

      <div style="height: 1097px; width: 100%; border: 1px solid  position: relative;">
        <div t-attf-style="margin: 0;position: relative; left:-15px;width: 930px;">
          <img 
            t-if="entry_page"
            t-att-src="image_data_uri(entry_page)"
            t-attf-style="margin: 0;position: absolute;left:0;"
            width="100%" height="1335px"
          />
        </div>
      </div>

      <p style="page-break-before: always;"></p>
      <t t-set="items_by_page" t-value="products_by_page"/>

      <t t-set="product_records" t-value="product_dict_list if product_dict_list else final_product_list"/>
      <t t-set="products_paginated" t-value="[product_records[i:i+items_by_page] for i in range(0, len(product_records), items_by_page)]"/>

      <t t-foreach="products_paginated" t-as="products_by_page">
        <div class="container-report">

          <div class="container-background">
            <img
              t-if="background"
              t-att-src="image_data_uri(background)"
              width="100%"
              height="100%"
            />

          </div>

          <div class="grid-catalog"  t-attf-style="padding: 0px {{padding_sides or 0}}px!important;padding-top: {{padding_top or 0}}px!important;">
            <t t-foreach="products_by_page" t-as="o">
              <div class="card-catalog-container">

                <div class="card-catalog" t-attf-style="border: {{border_width or 0}}px solid {{primary_color or ''}};">

                  <div class="block image-block">
                    <img
                      t-if="image"
                      class="itemImg"
                      t-att-src="'/web/image/product.product/%s/image_1920' %(o.get('id'))"
                    />
                  </div>

                  <div class="card-catalog__body">
                    <div class="block">
                      <div class="card-catalog__container__product-name">
                        <t t-set="brand_name" t-value="' - ' + o.get('brand_id').name if o.get('brand_id') else ''"/>
                        <h1 class="card-catalog__title helvetica-black first-letter--uppercase"><span t-esc="o.get('name')"/><span t-esc="brand_name" style="text-transform: uppercase;" /></h1>
                      </div>

                    </div>
                    <div class="card-catalog__strip custom-bg-primary card-catalog__strip--footer" t-attf-style="background: {{primary_color or ''}};">
                        <span class="card-catalog__title helvetica-bold white">Precio: <t t-esc="o.get('price', 0)"/></span>
                    </div>

                    <div class="card-catalog__specifications">
                      <p class="helvetica-bold" t-if="int_ref">SKU: <span t-esc="o.get('default_code')" style="text-transform: uppercase;" /></p>
                      <p class="helvetica-bold" t-if="show_sales_policy">Política ventas: <span t-esc="o.get('sales_policy') if o.get('sales_policy') else 0" /></p>
                      <p class="helvetica-bold" t-if="sh_add_uom_catalog">UOM: <span t-esc="o.get('uom_id', '')" /></p>
                      <p class="helvetica-bold" t-if="show_available_qty">Cantidad Disp.: <span t-esc="o.get('quantity', 0)" t-options="{'widget': 'float', 'precision': 0}" /></p>
                      <!-- <p class="helvetica-bold">Código de barras: <span t-field="o.barcode" /></p> -->
                      <!-- <p class="helvetica-bold">Referencia alterna: <span t-field="o.default_code_alternative"/></p>
                      <p class="helvetica-bold">Cantidad / Bulto: <span t-esc="o.qty_package if o.qty_package else 0"/></p>
                      <p class="helvetica-bold">Cantidad / Caja: <span t-esc="o.qty_box if o.qty_box else 0" /></p> -->
                    </div>
                  </div>

                </div>

              </div> 
            </t>
          </div>

        </div>
      </t>

      <p style="page-break-before: always;"></p>
      
      <div style="height: 1097px; width: 100%; border: 1px solid  position: relative;">
        <div t-attf-style="margin: 0;position: relative; left:-15px;width: 929px;">
          <img
            t-if="back_over"
            t-att-src="image_data_uri(back_over)"
            t-attf-style="margin: 0;position: absolute;left:0;"
            width="100%" height="1316px"
          />
        </div>
      </div>
    </div>
  </template>
</odoo>
