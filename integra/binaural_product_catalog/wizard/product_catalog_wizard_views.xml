<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Catalog Wizard View -->
    <record id="generate_product_catalog_wizard_view" model="ir.ui.view">
        <field name="name">binaural.generate.product.catalog.wizard.view</field>
        <field name="model">product.catalog.wizard</field>
        <field name="inherit_id" ref="sh_product_catalog_generator.generate_product_catalog_wizard_view"/>
        <field name="arch" type="xml">
            
            <xpath expr="//button[@name='print_report_xls']" position="attributes">
                <attribute name="attrs">{'invisible':['|',('catalog_type', '=', 'category'),('style','not in',['style_1'])]}</attribute>
            </xpath>

            <field name="style_box" position="attributes">
                <attribute name="attrs">{'invisible':[('style','not in',['style_2','style_5'])]}</attribute>
            </field>


            <field name="default_before_page" position="attributes">
                <attribute name="attrs">{'invisible':[('style','in',['style_6'])]}</attribute>
            </field>

            <field name="default_after_page" position="attributes">
                <attribute name="attrs">{'invisible':[('style','in',['style_6'])]}</attribute>
            </field>

            <field name="sh_print_category_name" position="attributes">
                <attribute name="attrs">{'invisible':[('style','in',['style_6'])]}</attribute>
            </field>

            <field name="product_link" position="attributes">
                <attribute name="attrs">{'invisible':[('style','in',['style_6'])]}</attribute>
            </field>

            <field name="description" position="attributes">
                <attribute name="attrs">{'invisible':[('style','in',['style_6'])]}</attribute>
            </field>

            <field name="break_page" position="attributes">
                <attribute name="attrs">{'invisible':[('style','in',['style_6', 'style_1'])]}</attribute>
            </field>

            <field name="image" position="after">
                <field name="entry_page" 
                    attrs="{ 'invisible': [('style','not in',['style_6'])] }"
                    widget="image"
                    style="width: 50px;"
                />
                <field name="back_over" 
                    attrs="{ 'invisible': [('style','not in',['style_6'])] }"
                    widget="image"
                    style="width: 50px;"
                />
                <field name="background" 
                    attrs="{ 'invisible': [('style','not in',['style_6'])] }"
                    widget="image"
                    style="width: 50px;"
                />
            </field>

            <field name="sh_add_uom_catalog" position="after">
                <field name="show_available_qty" attrs="{ 'invisible': [('style','not in',['style_6'])] }"  />
                <field name="show_sales_policy" attrs="{ 'invisible': [('style','not in',['style_6'])] }"  />
                <field name="primary_color"  attrs="{ 'invisible': [('style','not in',['style_6'])] }" />
                <field name="products_by_page"  attrs="{ 'invisible': [('style','not in',['style_6'])] }" />
                <field name="padding_top"  attrs="{ 'invisible': [('style','not in',['style_6'])] }" />
                <field name="padding_sides"  attrs="{ 'invisible': [('style','not in',['style_6'])] }" />
                <field name="border_width"  attrs="{ 'invisible': [('style','not in',['style_6'])] }" />
                <field name="order_by_name"  attrs="{ 'invisible': [('style','not in',['style_6'])] }" />
                <field name="price_without_tax"  attrs="{ 'invisible': [('style','not in',['style_6'])] }" />
            </field>
            <xpath expr="//field[@name='style']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='style']" position="after">
                <field name="style_mod" widget="radio"/>
            </xpath>
            <xpath expr="//field[@name='sh_price_decimal_places']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
