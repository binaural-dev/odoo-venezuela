<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_binaural_pos" model="ir.ui.view">
        <field name="name">res.config.settings.binaural.rate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="binaural_pos.res_config_settings_binaural_pos" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='igtf_setting']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="pos_sale_setting">
                    <div class="o_setting_left_pane">
                        <field name="pos_use_rate_from_order"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pos_use_rate_from_order"/>
                        <div class="text-muted">
                            Use Rate from Sale Order
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
