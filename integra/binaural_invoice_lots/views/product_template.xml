<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_invoice_lots_product_template" model="ir.ui.view">
        <field name="name">binaural.invoice.lots.product.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <div>
                    <field name="fixed_concept"/>
                    <label for="fixed_concept"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
