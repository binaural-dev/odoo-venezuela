<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="result_statement" model="account.report">
        <field name="name">Result Statment</field>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_year</field>
        <field name="column_ids">
            <record id="result_statement_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_financial_report_result_net_profit_result_statement" model="account.report.line">
                <field name="name">Net Profit</field>
                <field name="code">NEPRS</field>
                <field name="expression_ids">
                    <record id="account_financial_report_net_profit0_balance_result_statement" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">OPINCRS.balance + OINRS.balance - COSRS.balance - EXPRS.balance - DEPRS.balance</field>
                        <field name="date_scope">normal</field>
                    </record>
                </field>
            </record>
            <record id="account_financial_report_totalincome0_result_statement" model="account.report.line">
                <field name="name">Income</field>
                <field name="code">INCRS</field>
                <field name="expression_ids">
                    <record id="account_financial_report_totalincome0_balance_result_statement" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">OPINCRS.balance + OINRS.balance</field>
                        <field name="date_scope">normal</field>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_financial_report_gross_profit0_result_statement" model="account.report.line">
                        <field name="name">Gross Profit</field>
                        <field name="code">GRPRS</field>
                        <field name="expression_ids">
                            <record id="account_financial_report_gross_profit0_balance_result_statement" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">OPINCRS.balance - COSRS.balance</field>
                                <field name="date_scope">normal</field>
                            </record>
                        </field>
                        <field name="children_ids">
                            <record id="account_financial_report_income0_result_statement" model="account.report.line">
                                <field name="name">Operating Income</field>
                                <field name="code">OPINCRS</field>
                                <field name="groupby">account_id</field>
                                <field name="foldable" eval="True"/>
                                <field name="expression_ids">
                                    <record id="account_financial_report_income0_balance_result_statement" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">domain</field>
                                        <field name="formula" eval="[('account_id.account_type', '=', 'income')]"/>
                                        <field name="date_scope">normal</field>
                                        <field name="subformula">-sum</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_other_income0_result_statement" model="account.report.line">
                        <field name="name">Other Income</field>
                        <field name="code">OINRS</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="account_financial_report_other_income0_balance_result_statement" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'income_other')]"/>
                                <field name="date_scope">normal</field>
                                <field name="subformula">-sum</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="account_financial_report_cost_sales0_result_statement" model="account.report.line">
        	<field name="name">Cost</field>
                <field name="code">COSRS</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="account_financial_report_cost_sales0_balance_result_statement" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula" eval="[('account_id.account_type', '=', 'expense_direct_cost')]"/>
                        <field name="date_scope">normal</field>
                        <field name="subformula">sum</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
            </record>
            <record id="account_financial_report_less_expenses0_result_statement" model="account.report.line">
                <field name="name">Expenses</field>
                <field name="code">LEXRS</field>
                <field name="expression_ids">
                    <record id="account_financial_report_less_expenses0_balance_result_statement" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">EXPRS.balance + DEPRS.balance</field>
                        <field name="date_scope">normal</field>
                        <field name="green_on_positive" eval="False"/>
                    </record>
                </field>
                <field name="children_ids">
                    <record id="account_financial_report_expense0_result_statement" model="account.report.line">
                        <field name="name">Expenses</field>
                        <field name="code">EXPRS</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="account_financial_report_expense0_balance_result_statement" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense')]"/>
                                <field name="date_scope">normal</field>
                                <field name="subformula">sum</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                    <record id="account_financial_report_depreciation0_result_statement" model="account.report.line">
                        <field name="name">Depreciation</field>
                        <field name="code">DEPRS</field>
                        <field name="groupby">account_id</field>
                        <field name="foldable" eval="True"/>
                        <field name="expression_ids">
                            <record id="account_financial_report_depreciation0_balance_result_statement" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">domain</field>
                                <field name="formula" eval="[('account_id.account_type', '=', 'expense_depreciation')]"/>
                                <field name="date_scope">normal</field>
                                <field name="subformula">sum</field>
                                <field name="green_on_positive" eval="False"/>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
