<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tooltip']" position="before">
                <label for="tariff_code"/>
                <div class="o_row" name="tariff_code">
                    <field name="tariff_code" class="oe_inline"/>
                    <label for="percentage_tariff_code"/>
                    <field name="percentage_tariff_code"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
