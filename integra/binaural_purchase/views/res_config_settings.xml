<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_binaural_purchase" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.purchase</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="binaural_base.res_config_settings_view_form_binaural_base"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='binaural_setting_container']" position="inside">
		    <h2>Purchase Configuration</h2>
                    <div class="row mt16 o_settings_container" name="binaural_sale_settings">
                        <div class="o_setting_right_pane">
                            <group colspan="4" col="4">
				<field name="use_invoice_rate_from_purchase_order"/>
                            </group>
                            <div class="text-muted">
				Check this if you want the rate of the invoice to be taken from its
				purchase order. Else it will take the rate of the date when it is created.
                            </div>
                	</div>
		    </div>
                    <div class="row mt16 o_settings_container" name="binaural_sale_settings_2">
                        <div class="o_setting_right_pane">
                            <group colspan="4" col="4">
				<field name="update_purchase_order_rate_using_date_order"/>
                            </group>
                            <div class="text-muted">
				When checked, the rate of the purchase order will be updated using
				the date order whenever it changes. Else, when the rate is already
				set, it will not be updated.
                            </div>
                	</div>
		    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

