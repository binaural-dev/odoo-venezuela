<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//table[1]/thead[1]/tr[1]/th[2]" position="attributes">
            <attribute name="style">width: 20%</attribute>
        </xpath>
        <xpath expr="//table[1]/thead[1]/tr[1]/th[2]" position="after">
            <th class="text-end" style="width: 20%">Expected <t t-esc="env.pos.foreign_currency.symbol"/></th>
        </xpath>

        <xpath expr="//t[@t-if='cashControl']/tbody[1]/tr[1]/td[2]" position="after">
            <td/>
        </xpath>
        
        <xpath expr="//tbody[hasclass('cash-overview')]/tr[1]" position="inside">
            <td t-esc="env.pos.format_foreign_currency(foreignDefaultCashDetails.foreign_opening)"/>
        </xpath>

        <xpath expr="//tbody[hasclass('cash-overview')]/tr[@t-as='move']" position="after">
            <tr t-foreach="foreignDefaultCashDetails.moves" t-as="move" t-key="move_index">
                <td>
                    <div class="flex">
                        <div class="cash-sign" t-esc="move.amount &lt; 0 ? '-' : '+'"/>
                        <t t-esc="move.name"/>
                    </div>
                </td>
                <td />
                <td t-esc="env.pos.format_foreign_currency(Math.abs(move.amount))"/>
            </tr>
        </xpath>

        <xpath expr="//tbody[hasclass('cash-overview')]" position="inside">
            <tr t-if="foreignDefaultCashDetails.payment_foreign_amount">
                <td>
                    <div class="flex">
                        <div class="cash-sign" t-esc="foreignDefaultCashDetails.payment_foreign_amount &lt; 0 ? '-' : '+'"/>
                        Payments in <t t-esc="foreignDefaultCashDetails.name"/>
                    </div>
                </td>
                <td t-esc="env.pos.format_currency(Math.abs(defaultCashDetails.payment_amount))"/>
            </tr>
        </xpath>

        <xpath expr="//t[@t-if='cashControl']/tbody[1]" position="inside">
            <tr>
                <td t-esc="foreignDefaultCashDetails.name"/>
                <td />
                <td t-esc="env.pos.format_foreign_currency(foreignDefaultCashDetails.foreign_amount)"/>
                <td class="flex" t-on-input="(event) => this.handleInputChange(foreignDefaultCashDetails.id, event)">
                    <input class="pos-input" t-ref="closingForeignCashInput"/>
                    <div class="button icon" t-on-click="openForeignDetailsPopup">
                        <i class="fa fa-calculator" role="img" title="Open the money details popup"/>
                    </div>
                </td>
                <td t-esc="env.pos.format_foreign_currency(state.payments[foreignDefaultCashDetails.id].foreign_difference)" t-att-class="{'warning': state.payments[foreignDefaultCashDetails.id].foreign_difference}"/>
            </tr>
        </xpath>
        <xpath expr="//tr[@t-as='pm']" position="replace">
            <tr t-foreach="otherPaymentMethods" t-as="pm" t-key="pm.id">
                <td t-esc="pm.name"/>
                <t t-if="pm.is_foreign_currency">
                    <td/>
                    <td t-esc="env.pos.format_foreign_currency(pm.foreign_amount)"/>
                </t>
                <t t-else="">
                    <td t-esc="env.pos.format_currency(pm.amount)"/>
                    <td/>
                </t>
                <t t-set="_showDiff" t-value="_getShowDiff(pm)" />
                <td t-if="_showDiff" t-on-input="(event) => this.handleInputChange(pm.id, event)">
                    <input class="pos-input" t-ref="closingCashInput_{{pm.id}}"/>
                </td>
                <td t-if="_showDiff" t-esc="env.pos.format_currency(state.payments[pm.id].difference)" t-att-class="{'warning': state.payments[pm.id].difference}"/>
            </tr>
        </xpath>
        <xpath expr="//MoneyDetailsPopup" position="attributes">
            <attribute name="currency">state.currencyDetails</attribute>
        </xpath>
    </t>
</templates>
