                    <th>Days</th>
                    <th>Lt</th>
                    <th>Days</th>
                    <th>Lt</th>
                    <th>Days</th>
                </tr>
            </thead>
            <tbody>
                <t t-call="binaural_farming_website.tr_ancestral"/>
            </tbody>
        </table>
    </template>

