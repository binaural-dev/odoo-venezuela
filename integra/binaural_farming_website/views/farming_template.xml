<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="main_agro_template" name="Agro Base">
        <t t-call="website.layout">
            <div class="container">
                <t t-call="website.s_searchbar"></t>
                <div class="bg-primary">
                    <div class="row row-cols-1 row-cols-md-3 g-4">
                        <t t-call="binaural_farming_website.product_animal"/>
                        <t t-call="binaural_farming_website.product_animal"/>
                        <t t-call="binaural_farming_website.product_animal"/>
                        <t t-call="binaural_farming_website.product_animal"/>
                        <t t-call="binaural_farming_website.product_animal"/>
                        <t t-call="binaural_farming_website.product_animal"/>
                        <t t-call="binaural_farming_website.product_animal"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="product_animal" name="product Animal">
        <div class="col">
            <div class="card text-dark bg-light mb-3 text-center">
                <!-- <img src="..." class="card-img-top" alt="..."> -->
                <div class="card-body" >
                    <h3>GIO22002</h3>
                    <div class="card-text">
                        <div class="card_info-bloc">
                            <p><strong>VGC:</strong> 132.58</p>	
                            <p><strong>Fiabilidad:</strong> 0.59 </p>						
                        </div>
                        <br/>
                        <div class="card_info-bloc">
                            <p><strong>VG Morfología:</strong> 0.14 </p>	
                            <p><strong>Fiabilidad:</strong> 0.6 </p>						
                        </div>
                        <br/>
                        <div class="card_info-bloc">
                            <p><strong>VG Producción Vitalícia:</strong> 60.45</p>	
                            <p><strong>Fiabilidad:</strong> 0.5</p>						
                        </div>
                    </div>
                    <a class="btn btn-primary" href="/agro/1" role="button">Ver ficha</a>
                </div>
            </div>
        </div>
    </template>

    <template id="agro_animal_lot" name="Animal">
        <t t-call="website.layout">
            <div class="container">
                <br/>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="bg-primary" >
                            <h1>aaaaaaaaaaaaaaaaaaaaaaaaa</h1>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <h1 class="bg-primary">
                            <span class="badge">
                                Identificación
                            </span>
                        </h1>
                        <p><strong>Number: </strong></p>
                        <p><strong>Name: </strong></p>
                        <p>
                            <strong>Tattoo Left: </strong>
                        
                            <strong>Right: </strong>

                        </p>
                        <p><strong># Register: </strong></p>
                        <p><strong># Register Asocabra: </strong></p>
                        <p><strong>Birthdate: </strong></p>
                        <p><strong>Raza: </strong></p>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-5">
                        <h1 class="bg-primary text-center">
                            <span class="badge">
                                Breeder and owner information
                            </span>
                        </h1>
                        <p><strong>Breeder: </strong></p>
                        <p><strong>Owner: </strong></p>
                        <p><strong>Owner acronyms: </strong></p>
                    </div>
                    <div class="col-sm-7">
                        <h1 class="bg-secondary text-center">
                            <span class="badge">
                                Pedigree
                            </span>
                        </h1>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <h1 class="bg-secondary text-center">
                            <span class="badge">
                                Ancestral milk production data
                            </span>
                        </h1>
                        <t t-call="binaural_farming_website.table_ancestral"/>
                    </div>
                    <div class="col-sm-6">
                        <h1 class="bg-primary text-center">
                            <span class="badge">
                                Morphological evaluation
                            </span>
                        </h1>
                        <t t-call="binaural_farming_website.table_morpho_eval"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="table_ancestral" name="Ancestral Milk">
