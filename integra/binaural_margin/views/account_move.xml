<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_margin_account_move_form" model="ir.ui.view">
        <field name="name">binaural.margin.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="after">
                <field name="margin"/>
                <field name="margin_percent" widget="percentage"/>
		<field name="latest_standard_price_margin"/>
		<field name="latest_standard_price_margin_percent" widget="percentage"/>
            </xpath>
        </field>
    </record>

    <record id="binaural_margin_account_move_pivot" model="ir.ui.view">
        <field name="name">binaural.margin.account.move.view.pivot</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_pivot"/>
        <field name="arch" type="xml">
            <pivot position="inside">
                <field name="margin"/>
                <field name="margin_percent" widget="percentage"/>
		<field name="latest_standard_price_margin"/>
		<field name="latest_standard_price_margin_percent" widget="percentage"/>
            </pivot>
        </field>
    </record>

</odoo>
