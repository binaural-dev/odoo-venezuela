<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="binaural_margin_sale_order">
        <field name="name">binaural.purchase.order.margin.view.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_totals']" position="after">
                <label for="margin" groups="base.group_user"/>
                <div class="text-nowrap" groups="base.group_user">
                    <field name="margin" class="oe_inline"/>
                    <field name="amount_untaxed" invisible="1"/>
                    <span class="oe_inline" invisible="amount_untaxed == 0">
                        (<field name="margin_percent" nolabel="1" class="oe_inline" widget="percentage"/>)
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="binaural_margin_purchase_order_line_form">
        <field name="name">binaural.purchase.order.line.tree.margin.view.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
           <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="after">
                <field name="margin" optional="hide"/>
                <field name="margin_percent"
                    invisible="price_subtotal == 0"
                    optional="hide" widget="percentage"/>
                <field name="latest_standard_price_margin" optional="hide"/>
                <field name="latest_standard_price_margin_percent" optional="hide" widget="percentage"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="binaural_margin_purchase_order_pivot">
        <field name="name">binaural.purchase.order.margin.view.pivot</field>
        <field name="model">purchase.report</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_pivot"/>
        <field name="arch" type="xml">
            <pivot position="inside">
                <field name="margin" />
                <field name="margin_percent" widget="percentage"/>
		<field name="latest_standard_price_margin"/>
		<field name="latest_standard_price_margin_percent" widget="percentage"/>
            </pivot>
        </field>
    </record>
</odoo>
