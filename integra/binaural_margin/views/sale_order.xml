<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_margin_sale_order_inherit_binaural_margin" model="ir.ui.view">
        <field name="name">sale.order.margin.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order"/>
        <field name="arch" type="xml">

            <field name="amount_untaxed" position="replace"></field>
            <field name="margin_percent" position="replace"></field>
            <field name="margin" position="replace">
                <div class="text-nowrap" groups="base.group_user,binaural_margin.group_odoo_margin">
                    <field name="margin" class="oe_inline" groups="binaural_margin.group_odoo_margin"/>
                    <field name="amount_untaxed" invisible="1"/>
                    <span class="oe_inline" invisible="amount_untaxed == 0" groups="binaural_margin.group_odoo_margin">
                        (<field name="margin_percent" nolabel="1" class="oe_inline" widget="percentage"/>)
                    </span>
                </div>
            </field>

        </field>
    </record>

    <record id="sale_margin_sale_order_line_form_inherit_binaural" model="ir.ui.view">
        <field name="name">sale.order.margin.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_line_form"/>
        <field name="arch" type="xml">

            <field name="price_subtotal" position="replace">
                <field name="price_subtotal" invisible="1" groups="binaural_margin.group_odoo_margin"/>
            </field>
            <field name="purchase_price" position="replace">
                <field name="purchase_price" optional="hide" groups="binaural_margin.group_odoo_margin"/>
            </field>
            <field name="margin" position="replace">
                <field name="margin" optional="hide" groups="binaural_margin.group_odoo_margin"/>
            </field>
            <field name="margin_percent" position="replace">
                <field name="margin_percent"
                invisible="price_subtotal == 0"
                optional="hide" widget="percentage"
                groups="binaural_margin.group_odoo_margin"/>    
            </field>

        </field>
    </record>

    <record id="sale_margin_sale_order_line_inherit_binaural_margin" model="ir.ui.view">
        <field name="name">sale.order.margin.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_line_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='order_line']/tree//field[@name='purchase_price']" position="replace">
                <field name="purchase_price" optional="hide" groups="binaural_margin.group_odoo_margin"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='margin_percent']" position="after">
                <field name="latest_standard_price_margin" optional="hide" groups="binaural_margin.group_odoo_margin"/>
                <field name="latest_standard_price_margin_percent" optional="hide" groups="binaural_margin.group_odoo_margin"/>
            </xpath>

        </field>
    </record>

        <record id="sale_margin_sale_order_line_inherit_binaural_margin_line" model="ir.ui.view">
        <field name="name">sale.order.margin.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_line"/>
        <field name="arch" type="xml">
            
            <field name="purchase_price" position="replace">
                <field name="purchase_price" groups="binaural_margin.group_odoo_margin"/>
            </field>

        </field>
    </record>

    <record id="sale_margin_sale_order_pivot_inherit_binaural_margin" model="ir.ui.view">
        <field name="name">sale.order.margin.view.pivot.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_pivot"/>
        <field name="arch" type="xml">
            
            <field name="margin_percent" position="replace">
                <field name="margin_percent" invisible="1" groups="binaural_margin.group_odoo_margin" widget="percentage"/>
            </field>

        </field>
    </record>

     <record id="sale_margin_sale_order_pivot_inherit_binaural_margin_base" model="ir.ui.view">
        <field name="name">sale.order.margin.view.pivot.inherit.base</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot"/>
        <field name="arch" type="xml">
            <pivot position="inside">
                <field name="margin_percent" widget="percentage"/>
		<field name="latest_standard_price_margin"/>
		<field name="latest_standard_price_margin_percent" widget="percentage"/>
            </pivot>
        </field>
    </record>

    <record id="sale_margin_sale_order_graph_inherit_binaural_margin" model="ir.ui.view">
        <field name="name">sale.order.margin.view.graph.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_margin.sale_margin_sale_order_graph"/>
        <field name="arch" type="xml">

            <field name="margin_percent" position="replace">
                <field name="margin_percent" invisible="1" groups="binaural_margin.group_odoo_margin" widget="percentage"/>
            </field>
            
        </field>
    </record>

</odoo>
