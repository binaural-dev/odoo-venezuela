<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.website.sale.inherit.binaural.website.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="sale_shipping_settings" position="after">
                <h2>Binaural Website Sale Config</h2>
                <div class="row mt16 o_settings_container" >
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="do_not_show_products_without_availability_on_site" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="Do not show products without availability" for="do_not_show_products_without_availability_on_site"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="people_not_being_able_to_see_prices" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="Public user not being able to see prices" for="people_not_being_able_to_see_prices"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="people_not_being_able_to_see_available" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="people_not_being_able_to_see_available" for="people_not_being_able_to_see_available"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="budget_send" />
                        </div>
                        <div class="o_setting_right_pane">
                            <span>Send Quotation</span>
                            <div class="text-muted">
                                Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. 
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

