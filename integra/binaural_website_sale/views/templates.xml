<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cart" inherit_id="website_sale.cart">
		<xpath expr="//div[hasclass('oe_website_sale')]/div" position="before">
			<t t-if="errors">
			<h5 class="text-danger">The following products does not have enough stock:</h5>
			<ul>
				<t t-foreach="errors" t-as="error">
				<li>
					<p class="text-danger">
					<t t-out="error['product']"/> (available quantity
					<t t-out="error['qty'] + ')'"/>
					</p>
				</li>
				</t>
			</ul>
			</t>
		</xpath>
	</template>
	<template id="product" inherit_id="website_sale.product">
		<xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
			<t t-set="product_available_qty" t-value="round(product.quantity) or 0" />
			<div class="oe_item_qty_available mt-2">
				<t t-set="is_public" t-value="request.env.user._is_public()"/>
				<t t-set="public_see_qty" t-value="request.website.sudo().people_not_being_able_to_see_available"/>
				<t t-if="not is_public and public_see_qty or is_public and not public_see_qty or not is_public and not public_see_qty">
					<t t-if="product_available_qty > 0">
						<span class="available_text text-success">Disponibles: <span class="font-weight-bold"><t t-raw="product_available_qty"/></span></span>
						<br/>
					</t>
					<t t-else="">
						<span class="available_text text-danger">Disponibles: <span class="font-weight-bold"><t t-raw="product_available_qty"/></span></span>
					</t>
				</t>
            </div>
		</xpath>
	</template>
	
	<!-- Ocultar precio en vista del producto a usuarios portales -->
	<template id="product_price" name="product_price inherit" inherit_id="website_sale.product_price">

		<xpath expr="//div[1]" position="before">
			<t t-set="is_public" t-value="request.env.user._is_public()"/>
			<t t-set="public_see_price" t-value="request.website.sudo().people_not_being_able_to_see_prices"/>
			<t t-set="product_available_qty" t-value="round(product.quantity) or 0" />
		</xpath>
	
		<xpath expr="//div[1]//h3[1]/span[4]" position="replace">
			<t t-if="not is_public and public_see_price or is_public and not public_see_price or not is_public and not public_see_price">
				<span t-attf-class="text-danger oe_default_price ms-1 h5 {{'' if combination_info['has_discounted_price'] and not combination_info['compare_list_price'] else 'd-none'}}"
				style="text-decoration: line-through; white-space: nowrap;"
				t-esc="combination_info['list_price']"
				t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
				itemprop="listPrice"
				/>
			</t>
			<t t-else="">
				<span></span>
			</t>	
		</xpath>

		<xpath expr="//div[1]//h3[1]/span[1]" position="replace">
			<t t-if="not is_public and public_see_price or is_public and not public_see_price or not is_public and not public_see_price">
				<span class="oe_price text-primary" style="white-space: nowrap;" t-esc="combination_info['price']" 
					t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>					
			</t>
			<t t-else="">
				<span class='oe_price'></span>
			</t>
		</xpath>

		<xpath expr="//div[1]//h3[1]//del[1]//span[1]" position="replace">
			<t t-if="not is_public and public_see_price or is_public and not public_see_price or not is_public and not public_see_price">
				<span t-esc="combination_info['compare_list_price']"
					groups="website_sale.group_product_price_comparison"
					t-options='{"widget": "monetary", "display_currency": website.currency_id,}'/>
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>

		<xpath expr="//div[1]//h3[2]/span[1]" position="replace">
			<t t-if="not is_public and public_see_price or is_public and not public_see_price or not is_public and not public_see_price">
				<span t-field="product.list_price"
					t-options='{"widget": "monetary","display_currency": product.currency_id,}'/>
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>

		<xpath expr="//div[1]//h3[2]//del[1]//span[1]" position="replace">
			<t t-if="not is_public and public_see_price or is_public and not public_see_price or not is_public and not public_see_price">
				<span t-field="product.compare_list_price"
					groups="website_sale.group_product_price_comparison"
					t-options='{"widget": "monetary","display_currency": website.currency_id,}'/>
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>
		
	</template>

	<template id="product_default_code_inherit" inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_details'][1]/span[1]" position="after">
			<t t-if="product.default_code">
            	SKU: <span t-esc="product.default_code" style="text-transform: uppercase;" />
            </t>
        </xpath>
    </template>

	<!-- Cantidad Maxima en vista de carrito -->
	<template id="limit_number_product_cart_lines_binaural_website_sale" inherit_id="website_sale.cart_lines">
        <xpath expr="//t[1]/input[@class='js_quantity form-control quantity'][1]" position="replace">
            
            <t t-set="line_product_available_qty" t-value="round(line.product_id.quantity) or 0" />
            <input type="text" class="js_quantity form-control quantity" t-att-data-line-id="line.id" 
			t-att-data-max="line_product_available_qty" t-att-data-product-id="line.product_id.id" 
			t-att-value="int(line.product_uom_qty) == line.product_uom_qty and int(line.product_uom_qty) or line.product_uom_qty" />

        </xpath>
    </template>

	<!-- Esta seccion de products es la pagina principal de /shop, Sirve para agregar parametros y condicionar products_items -->
	<template id="products_binaural_website_sale" inherit_id="website_sale.products">
		<xpath expr="//div[1]" position="before">
			<t t-set="is_public" t-value="request.env.user._is_public()"/>
			<t t-set="public_see_price" t-value="request.website.sudo().people_not_being_able_to_see_prices"/>
		</xpath>
	</template>

	<!-- Esta vista aplica a Tipo Grid y List, condiciona el mostrar los precios a los usuarios publicos -->
	<template id="products_item_hide_price_binaural_website_sale" inherit_id="website_sale.products_item">

		<xpath expr="//div[1]" position="before">
			<t t-set="combination_info" t-value="product._get_combination_info(only_template=True, add_qty=add_qty or 1, pricelist=pricelist)"/>
		</xpath>

		<xpath expr="//div[@class='product_price']/span[3]" position="replace">
			<t t-if="not is_public and public_see_price or is_public and not public_see_price or not is_public and not public_see_price">
				<span itemprop="priceCurrency" style="display:none;" t-esc="website.currency_id.name" />
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>

		<xpath expr="//div[@class='product_price']/span[2]" position="replace">
			<t t-if="not is_public and public_see_price or is_public and not public_see_price or not is_public and not public_see_price">
				<span itemprop="price" style="display:none;" t-esc="combination_info['price']" />
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>
		
		<xpath expr="//div[@class='product_price']/span[1]" position="replace">
			<t t-if="not is_public and public_see_price or is_public and not public_see_price or not is_public and not public_see_price">
				<span t-if="combination_info['price']" t-esc="combination_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>
	
	</template>

	<template id="total" name="Total foreign" inherit_id="website_sale.total">
		<xpath expr="//tr[@id='order_total'][1]" position="after">
			<t t-if="website_sale_order.foreign_rate">
				<tr id="foreign_order_total">
					<td class="text-end border-top border-bottom-0"><strong>Total Foreign: </strong></td>
					<td class="text-xl-end border-top border-bottom-0">
						<strong t-field="website_sale_order.foreign_total_billed" class="monetary_field"/>
					</td>
				</tr>
				<tr id="foreign_rate">
					<td class="text-end border-top border-bottom-0">Rate: </td>
					<td class="text-xl-end border-top border-bottom-0">
						<strong t-out="website_sale_order.foreign_rate" class="monetary_field"
							t-options='{"widget": "monetary", "display_currency": website_sale_order.foreign_currency_id}'/>
					</td>
				</tr>
			</t>
		</xpath>
	</template>

</odoo> 
