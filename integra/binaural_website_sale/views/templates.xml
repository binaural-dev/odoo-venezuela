<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cart" inherit_id="website_sale.cart">
		<xpath expr="//div[hasclass('oe_website_sale')]/div" position="before">
			<t t-if="errors">
			<h5 class="text-danger">The following products does not have enough stock:</h5>
			<ul>
				<t t-foreach="errors" t-as="error">
				<li>
					<p class="text-danger">
					<t t-out="error['product']"/> (available quantity
					<t t-out="error['qty'] + ')'"/>
					</p>
				</li>
				</t>
			</ul>
			</t>
		</xpath>
	</template>
	<template id="product" inherit_id="website_sale.product">
		<xpath expr="//div[@id='o_wsale_cta_wrapper']" position="after">
			<t t-set="product_available_qty" t-value="round(product.quantity) or 0" />
			<div class="oe_item_qty_available mt-2">
				<t t-if="not request.env.user._is_public()">
					<t t-if="product_available_qty > 0">
						<span class="available_text text-success">Disponibles: <span class="font-weight-bold"><t t-raw="product_available_qty"/></span></span>
						<br/>
					</t>
					<t t-else="">
						<span class="available_text text-danger">Disponibles: <span class="font-weight-bold"><t t-raw="product_available_qty"/></span></span>
					</t>
				</t>
            </div>
		</xpath>
	</template>
	
	<!-- Ocultar precio en vista del producto a usuarios portales -->
	<template id="product_price" name="product_price inherit" inherit_id="website_sale.product_price">

		<xpath expr="//div[1]" position="before">
			<t t-set="is_public" t-value="request.env.user._is_public()"/>
			<t t-set="product_available_qty" t-value="round(product.quantity) or 0" />
		</xpath>
	
		<xpath expr="//div[1]//h3[1]/span[4]" position="replace">
			<t t-if="not is_public">
				<span t-attf-class="text-danger oe_default_price ms-1 h5 {{'' if combination_info['has_discounted_price'] and not combination_info['compare_list_price'] else 'd-none'}}"
				style="text-decoration: line-through; white-space: nowrap;"
				t-esc="combination_info['list_price']"
				t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"
				itemprop="listPrice"
				/>
			</t>
			<t t-else="">
				<span></span>
			</t>	
		</xpath>

		<xpath expr="//div[1]//h3[1]/span[1]" position="replace">
			<t t-if="not is_public">
				<span class="oe_price text-primary" style="white-space: nowrap;" t-esc="combination_info['price']" 
					t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>					
			</t>
			<t t-else="">
				<span class='oe_price'></span>
			</t>
		</xpath>

		<xpath expr="//div[1]//h3[1]//del[1]//span[1]" position="replace">
			<t t-if="not is_public">
				<span t-esc="combination_info['compare_list_price']"
					groups="website_sale.group_product_price_comparison"
					t-options='{"widget": "monetary", "display_currency": website.currency_id,}'/>
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>

		<xpath expr="//div[1]//h3[2]/span[1]" position="replace">
			<t t-if="not is_public">
				<span t-field="product.list_price"
					t-options='{"widget": "monetary","display_currency": product.currency_id,}'/>
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>

		<xpath expr="//div[1]//h3[2]//del[1]//span[1]" position="replace">
			<t t-if="not is_public">
				<span t-field="product.compare_list_price"
					groups="website_sale.group_product_price_comparison"
					t-options='{"widget": "monetary","display_currency": website.currency_id,}'/>
			</t>
			<t t-else="">
				<span/>
			</t>
		</xpath>
		
	</template>

	<template id="product_default_code_inherit" inherit_id="website_sale.product">
        <xpath expr="//div[@id='product_details'][1]/span[1]" position="after">
			<t t-if="product.default_code">
            	SKU: <span t-esc="product.default_code" style="text-transform: uppercase;" />
            </t>
        </xpath>
    </template>
</odoo> 
