<odoo>
	
    <record id="view_report_pos_order_search" model="ir.ui.view">
        <field name="name">report.pos.order.binaural.subsidary.search</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_search"/>
        <field name="arch" type="xml">
	    <field name="product_categ_id" position="after">
		<field name="subsidiary_id"/>
	    </field>

	    <group position="inside">
		<filter string="Subsidiary" name="subsidiary" context="{'group_by':'subsidiary_id'}"/>
	    </group>
	</field>
    </record>

    <record id="view_report_pos_order_graph" model="ir.ui.view">
        <field name="name">report.pos.order.binaural.subsidary.graph</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_graph"/>
        <field name="arch" type="xml">
	    <field name="product_categ_id" position="after">
		<field name="subsidiary_id"/>
	    </field>
	</field>
    </record>

    <record id="view_report_pos_order_pivot" model="ir.ui.view">
        <field name="name">report.pos.order.binaural.subsidary.pivot</field>
        <field name="model">report.pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_report_pos_order_pivot"/>
        <field name="arch" type="xml">
	    <field name="product_categ_id" position="before">
		<field name="subsidiary_id" type="row"/>
	    </field>
	</field>
    </record>

</odoo>
