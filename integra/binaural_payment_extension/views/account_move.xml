<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="account_move_form_binaural_payment_extension" model="ir.ui.view">
            <field name="name">account.move.form.binaural.payment.extension</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="after">
                    <group name="islr_group">
                        <field name="generate_iva_retention" />
                        <field name="iva_voucher_number" readonly="1" />
                        <field name="islr_voucher_number" readonly="1" />         
                    </group>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page name="iva_retention" string="IVA Retentions">
                        <field name="retention_iva_line_ids" nolabel="1" readonly="1">
                            <tree editable='bottom'>
                                <field name="is_retention_client" invisible="1" />
                                <field name="name"/>
                                <field name="invoice_total" attrs="{'invisible':[('is_retention_client','=', False)]}" widget="monetary" options="{'currency_field': 'company_currency_id'}" />
                                <field name="invoice_amount" attrs="{'invisible':[('is_retention_client','=', False)]}" widget="monetary" options="{'currency_field': 'company_currency_id'}" />
                                <field name="iva_amount" force_save="1" attrs="{'invisible':[('is_retention_client','=', False)]}" widget="monetary" options="{'currency_field': 'company_currency_id'}" />
                            </tree>
                        </field>     
                    </page>
                    <page name="islr_retention" string="ISLR Retentions">
                        <field name="retention_islr_line_ids" nolabel="1">
                            <tree editable='bottom'>
                                <field name="is_retention_client" invisible="1" />
                                <field name="name"/>
                                <field name="payment_concept_id"/>
                                <field name="invoice_total" attrs="{'invisible':[('is_retention_client','=', False)]}" widget="monetary" options="{'currency_field': 'company_currency_id'}" />
                                <field name="invoice_amount" attrs="{'invisible':[('is_retention_client','=', False)]}" widget="monetary" options="{'currency_field': 'company_currency_id'}" />
                                <field name="iva_amount" force_save="1" attrs="{'invisible':[('is_retention_client','=', False)]}" widget="monetary" options="{'currency_field': 'company_currency_id'}" />
                                <field name="related_pay_from" />
                                <field name="related_percentage_tax_base" />
                                <field name="related_percentage_fees" />
                                <field name="related_amount_subtract_fees" />
                                <field name="retention_amount" />
                                <field name="foreign_currency_rate" />
                                <field name="foreign_invoice_total" />
                                <field name="foreign_invoice_amount" />
                                <field name="foreign_retention_amount" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
    

</odoo>
