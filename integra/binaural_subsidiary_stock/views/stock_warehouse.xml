<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_wareohouse" model="ir.ui.view">
        <field name="name">view.stock.warehouse.binaural.subsidiary.stock</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="company_subsidiary" invisible='1'/>   
                <field name="subsidiary_id" attrs="{'invisible': [('company_subsidiary', '=', False)]}"/>
                <field name="inventory_account_id" attrs="{'invisible': [('company_subsidiary', '=', False)]}"/>
            </field>
        </field>
    </record>

</odoo>
