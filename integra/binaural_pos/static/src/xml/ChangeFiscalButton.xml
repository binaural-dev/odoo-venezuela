<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ChangeFiscalButton" owl="1">
        <div class="control-button button js_invoice"
            t-att-class="{ highlight: !currentOrder.is_to_receipt()}"
            >
            <i class="fa fa-file-text-o" /> 
            <t t-if="currentOrder.is_to_receipt()">
                Receipt
            </t>
            <t t-else="">
                Invoice
            </t>
            
        </div>
    </t>

</templates>
