<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="groups_id" eval="[(4,ref('binaural_fiscal_inspector.group_fiscal_inspectorate'))]"/>
    </record>

    <menuitem id="account_accountant.menu_accounting"
    groups="account.group_account_readonly,account.group_account_invoice,binaural_fiscal_inspector.group_fiscal_inspectorate"/>

    <record id="account.menu_finance_entries" model="ir.ui.menu">
        <field name="groups_id" eval="[(4,ref('binaural_fiscal_inspector.group_fiscal_inspectorate'))]"/>
    </record>

    <record id="account.menu_action_move_journal_line_form" model="ir.ui.menu">
        <field name="groups_id" eval="[(4,ref('binaural_fiscal_inspector.group_fiscal_inspectorate'))]"/>
    </record>

    <record id="account.menu_action_account_moves_all" model="ir.ui.menu">
        <field name="groups_id" eval="[(4,ref('binaural_fiscal_inspector.group_fiscal_inspectorate'))]"/>
    </record>

    <menuitem id="menu_fiscal_reports" name="Account Reports" 
    parent="account_accountant.menu_accounting" groups="binaural_fiscal_inspector.group_fiscal_inspectorate">
        <menuitem id="statement_report_fiscal_menu" name="Statement Reports" 
        groups="binaural_fiscal_inspector.group_fiscal_inspectorate" sequence="1">
            <menuitem id="menu_action_account_report_balance_sheet_fiscal" name="Balance Sheet" 
            action="account_reports.action_account_report_bs" groups="binaural_fiscal_inspector.group_fiscal_inspectorate"/>
            <menuitem id="menu_action_account_report_result_statement_fiscal" name="Result Statement"
            action="binaural_account_reports.action_account_report_rs" groups="binaural_fiscal_inspector.group_fiscal_inspectorate"/>
            <menuitem id="menu_action_account_report_financial_situation_statement_fiscal" name="Financial situation statement"
            action="binaural_account_reports.action_account_report_fs" groups="binaural_fiscal_inspector.group_fiscal_inspectorate"/>
        </menuitem>
        <menuitem id="partner_report_fiscal_menu" name="Partner Reports" 
        groups="binaural_fiscal_inspector.group_fiscal_inspectorate" sequence="2">
            <menuitem id="menu_action_account_report_partner_ledger_fiscal" name="Partner Ledger" 
            action="account_reports.action_account_report_partner_ledger" groups="binaural_fiscal_inspector.group_fiscal_inspectorate"/>   
            <menuitem id="menu_action_account_report_aged_receivable_fiscal" name="Aged Receivable" 
            action="account_reports.action_account_report_ar" groups="binaural_fiscal_inspector.group_fiscal_inspectorate"/>
            <menuitem id="menu_action_account_report_aged_payable_fiscal" name="Aged Payable" 
            action="account_reports.action_account_report_ap" groups="binaural_fiscal_inspector.group_fiscal_inspectorate"/>
        </menuitem>
        <menuitem id="audit_report_fiscal_menu" name="Audit Reports" 
        groups="binaural_fiscal_inspector.group_fiscal_inspectorate" sequence="3">
            <menuitem id="menu_action_account_report_general_ledger_fiscal" name="General Ledger" 
            action="account_reports.action_account_report_general_ledger" groups="binaural_fiscal_inspector.group_fiscal_inspectorate"/>    
            <menuitem id="menu_action_account_report_coa_fiscal" name="Trial Balance" 
            action="account_reports.action_account_report_coa" groups="binaural_fiscal_inspector.group_fiscal_inspectorate"/>
        </menuitem>        
    </menuitem>

</odoo>
