<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_retention_islr_form_binaural_fiscal_inspector" model="ir.ui.view">
        <field name="name">Retention.ISLR.binaural.fiscal.inspector.view.form.inherit</field>
        <field name="model">account.retention</field>
        <field name="inherit_id" ref="binaural_payment_extension.view_retention_islr_form_binaural_payment_extension"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel'][1]" position="attributes">
                <attribute name="groups">!binaural_fiscal_inspector.group_fiscal_inspectorate</attribute>
            </xpath>
            <xpath expr="//button[@name='action_draft'][1]" position="attributes">
                <attribute name="groups">!binaural_fiscal_inspector.group_fiscal_inspectorate</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][1]" position="attributes">
                <attribute name="groups">!binaural_fiscal_inspector.group_fiscal_inspectorate</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_retention_iva_form_binaural_fiscal_inspector" model="ir.ui.view">
        <field name="name">Retention.iva.binaural.fiscal.inspector.view.form.inherit</field>
        <field name="model">account.retention</field>
        <field name="inherit_id" ref="binaural_payment_extension.view_retention_iva_form_binaural_payment_extension"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel'][1]" position="attributes">
                <attribute name="groups">!binaural_fiscal_inspector.group_fiscal_inspectorate</attribute>
            </xpath>
            <xpath expr="//button[@name='action_draft'][1]" position="attributes">
                <attribute name="groups">!binaural_fiscal_inspector.group_fiscal_inspectorate</attribute>
            </xpath>
            <xpath expr="//button[@name='action_post'][1]" position="attributes">
                <attribute name="groups">!binaural_fiscal_inspector.group_fiscal_inspectorate</attribute>
            </xpath>
        </field>
    </record>

</odoo>
