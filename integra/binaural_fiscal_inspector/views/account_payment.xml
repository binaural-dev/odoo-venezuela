<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_inherit_binaural_fiscal_inspector" model="ir.ui.view">
        <field name="name">account.payment.binaural.fiscal.inspector.view.form.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_draft'][1]" position="attributes">
                <attribute name="groups" separator="," 
                add="binaural_fiscal_inspector.group_fiscal_inspectorate_editable"/>
            </xpath>
        </field>
    </record>

</odoo>
