<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_binaural_fiscal_inspector" model="ir.ui.view">
        <field name="name">account.move.binaural.fiscal.inspector.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//button[@name='action_post'][1]" position="attributes">
                <attribute name="groups" separator="," 
                add="binaural_fiscal_inspector.group_fiscal_inspectorate_editable"/>
            </xpath>

            <xpath expr="//button[@name='action_post'][2]" position="attributes">
                <attribute name="groups" separator="," 
                add="binaural_fiscal_inspector.group_fiscal_inspectorate_editable"/>
            </xpath>

            <xpath expr="//button[@name='button_cancel'][1]" position="attributes">
                <attribute name="groups" separator="," 
                add="binaural_fiscal_inspector.group_fiscal_inspectorate_editable"/>
            </xpath>

            <xpath expr="//button[@name='button_cancel'][2]" position="attributes">
                <attribute name="groups" separator="," 
                add="binaural_fiscal_inspector.group_fiscal_inspectorate_editable"/>
            </xpath>

            <xpath expr="//button[@name='button_draft'][1]" position="attributes">
                <attribute name="groups" separator="," 
                add="binaural_fiscal_inspector.group_fiscal_inspectorate_editable"/>
            </xpath>

            <xpath expr="//button[@name='action_register_payment'][1]" position="attributes">
                <attribute name="groups" separator="," 
                add="binaural_fiscal_inspector.group_fiscal_inspectorate_editable"/>
            </xpath>

            <xpath expr="//page[@id='aml_tab'][1]" position="attributes">
                <attribute name="groups" separator="," 
                add="binaural_fiscal_inspector.group_fiscal_inspectorate_editable,
                binaural_fiscal_inspector.group_fiscal_inspectorate"/>
            </xpath>

        </field>
    </record>

    <record id="account_invoice_form_inherit_binaural_fiscal_sale" model="ir.ui.view">
        <field name="name">account.move.binaural.fiscal.inspector.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="sale.account_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_source_sale_orders']" position="attributes">
                <attribute name="groups">!binaural_fiscal_inspector.group_fiscal_inspectorate_editable,!binaural_fiscal_inspector.group_fiscal_inspectorate</attribute>
            </xpath>
        </field>
    </record>

</odoo>
