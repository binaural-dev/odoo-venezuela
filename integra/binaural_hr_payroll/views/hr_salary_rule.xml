<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_form" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.view.binaural.hr.payroll</field>
        <field name="model">hr.salary.rule</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
	    <field name="amount_percentage_base" position="after">
		<field name="foreign_amount_percentage_base" attrs="{'invisible':[('amount_select','!=','percentage')], 'required': [('amount_select','=','percentage')]}"/>
	    </field>

	    <field name="amount_fix" position="after">
		    <field name="foreign_amount_fix" attrs="{'invisible':[('amount_select','!=','fix')], 'required':[('amount_select','=','fix')]}"/>
	    </field>
        </field>
    </record>
</odoo>

