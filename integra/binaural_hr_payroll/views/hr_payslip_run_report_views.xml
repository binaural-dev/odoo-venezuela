<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="hr_pre_payslip_run_report" model="ir.actions.report">
      <field name="name">Pre-payslip run report</field>
      <field name="model">hr.payslip.run</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">binaural_hr_payroll.report_pre_payslip_run</field>
      <field name="report_file">binaural_hr_payroll.report_pre_payslip_run</field>
      <field name="print_report_name">
        'Reporte Pre-nómina General %s - %s' % (
          object.date_start.strftime('%m/%d/%Y'), object.date_end.strftime('%m/%d/%Y')
        )
      </field>
      <field name="binding_model_id" ref="hr_payroll.model_hr_payslip_run"/>
      <field name="binding_type">report</field>
    </record>
  </data>
</odoo>
