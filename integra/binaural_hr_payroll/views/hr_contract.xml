<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_contract_form" model="ir.ui.view">
            <field name="name">hr.contract.form.binaural.hr.payroll</field>
            <field name="model">hr.contract</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="hr_payroll.hr_contract_form_inherit"/>
            <field name="arch" type="xml">
		<div name="wage" position="before">
		    <field name="foreign_currency_id" invisible="1"/>
		    <field name="wage_field_to_use" invisible="1"/>
		</div>
		<field name="structure_type_id" position="after">
		    <field name="salary_type"/>
		</field>
		<label for="wage" position="attributes">
                    <attribute name="attrs">{'invisible': [('wage_field_to_use', '!=', 'wage')]}</attribute>
	    	</label>
		<div name="wage" position="attributes">
                    <attribute name="attrs">{'invisible': [('wage_field_to_use', '!=', 'wage')]}</attribute>
		</div>
		<label for="hourly_wage" position="attributes">
                    <attribute name="attrs">{'invisible': [('wage_field_to_use', '!=', 'hourly_wage')]}</attribute>
	    	</label>
		<div name="hourly_wage" position="attributes">
                    <attribute name="attrs">{'invisible': [('wage_field_to_use', '!=', 'hourly_wage')]}</attribute>
		</div>
		<div name="wage" position="after">
                    <label for="foreign_hourly_wage" attrs="{'invisible': [('wage_field_to_use', '!=', 'foreign_hourly_wage')]}"/>
                    <div class="o_row mw-50" name="foreign_hourly_wage" attrs="{'invisible': [('wage_field_to_use', '!=', 'foreign_hourly_wage')]}">
                    	<field name="foreign_hourly_wage" nolabel="1"/>
                    	<span>/ hour</span>
                    </div>
                    <label for="foreign_wage" attrs="{'invisible': [('wage_field_to_use', '!=', 'foreign_wage')]}"/>
                    <div class="o_row mw-50" name="foreign_wage" attrs="{'invisible': [('wage_field_to_use', '!=', 'foreign_wage')]}">
                    	<field name="foreign_wage" nolabel="1"/>
                    	<span>/ month</span>
                    </div>
		</div>
            </field>
        </record>
    </data>
</odoo>
