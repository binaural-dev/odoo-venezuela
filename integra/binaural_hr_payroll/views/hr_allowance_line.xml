<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>

		<record id="binaural_paysheet_hr_allowance_line_action_list" model="ir.actions.act_window">
			<field name="name">Allowances Update</field>
			<field name="res_model">hr.allowance.line</field>
			<field name="view_mode">tree,form,search</field>
		</record>


		<record model="ir.ui.view" id="binaural_paysheet_hr_allowance_line_view_list">
			<field name="name">binarual.paysheet.hr.allowance.line.tree</field>
			<field name="model">hr.allowance.line</field>
			<field name="priority" eval="16"/>
				<field name="arch" type="xml">
					<tree string="Allowances Update List">
						<field name="employee_id" />
						<field name="code" />
						<field name="allowance_id" />
						<field name="value" />
						<field name="description" />
					</tree>
				</field>
		</record>

		<record model="ir.ui.view" id="binaural_paysheet_hr_allowance_line_view_form">
			<field name="name">binarual.paysheet.hr.allowance.line.form</field>
			<field name="model">hr.allowance.line</field>
			<field name="priority" eval="16"/>
				<field name="arch" type="xml">
					<tree string="Allowances Update List">
						<field name="employee_id" readonly="1"/>
						<field name="employee_vat"/>
						<field name="code"/>
						<field name="allowance_id" readonly="1"/>
						<field name="value"/>
						<field name="description"/>
					</tree>
				</field>
		</record>

		<record id="binaural_paysheet_hr_allowance_line_searcher" model="ir.ui.view">
      <field name="name">binarual.paysheet.hr.allowance.line.searcher</field>
      <field name="model">hr.allowance.line</field>
      <field name="arch" type="xml">
				<search>
					<field name="employee_id" />
					<field name="employee_vat" />
					<field name="code" />
				</search>
			</field>
  	</record>

		<record id="hr_payslip_allowance_line_tree" model="ir.ui.view">
				<field name="name">hr.payslip.line.tree</field>
				<field name="model">hr.payslip.line</field>
				<field name="arch" type="xml">
			<tree string="Salary Allowance Report" editable="bottom" create="false" edit="false" delete="false">
					<field name="employee_id"/>
					<field name="employee_vat"/>
					<field name="employee_department_id"/>
					<field name="name"/>
					<field name="employee_job_id"/>
					<field name="category_id"/>
					<field name="date_from"/>
					<field name="date_to"/>
					<field name="total"/>
			</tree>
				</field>
				</record>

		<record id="hr_payslip_allowance_line_search" model="ir.ui.view">
			<field name="name">hr.payslip.line.search</field>
			<field name="model">hr.payslip.line</field>
			<field name="arch" type="xml">
				<search>
					<field name="employee_name"/>
					<field name="employee_vat"/>
					<field name="employee_department_id"/>
					<field name="name"/>
					<field name="employee_job_id"/>
					<group expand="1" string="Group By">
						<filter name="employe_id" context="{'group_by':'employee_id'}"/>
					</group>
				</search>
			</field>
		</record>

		<record id="hr_payslip_allowance_line_action" model="ir.actions.act_window">
				<field name="name">Salary Allowances</field>
				<field name="res_model">hr.payslip.line</field>
				<field name="domain">[('category_code','=', 'COMPS'), ('slip_state', '=', 'done')]</field>
				<field name="context">{'search_default_employee_id': 1}</field>
				<field name="view_mode">tree,search</field>
				<field name="view_id" ref="hr_payslip_allowance_line_tree"/>
				<field name="search_view_id" ref="hr_payslip_allowance_line_search"/>
		</record>

	</data>
</odoo>
