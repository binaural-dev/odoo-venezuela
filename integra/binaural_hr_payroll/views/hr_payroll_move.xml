<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

	<record id="hr_payroll_move_view_search" model="ir.ui.view">
	    <field name="name">hr.payroll.move.view.search</field>
	    <field name="model">hr.payroll.move</field>
	    <field name="arch" type="xml">
		<search string="Payslip Payments">
		    <field name="employee_id" string="Employee"
			   filter_domain="['|',('employee_name', 'ilike', self),
			    		       ('employee_vat', 'ilike', self)]"/>
		    <field name="employee_vat"/>
		    <field name="department_id"/>
		    <field name="employee_job_id"/>
		    <field name="move_type"/>
		    <field name="date"/>
		    <separator/>
		    <group>
			<filter name="group_employee" string="Employee"
				domain="[]" context="{'group_by': 'employee_id'}"/>
			<filter name="group_department_id" string="Department"
				domain="[]" context="{'group_by': 'department_id'}"/>
			<filter name="group_move_type" string="Type"
				domain="[]" context="{'group_by': 'move_type'}"/>
			<filter name="group_date" string="Date"
				domain="[]" context="{'group_by': 'date'}"/>
		    </group>
		</search>
	    </field>
	</record>

	<record id="hr_payroll_move_salary_view_tree" model="ir.ui.view">
	    <field name="name">hr.payroll.move.salary.view.tree</field>
	    <field name="model">hr.payroll.move</field>
	    <field name="arch" type="xml">
		<tree string="Salary Payments" editable="bottom">
		    <field name="company_id" invisible="1"/>
		    <field name="date" optional="show"/>
		    <field name="slip_id" optional="hide"/>
		    <field name="employee_id" optional="show"/>
		    <field name="employee_vat" optional="show"/>
		    <field name="department_id" optional="show"/>
		    <field name="employee_job_id" optional="show"/>
		    <field name="total_basic" optional="show"/>
		    <field name="total_accrued" optional="show"/>
		    <field name="total_deduction" optional="show"/>
		    <field name="total_net" optional="show"/>
		    <field name="foreign_total_basic" optional="hide"/>
		    <field name="foreign_total_accrued" optional="hide"/>
		    <field name="foreign_total_deduction" optional="hide"/>
		    <field name="foreign_total_net" optional="hide"/>
		</tree>
	    </field>
	</record>

	<record id="hr_payroll_move_vacation_view_tree" model="ir.ui.view">
	    <field name="name">hr.payroll.move.vacation.view.tree</field>
	    <field name="model">hr.payroll.move</field>
	    <field name="arch" type="xml">
		<tree string="Vacation Payments" editable="bottom">
		    <field name="company_id" invisible="1"/>
		    <field name="date" optional="show"/>
		    <field name="date_from_vacation" optional="hide"/>
		    <field name="date_to_vacation" optional="hide"/>
		    <field name="vacational_period" optional="show"/>
		    <field name="slip_id" optional="hide"/>
		    <field name="employee_id" optional="show"/>
		    <field name="employee_vat" optional="show"/>
		    <field name="department_id" optional="show"/>
		    <field name="employee_job_id" optional="show"/>

		    <field name="total_basic" optional="show"/>
		    <field name="vacation_days" optional="show"/>
		    <field name="vacation_bonus_days" optional="show"/>
		    <field name="consumed_vacation_days" optional="show"/>
		    <field name="total_vacation" optional="show"/>
		    <field name="total_vacation_bonus" optional="show"/>
		    <field name="total_net" optional="show"/>

		    <field name="foreign_total_basic" optional="hide"/>
		    <field name="foreign_total_vacation" optional="hide"/>
		    <field name="foreign_total_vacation_bonus" optional="hide"/>
		    <field name="foreign_total_net" optional="hide"/>
		</tree>
	    </field>
	</record>

	<record id="hr_payroll_move_advance_view_tree" model="ir.ui.view">
	    <field name="name">hr.payroll.move.advance.view.tree</field>
	    <field name="model">hr.payroll.move</field>
	    <field name="arch" type="xml">
		<tree string="Advance Payments" editable="bottom">
		    <field name="company_id" invisible="1"/>
		    <field name="date" optional="show"/>
		    <field name="slip_id" optional="hide"/>
		    <field name="employee_id" optional="show"/>
		    <field name="employee_vat" optional="show"/>
		    <field name="department_id" optional="show"/>
		    <field name="total_basic" optional="show"/>
		    <field name="total_accrued" optional="show"/>
		    <field name="total_deduction" optional="show"/>
		    <field name="total_net" optional="show"/>

		    <field name="foreign_total_basic" optional="hide"/>
		    <field name="foreign_total_accrued" optional="hide"/>
		    <field name="foreign_total_deduction" optional="hide"/>
		    <field name="foreign_total_net" optional="hide"/>
		</tree>
	    </field>
	</record>


	<record id="hr_payroll_move_profit_sharing_view_tree" model="ir.ui.view">
	    <field name="name">hr.payroll.move.profit.sharing.view.tree</field>
	    <field name="model">hr.payroll.move</field>
	    <field name="arch" type="xml">
		<tree string="Profit Sharing Payments" editable="bottom">
		    <field name="company_id" invisible="1"/>
		    <field name="date" optional="show"/>
		    <field name="slip_id" optional="hide"/>
		    <field name="employee_id" optional="show"/>
		    <field name="employee_vat" optional="show"/>
		    <field name="department_id" optional="show"/>
		    <field name="employee_job_id" optional="show"/>
		    <field name="profit_sharing_payment" optional="show"/>
		    <field name="total_net" optional="show"/>

		    <field name="foreign_profit_sharing_payment" optional="hide"/>
		    <field name="foreign_total_net" optional="hide"/>
		</tree>
	    </field>
	</record>

	<record id="hr_payroll_move_view_pivot" model="ir.ui.view">
	    <field name="name">hr.payroll.move.view.pivot</field>
	    <field name="model">hr.payroll.move</field>
	    <field name="arch" type="xml">
		<pivot string="Payroll Payments">
		    <field name="company_id" invisible="1"/>
		    <field name="slip_id" optional="hide"/>
		    <field name="employee_id" type="row"/>
		    <field name="employee_vat" optional="show"/>
		    <field name="department_id" type="row"/>
		    <field name="employee_job_id" optional="show"/>
		    <field name="vacational_period" type="row"/>

		    <field name="total_basic" type="measure"/>
		    <field name="total_deduction" type="measure"/>
		    <field name="total_accrued" type="measure"/>
		    <field name="total_net" type="measure"/>
		    <field name="total_assig" type="measure"/>
		    <field name="vacation_days" type="measure"/>
		    <field name="consumed_vacation_days" type="measure"/>
		    <field name="total_vacation" type="measure"/>

		    <field name="foreign_total_basic" type="measure" optional="hide"/>
		    <field name="foreign_total_deduction" type="measure" optional="hide"/>
		    <field name="foreign_total_accrued" type="measure" optional="hide"/>
		    <field name="foreign_total_net" type="measure" optional="hide"/>
		    <field name="foreign_total_assig" type="measure" optional="hide"/>
		    <field name="foreign_total_vacation" type="measure" optional="hide"/>
		</pivot>
	    </field>
	</record>

	<record id="hr_payroll_move_salary_action" model="ir.actions.act_window">
	    <field name="name">Salary Payments</field>
	    <field name="res_model">hr.payroll.move</field>
	    <field name="domain">[("move_type",'=',"salary")]</field>
	    <field
	    	name="view_ids"
	    	eval="[(5, 0, 0),
		    (0, 0, {'view_mode': 'tree', 'view_id': ref('hr_payroll_move_salary_view_tree')}),
		    (0, 0, {'view_mode': 'pivot'})]"
	    />
	</record>

	<record id="hr_payroll_move_vacation_action" model="ir.actions.act_window">
	    <field name="name">Vacations Payments</field>
	    <field name="res_model">hr.payroll.move</field>
	    <field name="domain">[("move_type",'=',"vacation")]</field>
	    <field
	    	name="view_ids"
	    	eval="[(5, 0, 0),
		    (0, 0, {'view_mode': 'tree', 'view_id': ref('hr_payroll_move_vacation_view_tree')}),
		    (0, 0, {'view_mode': 'pivot'})]"
	    />
        <field name="context">{"default_move_type": "vacation"}</field>
	</record>

	<record id="hr_payroll_move_advance_action" model="ir.actions.act_window">
	    <field name="name">Advance Payments</field>
	    <field name="res_model">hr.payroll.move</field>
	    <field name="domain">[("move_type",'=',"advance")]</field>
	    <field
	    	name="view_ids"
	    	eval="[(5, 0, 0),
		    (0, 0, {'view_mode': 'tree', 'view_id': ref('hr_payroll_move_advance_view_tree')}),
		    (0, 0, {'view_mode': 'pivot'})]"
	    />
	</record>

	<record id="hr_payroll_move_profit_sharing_action" model="ir.actions.act_window">
	    <field name="name">Profit Sharing Payments</field>
	    <field name="res_model">hr.payroll.move</field>
	    <field name="domain">[("move_type",'=',"profit_sharing")]</field>
	    <field
	    	name="view_ids"
	    	eval="[(5, 0, 0),
		    (0, 0, {'view_mode': 'tree', 'view_id': ref('hr_payroll_move_profit_sharing_view_tree')}),
		    (0, 0, {'view_mode': 'pivot'})]"
	    />
            <field name="context">{"default_move_type": "profit_sharing"}</field>
	</record>
    </data>
</odoo>
