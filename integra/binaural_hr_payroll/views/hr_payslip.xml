<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_payslip_form" model="ir.ui.view">
            <field name="name">hr.payslip.form.view.binaural.hr.payroll</field>
            <field name="model">hr.payslip</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
		<xpath expr="//field[@name='worked_days_line_ids']/tree/field[@name='amount']" position="after">
		    <field name="foreign_currency_id" column_invisible="1"/>
		    <field name="foreign_amount"/>
		</xpath>
		<xpath expr="//field[@name='line_ids']/tree/field[@name='amount']" position="after">
		    <field name="foreign_currency_id" column_invisible="1"/>
		    <field name="foreign_amount"/>
		</xpath>
		<xpath expr="//field[@name='line_ids']/tree/field[@name='total']" position="after">
		    <field name="foreign_total"/>
		</xpath>
            </field>
        </record>
    </data>
</odoo>
