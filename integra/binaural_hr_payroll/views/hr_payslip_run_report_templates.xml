<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_pre_payslip_run_document">
    <t t-call="web.external_layout">

      <style>
        .entry-page .table .td, .entry-page .table .th {
          border: 1px solid #000 !important;
        }

        .entry-page h3 {
          font-size: 16px;
        }

        .table {
          margin-top: 20px;
        }

        .entry-page__header h1 {
          margin: 0px;
          padding: 0px;
        }
      </style>

      <div class="page entry-page">

       <t t-set="first_slip_id" t-value="doc.slip_ids[0] if len(doc.slip_ids) else False"/>

        <t t-set="net_wage_total" t-value="0"/>

        <t t-foreach="doc.slip_ids" t-as="slip_id">
          <t t-set="net_wage_total" t-value="net_wage_total + slip_id.net_wage"/>
        </t>

        <div class="entry-page__header">
          <div class="row">
            <div class="col-12 text-h1 text-center" style="margin-top: -20px;">
              <h1 style="margin: 0px;padding: 0px;">
                <strong style="font-size: 20px!important;">Reporte Pre-nómina - <span t-esc="doc.name" style="font-size: 20px!important;"/></strong>
              </h1>
              <p style="margin:0px;">Periodo: <span t-esc="doc.date_start.strftime('%d/%%m/%y')" /> - <span t-esc="doc.date_end.strftime('%d/%%m/%y')" /></p>
              <p style="margin:0px;">Emisión: <span t-esc="time.strftime('%d/%%m/%y')" /></p>
              <p style="margin:0px;">Total Empleados: <span t-esc="len(doc.slip_ids.mapped('employee_id'))"/></p>
            </div>
          
          </div>
        </div>

        <div style="margin-top: 20px;margin-bottom: 20px;" />
	<t t-set="totals_per_line" t-value="get_totals_per_line"/>
	<t t-set="total_assignations_amount" t-value="0"/>
	<t t-set="total_deductions_amount" t-value="0"/>

	<table class="table table-sm">
	    <thead>
	 	<tr style="text-align: left !important;">
		    <th>Nombre</th>
		    <th>Cantidad</th>
		    <th>Asignaciones</th>
		    <th>Deducciones</th>
	    	</tr>
	    </thead>
	    <tbody>
		<t t-foreach="totals_per_line.items()" t-as="line">
		    <tr>
			<td><span t-esc="line[0]"/></td>
			<td><span t-esc="line[1]['quantity']"/></td>
                      	<td>
			  <t t-if="line[1]['total'] &gt; 0">
			    <t t-set="total_assignations_amount" t-value="total_assignations_amount + line[1]['total']"/>
                            <span
                              t-esc="line[1]['total']"
                              t-options='{"widget": "monetary", "display_currency": vef_currency}'
                            />
			  </t>
                      	</td>
                      <td>
			  <t t-if="line[1]['total'] &lt; 0">
			    <t t-set="total_deductions_amount" t-value="total_deductions_amount + line[1]['total']"/>
                            <span
                              t-esc="line[1]['total']"
                              t-options='{"widget": "monetary", "display_currency": vef_currency}'
                            />
			  </t>
                      </td>
		    </tr>
		</t>
		<tr>
		    <td><strong>Total</strong></td>
		    <td></td>
		    <td>
			<strong>
			    <span
				t-if="total_assignations_amount != 0"
				t-esc="total_assignations_amount"
			    	t-options='{"widget": "monetary", "display_currency": vef_currency}'
			    />
			</strong>
		    </td>
		    <td>
			<strong>
			    <span
				t-if="total_deductions_amount != 0"
				t-esc="total_deductions_amount"
			    	t-options='{"widget": "monetary", "display_currency": vef_currency}'
			    />
			</strong>
		    </td>
		</tr>
	    </tbody>
	</table>

	<table class="table table-sm">
	    <tbody>
		<tr>
		    <td><strong>Neto</strong></td>
		    <td style="width:20%;"></td>
		    <td style="width:23%;"></td>
		    <td style="width:17%;">
			<strong>
			    <span t-esc="get_total_net"
			      	  t-options='{"widget": "monetary", "display_currency": vef_currency}'
			    />
			</strong>
		    </td>
		    <td style="width:20%;"></td>
	        </tr>
	    </tbody>
	</table>
      </div>

      <p style="page-break-after:always;" />

      <div class="page">

        <style>
          .half-page {
          }

          .half-page:last-child {
            border-bottom: none;
          }

          .add_comma span:after {
            content: ",";
            padding-right: 2px;
          }

          .add_comma span:last-child:after {
            content: "";
          }

          .half-page * {
            font-size: 9px !important;
          }

        </style>

        <t t-foreach="doc.slip_ids" t-as="slip_id">
          <t t-set="o" t-value="slip_id"/>

          <div class="half-page" style="padding-top: 30px;">

            <h2>Recibo de Salario - <span t-field="o.number" /> - 
            <span t-field="o.date_from" t-options='{"format": "MM/yyyy"}'/>
            </h2>
            <t t-set="is_invalid" t-value="o._is_invalid()"/>
            <t t-if="is_invalid">
                <strong>Esta nómina no está validada. Este no es un documento legal.</strong>
            </t>

            <table name="employee-infos" class="table table-sm table-bordered">
              <tr>
                <td class="w-25"><strong>Empleado: </strong><span t-field="o.employee_id"/></td>
                <td class="w-25"><strong>Cédula de Id.: </strong><span t-field="o.employee_id.prefix_vat"/><span t-field="o.employee_id.vat"/></td>
                <td class="w-25"><strong>Departamento: </strong><span t-field="o.employee_id.department_id"/></td>
                <td class="w-25"><strong>Cargo: </strong><span t-field="o.employee_id.job_title"/></td>
              </tr>

              <tr>
                <td class="w-25"><strong>Fecha de Ingreso: </strong><span t-field="o.employee_id.entry_date"/></td>
                <td class="w-25"><strong>Período de Pago: </strong><span t-field="o.date_from"/> - <span t-field="o.date_to"/></td>
                <td><strong>Calculado en: </strong><span t-field="o.compute_date"/></td>
              </tr>

            </table>

            <table class="table table-sm">
              <tr>
                <td class="w-25"><strong>Salario Básico</strong></td>
                <td style="color:#875A7B" class="w-25">
		    <span t-esc="o.contract_id.get_vef_wage()"
			  t-options='{"widget": "monetary", "display_currency": vef_currency}'/>
                </td>
                <td class="w-25"></td>
                <td class="w-25"></td>
              </tr>
            </table>

            <div id="total">
              <table class="table table-sm">
                <thead class="o_black_border">
	 	  <tr style="text-align: left !important;">
                    <th>Nombre</th>
                    <th>Número de horas</th>
                    <th>Número de días</th>
		    <th>Cantidad</th>
		    <th>Tasa (%)</th>
                    <th>Asignaciones</th>
                    <th>Deducciones</th>
                  </tr>
                </thead>
                <tbody>
                  <span t-foreach="o.worked_days_line_ids" t-as="worked_days">
                    <t t-if="worked_days.code != 'OUT'">
                      <tr style="color:none">
                        <td><span t-field="worked_days.name"/></td>
                        <td><span t-field="worked_days.number_of_hours"/></td>
                        <td><span t-esc="ceil(worked_days.number_of_days)"/></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                      </tr>
                    </t>
                  </span>

                  <span t-foreach="o.line_ids.filtered(lambda line: line.appears_on_payslip)" t-as="line">
                    <t t-set="line_style"/>
                    <t t-set="line_class"/>
                    <t t-if="line.code == 'NET'">
                      <t t-set="line_style" t-value="'color:#875A7B;'"/>
                      <t t-set="line_class" t-value="'o_total o_border_bottom'"/>
                    </t>
                    <t t-if="(line.code == 'BASIC') or (line.code == 'GROSS')">
                      <t t-set="line_style" t-value="'color:#00A09D;'"/>
                      <t t-set="line_class" t-value="'o_subtotal o_border_bottom'"/>
                    </t>
                    <tr t-att-class="line_class" t-att-style="line_style" t-if="bool(line.total)">
                      <td><span t-field="line.name"/></td>

                      <td>
                      </td>

                      <td>
                      </td>

		      <td><span t-field="line.quantity"/></td>
			<td><span t-field="line.rate"/></td>
                      	<td>
                          <span
                            t-if="line.total &gt; 0"
                            t-esc="line.total if o.foreign_currency_id != vef_currency else line.foreign_total"
                            t-options='{"widget": "monetary", "display_currency": vef_currency}'
                          />
                      	</td>
                      <td>
                          <span
                            t-if="line.total &lt; 0"
                            t-esc="line.total if o.foreign_currency_id != vef_currency else line.foreign_total"
                            t-options='{"widget": "monetary", "display_currency": vef_currency}'
                          />
                      </td>
                    </tr>
                  </span>

                </tbody>
              </table>
            </div>
		
	    <p 
                t-if="o.net_wage &gt;= 0 and o.employee_id.address_home_id.bank_ids"
                id="total-to-pay-on-account"
            >
                Total a pagar en
                <span t-field="o.employee_id.address_home_id.bank_ids[0].bank_id"/>
                (
                    <span t-field="o.employee_id.address_home_id.bank_ids.bank_id.name"/> 
                    <!-- Cuenta <span t-field="o.employee_id.default_account_bank_id.account_type"/> -->
                ).
            </p>

            <p t-if="o.net_wage &lt; 0">The net amount will be recovered from the first positive remuneration established after this.</p>

          </div>

        </t>


      </div>

      <div class="footer">
      </div>
    </t>
  </template>

  <template id="report_pre_payslip_run">
    <t t-call="web.html_container">
      <t t-set="data_report_margin_top" t-value="24"/>
      <t t-set="data_report_header_spacing" t-value="18"/>

      <t t-name="report.external_layout_header">
        <div class="header">

          <style>
            <!-- Header -->
            .custom-header .text-h1, .text-h1 * {
              font-size: 13px;
              margin:0px;
            }

            .custom-header .header__info-container {
              text-align: center !important;
              
              position: relative;
              left: -30px;

            }

            .custom-header .header__info-container p {
              margin: 0;
              padding: 0px;
            }

            .custom-header .header__info-container h1, .header__info-container h2 {
              font-size: 18px;
              font-weight: bold;
            }

            .custom-header .add_comma span:after {
              content: ", ";
            }

            .custom-header .add_comma span:last-child:after {
              content: "";
            }
          </style>

          <div class="row custom-header">

            <div class="col-3">
              <img 
                t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)"
                style="max-height: 100px;max-width: 150px;" alt="Logo"
              />
            </div>

            <div class="col-7 text-h1 text-left header__info-container">

              <h1><span t-esc="res_company.name"/></h1>
              <p t-if="res_company.street and res_company.street2">
                <div class="add_comma">
                  <span t-esc="res_company.street"/>
                  <span t-field="res_company.street2" />
                </div>
              </p>
              <p t-if="res_company.phone and res_company.email">
                <div class="add_comma">
                  <span t-esc="res_company.phone"/>
                  <span t-esc="res_company.email"/>
                </div>
              </p>

            </div>

            <div class="col-2 text-right pager">
              
              <span >Pagina </span><span class="page" /> de <span class="topage" />
              
            </div>
          </div>
        </div>
      </t>

      <t t-foreach="docs" t-as="doc">
        <t t-call="binaural_hr_payroll.report_pre_payslip_run_document" />
      </t>
    </t>
  </template>
</odoo>
