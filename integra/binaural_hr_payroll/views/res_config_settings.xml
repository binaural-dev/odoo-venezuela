<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_binaural_hr_payroll" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.hr.payroll</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
            <field name="arch" type="xml">
		<xpath expr="//div[@name='binaural_rate_settings']" position="after">
		    <h2>Payroll Configuration</h2>
                    <div class="row mt16 o_settings_container" name="binaural_hr_payroll_settings">
			<div class="col-lg-8 col-12 o_setting_box">
                            <div class="o_setting_right_pane">
                            	<group colspan="4" col="4">
                                    <field name="compute_payroll_using" widget="radio"/>
                            	</group>
                        	<div class="text-muted">
				    Wether the base wage for the payroll computations is gonna be
				    using the base or the foreign currency.
                            	</div> 
			    </div>
                        </div>
			<div class="col-lg-8 col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Minimun legal wage
                                </div>
                                <group class="mt16" name="default_deductions_1">
                                    <label for="law_base_wage"/>
                                    <div>
                                        <field name="law_base_wage" nolabel="1"/>
                                        <span>Bs</span>
                                    </div>                                                                    
                                </group>
                            </div>
                        </div>
                        <div class="col-lg-8 col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
				    IVSS Configuration
                                </div>
                                <group class="mt16" name="default_deductions_2">
                                    <label for="ivss_wage_treshold"/>
                                    <div>
                                        <field name="ivss_wage_treshold" nolabel="1"/>
                                        <span> / month</span>
                                    </div>
                                </group>
                            </div>
                        </div> 

                        <div class="col-lg-8 col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
				    Forced Unemployment Configuration
                                </div>
                                <group class="mt16" name="default_deductions_3">
                                    <label for="forced_unemployment_wage_treshold"/>
                                    <div>
                                        <field name="forced_unemployment_wage_treshold" nolabel="1"/>
                                        <span> / month</span>
                                    </div>
                                </group>
                            </div>
                        </div> 

                        <div class="col-lg-8 col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
				    Vacations Configuration
                                </div>
                                <group class="mt16" name="default_vacation">
                                    <label for="first_year_vacation_days"/>
                                    <div>
                                        <field name="first_year_vacation_days" nolabel="1"/>
                                        <span>Day(s)</span>
                                    </div>                                
                                    <label for="additional_vacation_days_after_first_year"/>
                                    <div>
                                        <field name="additional_vacation_days_after_first_year" nolabel="1"/>
                                         <span>Day(s)</span>
                                    </div>
                                    <label for="cc_additional_days"/>
                                    <div>
                                        <field name="cc_additional_days" nolabel="1"/>
                                        <span>Day(s)</span>
                                    </div>
                                    <label for="cc_bonus_additional_days"/>
                                    <div>
                                        <field name="cc_bonus_additional_days" nolabel="1"/>
                                        <span>Day(s)</span>
                                    </div>
                                    <label for="maximum_vacation_days"/>
                                    <div>
                                        <field name="maximum_vacation_days" nolabel="1"/>
                                         <span>Day(s)</span>
                                    </div>
                                </group>
                            </div>
                        </div>

                        <div class="col-lg-8 col-12 o_setting_box" id="binaural_hr_payroll_profit_sharing_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
				    Profit Sharing Configuration
                                </div>
                                <group class="mt16" name="default_profit_sharing">
                                    <label for="profit_sharing_type"/>
                                    <div>
                                        <field name="profit_sharing_type" nolabel="1" widget="radio"/>
                                    </div>
                                    <label for="profit_sharing_days_qty"/>
                                    <div>
                                        <field name="profit_sharing_days_qty" nolabel="1"/>
                                         <span>Day(s)</span>
                                    </div>
                                </group>
                            </div>
                        </div>
                        
                    	<div class="col-lg-8 col-12 o_setting_box">
			    <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <group class="mt16" name="binaural_hr_payroll_cron">
                          	    <label for="use_analytic_account_per_departments"/>
				    <div>
                          		<field name="use_analytic_account_per_departments" nolabel="1"/>
				    </div>
			    	</group>
                            </div>
		    	</div>

                      	<div class="col-lg-8 col-12 o_setting_box">
                            <div class="o_setting_left_pane"></div>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
				    CRON
                                </div>
                                <group class="mt16" name="binaural_hr_payroll_cron">
                          	    <label for="provisions_cron_day"/>
				    <div>
                          	    	<field name="provisions_cron_day" nolabel="1"/>
				    </div>
			    	</group>
                            </div>
                      	</div>
                    </div>               
                </xpath>
            </field>
        </record>
    </data>
</odoo>
