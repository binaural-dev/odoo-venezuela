<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="action_invoice_free_form_binaural_invoice" model="ir.actions.report">
            <field name="name">Free Form</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">binaural_invoice.template_invoice_free_form_binaural_invoice</field>
            <field name="report_file">binaural_invoice.template_invoice_free_form_binaural_invoice</field>
            <field name="attachment">(object.state == 'posted') and ((object.name or 'INV').replace('/','_') + '.pdf')</field>
            <field name="paperformat_id" ref="binaural_invoice.invoice_sale_note_paperformat_binaural_invoice"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="print_report_name" >(object.state == 'posted') and ((object.name or 'INV').replace('/','_') + '.pdf')</field>
        </record>

        <template id="template_invoice_free_form_binaural_invoice">
            <t t-call="web.html_container">
                <xpath expr="//t[@t-call='web.report_layout']" position="replace">
                    <t t-foreach="docs" t-as="invoice">
                        <t t-set="o" t-value="invoice"/>
                        <t t-set="base_usd" t-value="o.foreign_currency_id.id == %(base.VEF)s"/>
                        <div class="article" style="" t-att-data-oe-model="invoice and invoice._name" t-att-data-oe-id="invoice and invoice.id" t-att-data-oe-lang="invoice and invoice.env.context.get('lang')">
                            <link rel="stylesheet" type="text/css" href="/web/static/lib/bootstrap/dist/css/bootstrap.css"/>

                            <div class="page">
                                <style>
                                    .table_p{
                                        border-spacing: 0;
                                        border-collapse: collapse;
                                        gap: 0;
                                    }

                                    thead > tr{
                                        margin-bottom: 3px;
                                    }
                                    tbody > td {
                                    background-color: blue !important;
                                    }

                                    th{
                                        vertical-align: middle;
                                    }

                                    th{
                                    padding: 1px 5px;
                                        font-size:12px;
                                    }

                                    td{
                                        font-size:12px;
                                        width: 25%;
                                    }
                                    .col-xs-7,
                                    .col-xs-4{
                                        padding:0px !important;
                                    }

                                    .col-xs-4 span
                                    ,.col-xs-8 span {
                                        font-size:14px;
                                    }
                                    .td_right{
                                        padding:0px 10px;
                                    }
                                    .class_number td{
                                        font-size:11px;
                                        width: 15%;
                                        padding:0px 0px;
                                    }
                                    .row_1 > tr > td > span{
                                        font-size:11px;
                                    }
                                    .table_p > tbody > tr > td{
                                        padding-top: 5px !important;
                                    }
                                </style>

                                <section id="segmento_2">
                                    <table name="table_invoice_number" class="class_number" cellspacing="0" cellpadding="0">
                                        <!-- membrete -->
                                        <tr>
                                        </tr>

                                        <!--fila 1-->
                                        <tr class="row_1 text-nowrap">

                                            <td colspan="6">
                                                Razón social:
                                                <span t-field="invoice.partner_id.name"/>
                                            </td>
                                            <td colspan="1">
                                            </td>

                                            <t t-if="invoice.move_type == 'out_invoice' or invoice.move_type == 'in_invoice' or invoice.move_type == 'out_contingence'  or invoice.move_type == 'in_contingence'">
                                                <td colspan="3" style="text-align:right;font-weight:bold">
                                                    <span>Factura Nro:
                                                        <span t-field="invoice.name"/>
                                                    </span>
                                                </td>
                                            </t>
                                            <t t-else="">
                                                <t t-if="invoice.move_type == 'out_refund' or invoice.move_type == 'in_refund'">
                                                    <td colspan="3" style="text-align:right;font-weight:bold">
                                                        <span>Nota de crédito</span>
                                                        <strong>
                                                            <span t-field="invoice.name"/>
                                                        </strong>
                                                    </td>
                                                </t>
                                            </t>

                                        </tr>
                                        <!--fila 2-->
                                        <tr>
                                            <td colspan="2" name="td_vat">
                                                <span>RIF/Cédula:
                                                    <span t-field="invoice.vat"/>
                                                </span>
                                            </td>
                                            <td colspan="5"/>
                                            <td colspan="3" style="text-align:right">Emisión:
                                                <span t-field="invoice.invoice_date"/>
                                            </td>
                                        </tr>

                                        <!--fila 3-->
                                        <tr>
                                            <td colspan="7" style="font-size:10px">
                                                Domicilio Fiscal:
                                                <span t-field="invoice.partner_id.street"/>
                                                <span t-field="invoice.partner_id.street2"/>
                                                -

                                                Estado:
                                                <span t-field="invoice.partner_id.state_id.name"/>
                                                -

                                                Ciudad:
                                                <span t-field="invoice.partner_id.city"/>
                                            </td>
                                            <td colspan="3" style="text-align:right">Vencimiento:
                                                <span t-field="invoice.invoice_date_due"/>
                                            </td>

                                        </tr>
                                        <tr>
                                            <td colspan="2">
                                                Telf:
                                                <span t-field="invoice.partner_id.phone"/>
                                            </td>
                                        </tr>
                                    </table>
                                </section>
                                <!--<br/>-->
                                <section id="segmento_3" style="font-size:10px !important;">
                                    <table name="table_product" class="table_p">
                                        <thead>
                                            <th style="width:140px;text-align:center;border: 1px solid black;">Código
                                            </th>
                                            <th id="descripcion" style="width:420 px;text-align:left;border: 1px solid black;padding-left: 10px;">
                                                Descripción
                                            </th>
                                            <th style="width:40px;text-align:center;border: 1px solid black;">Cant
                                            </th>
                                            <th style="width:90px;text-align:center;border: 1px solid black;">Precio

                                            </th>
                                            <th style="width:50px;text-align:center;border: 1px solid black;">
                                                Desc %
                                            </th>
                                            <th style="width:90px;text-align:center;border: 1px solid black;">Total</th>
                                        </thead>
                                        <tbody>
                                            <t t-set="base_sin_descuento" t-value="0.00"/>
                                            <t t-set="base_16" t-value="0.00"/>
                                            <t t-set="iva_16" t-value="0.00"/>
                                            <t t-set="base_8" t-value="0.00"/>
                                            <t t-set="iva_8" t-value="0.00"/>
                                            <t t-foreach="invoice.invoice_line_ids" t-as="line">
                                                <tr>
                                                    <t t-set="base_sin_descuento"
                                                       t-value="base_sin_descuento + (line.quantity * line.foreign_price)"/>
                                                    <t t-if="len(line.tax_ids) > 0">
                                                        <t t-if="line.tax_ids[0].amount == 8">
                                                            <t t-set="base_8" t-value="base_8 + (line.price_subtotal)"/>
                                                            <t t-set="iva_8"
                                                               t-value="iva_8 + (line.tax_ids[0].amount/100) * (line.price_subtotal)"/>
                                                        </t>
                                                        <t t-if="line.tax_ids[0].amount == 16">
                                                            <t t-set="base_16"
                                                               t-value="base_16 + (line.price_subtotal)"/>
                                                            <t t-set="iva_16"
                                                               t-value="iva_16 +(line.tax_ids[0].amount/100) * (line.price_subtotal)"/>
                                                        </t>
                                                    </t>
                                                    <t t-if="invoice.move_type in ['out_debit', 'in_debit']">
                                                        <td></td>
                                                        <td style="width:420px;text-align:left;">
                                                            <span t-field="line.name"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td style="width:140px;text-align:center;">
                                                            <span t-field="line.product_id.default_code"/>
                                                        </td>
                                                        <t t-if="line.product_id.name">
                                                            <t t-set="product_name"
                                                               t-value="line.product_id.name[0:35]"/>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-set="product_name" t-value=""/>
                                                        </t>
                                                        <td style="width:420px;text-align:left;">
                                                            <span t-esc="line.name"/>
                                                        </td>
                                                    </t>
                                                    <td style="width:40px;text-align:right;">
                                                        <span t-esc="line.quantity" t-options='{"widget": "float", "precision": 2}'/>
                                                    </td>
                                                    <td style="width:80px;text-align:right;">
                                                        <t t-if="base_usd">
                                                            <span class="text-nowrap" t-esc="line.foreign_price" t-options='{"widget": "monetary", "display_currency": invoice.foreign_currency_id}'/>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-nowrap" t-esc="line.price_unit" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </t>
                                                    </td>
                                                    <td style="width:40px;text-align:right;">
                                                        <span t-esc="line.discount"/>
                                                    </td>

                                                    <td class="td_right" style="width:90px;text-align:right">
                                                        <t t-if="base_usd">
                                                            <span class="text-nowrap" t-esc="line.foreign_subtotal" t-options='{"widget": "monetary", "display_currency": invoice.foreign_currency_id}'/>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-nowrap" t-esc="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </section>
                                <div style="width:100%;margin-top:20px"></div>
                                <div class="clearfix" style="position: absolute;right: 0; width:50%">
                                    <t t-set="key_subtotals" 
                                        t-value="'foreign_subtotals' if base_usd else 'subtotals'"/>
                                    <t t-set="key_groups_by_subtotal" 
                                        t-value="'groups_by_foreign_subtotal' if base_usd else 'groups_by_subtotal'"/>

                                    <div id="total" class="row">
                                            <table class="table table-sm" 
                                                style="page-break-inside: avoid; width: 100%;">
                                                <tr class="border-black o_subtotal" style="">
                                                    <td>
                                                        <strong>Base Imponible</strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <t t-if="base_usd">
                                                            <span t-esc="o.foreign_taxable_income" t-options='{"widget": "monetary", "display_currency": o.foreign_currency_id }'/>
                                                        </t>
                                                        <t t-else="">
                                                            <span t-esc="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                        </t>
                                                    </td>
                                                </tr>
                                                <t t-set="subtotal_name" t-value="o.tax_totals[key_subtotals][0]['name']"/>
                                                <t t-foreach="o.tax_totals[key_groups_by_subtotal][subtotal_name]" t-as="tax">
                                                    <tr style="">
                                                        <t t-if="len(o.line_ids.filtered(lambda line: line.tax_line_id)) in [0, 1] and o.foreign_taxable_income == tax['tax_group_base_amount']">
                                                            <td>
                                                                <span class="text-nowrap" t-esc="tax['tax_group_name']"/>

                                                                <span class="text-nowrap">
                                                                   sobre (<t t-esc="tax['formatted_tax_group_base_amount']"/>)
                                                                </span>
                                                            </td>
                                                            <td class="text-right o_price_total">
                                                                <span class="text-nowrap" t-esc="tax['formatted_tax_group_amount']"/>
                                                            </td>
                                                        </t>
                                                        <t t-else="">
                                                            <td>
                                                                <span t-esc="tax['tax_group_name']"/>
                                                                
                                                                <span class="text-nowrap">
                                                                   sobre (<t t-esc="tax['formatted_tax_group_base_amount']"/>)
                                                                </span>
                                                            </td>
                                                            <td class="text-right o_price_total">
                                                                <span class="text-nowrap" t-esc="tax['formatted_tax_group_amount']"/>
                                                            </td>
                                                        </t>
                                                    </tr>
                                                </t>
                                                <tr class="border-black o_total">
                                                    <td>
                                                        <strong>Total General</strong>
                                                    </td>
                                                    <td class="text-right">
                                                        <t t-if="base_usd">
                                                            <span class="text-nowrap" t-esc="o.foreign_total_billed" t-options='{"widget": "monetary", "display_currency": o.foreign_currency_id}'/>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-nowrap" t-esc="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                        </t>
                                                    </td>
                                                </tr>
                                            </table>

                                    </div>
                                </div>
                                <div style="width:100%;margin-top:20px"></div>
                                <section id="segmento_4">
                                    <table name="table_total">
                                        <t t-if="invoice.move_type == 'out_refund'">
                                            <tr>
                                                <td colspan="6">
                                                    <span>Doc afectado: Nro Factura:
                                                        <span t-field="invoice.reversed_entry_id.name"/>
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="6">
                                                    <span>Nro de control:
                                                        <span t-field="invoice.reversed_entry_id.correlative"/>
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="6">
                                                    <span>Fecha de Factura:
                                                        <span t-field="invoice.reversed_entry_id.invoice_date"/>
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="7">
                                                    <span>Total Facturado:
                                                        <span t-esc="invoice.reversed_entry_id.foreign_total_billed" t-options='{"widget": "monetary", "display_currency": invoice.foreign_currency_id}'/>
                                                    </span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="7">
                                                    <span>Motivo:
                                                        <span t-field="invoice.ref"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </section>
                            </div>
                        </div>
                    </t>
                </xpath>
            </t>
        </template>

        <record id="account.account_invoices" model="ir.actions.report">
            <field name="name">Invoices</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">account.report_invoice_with_payments</field>
            <field name="report_file">account.report_invoice_with_payments</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="attachment">(object.state == 'posted') and ((object.name or 'INV').replace('/','_')+'.pdf')</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>

        <record id="account.account_invoices_without_payment" model="ir.actions.report">
            <field name="name">Invoices without Payment</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">account.report_invoice</field>
            <field name="report_file">account.report_invoice</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
            <field name="attachment">(object.state == 'posted') and ((object.name or 'INV').replace('/','_')+'.pdf')</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        </record>
    </data>

</odoo>
