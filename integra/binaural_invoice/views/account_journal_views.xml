<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">view.account.journal.form.binaural.invoice</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
	    <field name="fiscal" position="after">
                <field name="is_contingency" 
		       invisible="type != 'sale' or not fiscal"/>
	    </field>
            <xpath expr="//field[@name='type']" position="after">
                <field name="series_correlative_sequence_id" 
                       invisible="type != 'sale' or not fiscal"
                       groups="binaural_invoice.group_sales_invoicing_series"/>
            </xpath>
        </field>
    </record>

</odoo>
