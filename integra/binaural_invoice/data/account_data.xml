<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="invoice_correlative" model="ir.sequence">
            <field name="name">Sequence Number</field>
            <field name="code">invoice.correlative</field>
            <field name="padding">5</field>
        </record>

        <record forcecreate="True" id="alternative_discounts" model="decimal.precision">
            <field name="name">Descuentos alternos</field>
            <field name="digits">2</field>
        </record>

         <record forcecreate="True" id="alternative_rate" model="decimal.precision">
            <field name="name">Tasa</field>
            <field name="digits">2</field>
        </record>
        
    </data>
    

</odoo>
