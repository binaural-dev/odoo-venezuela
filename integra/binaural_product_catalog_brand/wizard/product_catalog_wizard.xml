<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="generate_product_catalog_wizard_view" model="ir.ui.view">
        <field name="name">asiacenter.generate.product.catalog.wizard.view</field>
        <field name="model">product.catalog.wizard</field>
        <field name="inherit_id" ref="binaural_product_catalog.generate_product_catalog_wizard_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='show_sales_policy']" position="after">
                <field name="show_brand" attrs="{ 'invisible': [('style','not in',['style_6'])] }" />
            </xpath>
        </field>
    </record>

</odoo>
