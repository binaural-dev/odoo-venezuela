<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_binaural_stock_sale" model="ir.ui.view">
        <field name="name">view.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]//tree/field[@name='tax_id']" position="after">
                <field name="liters_per_unit_total" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
