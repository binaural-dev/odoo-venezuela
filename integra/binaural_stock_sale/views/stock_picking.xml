<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_binaural_stock_sale" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <field name="backorder_id" position="after">
                <field name="sale_order_id" invisible="1"/>
                <field name="sale_user_id" string="Comercial" invisible="not sale_order_id"/>
                <field name="sale_invoice" string="Nº Factura" invisible="not sale_order_id"/>

                <button string="Set Commercial" name="set_sale_pos_order" type="object" class="oe_highlight" groups="base.group_no_one"/>
            </field>

        </field>
    </record>

</odoo>
