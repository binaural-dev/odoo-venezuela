<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_movil_seller_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">binaural.movil.seller.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
        <field name="arch" type="xml">
            
            <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                <h2>Seller Settings</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="company_seller"/>
                                </div>
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="company_seller"/>
                            <div class="text-muted">
                                Activate Sellers in this company
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" invisible="not company_seller">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="initial_seller"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="initial_seller"  domain="[('is_seller','=', True)]" required="company_seller"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" invisible="not company_seller">
                        <div class="o_setting_left_pane">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="multiple_sellers"/>
                                </div>
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="multiple_sellers"/>
                            <div class="text-muted">
                                Allow the client to have several sellers associated with it
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" invisible="not company_seller">
                        <div class="o_setting_left_pane">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="restrict_seller"/>
                                </div>
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="restrict_seller"/>
                            <div class="text-muted">
                                Restrict selection of sellers according to customer file
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
