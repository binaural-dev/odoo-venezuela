<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="binaural_seller_partner_inherit_view_form" model="ir.ui.view">
        <field name="name">binaural.seller.partner.inherit.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='internal_notes']" position="before">
                <field name="company_seller" invisible="1"/>
                <page name="sellers_assigned" string="Sellers"  attrs="{'invisible': [('company_seller', '=', False)]}">
                    <field name="seller_ids" nolabel="1">
                        <tree create="False" delete="False" multi_edit="False" edit="False" editable="top" no_open="1">
                            <field name="name"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
