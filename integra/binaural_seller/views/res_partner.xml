<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="binaural_seller_partner_inherit_view_form" model="ir.ui.view">
        <field name="name">binaural.seller.partner.inherit.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='internal_notes']" position="before">
                <page name="sellers_assigned" string="Sellers">
                    <field name="seller_ids" required="1">
                        <tree name="sellers_tree" create="0" delete="1" multi_edit="0">
                            <field name="name"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
