<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_sale_order" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="sellers_available" invisible="1"/>
                <field name="company_seller" invisible="1"/>
                <field name="seller_id" attrs="{'readonly': [('state', '!=', 'draft')], 
                                                'invisible': [('company_seller', '=', False)]}"/>
            </xpath>

        </field>
    </record>

</odoo>
