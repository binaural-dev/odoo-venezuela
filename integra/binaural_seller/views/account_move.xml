<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="binaural_seller_account_move_inherit_form_view" model="ir.ui.view">
        <field name="name">binaural.seller.account.move.inherit.form.view</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="sellers_available" invisible="1"/>
                <field name="company_seller" invisible="1"/>
                <field name="seller_id" attrs="{'readonly': [('state', '!=', 'draft')], 
                                                'invisible': [('company_seller', '=', False)]}"/>
            </field>
            
            <field name="partner_shipping_id" position="after">
                <field name="sellers_available" invisible="1"/>
                <field name="company_seller" invisible="1"/>
                <field name="seller_id" attrs="{'readonly': [('state', '!=', 'draft')], 
                        'invisible': ['|',('move_type', '!=', 'out_receipt'),('company_seller', '=', False)]}"/>
            </field>
        </field>
    </record>

</odoo>