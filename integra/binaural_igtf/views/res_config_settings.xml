<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_binaural_rate" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.rate</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='binaural_account_settings']" position="after">
                    <h2>IGTF Configuration</h2>
                    <div class="row mt16 o_settings_container" name="binaural_igtf_settings">
                        <div class="o_setting_right_pane">
                            <group colspan="2" col="3">
                                <field name="account_igtf" />
                                <field name="igtf_percentage"/>
                            </group>
                        </div>    
                    </div>
                </xpath>
            </field>
        </record>
    
    </data>
    

</odoo>
