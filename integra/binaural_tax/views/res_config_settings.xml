<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_binaural_taxes" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.rate</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                    <h2>Taxes Configuration</h2>
                    <div class="row mt16 o_settings_container" name="binaural_igtf_settings">
                        <div class="col-12 col-lg-6 o_setting_box" id="base_igtf_setting">
                            <div class="o_setting_left_pane">
                                <field name="module_binaural_igtf"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_binaural_igtf"/>
                                <div class="text-muted">
                                    Configuraciones de IGTF
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
