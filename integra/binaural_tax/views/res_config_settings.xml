<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_binaural_taxes" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.rate</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                    <h2>Taxes Configuration</h2>
                    <div class="row mt16 o_settings_container" name="binaural_igtf_settings">
                        <div class="col-12 col-lg-6 o_setting_box" id="base_igtf_setting">
                            <div class="o_setting_left_pane">
                                <field name="module_binaural_igtf"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="module_binaural_igtf"/>
                                <div class="text-muted">
                                    Configuraciones de IGTF
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="base_taxes_setting">
                            <h3>Sale</h3>
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="exent_aliquot_sale" class="col-lg-6 o_light_label"/>
                                        <field name="exent_aliquot_sale"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="general_aliquot_sale" class="col-lg-6 o_light_label"/>
                                        <field name="general_aliquot_sale"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="reduced_aliquot_sale" class="col-lg-6 o_light_label"/>
                                        <field name="reduced_aliquot_sale"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="extend_aliquot_sale" class="col-lg-6 o_light_label"/>
                                        <field name="extend_aliquot_sale"/>
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <h3>Purchase</h3>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="exent_aliquot_purchase" class="col-lg-6 o_light_label"/>
                                        <field name="exent_aliquot_purchase"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="general_aliquot_purchase" class="col-lg-6 o_light_label"/>
                                        <field name="general_aliquot_purchase"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="reduced_aliquot_purchase" class="col-lg-6 o_light_label"/>
                                        <field name="reduced_aliquot_purchase"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="row">
                                        <label for="extend_aliquot_purchase" class="col-lg-6 o_light_label"/>
                                        <field name="extend_aliquot_purchase"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
