<?xml version="1.0" encoding="ISO-8859-1"?>
<odoo>
  <record id="action_binaural_report_guide_dispatch_freeform" model="ir.actions.report">
      <field name="name">Guia de despacho (Impresion directa)</field>
      <field name="model">stock.picking</field>
      <field name="report_type">qweb-text</field>
      <field name="report_name">binaural_report_guide_dispatch.template</field>
      <field name="binding_model_id" ref="stock.model_stock_picking" />
  </record>

<template id="template">
  <t t-out="b'\x1b\x21\x00'.decode()"/>
  <t t-out="b'\x1b\x61\x00'.decode()"/><t t-out="b'\x1b\x0f'.decode()"/><t t-out="b'\x1b\x74\x16'.decode()"/>
  <t t-if="docs.picking_type_id.sequence_code in 'OUT'">
    <t t-call="binaural_report_guide_dispatch.tmp_header_invoice"/>
    <t t-call="binaural_report_guide_dispatch.tmp_client_data_invoice"/>
    <t t-call="binaural_report_guide_dispatch.tmp_delivery_address_invoice"/>
    <t t-call="binaural_report_guide_dispatch.tmp_body_data_invoice"/>
    <t t-call="binaural_report_guide_dispatch.tmp_list_products_invoice"/>
    <t t-out="b'\x1b\x61\x02'.decode()"/>
    <t t-call="binaural_report_guide_dispatch.tmp_tax_totals_foreign_invoice"/>  
    <t t-call="binaural_report_guide_dispatch.tmp_warehouse_invoice"/>
  </t>
  <t t-elif="docs.picking_type_id.sequence_code == 'INT'">
    <t t-call="binaural_report_guide_dispatch.tmp_header_stock_picking"/>
    <t t-call="binaural_report_guide_dispatch.tmp_client_data_stock_picking"/>
    <t t-call="binaural_report_guide_dispatch.tmp_delivery_address_stock_picking"/>
    <t t-call="binaural_report_guide_dispatch.tmp_body_data_stock_picking"/>
    <t t-call="binaural_report_guide_dispatch.tmp_list_products_stock_picking"/>
    <t t-out="b'\x1b\x61\x02'.decode()"/>
    <t t-call="binaural_report_guide_dispatch.tmp_body_tax_totals_stock_picking"/>
    <t t-call="binaural_report_guide_dispatch.tmp_warehouse_stock_picking"/>
  </t>
  <t t-else="">
  </t>
</template>

<!-- templates -->

<!--                               Invoice Formats                               -->
<!-- Header -->
<template id="tmp_header_invoice">
TIPO DE DOCUMENTO..: GUIA DE DESPACHO <t t-if="docs.invoice_id.filter_partner == 'customer'">( CLIENTES )</t><t t-elif="docs.invoice_id.filter_partner == 'supplier'">( PROVEEDOR )</t><t t-else="docs.invoice_id.filter_partner == 'contact'">( CONTACTO )</t>
NUMERO DE DOCUMENTO: <t t-out="docs.invoice_id.name.ljust(15)"/> FECHA DE DOCUMENTO: <t t-out="str(docs.invoice_id.invoice_date).ljust(60)"/> HORA: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%I:%M:%S:%P')"/>
NUMERO DE PEDIDO...: <t t-out="str(docs.invoice_id.invoice_origin).ljust(15)"/> FECHA DE VENCIMIENTO: <t t-out="str(docs.invoice_id.invoice_date_due).ljust(12)"/> <t t-out="docs.invoice_id.journal_id.series_correlative_sequence_id.name"/>  
</template>

<!-- Client data -->
<template id="tmp_client_data_invoice">
--CLIENTE--------------------------------------------------------------------------------------------------------------------------------
<t t-out="docs.invoice_id.partner_id.name.ljust(117)"/> COD. CLIENTE: <t t-out="docs.invoice_id.partner_id.id"/>
R.I.F: <t t-out="docs.invoice_id.partner_id.prefix_vat"/>-<t t-out="docs.invoice_id.partner_id.vat.ljust(17)"/> TELEFONOS: <t t-out="docs.invoice_id.partner_id.phone"/>
<t t-out="docs.invoice_id.partner_id.contact_address_complete"/>
</template>

<!-- Delivery address -->
<template id="tmp_delivery_address_invoice">
--DIRECCION DE ENTREGA-------------------------------------------------------------------------------------------------------------------
<t t-out="docs.invoice_id.partner_shipping_id.name"/>
<t t-out="docs.invoice_id.partner_shipping_id.contact_address_complete"/>
ATN: <t t-out="docs.invoice_id.partner_shipping_id.name.ljust(10)"/> TELF: <t t-out="docs.invoice_id.partner_shipping_id.phone"/>
-----------------------------------------------------------------------------------------------------------------------------------------
</template>

<!-- Body -->
<template id="tmp_body_data_invoice">
               CONDICIONES DE PAGO               |                FORMA DE PAGO               |                REQUISICION              
-----------------------------------------------------------------------------------------------------------------------------------------
<t t-set="payment_term" t-value="docs.invoice_id.invoice_payment_term_id.name if docs.invoice_id.invoice_payment_term_id else 'CONTADO'" />
<t t-out="payment_term[0:20].center(50)"/>|                    N/A                     |                N/A     
</template>

<!-- List products -->
<template id="tmp_list_products_invoice">
-----------------------------------------------------------------------------------------------------------------------------------------
  ITEM   |   CODIGO PRODUCTO   |   CANTIDAD   |    UNIDAD    |       D E S C R I P C I O N       |    PRECIO UNITARIO    |  T O T A L   
-----------------------------------------------------------------------------------------------------------------------------------------
<t t-foreach="docs.get_lines_escpos_stock_picking()" t-as="line">
<t t-out="line.ljust(137,' ')"/>
</t>
-----------------------------------------------------------------------------------------------------------------------------------------
</template>
   
<!-- Tax totals -->
<template id="tmp_tax_totals_foreign_invoice">
<t t-foreach="docs.get_tax_totals_escpos_stock_picking(1)" t-as="line">
<t t-out="line.rjust(137,' ')"/>
</t>
</template>

 <!-- Warehouse -->
<template id="tmp_warehouse_invoice">




ALMACEN: <t t-out="docs.location_id.location_id.name"/>  ALMACEN DESTINO: <t t-out="docs.location_dest_id.location_id.name"/>
</template>


<!--                               Stock Picking                               -->
                               
<template id="tmp_header_stock_picking">
TIPO DE DOCUMENTO..: GUIA DE DESPACHO <t t-out="docs.subsidiary_origin_id.name"/> ( CLIENTES )
NUMERO DE DOCUMENTO: <t t-out="docs.get_number_document_guide_dispatch().ljust(15)"/>   FECHA DE DOCUMENTO: <t t-out="str(docs.date_done.strftime('%Y-%m-%d')).ljust(60)"/> HORA: <t t-out="context_timestamp(datetime.datetime.now()).strftime('%I:%M:%S:%P')"/>
<t t-set="origin" t-value="docs.origin if docs.origin else ' '"/>
NUMERO DE PEDIDO...: <t t-out="str(origin).ljust(15)"/> FECHA DE VENCIMIENTO: <t t-out="str(docs.date_done.strftime('%Y-%m-%d')).ljust(12)"/> SERIE A 
</template>

<template id="tmp_client_data_stock_picking">
--CLIENTE--------------------------------------------------------------------------------------------------------------------------------
<t t-out="(docs.partner_id.name or docs.company_id.name).ljust(117)"/> COD. CLIENTE: <t t-out="(docs.partner_id.id or docs.company_id.id)"/>
R.I.F: <t t-out="docs.partner_id.prefix_vat or ''"/> <t t-out="(docs.partner_id.vat or docs.company_id.vat).ljust(17)"/> TELEFONOS: <t t-out="(docs.partner_id.phone or docs.company_id.phone)"/>
<t t-out="(docs.partner_id.contact_address_complete or docs.company_id.street)"/>
</template>

<template id="tmp_delivery_address_stock_picking">
--DIRECCION DE ENTREGA-------------------------------------------------------------------------------------------------------------------



-----------------------------------------------------------------------------------------------------------------------------------------
</template>

<template id="tmp_body_data_stock_picking">
               CONDICIONES DE PAGO               |                FORMA DE PAGO               |                REQUISICION               
-----------------------------------------------------------------------------------------------------------------------------------------
                                                 |                                            |            
</template>

<template id="tmp_list_products_stock_picking">
-----------------------------------------------------------------------------------------------------------------------------------------
  ITEM   |   CODIGO PRODUCTO   |   CANTIDAD   |    UNIDAD    |       D E S C R I P C I O N       |    PRECIO UNITARIO    |  T O T A L   
-----------------------------------------------------------------------------------------------------------------------------------------
<t t-foreach="docs.get_lines_escpos_stock_picking()" t-as="line">
<t t-out="line.ljust(137,' ')"/>
</t>
-----------------------------------------------------------------------------------------------------------------------------------------
</template>
<template id="tmp_body_tax_totals_stock_picking">
<t t-foreach="docs.get_tax_totals_escpos_stock_picking(1)" t-as="line">
<t t-out="line.rjust(137,' ')"/>
</t>
</template>

<template id="tmp_warehouse_stock_picking">





ALMACEN: <t t-out="docs.location_id.location_id.name"/>  ALMACEN DESTINO: <t t-out="docs.location_dest_id.location_id.name"/>
</template>

</odoo>