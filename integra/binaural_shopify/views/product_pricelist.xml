<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="binaural_shopify_view_form" model="ir.ui.view">
        <field name="name">binaural.shopify.view.form</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button string="Update product price" type="object" name="action_set_product_price"/>
                </header>
            </xpath>
            
        </field>
    </record>

</odoo>
