<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_form_binaural_stock_accountant" model="ir.ui.view">
        <field name="name">view.account.move.form.binaural.stock.accountant</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="after">
                <field name="liters_per_unit_total" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
