<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="paperformat_nota_despacho" model="report.paperformat">
            <field name="name">Nota de Despacho</field>
            <field name="format">Letter</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">95</field>
            <field name="margin_left">2</field>
            <field name="margin_right">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">3</field>
            <field name="dpi">80</field>
        </record>

        <record id="dispatch_note_binaural_ft" model="ir.actions.report">
            <field name="name">Dispatch Note</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">binaural_ft.dispatch_note_binaural_ft_template</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="paperformat_id" ref="binaural_ft.paperformat_nota_despacho"/>
        </record>
        
        <template id="dispatch_note_binaural_ft_template">
            <t t-set="pos" t-value="docs.pos_order_id"/>
            <t t-set="sale" t-value="docs.sale_id"/>
            <t t-set="company" t-value="env.company"/>
            <t t-set="user" t-value="env.user.partner_id"/>
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <style>
                        @font-face{
                            font-family: "IBM";
                            src: url('/binaural_ft/static/src/fonts/IBMPlexMono-Medium.ttf') format("truetype");
                        }
                        * {
                            font-size: 12px !important;
                            letter-spacing: 1.4px;
                            font-family: "IBM" !important;
                        }

                        table {
                            width: 100%;
                            border-collapse: collapse;
                            border: 1px solid #CBCBCB;
                        }

                        .tr-back {background-color: #f2f2f2;}

                        #table-report th {
                            border: 1px solid black;
                            background-color: #CBCBCB;
                            text-align:center;
                            }
                        
                        .tr-inside {
                            padding-top: 20px;
                            padding-bottom: 20px;
                            border-top: 1px solid #CBCBCB;
                        }
                                
                        #total-tr{
                            border: 1px solid #ADADAD;
                        }

                    </style>
                    <div class="page">
                        <div class="row border border-dark mb-1 p-2">
                            <div class="col-3 text-center">
                                <img t-if="company.logo"
                                    t-att-src="image_data_uri(company.logo)"
                                    style="width: 180px;height: 100px"/>
                            </div>
                            <div class="col-5 p-1">
                                <label t-out="company.name"/><br/>
                                <label>RIF: <t t-out="company.vat"/></label><br/>
                                <div class="text-center">
                                    <strong>
                                        <label>DISPATCH NOTE FORMAT</label>
                                    </strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <label>User: <t t-out="user.name"/></label><br/>
                                <label>Date: 
                                </label><br/>
                            </div>
                        </div>
                        <div class="row border border-dark mb-1 p-2">
                            <div class="col-6 gap-3">
                                <div class="row gap-3">
                                    <div class="col-4 text-end">
                                        <label>Cliente:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.partner_id.name"/><br/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>RIF:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.partner_id.vat"/><br/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Street:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                            <t t-out="docs.partner_id.street"/><br/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Seller:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-if="pos">
                                            <t t-out="pos.user_id.name"/><br/>
                                        </t>
                                        <t t-if="sale">
                                            <t t-out="sale.user_id.name"/><br/>
                                        </t>
                                    </div>
                                </div>
                                <div class="row gap-3">
                                    <div class="col-4 text-end">
                                        <label>Transport:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-if="docs.carrier_id" t-out="docs.carrier_id.name"/>
                                        <label t-else="">Sin Asignar</label><br/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Dispatch note:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.name"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Date E:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.scheduled_date"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Date V:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.date_done"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Cond. Pay:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-if="pos">
                                            <label>Contado</label>
                                        </t>
                                        <t t-if="sale">
                                            <t t-out="sale.payment_term_id.name"/>
                                        </t>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                    <label>Description:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                    <t t-out="docs.note"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                    <label>Currency:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                    <t t-out="company.currency_id.name+''+company.currency_id.symbol"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Invoice Origin:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-if="pos and pos.account_move">
                                            <t t-out="pos.account_move.name"/>
                                        </t>
                                        <t t-if="sale and sale.invoice_ids">
                                            <t t-out="sale.invoice_ids[0].name"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row ">
                            <div class="col-1 p-1 border border-dark">
                                Code
                            </div>
                            <div class="col-7 p-1 border border-dark">
                                Description
                            </div>
                            <div class="col-2 p-1 border border-dark">
                                Warehouse
                            </div>
                            <div class="col-1 p-1 border border-dark">
                                Qty
                            </div>
                            <div class="col-1 p-1 border border-dark">
                                Unit
                            </div>
                        </div>

                        <t t-if="docs.move_ids_without_package">
                            <t t-foreach="docs.move_ids_without_package" t-as="product">
                                <div class="row p-1">
                                    <div class="col-1 ">
                                        <t t-out="product.product_id.default_code"/>
                                    </div>
                                    <div class="col-7">
                                        <t t-out="product.product_id.name"/>
                                    </div>
                                    <div class="col-2">
                                        <t t-out="product.warehouse_id.code"/>
                                    </div>
                                    <div class="col-1">
                                        <t t-out="product.quantity_done"/>
                                    </div>
                                    <div class="col-1">
                                        <t t-out="product.product_uom.name"/>
                                    </div>
                                </div>
                                <t t-set="has_lot" t-value="False"/>
                                <t t-foreach="docs.move_line_ids_without_package" t-as="product_d">
                                    <t t-if="product_d.lot_id and product.product_id.id == product_d.product_id.id">
                                        <t t-set="has_lot" t-value="True"/>
                                    </t>
                                </t>
                                <div class="row" t-if="has_lot">
                                    <strong>Serial: </strong>
                                    <t t-foreach="docs.move_line_ids_without_package" t-as="product_d">
                                        <t t-out="product_d.lot_id.name + ','" t-if="product_d.lot_id and product.product_id.id == product_d.product_id.id"/>
                                    </t>
                                </div>
                            </t>
                        </t>

                    </div>
                </t>
            </t>
        </template>
    </data>

</odoo>
