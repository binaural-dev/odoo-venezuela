<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="paperformat_nota_entrega" model="report.paperformat">
            <field name="name">Nota de Entrega</field>
            <field name="format">Letter</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">3</field>
            <field name="dpi">100</field>
        </record>

        <record id="delivery_note_binaural_ft" model="ir.actions.report">
            <field name="name">Nota de Entrega</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">binaural_ft.delivery_note_binaural_ft_template</field>
            <field name="binding_model_id" ref="account.model_account_move" />
            <field name="paperformat_id" ref="binaural_ft.paperformat_nota_entrega"/>
        </record>
        
        <template id="delivery_note_binaural_ft_template">
            <!-- <t t-set="pos" t-value="docs.pos_order_id"/> -->
            <t t-set="company" t-value="env.company"/>
            <t t-set="user" t-value="env.user.partner_id"/>
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <style>
                        * {
                            font-size: 14px !important;
                        }
                        table {
                            width: 100%;
                            border-collapse: collapse;
                            border: 1px solid #CBCBCB;
                        }

                        .tr-back {background-color: #f2f2f2;}

                        #table-report th {
                            border: 1px solid black;
                            background-color: #CBCBCB;
                            text-align:center;
                            }
                        
                        .tr-inside {
                            padding-top: 20px;
                            padding-bottom: 20px;
                            border-top: 1px solid #CBCBCB;
                        }
                                
                        #total-tr{
                            border: 1px solid #ADADAD;
                        }

                    </style>
                    <div class="page">
                        <div class="row border border-dark mb-1 p-2">
                            <div class="col-3 pt-3 text-center">
                                <img t-if="company.logo"
                                    t-att-src="image_data_uri(company.logo)"
                                    style="width: 180px;height: 100px"/>
                            </div>
                            <div class="col-5 p-1">
                                <label t-out="company.name"/><br/>
                                <label>RIF: <t t-out="company.vat"/></label><br/>
                                <br/>
                                <div class="text-center">
                                    <strong>FORMATO NOTA DE ENTREGA (OM)</strong>
                                </div>
                            </div>
                            <div class="col-4">
                                <label>User: <t t-out="user.name"/></label><br/>
                                <label>Date: 
                                <t t-out="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
                                </label><br/>
                            </div>
                        </div>
                        <div class="row border border-dark mb-1 p-2">
                            <div class="col-6 gap-3">
                                <div class="row gap-3">
                                    <div class="col-4 text-end">
                                        <label>Cliente:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.partner_id.name"/><br/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>RIF:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.partner_id.vat"/><br/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Telefonos:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.partner_id.phone"/><br/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Direccion:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                            <t t-out="docs.partner_id.contact_address_complete"/><br/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Vendedor:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.user_id.name"/><br/>
                                    </div>
                                </div>
                                <div class="row gap-3">
                                    <div class="col-4 text-end">
                                        <label>Transporte:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Nota de entrega:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.name"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Date E:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.invoice_date"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Date V:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-out="docs.invoice_date_due"/>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                        <label>Cond. Pay:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                        <t t-if="docs.invoice_payment_term_id">
                                            <label t-field="docs.invoice_payment_term_id"/>
                                        </t>
                                        <t t-else="">
                                            <label>Contado</label>
                                        </t>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                    <label>Descripción:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-4 text-end">
                                    <label>Currency:</label>
                                    </div>
                                    <div class="col-8 ms-2">
                                    <t t-out="company.currency_id.name+''+company.currency_id.symbol"/>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <div class="row text-center border border-dark">
                            <div class="col-1 p-1 border-end border-dark">Codigo</div>
                            <div class="col-2 p-1 border-end border-dark">Descripción</div>
                            <div class="col-2 row">
                                <div class="col-3 p-1 border-end border-dark">Alm.</div>
                                <div class="col-6 p-1 border-end border-dark">Cantidad</div>
                                <div class="col-3 p-1 border-end border-dark">Unid</div>
                            </div>
                            <div class="col-1 p-1 border-end border-dark">Precio</div>
                            <div class="col-1 p-1 border-end border-dark">% Desc.</div>
                            <div class="col-1 p-1 border-end border-dark">Desc</div>
                            <div class="col-1 p-1 border-end border-dark">% I.V.A</div>
                            <div class="col-1 p-1 border-end border-dark">I.V.A</div>
                            <div class="col-1 p-1">Neto</div>
                        </div>
                        <div class="border border-dark">
                            <t t-set="discount_amount" t-value="0"/>
                            <t t-set="max_qty" t-value="docs.company_id.max_product_invoice"/> 
                            <t t-foreach="docs.invoice_line_ids" t-as="line">
                                <div class="row">
                                    <div class="col-1 p-1 border-end border-dark">
                                        <span t-field="line.product_id.default_code"/>
                                    </div>
                                    <div class="col-2 p-1 border-end border-dark">
                                        <span t-field="line.name"/>
                                    </div>
                                    <div class="col-2 row">
                                        <div class="col-3 p-1 border-end border-dark">
                                            <t t-out="line.move_id.warehouse_id.code"/>
                                        </div>
                                        <div class="col-6 p-1 border-end border-dark">
                                            <span t-field="line.quantity"/>
                                        </div>
                                        <div class="col-3 p-1 border-end border-dark text-end">
                                            <span t-field="line.product_uom_id.name"/>
                                        </div>
                                    </div>
                                    <div class="col-1 p-1 border-end border-dark text-end">
                                        <span t-field="line.price_unit"/>
                                    </div>
                                    <div class="col-1 p-1 border-end border-dark text-end">
                                        <span t-field="line.discount"/>
                                    </div>
                                    <div class="col-1 p-1 border-end border-dark text-end">
                                        <t t-set="discount" t-value="(line.price_unit * line.quantity) * (line.discount / 100)"/>
                                        <t t-set="discount_amount" t-value="discount_amount + discount"/>
                                        <span t-out="'{0:,.2f}'.format(discount).replace(',', '@').replace('.', ',').replace('@', '.')"/>
                                    </div>
                                    <div class="col-1 p-1 border-end border-dark text-end">
                                        <span t-out="'{0:,.2f}'.format(line.tax_ids.amount).replace(',', '@').replace('.', ',').replace('@', '.')"/>
                                    </div>
                                    <div class="col-1 p-1 border-end border-dark text-end">
                                        <span t-out="'{0:,.2f}'.format(line.price_unit * (line.tax_ids.amount / 100)).replace(',', '@').replace('.', ',').replace('@', '.')"/>
                                    </div>
                                    <div class="col-2 p-1 border-dark text-end">
                                        <span t-field="line.price_total"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <br/>


                        <t t-set="invoice" t-value="docs"/>
                        <div id="total" class="row">
                            <div t-attf-class="#{'col-7' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-borderless border-dark" style="page-break-inside: avoid;font-size:17px">
                                    <!--Tax totals-->
                                    <t t-set="tax_totals" t-value="invoice.tax_totals"/>
                                    <t>
                                        <t t-set="str_tax" t-value="'subtotals'"/>
                                        <t t-foreach="tax_totals[str_tax]" t-as="subtotal">
                                            <tr class="border-black o_subtotal">
                                                <td style="width:400px"><strong t-esc="subtotal['name']"/></td>
                                                <td class="text-end">
                                                    <span
                                                        t-att-class="oe_subtotal_footer_separator"
                                                        t-esc="subtotal['formatted_amount']"
                                                    />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <span class="text-nowrap">Descuentos</span> 
                                                </td>
                                                <td class="text-end o_price_total" style="margin-start:5px"> 
                                                   $ <span t-out="'{0:,.2f}'.format(discount_amount).replace(',', '@').replace('.', ',').replace('@', '.')"/>
                                                </td>
                                            </tr>
                                            <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                                            <t>
                                                <t t-set="str_tax" t-value="'groups_by_subtotal'"/>
                                                <t t-foreach="tax_totals[str_tax][subtotal_to_show]" t-as="amount_by_group">
                                                    <tr>
                                                        <t t-if="tax_totals['display_tax_base']">
                                                            <td style="width:400px">
                                                                <span t-esc="amount_by_group['tax_group_name']"/>
                                                                <span class="text-nowrap"> on
                                                                    <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                                                                </span>
                                                            </td>
                                                            <td class="text-end o_price_total">
                                                                <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']"/>
                                                            </td>
                                                        </t>
                                                        <t t-else="">
                                                            <td><span class="text-nowrap" t-esc="amount_by_group['tax_group_name']"/>
                                                                <span class="text-nowrap"> on
                                                                    <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                                                                </span> 
                                                            </td>
                                                            <td class="text-end o_price_total" style="margin-start:5px"> 
                                                                <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']" />
                                                            </td>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                        <tr class="border-black o_total">
                                            <td><strong>Neto</strong></td>
                                            <td class="text-end">
                                                <t>
                                                    <span t-esc="tax_totals['formatted_amount_total']"/>
                                                </t>
                                            </td>
                                        </tr>
                                        </t>
                                </table>
                            </div>
                        </div>
                </t>
            </t>
        </template>
    </data>

</odoo>
