<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="binaural_invoice.invoice_free_form_paperformat_binaural_invoice" model="report.paperformat">
        <field name="format">Letter</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">55</field>
    </record>


    <template id="freform" inherit_id="binaural_invoice.report_freeform_document">
        <xpath expr="." position="replace">
            <div>
                <t t-set="company" t-value="env.company"/>
                <t t-set="user" t-value="env.user.partner_id"/>
                <style>
                    * {
                        font-size: 14px !important;
                    }
                </style>
                <div class="row border border-dark mb-1">
                    <div class="col-6 gap-3">
                        <div class="row gap-3">
                            <div class="col-4 text-end">
                                <label>Cliente:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-out="docs.partner_id.name"/><br/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-end">
                                <label>RIF:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-out="docs.partner_id.vat"/><br/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-end">
                                <label>Telefonos:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-out="docs.partner_id.phone"/><br/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-end">
                                <label>Direccion:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-out="docs.partner_id.contact_address_complete"/><br/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-end">
                                <label>Vendedor:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-out="docs.user_id.name"/><br/>
                            </div>
                        </div>
                        <div class="row gap-3">
                            <div class="col-4 text-end">
                                <label>Transporte:</label>
                            </div>
                            <div class="col-8 ms-2">
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="row">
                            <div class="col-4 text-end">
                                <label>Nº de Factura:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-out="docs.name"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-4 text-end">
                                <label>Fecha Emisión:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-out="docs.invoice_date"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-4 text-end">
                                <label>Fecha Ven:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-out="docs.invoice_date_due"/>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-4 text-end">
                                <label>Cond. de Pago:</label>
                            </div>
                            <div class="col-8 ms-2">
                                <t t-if="docs.invoice_payment_term_id">
                                    <label t-field="docs.invoice_payment_term_id"/>
                                </t>
                                <t t-else="">
                                    <label>Contado</label>
                                </t>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="row text-center border border-dark">
                            <div class="col-1 p-1 border-end border-dark">Codigo</div>
                            <div class="col-2 p-1 border-end border-dark">Descripción</div>
                            <div class="col-2 row">
                                <div class="col-3 p-1 border-end border-dark">Alm.</div>
                                <div class="col-6 p-1 border-end border-dark">Cantidad</div>
                                <div class="col-3 p-1 border-end border-dark">Unid</div>
                            </div>
                            <div class="col-1 p-1 border-end border-dark">Precio</div>
                            <div class="col-1 p-1 border-end border-dark">% Desc.</div>
                            <div class="col-1 p-1 border-end border-dark">Desc</div>
                            <div class="col-1 p-1 border-end border-dark">% I.V.A</div>
                            <div class="col-1 p-1 border-end border-dark">I.V.A</div>
                            <div class="col-2 p-1">Neto</div>
                        </div>
                        <div>
                            <t t-set="discount_amount" t-value="0"/>
                            <t t-set="max_qty" t-value="docs.company_id.max_product_invoice"/> 
                            <t t-foreach="docs.invoice_line_ids" t-as="line">
                                <div class="row">
                                    <div class="col-1 p-1">
                                        <span t-field="line.product_id.default_code"/>
                                    </div>
                                    <div class="col-2 p-1">
                                        <span t-field="line.name"/>
                                    </div>
                                    <div class="col-2 row">
                                        <div class="col-3 p-1">
                                            <t t-out="line.move_id.warehouse_id.code"/>
                                        </div>
                                        <div class="col-6 p-1">
                                            <span t-field="line.quantity"/>
                                        </div>
                                        <div class="col-3 p-1 text-end">
                                            <span t-field="line.product_uom_id.name"/>
                                        </div>
                                    </div>
                                    <div class="col-1 p-1 text-end">
                                        <span t-field="line.foreign_price"/>
                                    </div>
                                    <div class="col-1 p-1 text-end">
                                        <span t-field="line.discount"/>
                                    </div>
                                    <div class="col-1 p-1 text-end">
                                        <t t-set="discount" t-value="(line.foreign_price * line.quantity) * (line.discount / 100)"/>
                                        <t t-set="discount_amount" t-value="discount_amount + discount"/>
                                        <span t-out="'{0:,.2f}'.format(discount).replace(',', '@').replace('.', ',').replace('@', '.')"/>
                                    </div>
                                    <div class="col-1 p-1 text-end">
                                        <span t-out="'{0:,.2f}'.format(line.tax_ids.amount).replace(',', '@').replace('.', ',').replace('@', '.')"/>
                                    </div>
                                    <div class="col-1 p-1 text-end">
                                        <span t-out="'{0:,.2f}'.format(line.foreign_price * (line.tax_ids.amount / 100)).replace(',', '@').replace('.', ',').replace('@', '.')"/>
                                    </div>
                                    <div class="col-2 p-1 text-end">
                                        <span t-field="line.foreign_price_total"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <br/>


                        <t t-set="invoice" t-value="docs"/>
                        <div id="total" class="row footer">
                            <div t-attf-class="#{'col-7' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-borderless border-dark" style="page-break-inside: avoid;font-size:17px">
                                    <!--Tax totals-->
                                    <t t-set="tax_totals" t-value="invoice.tax_totals"/>
                                    <t>
                                        <t t-set="str_tax" t-value="'foreign_subtotals'"/>
                                        <t t-foreach="tax_totals[str_tax]" t-as="subtotal">
                                            <tr class="border-black o_subtotal">
                                                <td style="width:400px"><strong t-esc="subtotal['name']"/></td>
                                                <td class="text-end">
                                                    <span
                                                        t-att-class="oe_subtotal_footer_separator"
                                                        t-esc="subtotal['formatted_amount']"
                                                    />
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <span class="text-nowrap">Descuentos</span> 
                                                </td>
                                                <td class="text-end o_price_total" style="margin-start:5px"> 
                                                    <span t-out="'{0:,.2f}'.format(discount_amount).replace(',', '@').replace('.', ',').replace('@', '.')"/>
                                                    <span t-out="line.foreign_currency_id.symbol"/>
                                                </td>
                                            </tr>
                                            <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
                                            <t>
                                                <t t-set="str_tax" t-value="'groups_by_foreign_subtotal'"/>
                                                <t t-foreach="tax_totals[str_tax][subtotal_to_show]" t-as="amount_by_group">
                                                    <tr>
                                                        <t t-if="tax_totals['display_tax_base']">
                                                            <td style="width:400px">
                                                                <span t-esc="amount_by_group['tax_group_name']"/>
                                                                <span class="text-nowrap"> de
                                                                    <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                                                                </span>
                                                            </td>
                                                            <td class="text-end o_price_total">
                                                                <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']"/>
                                                            </td>
                                                        </t>
                                                        <t t-else="">
                                                            <td><span class="text-nowrap" t-esc="amount_by_group['tax_group_name']"/>
                                                                <span class="text-nowrap"> de
                                                                    <t t-esc="amount_by_group['formatted_tax_group_base_amount']"/>
                                                                </span> 
                                                            </td>
                                                            <td class="text-end o_price_total" style="margin-start:5px"> 
                                                                <span class="text-nowrap" t-esc="amount_by_group['formatted_tax_group_amount']" />
                                                            </td>
                                                        </t>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                        <tr class="border-black o_total">
                                            <td><strong>Neto</strong></td>
                                            <td class="text-end">
                                                <t>
                                                    <span t-esc="tax_totals['foreign_formatted_amount_total']"/>
                                                </t>
                                            </td>
                                        </tr>
                                        </t>
                                </table>
                            </div>
                        </div>
            </div>
        </xpath>

    </template>
</odoo>
