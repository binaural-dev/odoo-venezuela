<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="binaural_pos_mf.pos_payment_method_view_form"/> 
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code_fiscal_printer']" position="after">
                <field name="payment_name_in_mf"/>
            </xpath>
        </field>
    </record>

</odoo>
