<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.commissions</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
            <field name="arch" type="xml">
		<xpath expr="//div[@name='binaural_rate_settings']" position="after">
		    <h2>Commissions Configuration</h2>
		    <div class="row mt16 o_settings_container" name="binaural_commissions_settings_container_1">
                        <div id="commission_invoice_date_field"
                             class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="commission_invoice_date_field"/>
                                <div class="text-muted">
                                    Compute commission from date of
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="commission_invoice_date_field" class="o_light_label" widget="radio"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="commission_product">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Commission Product</span>
                                <div class="text-muted">
                                    Product used for commissions computation
                                </div>
                                <div class="text-muted">
				    <field name="commission_product_id"
					   context="{'default_detailed_type': 'service'}"
					   domain="[('detailed_type', '=', 'service')]"/>
                                </div>
                            </div>
                        </div>
                    </div>
		    <div class="row mt16 o_settings_container" name="binaural_commissions_settings_container_2">
                        <div id="compute_commission_when"
                            invisible="1"
                             class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="compute_commission_when"/>
                                <div class="text-muted">
                                    Moment when commission is computed
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="compute_commission_when" class="o_light_label" widget="radio" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="status_invoice_commission"
                            class="col-12 col-lg-6 o_setting_box"
                            attrs="{'invisible': [('commission_payment_through','!=','commission_invoice')]}">
                            <div class="o_setting_right_pane">
                                <label for="in_invoice_status_commission"/>
                                <div class="text-muted">
                                    state of invoice payment of commission
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="in_invoice_status_commission" class="o_light_label" widget="radio"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="commission_journal">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Commission Journal</span>
                                <div class="text-muted">
                                    Journal used for commissions computation
                                </div>
                                <div class="text-muted">
				    <field name="commission_journal_id"
					   domain="[('type', '=', 'purchase')]"
					   context="{'default_type': 'purchase'}"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 o_setting_box" id="commission_order">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Order Commission</span>
                                <div class="text-muted">
                                    Configure the order of commissions assignment
                                </div>
                                <div class="mt16">
                                    <button name="action_edit_commission_policy_type_order" 
                                        type="object" 
                                        icon="fa-level-down"
                                        string="Commission Order"/>
                                </div>
                            </div>
                        </div>
                    </div>
		    <div class="row mt16 o_settings_container" name="binaural_commissions_settings_container_3">
                        <div id="compute_commission_when"
                            invisible="1"
                             class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="commission_payment_through"/>
                                <div class="text-muted">
                                    Pay the commissions using
                                </div>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="commission_payment_through" class="o_light_label" widget="radio"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
