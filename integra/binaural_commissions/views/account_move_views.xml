<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="commission_sale_invoice_filter" model="ir.ui.view">
    <field name="name">commission.sale.invoice.filter</field>
    <field name="mode">primary</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter"/>
    <field name="arch" type="xml">
        <xpath expr="//filter[@name='duedate']" position='after'>
            <separator/>
            <filter name="group_seller_id" string="Seller" context="{'group_by':'seller_id'}"/>
            <separator/>
        </xpath>
    </field>
</record>

<record id="view_account_move_form_binaural_invoice" model="ir.ui.view">
    <field name="name">account.move.form</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="binaural_invoice.view_account_move_form_binaural_invoice"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='invoice_reception_date']" position="attributes">
            <attribute name="attrs">{'required': [('commission_invoice_date_field','=','invoice_reception_date'),('move_type','=','out_invoice')]}</attribute>
        </xpath>
        <xpath expr="//field[@name='correlative']" position="attributes">
            <attribute name="attrs">{
                        'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund', 'in_invoice', 'in_refund'])],
                        'readonly':  ['|', '&amp;', ('move_type', 'in', ['out_invoice', 'out_refund']), ('is_contingency', '=', False), ('state', '=', 'posted')],
                        'required':  [('move_type', 'in', ['in_invoice', 'in_refund']), ('is_commission_invoice', '!=', True)]
                    }
            </attribute>
        </xpath>
    </field>
</record>

<record id="view_move_form" model="ir.ui.view">
    <field name="name">account.move.form</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div[@name='journal_div']" position="after">
            <field name="collection_days" attrs="{'invisible': [('move_type', '!=','out_invoice')]}"/>
            <field name="commission_payment_state" widget="badge" decoration-muted="commission_payment_state == 'not_paid'"
                   decoration-success="commission_payment_state == 'paid'" decoration-info="commission_payment_state == 'process'"
                   optional="show" string="Payment State (Commission)" attrs="{'invisible': [('move_type', '!=','out_invoice')]}"/>
            <field name="total_commission" widget="monetary" attrs="{'invisible': [('move_type', '!=','out_invoice')]}"/>
            <field name="commission_invoice_date_field" invisible="1"/>
            <field name="compute_commission_when" invisible="1"/>
            <field name="last_payment_date" string="Last Payment Date" invisible="1"/>
            <field name="first_payment_date" string="First Payment Date" invisible="1"/>
            <field name="commission_invoice" readonly="1" attrs="{'invisible': [('move_type', '!=','out_invoice')]}"/>
            <field name="is_commission_invoice" invisible="1"/>
        </xpath>
        <xpath expr="//notebook" position="inside">
            <page id="origin_commission_tab" name="origin_commission_tab" string="Origin commissions" attrs="{'invisible': [('is_commission_invoice', '!=', True)]}">
                <field name="origin_commission_invoice" mode="tree">
                    <tree editable="bottom" string="Journal Items">
                        <field name="name"/>
                        <field name="total_commission" widget="monetary" sum="Total Commission"/>
                    </tree>
                </field>
            </page>
        </xpath>
    </field>
</record>

<record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
    <field name="domain">[('move_type', '=', 'in_invoice'),("is_commission_invoice", "=",False)]</field>
</record>

<record id="commission_sale_invoices_tree_view" model="ir.ui.view">
    <field name="name">commission.sale.invoices.tree</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_invoice_tree"/>
    <field name="mode">primary</field>
    <field name="arch" type="xml">
	
	<tree position="attributes">
	    <attribute name="create">false</attribute>
	</tree>

        <xpath expr="//field[@name='name']" position="after">
            <field name="invoice_origin" invisible="1"/>
	    <field name="partner_id" string="Customer"/>
            <field name="commission_invoice" widget="tagged" string="Commission Invoice"/>
        </xpath>

        <xpath expr="//field[@name='state']" position="attributes">
            <field name="optional">1</field>
        </xpath>

        <xpath expr="//field[@name='amount_total_signed']" position="before">
            <button name="show_invoice_resume" icon="fa-list" string="Commissions" type="object"/> 
            <field name="total_commission" widget="monetary"/>
            <field name="commission_discount"/>
        </xpath>

        <xpath expr="//field[@name='invoice_date']" position="after">
	    <field name="seller_id"/>
            <field name="last_payment_date" string="Last Payment Date"/>
            <field name="collection_days" string="Días de cobro"/>
            <field name="invoice_payment_term_id" invisible="1"/>
        </xpath>

        <xpath expr="//field[@name='amount_total_signed']" position="after">
            <field name="commission_payment_state" widget="badge" decoration-muted="commission_payment_state == 'not_paid'"
                   decoration-success="commission_payment_state == 'paid'" decoration-info="commission_payment_state == 'process'"
                   optional="show" string="Payment State (Commission)"/>
        </xpath>

        <xpath expr="//field[@name='payment_state']" position="attributes">
            <attribute name="string">Payment State (Client Invoice)</attribute>
        </xpath>

        <xpath expr="//field[@name='invoice_date_due']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='activity_ids']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//field[@name='amount_untaxed_signed']" position="attributes">
            <attribute name="invisible">0</attribute>
        </xpath>
        <xpath expr="//field[@name='company_id']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
    </field>
</record>

<record id="commission_invoice_action" model="ir.actions.act_window">
    <field name="name">Commission / Invoice Commission</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">
	[
	    ("move_type", "=", "in_invoice"),
        ("is_commission_invoice", "=", True),
	]
    </field>
	    <!-- ("date_reception", "!=", False) -->
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            There are no invoices for commissions payment!
        </p>
    </field>
</record>


<record id="commission_sale_invoices_action" model="ir.actions.act_window">
    <field name="name">Sale Invoices Per Seller</field>
    <field name="res_model">account.move</field>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="commission_sale_invoices_tree_view"/>
    <field name="search_view_id" ref="commission_sale_invoice_filter"/>
    <field name="context">{"search_default_group_seller_id": 1}</field>
    <field name="domain">
	[
	    ("move_type", "=", "out_invoice"),
	    ("payment_state", "in", ("paid", "in_payment")),
	    ("seller_id", "!=", False)
	]
    </field>
	    <!-- ("date_reception", "!=", False) -->
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            There are no applicable invoices for commissions payment!
        </p>
    </field>
</record>

</odoo>
