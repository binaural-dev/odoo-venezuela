<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="commission_policy_tree_view" model="ir.ui.view">
    <field name="name">commission.policy.tree.view</field>
        <field name="model">commission.policy</field>
        <field name="arch" type="xml">
            <tree string="Commission Policy">
                <field name="display_name"/>
                <field name="policy_type_name" 
                    widget="badge" 
                    decoration-primary="policy_type_name=='client'"
                    decoration-success="policy_type_name=='product'" 
                    decoration-danger="policy_type_name=='pricelist'" 
                    decoration-warning="policy_type_name=='all'"/>
                <field name="commission_line_ids"/>
            </tree>
        </field>
</record>

<record id="commission_policy_form_view" model="ir.ui.view">
    <field name="name">commission.policy.form.view</field>
    <field name="model">commission.policy</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <div class="oe_title oe_edit_only">
                    <label for="name"/>
                    <h1 class="oe_edit_only">
                        <field name="name"/>
                    </h1>
                </div>
                <div class="oe_title oe_read_only">
                    <h1 class="">
                        <field name="display_name"/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="policy_type_id" options="{'no_create': True,'no_create_edit': True}"/>
                        <field name="policy_type_name" invisible="1"/>
                        <field name="policy_type" invisible="1"/>
                    </group>
                    <group>
                    </group>
                </group>
                <notebook>
                    <page string="Commissions Range">
                        <field name="commission_line_ids"/>
                        <group col="3" string="Legend (Type of Commission)">
                            <group>
                                <field colspan="2" name="text_priority" nolabel="1"/>
                            </group>
                            <group>
                                <span colspan="2" class="oe_title">Product Commission, apply to</span>
                                <span colspan="2">- Product (Priority 1)</span>
                                <span colspan="2">- Marca (Priority 2)</span>
                                <span colspan="2">- Category (Priority 3)</span>
                            </group>
                        </group>
                    </page>
                    <page string="Products" attrs="{'invisible': [('policy_type', '!=','product')]}">
                    <field name="commission_product_item_ids" mode="tree" options="{'no_create': True, 'no_create_edit':True}">
                        <tree>
                            <field name="applied_on"/>
                            <field name="name"/>
                            <field name="len_category_sub_category" invisible="1"/>
                        </tree>
                    </field>
                    </page>
		    <page string="Clients"
			  attrs="{'invisible': [('policy_type_name', '!=', 'client')]}">
                <field name="clients_id"/>
		    </page>
		    <page string="Pricelists"
			  attrs="{'invisible': [('policy_type_name', '!=', 'pricelist')]}">
                <field name="pricelist_ids"/>
		    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="commission_policy_action" model="ir.actions.act_window">
    <field name="name">Commission Policy</field>
    <field name="res_model">commission.policy</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Create a new commission policy!
        </p>
    </field>
</record>
</odoo>
