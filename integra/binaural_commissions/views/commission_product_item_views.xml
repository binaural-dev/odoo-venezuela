<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="commission_product_item_form_view" model="ir.ui.view">
        <field name="name">commission.product.item.form.view</field>
        <field name="model">commission.product.item</field>
        <field name="arch" type="xml">
            <form string="Commission Policy">
                <sheet>
                    <group>
                        <group>
                            <field name="applied_on" widget="radio"/>
                        </group>
                        <group>
                            <field name="product_id" domain="[('commission_item_ids', '=',False)]" attrs="{'invisible': [('applied_on','!=', '1_product')]}"/>
                            <field name="excluded" attrs="{'invisible': [('applied_on','!=', '1_product')]}"/>
                            <field name="brand_id" domain="[('commission_item_ids', '=',False)]" attrs="{'invisible': [('applied_on','!=', '2_brand')]}"/>
                            <button name="show_products_brands" icon="fa-list" string="Show Products" type="object" attrs="{'invisible': [('applied_on','!=', '2_brand')]}"/> 
                            <field name="category_id" domain="[('commission_item_ids', '=',False)]" attrs="{'invisible': [('applied_on','!=', '3_category')]}"/>
                            <button name="show_products_categories" icon="fa-list" string="Show Products" type="object" attrs="{'invisible': [('applied_on','!=', '3_category')]}"/> 
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
