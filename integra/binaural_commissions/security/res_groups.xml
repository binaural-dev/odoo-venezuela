<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_policy_commissions">
            <field name="name">Policy Commissions</field>
            <field name="sequence">22</field>
        </record>

        <record id="group_commission_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="binaural_commissions.module_category_policy_commissions"/>
        </record>

        <record id="group_commission_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="binaural_commissions.module_category_policy_commissions"/>
            <field name="implied_ids" eval="[(4, ref('binaural_commissions.group_commission_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
