<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="generate_commission_from_invoice" model="ir.ui.view">
        <field name="name">generate.commission.from.invoice</field>
        <field name="model">generate.commission.from.invoice</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="invoice_type" widget="radio"/>
                            <field name="seller_id" readonly="1" invisible="1"/>
                            <field name="seller_ids" invisible="1" />
                        </group>
                        <field name="invoice_ids" mode="tree"  domain="[
                            ('move_type','=','out_invoice'),
                            ('total_commission','!=', 0),
                            ('commission_payment_state','=','not_paid'),
                            ('seller_id','in',seller_ids)
                            ]">
                            <tree>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="seller_id"/>
                                <field name="total_commission" widget="monetary" sum="Total Commission"/>
                                <field name="commission_discount" widget="monetary" sum="Total discount"/>
                                <field name="amount_total" widget="monetary"/>
                                <field name="commission_invoice"/> 
                                <field name="payment_state"/>
                                <field name="commission_payment_state" widget="badge" decoration-muted="commission_payment_state == 'not_paid'" decoration-success="commission_payment_state == 'paid'" decoration-info="commission_payment_state == 'process'" optional="show" string="Payment State (Commission)" />
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
            <footer>
                <button name="create_invoice" type="object" string="Generate"/>
            </footer>
        </field>
    </record>
</odoo>
