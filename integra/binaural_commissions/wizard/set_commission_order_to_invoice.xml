<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="set_commission_order_to_invoice_form" model="ir.ui.view">
        <field name="name">set.commission.order.to.invoice</field>
        <field name="model">set.commission.order.to.invoice</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="overwrite_commission"/>
                            <field name="sale_order_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
            <footer>
                <button name="action_confirm" class="btn-primary" type="object" string="Generate"/>
                <button string="Close" class="btn-secondary" special="cancel"/>
            </footer>
        </field>
    </record>
</odoo>
