<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="set_commission_order_to_invoice_form" model="ir.ui.view">
        <field name="name">set.commission.pos.order.to.invoice</field>
        <field name="model">set.commission.order.to.invoice</field>
        <field name="inherit_id" ref="binaural_commissions.set_commission_order_to_invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_ids']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_pos','=',True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_ids']" position="after">
                <field name="is_pos" invisible="1"/>
                <field name="pos_order_ids" attrs="{'invisible': [('is_pos','!=',True)]}" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
