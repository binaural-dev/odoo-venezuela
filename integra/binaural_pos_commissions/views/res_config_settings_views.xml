<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings" model="ir.ui.view">
            <field name="name">res.config.settings.binaural.pos.commissions</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="100"/>
            <field name="inherit_id" ref="binaural_commissions.res_config_settings"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='binaural_commissions_settings_container_1']" position="after">
                    <div class="row mt16 o_settings_container" name="binaural_commissions_settings_container_pos">
                        <div class="col-12 o_setting_box" id="commission_order">
                            <div class="o_setting_left_pane">
                                <field name="pos_use_image_from_sale_order"/>

                            </div>
                            <div class="o_setting_right_pane">
                                <label for="pos_use_image_from_sale_order"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
