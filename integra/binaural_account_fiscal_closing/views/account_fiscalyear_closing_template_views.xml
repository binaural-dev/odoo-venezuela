<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_fiscalyear_closing_template_tree" model="ir.ui.view">
        <field name="model">account.fiscalyear.closing.template</field>
        <field name="arch" type="xml">
            <tree string="Cierre del año fiscal">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="move_config_ids"/>
            </tree>
        </field>
    </record>

    <record id="view_account_fiscalyear_closing_template_form" model="ir.ui.view">
        <field name="model">account.fiscalyear.closing.template</field>
        <field name="arch" type="xml">
            <form string="Cierre del año fiscal">
                <sheet>
                    <h1 class="oe_title">
                        <label for="name" clas="oe_edit_only"/>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="check_draft_moves"/>
                        </group>
                        <group>
                            <field name="chart_template_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="moves_config" string="Accounting Entry Configuration">
                            <field name="move_config_ids">
                                <tree>
                                    <field name="sequence" widget="handle" />
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="inverse"/>
                                    <field name="move_type"/>
                                    <field name="journal_id"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="move_date"/>
                                                <field name="journal_id"/>
                                                <field name="sequence"/>
                                            </group>
                                            <group>
                                                <field name="code"/>
                                                <field name="inverse"/>
                                                <field name="move_type"/>
                                            </group>
                                        </group>
                                        
                                        <label for="l_map"/>
                                        <div>
                                            <field  name="l_map" string="Load Accounts"/>
                                        </div>
                                        
                                        <notebook>
                                            <page name="accounts_mapping" string="Account Mapping">
                                                <field name="mapping_ids" nolabel="1">
                                                    <!-- <button name="_get_accounts_close">Cargar cuentas</button> -->
                                                    <tree editable="bottom">
                                                        <field name="name"/>
                                                        <field name="src_accounts"/>
                                                        <field name="dest_account"/>
                                                    </tree>
                                                </field>
                                            </page>
                                            <page name="accounts_closing_types" string="Accounts Closing Types">
                                                <group name="accounts_closing_types">
                                                    <field name="closing_type_default"/>
                                                </group>
                                                <field name="closing_type_ids">
                                                    <tree editable="bottom">
                                                        <field name="account_type_id"/>
                                                        <field name="closing_type_default"/>
                                                    </tree>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_fiscalyear_closing_template" model="ir.actions.act_window">
        <field name="name">Plantillas de cierre</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.fiscalyear.closing.template</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- <menuitem id="menu_account_fiscalyear_closing_configuration"
              parent="account.menu_finance_receivables"
              sequence="40"
              name="Cierre del año fiscal"
    /> -->
    <menuitem id="menu_account_fiscalyear_closing_template"
              parent="account.menu_finance_entries"
              sequence="94"
              name="Plantillas de cierre"
              action="action_account_fiscalyear_closing_template"
    />

</odoo>
