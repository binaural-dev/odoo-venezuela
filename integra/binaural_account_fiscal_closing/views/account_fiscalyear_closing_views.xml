<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_fiscalyear_closing_tree" model="ir.ui.view">
        <field name="name">account.fiscalyear.closing.tree</field>
        <field name="model">account.fiscalyear.closing</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="date_opening"/>
                <field name="state"/>
                <field name="calculation_date"/>
            </tree>
        </field>
    </record>

    <record id="view_account_fiscalyear_closing_form" model="ir.ui.view">
        <field name="name">account.fiscalyear.closing.form</field>
        <field name="model">account.fiscalyear.closing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- <button name="button_calculate"
                            type="object"
                            string="Calcular"
                            class="oe_highlight"
                            attrs="{'invisible': ['|', ('stored_template_id', '=', False), ('state', 'not in', ['draft'])]}"
                    />
                    <button name="button_recalculate"
                            states="calculated"
                            type="object"
                            string="Recalcular"
                    />
                    <button name="button_post"
                            type="object"
                            string="Confirmar y publicar movimientos"
                            class="oe_highlight"
                            attrs="{'invisible': ['|', ('move_config_ids', '=', []), ('state', 'not in', ['calculated'])]}"
                    />
                    <button name="button_recover"
                            states="cancelled"
                            type="object"
                            string="Borrador"
                    />
                    <button name="button_cancel"
                            states="calculated,posted"
                            type="object"
                            string="Cancelar"
                            confirm="This will remove all the closing moves. Are you sure you want to continue?"
                    /> -->
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,calculated,posted,cancelled"
                           statusbar_colors="{'cancelled': 'red', 'posted': 'blue'}"
                    />
                </header>
                <sheet>
                    <!-- <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                name="button_open_moves"
                                states="calculated,posted"
                                type="object"
                                string="Mostrar asientos"
                                icon="fa-list"
                        />
                        <button class="oe_stat_button"
                                name="button_open_move_lines"
                                states="calculated,posted"
                                type="object"
                                string="Mostrar líneas de asientos"
                                icon="fa-list"
                        />
                    </div> -->
                    <div class="oe_title">
                        <label for="name" string="Cierre fiscal"/>
                        <field name="name" class="oe_inline"/>
                    </div>
                    <group>
                        <group>
                            <field name="chart_template_id" invisible="1"/>
                            <field name="stored_template_id" invisible="1"/>
                            <field name="is_new_template" invisible="1"/>
                            <!-- <label for="closing_template_id"/>
                            <div>
                                <field name="closing_template_id" class="oe_inline"/>
                                <button name="action_load_template"
                                        type="object"
                                        attrs="{'invisible': [('is_new_template', '=', False)]}"
                                        string="Cargar plantilla"
                                />
                            </div> -->
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="journals_filter" />
                        </group>
                        <group>
                            <field name="year" string="Año"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="date_opening"/>
                            <field name="check_draft_moves"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('calculation_date', '=', False)]}">
                        <group>
                            <field name="calculation_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="moves_config" string="Accounting Entry Configuration">
                            <field name="move_config_ids">

                                <tree>
                                    <field name="sequence" widget="handle" />
                                    <field name="enabled"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="inverse"/>
                                    <field name="move_type"/>
                                    <field name="date"/>
                                    <field name="journal_id"/>
                                </tree>

                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="enabled"/>
                                                <field name="date"/>
                                                <field name="journal_id"/>
                                                <field name="sequence"/>
                                            </group>
                                            <group>
                                                <field name="code"/>
                                                <field name="inverse"/>
                                                <field name="move_type"/>
                                            </group>
                                        </group>
                                        <label for="l_map"/>
                                        <div>
                                            <field  name="l_map" string="Cargar Cuentas"/>
                                        </div>
                                        <notebook>
                                            <page name="accounts_mapping" string="Accounts Mapping">
                                                <field name="mapping_ids">
                                                    <tree editable="bottom">
                                                        <field name="name"/>
                                                        <field name="src_accounts"/>
                                                        <field name="dest_account_id"/>
                                                    </tree>
                                                </field>
                                            </page>
                                            <page name="accounts_closing_types" string="Accounts Closing Types">
                                                <group name="accounts_closing_types">
                                                    <field name="closing_type_default"/>
                                                </group>
                                                <field name="closing_type_ids">
                                                    <tree editable="bottom">
                                                        <field name="account_type"/>
                                                        <field name="closing_type_default"/>
                                                    </tree>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>

                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_fiscalyear_closing_search" model="ir.ui.view">
        <field name="name">account.fiscalyear.closing.search</field>
        <field name="model">account.fiscalyear.closing</field>
        <field name="arch" type="xml">
            <search string="Fiscal year close">
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In process" name="in_process" domain="[('state', '=', 'calculated')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="Company" name="company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_account_fiscalyear_closing" model="ir.actions.act_window">
        <field name="name">Fiscal year close</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.fiscalyear.closing</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_account_fiscalyear_closing_tree" />
    </record>

    <menuitem
        id="account_fiscalyear_closing_menu"
        name="Fiscal year close"
        action="action_account_fiscalyear_closing"
        parent="account.menu_finance_entries"
        sequence="93"/>

</odoo>
