<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_partner_binaural_payment_extension" model="ir.ui.view">
        <field name="name">res.partner.binaural.payment.extension</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="binaural_payment_extension.res_partner_binaural_payment_extension"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='withholding_type_id']" position="replace">
                <field name="is_required_withholding_type_id" invisible="1" />
                <field
                    name="withholding_type_id" 
                    attrs="{'required':[('is_required_withholding_type_id','=', True)]}" 
                />
            </xpath>
        </field>
    </record>
</odoo>