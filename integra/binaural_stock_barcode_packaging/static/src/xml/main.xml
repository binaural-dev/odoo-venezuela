<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="MainComponent" t-inherit="stock_barcode.MainComponent" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_barcode_header')]/div[1]/nav[2]/t[1]" position="before">
            <button t-if="is_picking_type_out" t-on-click="add_packaging" class="o_barcode_actions btn btn-primary nav-link">
                <i class="fa fa-cube"/>
                AGREGAR BULTOS
            </button>

            <button t-if="is_picking_type_out" t-on-click="print_packaging" class="o_barcode_actions btn btn-primary nav-link ms-2">
                <i class="fa fa-print"/>
                IMPRIMIR ETIQUETAS 
            </button>
        </xpath>
    </t>
</templates>
