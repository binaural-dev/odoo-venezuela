<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
    
        <record id="base.main_company" model="res.company">
            <field name="currency_interval_unit">daily</field>
            <field name="currency_provider">bcv</field>
            <field
                name="currency_next_execution_date"
                eval="datetime.datetime.now().replace(
                    day=datetime.datetime.now().day + 1,
                    hour=3,
                    minute=0,
                    second=0
                )"
            />
        </record>
    
    </data>
    

</odoo>
