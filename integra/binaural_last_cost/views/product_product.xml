<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_product_binaural_last_cost" model="ir.ui.view">
        <field name="name">product.product.binaural.last.cost</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_product_stock_tree" />
        <field name="arch" type="xml">
            <field name='display_name' position="after">
                <field name="latest_standard_price" groups="binaural_last_cost.group_show_standard_price"/>
            </field>
        </field>
    </record>

    <record id="product_product_search_last_cost" model="ir.ui.view">
        <field name="name">product.product.search.binaural.last.cost</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_search_form_view_stock_report" />
        <field name="arch" type="xml">
            <filter name="services" position="after">
                <filter string="Last Cost" name="last_cost_filter" 
                domain="[('latest_standard_price', '>', 0)]" groups="binaural_last_cost.group_show_standard_price"
                />
            </filter>
        </field>
    </record>

    <record id="product_product_tree_view_inherit_binaural_last_cost" model="ir.ui.view">
        <field name="name">product.product.view.list.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="qty_available" position="after">
                <field name="latest_standard_price" />
                <field name="value_total_last_cost" widget="monetary" sum="Total Last Cost"/>
            </field>
        </field>
    </record>

</odoo>
