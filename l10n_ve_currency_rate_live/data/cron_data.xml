<odoo>
  <record id="currency_rate_live.ir_cron_currency_update" model="ir.cron">
    <field name="name">Currency: rate update (BCV)</field>
    <field name="model_id" ref="base.model_res_company" />
    <field name="state">code</field>
    <field name="code">model.run_update_bcv_currency()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="numbercall">-1</field>
    <field name="active" eval="True" />
    <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')" />
    <field name="doall" eval="False" />
  </record>

</odoo>
