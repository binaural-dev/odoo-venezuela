<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_zmart" model="ir.ui.view">
        <field name="name">view.sale.order.form.zmart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <button name="action_cancel" position="after">
                <button name="button_sale_order_note" string="Imprimir Presupuesto/Pedido" type="object" class="oe_highlight"/>
                <button name="button_invoice_sale_note_rma" string="Imprimir Nota de Entrega RMA" type="object" class="oe_highlight" groups="sale_zmart.group_sale_note_rma" attrs="{'invisible': [('invoice_status', '!=', 'invoiced')]}"/>
            </button>
            <field name="partner_shipping_id" position="after">
                <field name="discount_4"/>
            </field>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="printed" readonly="True"/>
                <field name="invoice_type" invisible="1"/>
                <field name="priority_sale" required="1"/>
                <field name="shipping_type" required="1"/>
                <field name="shipping_mean" attrs="{'invisible': [('shipping_type', '=', 'withdrawal')], 'required': [('shipping_type', '=', 'shipment')]}" />
                <field name="shipping_method" attrs="{'invisible': [('shipping_type', '=', 'withdrawal')], 'required': [('shipping_type', '=', 'shipment')]}"/>
                <field name="shipping_weight" />
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_quick_create': True}</attribute>
            </field>

            <field name="partner_id" position="after">
                <field name="partner_street" />
            </field>
        </field>
    </record>
    <record id="view_sale_order_tree_zmart" model="ir.ui.view">
        <field name="name">view.sale.order.tree.zmart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="priority_sale"/>
                <field name="shipping_type"/>
                <field name="printed"/>
                <field name="invoice_type"/>
                <field name="shipping_mean"/> 
            </xpath>

        </field>
    </record>
    <record id="view_order_tree_zmart" model="ir.ui.view">
        <field name="name">view.sale.order.tree.zmart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="before">
                <field name="priority_sale"/>
            </xpath>
        </field>
    </record>
    <record id="sale_order_view_search_inherit_quotation_zmart" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.quotation.zmart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_quotation']" position="after">
                <filter name="Facturas" domain="[('invoice_type','=','Factura')]"/>
                <filter name="Notas de entrega" domain="[('invoice_type','=','Nota de Entrega')]"/>
            </xpath>
        </field>
    </record>
</odoo>
