<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="sale_shipping_mean_tree_view" model="ir.ui.view">
        <field name="name">Sale shipping mean tree view</field>
        <field name="model">sale.shipping.mean</field>
        <field name="arch" type="xml">
            <tree string="Sale shipping means" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>


    <record id="sale_shipping_mean_action" model="ir.actions.act_window">
        <field name="name">Sale shipping means</field>
        <field name="res_model">sale.shipping.mean</field>
        <field name="view_mode">tree,form</field>
        <field name="domain"></field>
    </record>

    <!-- Act Tree view -->
    <record id="sale_shipping_mean_tree" model="ir.actions.act_window.view">
        <field name="view_mode">tree</field>
        <field name="view_id" ref="sale_shipping_mean_tree_view"/>
        <field name="act_window_id" ref="sale_shipping_mean_action"/>
    </record>


    <menuitem name="Sale Shipping Mean" parent="sale.menu_sale_config" id="sale_shipping_mean_menu"
              action="sale_shipping_mean_action" sequence="3"/>

</odoo>
