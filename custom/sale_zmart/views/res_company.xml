<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inher_zmart" model="ir.ui.view">
        <field name="name">res.company.form.inherit.account.zmart</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='favicon']" position="after">
                <field name="logo_2" widget="image" class="oe_avatar"/>
            </xpath>
        </field>
    </record>
</odoo>