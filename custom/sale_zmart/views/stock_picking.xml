<odoo>
    <data>
        <record id="view_picking_form_inherited_zmart_binaural" model="ir.ui.view">
            <field name="name">stock.picking.form.zmart</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="binaural_stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='package_qty']" position="replace">
                    <field name="package_qty" attrs="{'invisible': [('sequence_code', '!=', 'PACK'), ('sequence_code', '!=', 'OUT')], 'readonly': [('sequence_code', '!=', 'PACK')]}"/>
                </xpath>
            </field>
        </record>

        <record id="view_picking_form_inherited_zmart" model="ir.ui.view">
            <field name="name">stock.picking.form.zmart</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="guide_sequence" invisible="1"/>
                    <field name="guide" attrs="{'invisible': [('sequence_code', '!=', 'PACK'), ('sequence_code', '!=', 'OUT')], 'readonly': 1}"/>
                    <field name="document_type_invoice"/>
                    <field name="document_number_invoice"/>
                </field>
                <field name="user_id" position="replace">
                    <field name="user_pick_id" attrs="{'invisible': [('sequence_code', '!=', 'PICK')], 'readonly': [('user_pick_id', '!=', False)]}"/>
                    <field name="user_pack_id" attrs="{'invisible': [('sequence_code', '!=', 'PACK')], 'readonly': True}"/>
                    <field name="user_out_id" attrs="{'invisible': [('sequence_code', '!=', 'OUT')], 'readonly': True}"/>
                    <field name="sequence_code" invisible="1"/>
                </field>
                <xpath expr="//button[@name='action_open_label_type']" position="replace">
                    <button string="Imprimir etiqueta" type="object" name="print_label" attrs="{'invisible': [('sequence_code', '!=', 'PACK'), ('sequence_code', '!=', 'OUT')], 'readonly': [('sequence_code', '!=', 'PACK')]}"/>
                </xpath>
                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <field name="user_sale" attrs="{'invisible': [('sequence_code', '==', 'IN')]}"/>
                    <field name="priority_sale" attrs="{'invisible': [('sequence_code', '==', 'IN')]}"/>
                    <field name="shipping_type" attrs="{'invisible': [('sequence_code', '==', 'IN')]}"/>
                    <field name="shipping_mean" attrs="{'invisible': [('sequence_code', '==', 'IN')]}"/>
                    <field name="shipping_method" attrs="{'invisible': [('shipping_type', '!=', 'shipment')]}"/>
                </xpath>
            </field>
        </record>
        <record id="view_picking_sale_tree_inherit_zmart" model="ir.ui.view">
            <field name="name">stock.picking.sale.tree.zmart</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="priority_sale" optional="hide"/>
                    <field name="shipping_type" optional="hide"/>
                    <field name="shipping_mean" optional="hide"/>
                    <field name="document_type_invoice"/>
                    <field name="document_number_invoice"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
