<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_print_label" model="ir.actions.report">
            <field name="name">Print Label</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sale_zmart.report_print_label</field>
            <field name="report_file">sale_zmart.report_print_label</field>
            <field name="print_report_name">'Picking Operations - %s - %s' % (object.partner_id.name or '', object.name)</field>
            <field name="paperformat_id" ref="sale_zmart.paperformat_custom"/>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
        
        <template id="report_print_label">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-foreach="range(int(o.package_qty))" t-as="i">
                        <t t-call="web.basic_layout">
                            <style>
                                section {
                                    border: 1px solid black;
                                    border-radius: 5px;
                                    margin-top: 0px;
                                    padding: 10px;
                                }
                                table td, table th {
                                    border: 1px solid white;
                                    line-height: 1.1;
                                }
                            </style>
                            <section id="segmento_1" style="font-size: 0.3em; line-height: 0.8em; width: 4cm;">
                                <div style="display: inline-block; text-align: center; width: 100%;margin-top:-10px">
                                    <img t-if="o.company_id.logo"
                                        t-att-src="image_data_uri(o.company_id.logo)"
                                        height="30"
                                        width="40"
                                        class="mr-3 mt-1" style="display: inline-block; vertical-align: middle;"/>
                                    <div style="display: inline-block; vertical-align: middle; width: 50%; margin-left: 10px; border-left: 1px solid gray;">
                                        <div class="col-8">
                                            <table style="display: inline-block; vertical-align: middle;width:150%">
                                                <tr style="text-align:left;padding-left:5px">
                                                    <th style="text-align:left;padding-left:5px;font-weight: normal">EMISOR:</th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th style="text-align:left;padding-left:5px;font-weight: normal"><div t-field="o.company_id"/></th>
                                                </tr>
                                                <tr style="text-align:left">
                                                    <th style="width:80%;padding-left:5px;font-weight: normal">R.I.F.:<span t-field="o.company_id.vat"/></th>
                                                </tr>
                                                <tr style="text-align:left">
                                                    <th style="width:80%;padding-left:5px;font-weight: normal">TLF:<span t-field="o.company_id.phone"/></th>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <hr style="width: 100%; margin-top: 0.2em; margin-bottom: 0.2em; border: none; border-top: 1px solid black;"/>
                                <div style="display: flex; flex-wrap: wrap;">
                                    <div style="flex: 1 1 100%; margin-bottom: 0.5em;">
                                        <span><strong>DESTINATARIO:</strong></span>
                                        <div>  
                                            <span style="margin-right: 1px;"><strong>Nombre/Razón Social:</strong></span>
                                            <span t-out="o.partner_id.name"/>
                                        </div>
                                        <div>
                                            <span style="margin-right: 1px;"><strong>Cédula/RIF:</strong></span>
                                            <span t-out="o.partner_id.vat"/>
                                        </div>
                                        <div>
                                            <span style="margin-right: 1px;"><strong>Contacto:</strong></span>
                                            <span t-out="o.partner_id.child_ids.name"/>
                                        </div>
                                        <div>
                                            <span style="margin-right: 1px;"><strong>TLF:</strong></span>
                                            <span t-out="o.partner_id.phone"/>
                                        </div>
                                        <div>
                                            <span style="margin-right: 1px;"><strong>Ciudad:</strong></span>
                                            <span t-out="o.partner_id.city_id.name"/>
                                        </div>
                                        <div>
                                            <span style="margin-right: 1px;"><strong>Estado:</strong></span>
                                            <span t-out="o.partner_id.state_id.name"/>
                                        </div>
                                        <div>
                                            <span style="margin-right: 1px;"><strong>Dirección:</strong></span>
                                            <span t-out="o.partner_id.contact_address_complete"/>
                                        </div>
                                    </div>
                                </div>
                                <hr style="width: 100%; margin-top: 0.2em; margin-bottom: 0.2em;"/>
                                <div style="display: inline-block; vertical-align: middle;">
                                    <div style="display: inline-block; text-align: center; width: 100%;">
                                        <strong>N° GUÍA:</strong>
                                        <strong><span style="margin-right: 5px;" t-field="o.guide"/></strong>
                                        <strong>PESO:</strong>
                                        <strong><span t-out="o.weight"/></strong>
                                    </div>
                                    <hr style="width: 130%; margin-top: 0.2em; margin-bottom: 0.2em;"/>
                                    <div>
                                        <span style="margin-right: 1px;"><strong>DOC DE VENTA:</strong></span>
                                        <span t-field="o.origin"/>
                                    </div>
                                    <div>
                                        <span style="margin-right: 1px;"><strong>CLIENTE:  </strong></span>
                                        <span t-out="o.partner_id.name" />
                                    </div>
                                    <div>
                                        <span style="margin-right: 1px;"><strong>ESTADO:  </strong></span>
                                        <span t-field="o.partner_id.state_id.name" />
                                    </div>
                                </div>
                                <hr style="width: 100%; margin-top: 0.2em; margin-bottom: 0.2em;"/>
                                <div style="display: flex; flex-wrap: wrap; margin-top: 0.5em;">
                                    <div style="display: flex; align-items: center;margin-left:10px">
                                        <div style="flex: 1 1 100%; display: flex; justify-content: center;">
                                            <span>BULTOS: <t t-out="i+1"/> de <t t-out="o.package_qty"/></span>
                                            <img t-if="o.qr_code" t-att-src="'data:image/png;base64,' + o.qr_code.decode('utf-8')" style="max-width: 50px; max-height: 50px;"/>
                                        </div>
                                    </div>
                                </div>
                                <hr style="width: 100%; margin-top: 0.2em; margin-bottom: 0.2em;"/>
                                <table style="display: inline-block; vertical-align: middle;">
                                    <tr style="text-align:left">
                                        <th>Fecha:</th>
                                        <td t-out="o.date.strftime('%d/%m/%Y')"/>
                                        <th>Pick:</th>
                                        <td t-out="o.user_pick_id.name"></td>
                                    </tr>
                                    <tr style="text-align:left">
                                        <th>Hora:</th>
                                        <td t-out="o.date.strftime('%H:%M:%S')"/>
                                        <th>Pack:</th>
                                        <td t-out="o.user_pack_id.name"></td>
                                    </tr>
                                    <tr style="text-align:left">
                                        <th >Vent:</th>
                                        <td t-out="o.user_vend_id.name" style="padding-right:10px"></td>
                                        <th>Verificado:</th>
                                        <td t-out="o.user_out_id.name"></td>
                                    </tr>
                                </table>
                                <div style="flex: 1 1 100%;"><strong>Observaciones: </strong></div>
                                    <span style="flex: 1 1 100%;" t-out="o.note"/>
                            </section>
                        </t>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>