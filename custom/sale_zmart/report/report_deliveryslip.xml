<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document_zmart" inherit_id="stock.report_delivery_document">
        <xpath expr="//t" position="replace">
            <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())" />
                <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>
                <style>
                    .container {
                        display: flex;
                        flex-wrap: wrap;
                    }
                    .izquierda {
                        width: 50%;
                    }
                    .derecha {
                        width: 50%;
                    }.linea-vertical {
  border: none;
  border-left: 2px solid black;
  margin: 0 auto;
  width: 1px;
  height: 100%;
}
.main-container {
  position: relative;
  min-height: 100vh;
  
}
#footer {
   background: url("../images/glow.png") no-repeat scroll center 0 #241E20;
   color: #888888;
   padding: 20px 10px;
   width: 960px;
   margin-top: 40px!important;
}
.nuevo-div {
  position: absolute;
  bottom: 50px; /* ajusta la posición vertical del div según la altura del footer */
  width: 100%;
  height: 50px;
  background-color: #CCCCCC;
}
.left{
    float: left;
    background:blue;
	color:white;
}
.right{
    float: right;
    background:red;
	color:white;
}
.center{
    background:green;
   display:inline-block;
   color:white;
}
                </style>
                

                <div class="container" style="">
                    <div class="izquierda" style="float: left;">
                        <span>Cliente:</span>
                        <span t-field="o.partner_id"/>
                        <div>
                            <span>R.I.F:</span>
                            <span t-field="o.partner_id.prefix_vat"/>
                            -<span t-field="o.partner_id.vat"/>
                        </div>
                        <span>Vendedor:</span>
                        <span t-out="o.user_id.name"/>
                    </div>
                    <div class="derecha" style="float: right">
                        <div>Fecha de emision
                            <span t-field="o.scheduled_date"/>
                        </div>
                        <div>Nota de Entrega
                            <span t-field="o.origin"/>
                        </div>
                        <div>Condicion</div>
                        <hr style="border: none; visibility: hidden" />
                    </div>
                    <hr class="linea-vertical" />
                    <hr style="border: none; visibility: hidden" />
                </div>
                <div class="container" style="margin: auto; width: 50%; text-align: center;">
                    <span>PICKING - ALMACÉN</span>
                </div>
                <div>
                    <table class="table table-sm" t-if="o.state!='done'" name="stock_move_table">
                        <thead>
                            <tr>
                                <th name="th_sm_product" style="border-top: 2px solid black"><strong>Código</strong></th>
                                <th name="th_sm_product" style="border-top: 2px solid black"><strong>Descripción</strong></th>
                                <th name="th_sm_ordered" style="border-top: 2px solid black"><strong>Cant.</strong></th>
                                <th name="th_sm_quantity" style="border-top: 2px solid black"><strong>Unid</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                            <tr t-foreach="lines" t-as="move">
                                <td>
                                    <span t-field="move.product_id.default_code"/>
                                </td>
                                <td>
                                    <span t-field="move.product_id.name"/>
                                </td>
                                <td>
                                    <span t-field="move.product_uom_qty"/>
                                </td>
                                <td>
                                    <span t-field="move.product_uom"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <hr class="linea-vertical" />

                <div>
    <div class="derecha" style="float: left">
        <span>ENVÍO</span>
        <span>----------------------------</span>
        <span>GUÍA DE DESPACHO</span>
    </div>
    <div class="derecha" style="float: right">
        <div>Fecha de emision
            <span t-field="o.scheduled_date"/>
        </div>
        <div>Nota de Entrega
            <span t-field="o.origin"/>
        </div>
    </div>
    <div class="derecha" style="float: left">
        <div>-----------------------------------------------</div>
        <div>ENVÍA:</div>
        <div t-field="o.company_id.name"/>
        <div>RIF:</div>
        <span t-field="o.company_id.vat"/>
        <div>TLF:</div>
        <span t-field="o.company_id.phone"/>
    </div>
    <div class="derecha" style="float: right">
        <div>RECIBE:
        </div>
        <div>
            <span t-field="o.partner_id"/>
        </div>
        <div>RIF ó CI:
            <span t-field="o.partner_id.vat"/>
        </div>
        <div>CONTACTO: 
            <span t-field="o.partner_id"/>
        </div>
    </div>
    <div>
    </div>
</div>
            </t>
            </t>
        </xpath>
    </template>
</odoo>
