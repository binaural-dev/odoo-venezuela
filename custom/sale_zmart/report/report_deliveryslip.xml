<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_delivery_document_zmart" inherit_id="stock.report_delivery_document">
        <xpath expr="//t" position="replace">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())" />
                    <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>
                            <style>
                                .container {
                                    display: flex;
                                    flex-wrap: wrap;
                                }
                                    .izquierda {
                                    width: 50%;
                                }
                                .derecha {
                                    width: 50%;
                                }
                                .linea-vertical {
                                    border: none;
                                    border-left: 2px solid black;
                                    margin: 0 auto;
                                    width: 1px;
                                    height: 100%;
                                }
                                .main-container {
                                    position: relative;
                                    min-height: 100vh;
                                }
                                #footer {
                                    background: url("../images/glow.png") no-repeat scroll center 0 #241E20;
                                    color: #888888;
                                    padding: 20px 10px;
                                    width: 960px;
                                    margin-top: 40px!important;
                                }
                                .nuevo-div {
                                    position: absolute;
                                    bottom: 50px; /* ajusta la posición vertical del div según la altura del footer */
                                    width: 100%;
                                    height: 50px;
                                    background-color: #CCCCCC;
                                }
                                .left{
                                    float: left;
                                    background:blue;
                                    color:white;
                                }
                                .right{
                                    float: right;
                                    background:red;
                                    color:white;
                                }
                                .center{
                                    background:green;
                                    display:inline-block;
                                    color:white;
                                }
                            </style>
                            <div class="container" style="">
                                <div class="izquierda" style="float:left;">
                                    <span style="font-weight:bold; width: 76px; display: inline-block;">Cliente:</span>
                                    <span t-field="o.partner_id"/>
                                    <div>
                                        <span style="font-weight:bold; width: 76px; display: inline-block;">R.I.F:</span>
                                        <span t-field="o.partner_id.prefix_vat"/>
                                        -<span t-field="o.partner_id.vat"/>
                                    </div>
                                    <span style="font-weight:bold">Vendedor:</span>
                                    <span t-out="o.user_sale.name"/>
                                </div>
                                <div class="derecha" style="float: right">
                                    <div>
                                        <span style="font-weight: bold; width: 250px; display: inline-block;">Fecha de emisión:
                                            <span style="font-weight: normal; display: inline-block;" t-out="o.scheduled_date.strftime('%d/%m/%Y')"></span>
                                        </span>
                                    </div>
                                    <span style="font-weight: bold; width: 130px; display: inline-block;">Nota de Entrega:</span>
                                    <span style="font-weight:normal;display: inline-block;" t-field="o.origin"/>
                                    <div style="font-weight:bold">Condiciones:</div>
                                    <hr style="border: none; visibility: hidden"/>
                                </div>
                                <hr class="linea-vertical"/>
                                <hr style="border: none; visibility: hidden"/>
                            </div>
                            <div class="container" style="margin: auto; width: 50%; text-align: center;">
                                <span style="font-weight:bold">PICKING - ALMACÉN</span>
                            </div>
                            <div>
                                <table class="table table-sm" name="stock_move_table">
                                    <thead>
                                        <tr>
                                            <th name="th_sm_product" style="border-top: 2px solid black"><strong>Código</strong></th>
                                            <th name="th_sm_product" style="border-top: 2px solid black"><strong>Descripción</strong></th>
                                            <th name="th_sm_ordered" style="border-top: 2px solid black"><strong>Cant.</strong></th>
                                            <th name="th_sm_quantity" style="border-top: 2px solid black"><strong>Unid</strong></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                        <tr t-foreach="lines" t-as="move">
                                            <td style="text-align:center">
                                                <span t-field="move.product_id.default_code"/>
                                            </td>
                                            <td style="text-align:center">
                                                <span t-field="move.product_id.name"/>
                                            </td>
                                            <td style="text-align:center">
                                                <span t-field="move.product_uom_qty"/>
                                            </td>
                                            <td style="text-align:center">
                                                <span t-field="move.product_uom"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div style="margin-top:200px; width: 100%;">
                                <hr style="border: 2px dashed white;"/>
                                <table style="display: inline-block; vertical-align: middle;">
                                    <tr style="text-align:left;">
                                        <th style="width:40%;font-size:22px">ENVÍO</th>
                                        <th style="width:30%;">GUÍA DE DESPACHO</th>
                                        <th><span style="font-weight: bold; width: 130px; display: inline-block;">Fecha de emision</span></th>
                                        <td t-out="o.scheduled_date.strftime('%d/%m/%Y')"/>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th></th>
                                        <th></th>
                                        <th>Nota de Entrega:</th>
                                        <td t-out="o.origin"></td>
                                    </tr>
                                </table>
                                <table style="display: inline-block; vertical-align: middle;">
                                    <hr style="border: none; visibility: hidden"/>
                                    <tr style="text-align:left;">
                                        <th style="width:55%">ENVÍA:</th>
                                        <th style="width:30%;">RECIBE:</th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th style="font-weight: normal;" t-field="o.company_id.name"></th>
                                        <th style="font-weight: normal;" t-field="o.partner_id"></th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th>
                                            <span style="margin-right:3px">RIF:</span><span style="font-weight: normal;" t-field="o.company_id.vat"/>
                                        </th>
                                        <th>
                                            <span style="margin-right:3px">RIF ó CI:</span>
                                            <span style="font-weight: normal;" t-field="o.partner_id.prefix_vat"/>-
                                            <span style="font-weight: normal;" t-field="o.partner_id.vat"/>
                                        </th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th>
                                            <span style="margin-right:3px">TLF:</span>
                                            <span style="font-weight: normal;" t-field="o.company_id.phone"/>
                                        </th>
                                        <th>
                                            <span style="margin-right:3px">CONTACTO:
                                            </span><span style="font-weight: normal;" t-field="o.partner_id.child_ids.name"/></th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th></th>
                                        <th>
                                            <span style="margin-right:3px">TLF:</span>
                                            <span style="font-weight: normal;" t-field="o.partner_id.phone"/>
                                        </th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th></th>
                                        <th>
                                            <span style="margin-right:3px">DIRECCIÓN DE ENVÍO:</span>
                                            <span style="font-weight: normal;" t-field="o.partner_id.child_ids.street"/>
                                        </th>
                                    </tr>
                                </table>
                                <table style="display: inline-block; vertical-align: middle;">
                                    <hr style="border: none; visibility: hidden" />
                                    <tr style="text-align:left;">
                                        <th style="width:75%">DATOS DE ENCOMIENDA</th>
                                        <th style="width:30%;">OBSERVACIONES:</th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th>
                                            <span style="font-weight: normal;margin-right:3px">EMPRESA DE ENCOMIENDA:</span>
                                            <span style="font-weight: normal;" t-field="o.shipping_mean"/>
                                        </th>
                                        <th>
                                            <span style="font-weight: normal;margin-right:3px"></span>
                                            <span style="font-weight: normal;" t-field="o.note"/>
                                        </th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th>
                                            <span style="font-weight: normal;margin-right:3px">VALOR:</span>
                                        </th>
                                        <th></th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th>
                                            <span style="font-weight: normal;font-weight: normal;margin-right:3px">TIPO DE ENVÍO:</span>
                                        </th>
                                        <th></th>
                                    </tr>
                                </table>
                                <table style="display: inline-block; vertical-align: middle;">
                                    <tr style="text-align:left;">
                                        <th style="font-weight: normal;">N° de BULTOS:</th>
                                        <th style="padding-right:70px;">
                                            <div>___________________</div>
                                        </th>
                                        <th style="font-weight: normal;">Desp.:</th>
                                        <th style="padding-right:70px;">
                                            <div>___________________</div>
                                        </th>
                                        <th style="font-weight: normal;">Rev.:</th>
                                        <th style="margin-right:10px;">
                                            <div>___________________</div>
                                        </th>
                                    </tr>
                                    <tr style="text-align:left;">
                                        <th>
                                            <span style="font-weight: normal;margin-right:3px">N° de FACTURAS:</span>
                                            <span t-field="o.shipping_mean"/>
                                        </th>
                                        <th style="">
                                            <div>___________________</div>
                                        </th>
                                    </tr>
                                </table>
                            <div>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
