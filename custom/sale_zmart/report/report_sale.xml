<odoo>
    <data>

        <record id="sale.action_report_saleorder" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>

        <record id="action_report_sale_order_usd" model="ir.actions.report">
            <field name="name">Print Quote/Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sale_zmart.template_sale_order_delivery_note_usd</field>
            <field name="report_file">sale_zmart.template_sale_order_delivery_note_usd</field>
            <field name="attachment">object.name</field>
            <field name="paperformat_id" ref="sale_zmart.paperformat_note"/>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">object.name</field>
        </record>

        <record id="action_report_sale_order_bs" model="ir.actions.report">
            <field name="name">Print Quote/Order Bs</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">sale_zmart.template_sale_order_delivery_note_bs</field>
            <field name="report_file">sale_zmart.template_sale_order_delivery_note_bs</field>
            <field name="attachment">object.name</field>
            <field name="paperformat_id" ref="sale_zmart.paperformat_note"/>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">object.name</field>
        </record>

    </data>
</odoo>