<record id="ir_cron_action_cancel_if_no_invoice" model="ir.cron">
            <field name="name">Cancel Sale Order if No Invoice</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="code">model.action_cancel_if_no_invoice()</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=+2)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_send_cancel_warning_email" model="ir.cron">
            <field name="name">Send Cancel Warning Email</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="code">model.send_cancel_warning_email()</field>
            <field name="nextcall" eval="(DateTime.now() + relativedelta(days=+2, hours=-8)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>