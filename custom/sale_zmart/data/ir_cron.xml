<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="1">
        <record model="ir.cron" id="cancel_sale">
            <field name="name">Cancel sale order</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.check_pending_orders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">1</field>
        </record>
        <record model="ir.cron" id="send_email">
            <field name="name">Send Cancel Warning Emails</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.send_cancel_warning_email()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">1</field>
        </record>
    </data>
</odoo>