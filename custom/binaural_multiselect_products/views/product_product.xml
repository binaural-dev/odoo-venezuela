<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="product_product_tree" model="ir.ui.view">
    <field name="name">product_product_product_view_tree</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_product_tree_view" />
    <field name="arch" type="xml">
      <xpath expr="//header/button[@name='action_open_label_layout']" position="after">
        <button 
          name="set_products_selected" 
          type="object" 
          string="Select Products"
          class="btn-primary mb-3"
          invisible="not context.get('default_is_trigger_from_multiselect',False)"
        />
      </xpath>
    </field>
  </record>
</odoo>