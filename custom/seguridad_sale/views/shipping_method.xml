<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="shipping_method_search_form_view" model="ir.ui.view">
            <field name="name">shipping.method.search.form</field>
            <field name="model">sale.shipping.method</field>
            <field name="arch" type="xml">
                <search string="Shipping Method">
                    <field name="name" />
                </search>
            </field>
        </record>
        

        <!-- List view -->
        <record id="shipping_method_tree_view" model="ir.ui.view">
            <field name="name">shipping method tree view</field>
            <field name="model">sale.shipping.method</field>
            <field name="arch" type="xml">
                <tree string="Shipping Method" editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>


        <record id="shipping_method_action" model="ir.actions.act_window">
            <field name="name">Shipping Method</field>
            <field name="res_model">sale.shipping.method</field>
            <field name="view_mode">tree,form</field>
            <field name="domain"></field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new shipping method!
                </p>
            </field>
        </record>

        <!-- Act Tree view -->
        <record id="shipping_method_tree" model="ir.actions.act_window.view">
            <field name="view_mode">tree</field>
            <field name="view_id" ref="shipping_method_tree_view"/>
            <field name="act_window_id" ref="shipping_method_action"/>
        </record>


        <menuitem name="Metodo de entrega" parent="sale.menu_sale_config" id="shipping_method_menu"
                  action="shipping_method_action" sequence="30"/>

    </data>
</odoo>

