<odoo>
    <data>
        <record id="binaural_invoice.action_invoice_sale_note_binaural_invoice" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="account.account_invoices_without_payment" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="account.account_invoices" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="binaural_invoice.action_invoice_free_form_binaural_invoice" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <template id="delivery_note_usd" 
                inherit_id="binaural_invoice.template_invoice_sale_note_binaural_invoice">
            <xpath expr="//section[@id='segmento_2']" position="replace">
            <style>
                .align-right {
                    float: right;
                }
            </style>
            
            <section id="segmento_1" style="padding: 10px;height: 100px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center;width:60%;height:100px;border: 1px solid black; border-radius: 10px;padding-top:10px;padding-top:10px">
                    <img t-if="invoice.company_id.logo"
                        t-att-src="image_data_uri(invoice.company_id.logo)"
                        height="50"
                        width="70"
                        class="mr-3 mt-1" style="display: inline-block; vertical-align: middle;"/>
                    <div style="display: inline-block;vertical-align: middle;width:50%;margin-left:10px;">
                        <div class="col-8">
                            <div t-field="invoice.company_id"/>
                            <div>R.I.F: 
                                <span t-field="invoice.company_id.vat"/>
                            </div>
                            <div>N.I.T: 
                                <span/>
                            </div>
                        </div>
                    </div>
                </div>
                <div style="display: flex; align-items: center;margin-top:-100px">
                    <div style="display: inline-block;" class="align-right">
                        <div>
                            <span> Nota de Entrega:
                                <span t-field="invoice.correlative"/>
                            </span>
                            <div> Página: 
                                <span />
                            </div>
                            <div> Fecha Emisión: 
                                <span t-field="invoice.invoice_date"/>
                            </div>
                            <div> Fecha Entrega:
                                <span t-field="invoice.invoice_reception_date"/>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
                <hr style="border: none; visibility: hidden;" />
                <section id="segmento_2" style="border: 1px solid black; padding: 10px; border-radius: 10px;font-size:10px">
                     <div style="display: flex; align-items: center;width:60%;height:100px;padding-top:10px;padding-top:10px">
                    
                </div>
                <div style="display: flex; align-items: center;margin-top:-100px">
                    <div style="display: inline-block;" class="align-right">
                        <div>
                            <div> Condic. Pago:
                                <span t-field="invoice.invoice_date"/>
                            </div>
                            <div> Vendedor: 
                                <span t-field="invoice.invoice_reception_date"/>
                            </div>
                        </div>
                    </div>
                </div>
                    <div>
                        <div style="display: inline-block;width: 70%" >
                            <div class="col-8">
                                <span> Cliente:
                                    <span t-field="invoice.partner_id"/>
                                </span>
                                <div> R.I.F.:
                                    <span t-field="invoice.partner_id.vat"/>
                                    N.I.T.:
                                    <span t-field="invoice.partner_id.vat"/>
                                </div>
                                <span> Dirección: 
                                    <span t-out="invoice.partner_id.contact_address_complete"/>
                                </span>
                                <div> Teléfonos: 
                                    <span t-out="invoice.partner_id.phone"/>
                                </div>
                                <div> Transporte: 
                                    <!-- <span t-out="partner_id.contact_address_complete"/> -->
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <hr style="border: none; visibility: hidden;" />
            </xpath>"
            <xpath expr="//section[@id='segmento_3']/table/thead" position="replace">
                <thead>
                    <tr style="border-bottom: 1px solid black;">
                        <th style="width:120px;text-align:center;border: 0px solid black;">Código</th>
                        <th style="width:120px;text-align:center;border: 0px solid black;">Modelo</th>
                        <th style="width:380 px;text-align:left;border: 0px solid black;padding-left: 10px;">Descripción</th>
                        <th style="width:60px;text-align:center;border: 0px solid black;">Cant.</th><th style="width:40;text-align:center;border: 0px solid black;">Unidad</th>
                        <th style="width:90px;text-align:center;border: 0px solid black;">Precio Unitario</th>
                        <th style="width:90px;text-align:center;border: 0px solid black;">% Desc.</th>
                        <!-- <th style="width:90px;text-align:center;border: 0px solid black;">Precio Uni. Con Desc.</th> -->
                        <th style="width:90px;text-align:center;border: 0px solid black;">Neto</th>
                    </tr>
                </thead>
            </xpath>
            <xpath expr="//section[@id='segmento_3']/table/tbody" position="replace">
                <tbody>
                                            <t t-set="base_sin_descuento" t-value="0.00"/>
                                            <t t-set="base_16" t-value="0.00"/>
                                            <t t-set="iva_16" t-value="0.00"/>
                                            <t t-set="base_8" t-value="0.00"/>
                                            <t t-set="iva_8" t-value="0.00"/>
                                            <t t-foreach="invoice.invoice_line_ids" t-as="line">
                                                <tr>
                                                    <t t-set="base_sin_descuento"
                                                       t-value="base_sin_descuento + (line.quantity * line.price_unit)"/>
                                                    <t t-if="len(line.tax_ids) > 0">
                                                        <t t-if="line.tax_ids[0].amount == 8">
                                                            <t t-set="base_8" t-value="base_8 + (line.price_subtotal)"/>
                                                            <t t-set="iva_8"
                                                               t-value="iva_8 + (line.tax_ids[0].amount/100) * (line.price_subtotal)"/>
                                                        </t>
                                                        <t t-if="line.tax_ids[0].amount == 16"> 
                                                            <t t-set="base_16"
                                                               t-value="base_16 + (line.price_subtotal)"/>
                                                            <t t-set="iva_16"
                                                               t-value="iva_16 +(line.tax_ids[0].amount/100) * (line.price_subtotal)"/>
                                                        </t>
                                                    </t>
                                                    <t t-if="invoice.move_type in ['out_debit', 'in_debit']">
                                                        <td></td>
                                                        <td style="width:390px;text-align:left;">
                                                            <span t-field="line.name"/>
                                                        </td>
                                                    </t>
                                                    <t t-else="">
                                                        <td style="width:130px;text-align:center;">
                                                            <span t-field="line.product_id.default_code"/>
                                                        </td>
                                                        <td style="width:130px;text-align:center;">
                                                            <span t-field="line.product_id.model_product"/>
                                                        </td>
                                                        <t t-if="line.product_id.name">
                                                            <t t-set="product_name" t-value="line.product_id.name[0:35]"/>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-set="product_name" t-value=""/>
                                                        </t>
                                                        <td style="width:350px;text-align:left;">
                                                            <span t-esc="line.name"/>

                                                        </td>
                                                    </t>
                                                    <td style="width:50px;text-align:right;">
                                                        <span t-esc="line.quantity" t-options='{"widget": "float", "precision": 2}'/>
                                                    </td>
                                                    <td style="width:40px;text-align:center;">
                                                        <span t-field="line.product_uom_id"/>
                                                    </td>
                                                    <td style="width:80px;text-align:right;">
                                                        <span t-esc="'{0:,.3f}'.format(float(line.price_unit)).replace(',', ' ').replace('.', ',').replace(' ', '.')"/>
                                                    </td>
                                                    <td style="width:50px;text-align:right;">
                                                        <span t-esc="line.discount"/>
                                                    </td>

                                                    <t t-set="price_total" t-value="line.price_subtotal"/>

                                                    <td class="td_right"
                                                        style="width:90px;text-align:right">
                                                        <span t-esc="'{0:,.2f}'.format(float(price_total)).replace(',', ' ').replace('.', ',').replace(' ', '.')"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
            
            </xpath>
            <xpath expr="//t/div/div/section[@id='segmento_4']/table/tr/td[1]" position="replace">
            <hr style="border: 1px solid black;" />
                <td colspan="4">
                    <span >Descripción:&amp;nbsp;</span>
                    <span t-field="invoice.narration"></span>
                </td>
            </xpath>
            <xpath expr="//t/div/div/section[@id='segmento_4']/table/tr/td[3]/table/tr/td[1]" position="replace">
                <td style="text-align: right" colspan="3">Sub-Total USD</td>
            </xpath>
        </template>
    </data>
</odoo>