<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_islr_customer_inh" inherit_id="binaural_payment_extension.report_islr_customer">
        <xpath expr="//div/div/div/img" position="replace">
            <img
                t-if="res_company.logo"
                    t-att-src="image_data_uri(res_company.logo)"
                    style="width:130px; display: block; margin-left: 0; margin-right: auto;"
                />
        </xpath>
    </template>
    <template id="report_iva_customer_inh" inherit_id="binaural_payment_extension.report_iva_customer">
        <xpath expr="//div/div/div/img" position="replace">
            <img
                t-if="res_company.logo"
                    t-att-src="image_data_uri(res_company.logo)"
                    style="width:130px; display: block; margin-left: 0; margin-right: auto;"
                />
        </xpath>
    </template>
</odoo>