<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_invoice" model="report.paperformat">
            <field name="name">Free Form Paperformat</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">35</field>
            <field name="margin_bottom">11</field>
            <field name="margin_left">8</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">3</field>
            <field name="dpi">110</field>
        </record>

        <record id="paperformat_note" model="report.paperformat">
            <field name="name">Free Form Paperformat</field>
            <field name="default" eval="True"/>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">11</field>
            <field name="margin_left">8</field>
            <field name="margin_right">9</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">3</field>
            <field name="dpi">110</field>
        </record>
    </data>
</odoo>