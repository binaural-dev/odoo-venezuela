<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_payment_register_view_form_zmart" model="ir.ui.view">
            <field name="name">account.payment.register.view.form.zmart</field>
            <field name="model">account.payment.register</field>
            <field name="inherit_id" ref="account.view_account_payment_register_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='group3']" position="after">
                    <group name="proof">
                        <field name="proof_of_payment" widget="many2many_binary"/>
                        <field name="taxpayer_type" invisible="1"/>
                        <field name="retention_receipt" widget="many2many_binary" attrs="{'invisible': [('taxpayer_type', '!=', 'special')]}"/>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="view_account_payment_form_zmart" model="ir.ui.view">
            <field name="name">view.account.payment.form.zmart</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
            <field name="partner_bank_id" position="after">
                <field name="proof_of_payment" widget="many2many_binary"/>
                <field name="taxpayer_type" invisible="1"/>
                <field name="retention_receipt" widget="many2many_binary" attrs="{'invisible': [('taxpayer_type', '!=', 'special')]}"/>
            </field>
            </field>
        </record>
    </data>
</odoo>