<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_out_invoice_tree_zmart" model="ir.ui.view">
        <field name="name">account.move.tree.zmart</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree[1]/field[@name='activity_ids']" position="after">
                <field name="printed"/>
                <field name="invoice_type"/>
            </xpath>
        </field>
    </record>
    <record id="view_in_invoice_tree_zmart" model="ir.ui.view">
        <field name="name">account.move.tree.in.invoice.zmart</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree[1]/field[@name='activity_ids']" position="after">
                <field name="printed"/>
                <field name="invoice_type"/>
            </xpath>
        </field>
    </record>
    <record id="account_move_form_zmart" model="ir.ui.view">
        <field name="name">account.move.form.zmart</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button name="button_digital_invoice" string="Factura Digital" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('invoice_type', '!=', 'Factura'), ('move_type', '!=', 'out_invoice')]}"/>
                <button name="button_free_form" string="Imprimir Factura Bs" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('invoice_type', '!=', 'Factura'), ('move_type', '!=', 'out_invoice')]}"/>
                <button name="button_free_form_usd" string="Imprimir Factura $" type="object" class="oe_highlight"  groups="invoice_zmart.group_invoice" attrs="{'invisible': ['|', ('invoice_type', '!=', 'Factura'), ('move_type', '!=', 'out_invoice')]}"/>
                <button name="button_invoice_sale_note" string="Imprimir Nota de Entrega $" type="object" class="oe_highlight" groups="invoice_zmart.group_sale_note" attrs="{'invisible': ['|', ('invoice_type', '==', 'Factura'), ('move_type', '!=', 'out_invoice')]}"/>
                <button name="button_invoice_sale_note_bs" string="Imprimir Nota de Entrega Bs" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('invoice_type', '==', 'Factura'), ('move_type', '!=', 'out_invoice')]}"/>
            </button>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="printed" readonly="true"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']/div[3]" position="after">
                <field name="invoice_type"/>
            </xpath>

            <field name="partner_id" position="attributes">
                <attribute name="options">{'no_quick_create': True}</attribute>
            </field>

        </field>
    </record>
    <record id="view_account_invoice_filter_zmart" model="ir.ui.view">
        <field name="name">account.invoice.select.account_check_printing</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='line_ids']" position="after">
                <filter name="Facturas" domain="[('invoice_type','=','Factura')]"/>
                <filter name="Notas de entrega" domain="[('invoice_type','=','Nota de Entrega')]"/>
            </xpath>
            <xpath expr="//search/group/filter[@name='status']" position="after">
                <filter name="invoice_type" context="{'group_by': 'invoice_type'}"/>
            </xpath>
        </field>
    </record>
</odoo>
