<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_out_invoice_tree_zmart" model="ir.ui.view">
        <field name="name">account.move.tree.zmart</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree[1]/field[@name='activity_ids']" position="after">
                <field name="printed"/>
            </xpath>
        </field>
    </record>
    <record id="account_move_form_zmart" model="ir.ui.view">
        <field name="name">account.move.form.zmart</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button name="button_draft" position="after">
                <button name="button_free_form" string="Imprimir Factura" type="object" class="oe_highlight"/>
                <button name="button_invoice_sale_note" string="Imprimir Nota de Entrega" type="object" class="oe_highlight"/>
            </button>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="printed" readonly="true"/>
            </xpath>
        </field>
    </record>
</odoo>