<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_confirm_account_move_form" model="ir.ui.view">
        <field name="name">wizard.confirm.account.move</field>
        <field name="model">wizard.confirm.account.move</field>
        <field name="arch" type="xml">
            <form string="Action Confirm">
                <p>Confirmas el uso del diario: <field name="journal_id" nolabel="1" readonly="1"/> en la factura.</p>
                <footer>
                    <button name="action_post" string="Confirm" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
