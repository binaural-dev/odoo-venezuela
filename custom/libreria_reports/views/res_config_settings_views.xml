<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_libreria" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.binaural.stock</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="binaural_rate.res_config_settings_binaural_rate"/>
        <field name="arch" type="xml">
	        <xpath expr="//div[@name='binaural_rate_settings']" position="after">
                <h2>Stock Settings</h2>
                <div class="row mt16 o_settings_container" name="libreria_warehouse_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <div class="content-group">
                                <div class="row">
                                    <label for="store_location_id" class="col-lg-6 o_light_label"/>
                                    <field name="store_location_id"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
