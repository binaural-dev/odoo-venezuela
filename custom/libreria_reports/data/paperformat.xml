<odoo>
	<record id="paperformat_3x18" model="report.paperformat">
        <field name="name">paperformat.3x18</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_width">101</field>
        <field name="page_height">101</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_right">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">100</field>
    </record>

	<record id="paperformat_tag" model="report.paperformat">
        <field name="name">paperformat.tag</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_width">61</field>
        <field name="page_height">25</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_right">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">125</field>
    </record>
</odoo>
