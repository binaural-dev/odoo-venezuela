<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock.action_report_picking" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="action_report_picking_2" model="ir.actions.report">
            <field name="name">Nota de Despacho</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">seguridad_stock.report_picking_2</field>
            <field name="report_file">seguridad_stock.report_picking_2</field>
            <field name="print_report_name">'Picking Operations - %s - %s' % (object.partner_id.name or '', object.name)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_picking_2">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <div t-attf-class="header o_company_#{o.company_id.id}_layout" t-att-style="report_header_style">
                            <div class="col-3 mb4">
                                <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 45px;" alt="Logo"/>
                            </div>
                            <div style="border-bottom: 1px solid black;height:4px;"/>
                            <div style="float:left;width: 50%;">
                                <div style="margin-left:3px" t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                            </div>
                            <div style="float:right;width: 50%;">
                                <div class="col-6" name="div_outgoing_address">
                                    <div t-if="o.should_print_delivery_address()">
                                        <div><strong>Fecha:</strong> <span style="margin-left:33px" t-out="o.date.strftime('%d/%m/%Y')"/></div>
                                        <div><strong>Factura:</strong><span style="margin-left:24px" t-field="o.sale_id.invoice_ids"/></div>
                                        <div style="width:200%"><span style="font-weight:bold;">Vendido a:</span><span style="margin-left:8px" t-field="o.partner_id.name"/></div>
                                        <div><span style="font-weight:bold;">Vendedor:</span><span style="margin-left:8px" t-field="o.comercial"/></div>
                                            <div style="width:200%"><strong>Enviar por:</strong> <span style="margin-left:5px" t-field="o.shipping_method"/></div>
                                            <div style="width:200%"><span style="display: inline-block;"><strong>Destino:</strong></span><span style="margin-left:25px" t-field="o.destiny"/></div>
                                            <div style="width:200%"><span style="display: inline-block;"><strong>Impresion: </strong></span> <span style="display: inline-block;margin-left:8px" t-field="o.action_report_picking_2_datetime"/></div>
                                        </div>
                                        
                                        <div t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id">
                                            <span><strong>Warehouse Address:</strong></span>
                                            <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="page">
                                <div class="row">
                                    <div class="col-5 offset-1" name="div_incoming_address">
                                        <t t-set="show_partner" t-value="False"/>
                                            <div t-if="o.picking_type_id.code=='incoming' and o.partner_id">
                                                <span><strong>Vendor Address:</strong></span>
                                                <t t-set="show_partner" t-value="True" />
                                            </div>
                                            <div t-if="o.picking_type_id.code=='internal' and o.partner_id">
                                                <span><strong>Warehouse Address:</strong></span>
                                                <t t-set="show_partner" t-value="True" />
                                            </div>
                                            <div t-if="o.picking_type_id.code=='outgoing' and o.partner_id and o.partner_id != o.partner_id.commercial_partner_id">
                                                <span><strong>Customer Address:</strong></span>
                                                <t t-set="show_partner" t-value="True" />
                                            </div>
                                            <div t-if="show_partner" name="partner_header">
                                                <div t-field="o.partner_id.commercial_partner_id"
                                                    t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                                            </div>
                                        </div>
                                </div>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <h3 style="margin-top:50px">Despacho:</h3>
                                <h1 t-field="o.name" class="mt0"/>
                                <div class="row mt48 mb32">
                                    <div t-if="o.origin" class="col-auto" name="div_origin">
                                        <strong>Order:</strong>
                                        <p t-field="o.origin"/>
                                    </div>
                                    <div class="col-auto" name="div_state">
                                        <strong>Status:</strong>
                                        <p t-field="o.state"/>
                                    </div>
                                    <div class="col-auto" name="div_sched_date">
                                        <strong>Fecha:</strong>
                                        <p t-field="o.scheduled_date"/>
                                    </div>
                                </div>
                                <table class="table table-sm" t-if="o.move_line_ids and o.move_ids_without_package">
                                    <t t-set="has_barcode" t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>
                                    <t t-set="has_serial_number" t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)" groups="stock.group_production_lot"/>
                                    <thead>
                                        <tr>
                                            <th name="th_product">
                                                <strong>Code</strong>
                                            </th>
                                            <th name="th_product">
                                                <strong>Description</strong>
                                            </th>
                                            <th>
                                                <strong>Quantity</strong>
                                            </th>
                                            <th name="th_from" t-if="o.picking_type_id.code != 'incoming'" align="left" groups="stock.group_stock_multi_locations">
                                                <strong>From</strong>
                                            </th>
                                            <th name="th_to" t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                                                <strong>To</strong>
                                            </th>
                                            <th name="th_serial_number" class="text-center" t-if="has_serial_number">
                                            <strong>Lot/Serial Number</strong>
                                            </th>
                                            <th name="th_barcode" class="text-center" t-if="has_barcode">
                                                <strong>Product Barcode</strong>
                                            </th>
                                            <th name="th_warranty" class="text-center" t-if="o.product_id.warranty">
                                                <strong>Warranty</strong>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- In case you come across duplicated lines, ask NIM or LAP -->
                                        <t>
                                            <tr>
                                                <td>
                                                    <span t-field="o.move_line_ids_without_package.product_id.default_code"/><br/>
                                                </td>
                                                <td>
                                                    <span t-field="o.move_line_ids_without_package.product_id.name"/>
                                                </td>
                                                <td>
                                                    <span t-if="o.state != 'done'" t-field="o.move_ids.product_uom_qty"/>
                                                    <span t-if="o.state == 'done'" t-field="o.move_ids.quantity_done"/>
                                                    <span t-field="o.move_line_ids_without_package.product_uom_id" groups="uom.group_uom"/>
                                                </td>
                                               <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">
                                                    <span t-esc="o.move_line_ids_without_package.location_id.display_name"/>
                                                        <t t-if="o.move_line_ids_without_package.package_id">
                                                            <span t-field="o.move_line_ids_without_package.package_id"/>
                                                        </t>
                                                </td>
                                                 <td t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                                                    <div>
                                                        <span t-field="o.move_line_ids_without_package.location_dest_id"/>
                                                        <t t-if="o.move_line_ids_without_package.result_package_id">
                                                            <span t-field="o.move_line_ids_without_package.result_package_id"/>
                                                        </t>
                                                    </div>
                                                </td>
                                                <td class=" text-center h6" t-if="has_serial_number">
                                                    <t t-foreach="o.move_line_ids_without_package.filtered(lambda ml2: ml2.product_id == o.move_line_ids_without_package.product_id and ml2.lot_id)" t-as="ml2">
                                                        <div t-if="ml2.lot_name or ml2.lot_id.name" t-esc="ml2.lot_name or ml2.lot_id.name"/>
                                                    </t>
                                                </td>
                                                <td class="text-center" t-if="has_barcode">
                                                    <t t-if="product_barcode != o.move_line_ids_without_package.product_id.barcode">
                                                        <span t-if="o.move_line_ids_without_package.product_id and o.move_line_ids_without_package.product_id.barcode">
                                                            <div t-field="o.move_line_ids_without_package.product_id.barcode"/>
                                                        </span>
                                                        <t t-set="product_barcode" t-value="o.move_line_ids_without_package.product_id.barcode"/>
                                                    </t>
                                                </td>
                                                <td class="text-center" t-if="o.move_line_ids_without_package.product_id.warranty">
                                                    <div t-field="o.move_line_ids_without_package.product_id.warranty"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                <table class="table table-sm" t-if="o.package_level_ids and o.picking_type_entire_packs and o.state in ['assigned', 'done']">
                                    <thead>
                                        <tr>
                                            <th name="th_package">Package</th>
                                            <th name="th_pko_from" t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">From</th>
                                            <th name="th_pki_from" t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">To</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.package_level_ids.sorted(key=lambda p: p.package_id.name)" t-as="package">
                                            <t t-set="package" t-value="package.with_context(picking_id=o.id)" />
                                            <td name="td_pk_barcode">
                                                <div t-field="package.package_id.name"/><br/>
                                            </td>
                                            <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">
                                                <span t-field="package.location_id"/>
                                            </td>
                                            <td t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                                                <span t-field="package.location_dest_id"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <t t-set="no_reserved_product" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty != x.reserved_availability and x.move_line_ids and x.state!='done')"/>
                                <p t-if="o.state in ['draft', 'waiting', 'confirmed'] or no_reserved_product"><i class="fa fa-exclamation-triangle" />
                                    All products could not be reserved. Click on the "Check Availability" button to try to reserve products.
                                </p>
                                <p t-field="o.note"/>
                            </div>
                            <div style="width: 100%; text-align: center;margin-top:40px;">
                                <span>ACEPTADO CONFORME ____________________________________ CEDULA ____________________________________</span>
                            </div>
                            <div style="width: 800px; text-align: center;margin-top:40px;margin-left:40px">
                                <span>ENTREGADO POR ____________________________________ CHEQUEADO POR ____________________________________ </span></div>
                            <div class="footer">
                                <div class="row">
                                    <div class="col-12">
                                        <td style="width: 350px">
                                            <div style="text-align: center;">
                                                <div>He recibido la mercancia en perfecto estado y conforme a lo acordado</div>
                                            </div>
                                            
                                            <div  style="border-bottom: 1px solid black;height:4px;"/>
                                            <div style="text-align: center;">
                                                <div>
                                                    <span t-field="o.company_id.phone" />
                                                    <span t-field="o.company_id.email" />
                                                    <span t-field="o.company_id.website" />
                                                </div>
                                            </div>
                                            <div t-if="report_type == 'pdf'" class="text-muted" style="text-align: center;">
                                                Pagina:
                                                <span class="page"/>
                                                de
                                                <span class="topage"/>
                                            </div>
                                            <div style="text-align: center;">
                                                <div>No se aceptan cambios despues de 72 horas. Los equipos deben estar en perfecto estado</div>
                                            </div>
                                        </td>
                                        <br/>
                                    </div>
                                </div>
                            </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
