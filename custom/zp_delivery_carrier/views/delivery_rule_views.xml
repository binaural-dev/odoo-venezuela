<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_delivery_price_rule_form" model="ir.ui.view">
        <field name="name">view.delivery.price.rule.form.zp.delivery.carrier</field>
        <field name="model">delivery.price.rule</field>
        <field name="inherit_id" ref="delivery.view_delivery_price_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[2]/div[hasclass('o_row')]" position="after">
                <label for="is_foreign_currency"/>
                <div class="o_row">
                    <field name="is_foreign_currency"/>
                </div>
                <label 
                    for="foreign_list_base_price" 
                    string="Foregin Cost" 
                    attrs="{'invisible': [('is_foreign_currency', '=', False)]}"/>
                <div class="o_inline" attrs="{'invisible': [('is_foreign_currency', '=', False)]}">
                    <group col="8">
                        <field name="foreign_list_base_price" nolabel="1" colspan="2"/>
                    </group>
                </div>
            </xpath>

            <xpath expr="//field[@name='list_base_price']" position="attributes">
                <!-- <attribute name="force_save">1</attribute> -->
                <attribute name="attrs">{'readonly': [('is_foreign_currency', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
