<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="stock.action_report_delivery" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="action_print_albaran" model="ir.actions.report">
            <field name="name">Print Albaran</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">stock_zmart.report_albaran_zmart_2</field>
            <field name="report_file">stock_zmart.report_albaran_zmart_2</field>
            <field name="print_report_name">'Guia Despacho - %s - %s' % (object.partner_id.name or '', object.name)</field>
            <field name="paperformat_id" ref="stock_zmart.report_picking_op_albaran"/>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_albaran_zmart_2">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="web.basic_layout">
                        <style>
                            table td, table th {
                                    border: 1px solid white;
                                    line-height: 1.1;
                                }
                        </style>
                        
                        <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>
                                <style>
                                    .container {
                                        display: flex;
                                        flex-wrap: wrap;
                                    }
                                        .izquierda {
                                        width: 50%;
                                    }
                                    .derecha {
                                        width: 50%;
                                    }
                                    .linea-vertical {
                                        border: none;
                                        border-left: 2px solid black;
                                        margin: 0 auto;
                                        width: 1px;
                                        height: 100%;
                                    }
                                    .main-container {
                                        position: relative;
                                        min-height: 100vh;
                                    }
                                    #footer {
                                        background: url("../images/glow.png") no-repeat scroll center 0 #241E20;
                                        color: #888888;
                                        padding: 20px 10px;
                                        width: 960px;
                                        margin-top: 40px!important;
                                    }
                                    .nuevo-div {
                                        position: absolute;
                                        bottom: 50px; /* ajusta la posición vertical del div según la altura del footer */
                                        width: 100%;
                                        height: 50px;
                                        background-color: #CCCCCC;
                                    }
                                    .left{
                                        float: left;
                                        background:blue;
                                        color:white;
                                    }
                                    .right{
                                        float: right;
                                        background:red;
                                        color:white;
                                    }
                                    .center{
                                        background:green;
                                        display:inline-block;
                                        color:white;
                                    }
                                </style>
                                
                                <div class="container" >
                                    <div class="col-3 mb4">
                                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 45px;" alt="Logo"/>
                                    </div>
                                     <div style="float:left;width: 50%;">
                                        <div style="margin-left:3px" t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                                    </div>
                                    <div style="border-bottom: 1px solid black;height:4px;"/>
                                    <div class="izquierda" style="float:left;">
                                        <span style="width: 76px; display: inline-block;">Cliente:</span>
                                        <span t-field="o.partner_id"/>
                                        <div>
                                            <span style="width: 76px; display: inline-block;">R.I.F:</span>
                                            <span t-field="o.partner_id.prefix_vat"/>
                                            -<span t-field="o.partner_id.vat"/>
                                        </div>
                                        <span>Vendedor:</span>
                                        <span t-out="o.user_sale.name"/>
                                    </div>
                                    <div class="derecha" style="float: right;margin-top:-10px">
                                        <div>
                                            <span style="width: 250px; display: inline-block;padding-top:8px">Fecha de emisión:
                                                <span style="font-weight: normal; display: inline-block;" t-out="o.scheduled_date.strftime('%d/%m/%Y')"></span>
                                            </span>
                                        </div>
                                        <span style="width: 130px; display: inline-block;">Nota de Entrega:</span>
                                        <span style="display: inline-block;" t-field="o.origin"/>
                                        <div style="margin-top:4px;margin-bottom:5px;">Condiciones:<span t-field="o.sale_id.payment_term_id"/></div>
                                        <div class="col-auto">Estado:
                                            <span t-field="o.state"/>
                                        </div>
                                        <hr style="border: none; visibility: hidden"/>
                                    </div>
                                    <hr class="linea-vertical"/>
                                    <hr style="border: none; visibility: hidden"/>
                                </div>
                                <br></br>
                                <br></br>
                                <br></br>
                                <div class="container" style="margin: auto; width: 50%; text-align: center;">
                                    <span style="font-weight:bold;">PICKING - ALMACÉN</span>
                                </div>
                                <div class="page">
                        <h2>
                            <span t-field="o.name"/>
                        </h2>
                        <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                        <t t-if="o.backorder_ids and backorders">
                            <p class="mt-5">
                                <span>Remaining quantities not yet delivered:</span>
                            </p>
                            <table class="table table-sm" name="stock_backorder_table" style="table-layout: fixed;">
                                <thead>
                                    <tr>
                                        <th name="th_sb_product"><strong>Product</strong></th>
                                        <th/>
                                        <th name="th_sb_quantity" class="text-center"><strong>Quantity</strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="backorders" t-as="backorder">
                                        <t t-set="bo_lines" t-value="backorder.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                        <tr t-foreach="bo_lines" t-as="bo_line">
                                            <td class="w-auto">
                                                <span t-field="bo_line.product_id"/>
                                                <p t-if="bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                                    <span t-field="bo_line.description_picking"/>
                                                </p>
                                            </td>
                                            <td/>
                                            <td class="text-center w-auto">
                                                <span t-field="bo_line.product_uom_qty"/>
                                                <span t-field="bo_line.product_uom"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <div t-if="o.signature" class="mt32 ml64 mr4" name="signature">
                            <div class="offset-8">
                                <strong>Signature</strong>
                            </div>
                            <div class="offset-8">
                                <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                            </div>
                            <div class="offset-8 text-center">
                                <p t-field="o.partner_id.name"/>
                            </div>
                        </div>
                    </div>
                                <div>
                                    <table class="table table-sm" name="stock_move_table">
                                        <thead>
                                            <tr>
                                                <th name="th_sm_product" style="border-top: 2px solid black"><strong>Código</strong></th>
                                                <th name="th_sm_product" style="border-top: 2px solid black"><strong>Descripción</strong></th>
                                                <th name="th_sm_ordered" style="border-top: 2px solid black"><strong>Cant.</strong></th>
                                                <th name="th_sm_quantity" style="border-top: 2px solid black"><strong>Unid</strong></th>
                                                <th name="th_barcode" style="border-top: 2px solid black"><strong>Cód Barra</strong>
                                            </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                                            <tr t-foreach="lines" t-as="move">
                                                <td style="text-align:center">
                                                    <span t-field="move.product_id.default_code"/>
                                                </td>
                                                <td style="text-align:left">
                                                    <span t-field="move.product_id.name"/>
                                                </td>
                                                <td style="text-align:center">
                                                    <span t-field="move.product_uom_qty"/>
                                                </td>
                                                <td style="text-align:center">
                                                    <span t-field="move.product_uom"/>
                                                </td>
                                                <td style="text-align:center">
                                                    <span t-field="move.product_id.barcode"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div>
                                    <section>
                                        <div style="margin-top:150px; width: 100%;">
                                            <hr style="border: 2px dashed white;"/>
                                            <table style="display: inline-block; vertical-align: middle;">
                                                <tr style="text-align:left;">
                                                    <th style="width:30%">ENVÍO</th>
                                                    <th style="width:40%;">GUÍA DE DESPACHO</th>
                                                    <th><span style="font-weight: bold; width: 130px; display: inline-block;">Fecha de emision</span></th>
                                                    <td t-out="o.scheduled_date.strftime('%d/%m/%Y')"/>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th></th>
                                                    <th></th>
                                                    <th>Nota de Entrega:</th>
                                                    <td t-out="o.origin"></td>
                                                </tr>
                                            </table>
                                            <table style="display: inline-block; vertical-align: middle;font-size:13px">
                                                <hr style="border: none; visibility: hidden"/>
                                                <tr style="text-align:left;">
                                                    <th style="width:50%;padding-bottom:3px">ENVÍA:</th>
                                                    <th style="width:50%;padding-left:80px;padding-bottom:3px">RECIBE: <span style="font-weight: normal;padding-bottom:3px" t-field="o.company_id.name"></span></th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th>
                                                        <span style="margin-right:3px;padding-bottom:3px">RIF:</span><span style="font-weight: normal;" t-field="o.company_id.vat"/>
                                                    </th>
                                                    <th>
                                                        <span style="margin-right:3px;padding-left:80px;padding-bottom:3px">RIF ó CI:</span>
                                                        <span style="font-weight: normal;padding-bottom:3px" t-field="o.partner_id.prefix_vat"/>-
                                                        <span style="font-weight: normal;padding-bottom:3px" t-field="o.partner_id.vat"/>
                                                    </th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th>
                                                        <span style="margin-right:3px;padding-bottom:3px">TLF:</span>
                                                        <span style="font-weight: normal;padding-bottom:3px" t-field="o.company_id.phone"/>
                                                    </th>
                                                    <th>
                                                        <span style="margin-right:3px;padding-left:80px;padding-bottom:3px">CONTACTO:
                                                        </span><span style="font-weight: normal;padding-bottom:3px" t-field="o.partner_id.name"/></th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th></th>
                                                    <th>
                                                        <span style="margin-right:3px;padding-left:80px">TLF:</span>
                                                        <span style="font-weight: normal;" t-field="o.partner_id.phone"/>
                                                    </th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th></th>
                                                    <th>
                                                        <div style="margin-right:3px;padding-left:80px">DIRECCIÓN DE ENVÍO:
                                                        <span style="font-weight: normal;" t-field="o.sale_id.partner_id.street"/></div>
                                                    </th>
                                                </tr>
                                            </table>
                                            <table style="display: inline-block; vertical-align: middle;font-size:13px;padding-bottom:3px">
                                                <hr style="border: none; visibility: hidden" />
                                                <tr style="text-align:left;">
                                                    <th style="width:75%;padding-bottom:20px">DATOS DE ENCOMIENDA</th>
                                                    <th style="width:30%;">OBSERVACIONES:<span style="display: inline-block;font-weight: normal;" t-field="o.note"/></th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th>
                                                        <span style="font-weight: normal;margin-right:3px">EMPRESA DE ENCOMIENDA:</span>
                                                        <span style="font-weight: normal;" t-field="o.shipping_mean"/>
                                                    </th>
                                                    <th>
                                                        <span style="font-weight: normal;margin-right:3px"></span> 
                                                    </th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th>
                                                        <span style="font-weight: normal;margin-right:3px;padding-bottom:20px">VALOR:</span>
                                                    </th>
                                                    <th></th>
                                                </tr>
                                            </table>
                                            <table style="display: inline-block; vertical-align: middle;font-size:13px;">
                                                <tr style="text-align:left;">
                                                    <th>
                                                        <span style="font-weight: normal;font-weight: normal;margin-right:3px;padding-top:20px;width:200px">TIPO DE ENVÍO:<span t-field="o.shipping_type"/></span>
                                                    </th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th style="font-weight: normal;padding-bottom:20px;padding-top:10px">N° de BULTOS:</th>
                                                    <th style="padding-right:70px;">
                                                        <div><span t-field="o.package_qty"/></div>
                                                    </th>
                                                    <th style="font-weight: normal;">Desp.:</th>
                                                    <th style="padding-right:70px;">
                                                        <div>___________________</div>
                                                    </th>
                                                    <th style="font-weight: normal;">Rev.:</th>
                                                    <th style="margin-right:10px;">
                                                        <div>___________________</div>
                                                    </th>
                                                </tr>
                                                <tr style="text-align:left;">
                                                    <th>
                                                        <div style="font-weight: normal;margin-right:3px">N° de FACTURAS:</div>
                                                    </th>
                                                    <th style="">
                                                        <div><span t-field="o.sale_id.invoice_ids"/></div>
                                                    </th>
                                                </tr>
                                            </table>
                                        </div>
                                    </section>
                                </div>
                                <div class="footer">
                                            <div class="row">
                                                <div class="col-12">
                                                    <td style="width: 350px">
                                                        <div  style="border-bottom: 1px solid black;height:4px;"/>
                                                        <div t-if="report_type == 'pdf'" class="text-muted" style="text-align: center;">
                                                            Pagina:
                                                            <span class="page"/>
                                                            de
                                                            <span class="topage"/>
                                                        </div>
                                                    </td>
                                                    <br/>
                                                </div>
                                            </div>
                                        </div>
                            </t>
                    </t>
                </t>
        </template>
    </data>
</odoo>
