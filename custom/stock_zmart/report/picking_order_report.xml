<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="stock.action_report_picking" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="action_print_picking_order" model="ir.actions.report">
            <field name="name">Print Picking Order</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">stock_zmart.report_albaran_zmart</field>
            <field name="report_file">stock_zmart.report_albaran_zmart</field>
            <field name="print_report_name">'Picking Order - %s - %s' % (object.partner_id.name or '', object.name)</field>
            <field name="paperformat_id" ref="stock_zmart.report_picking_op_albaran"/>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_albaran_zmart">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="web.external_layout">
                            <div style="font-size:22px">
                                <div style="width:700px;;display: inline-block; vertical-align: middle;margin-left:700px;border: 2px solid #fff;border-collapse: collapse;line-height: 1.4;">
                                    <table style="width:700px; border: 2px solid #fff; border-collapse: collapse; line-height: 1.4;">
                                        <tr>
                                            <th style="font-weight:normal; text-align: left;">Nº Orden: <span t-out="o.origin"/></th>
                                        </tr>
                                    </table>
                                    <table style="width:700px; border: 2px solid #fff; border-collapse: collapse; line-height: 1.4;">
                                        <tr>
                                            <th style="font-weight:normal; text-align: left;">T/Entrega: <span t-field="o.shipping_type"/></th>
                                        </tr>
                                    </table>
                                    <table style="width:700px; border: 2px solid #fff; border-collapse: collapse; line-height: 1.4;">
                                        <tr>
                                            <th style="font-weight:normal; text-align: left;">Prioridad: <span t-field="o.priority_sale"/></th>
                                        </tr>
                                    </table>
                                    <table style="width:60%; border: 2px solid #fff; border-collapse: collapse; line-height: 1.4;">
                                        <tr>
                                            <th style="font-weight:normal; border: 1px solid white;text-align: left">Cliente: <span style="text-align: left" t-field="o.partner_id.name"/></th>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                                
                            <div class="page">
                                <br/>
                                <div style="margin-left:42%;font-size:22px;margin-top:55px">Picking Order</div>
                                <br/>
                                <table class="table table-sm" t-if="o.move_line_ids and o.move_ids_without_package">
                                    <t t-set="has_barcode" t-value="any(move_line.product_id and move_line.product_id.sudo().barcode or move_line.package_id for move_line in o.move_line_ids)"/>
                                    <t t-set="has_serial_number" t-value="any(move_line.lot_id or move_line.lot_name for move_line in o.move_line_ids)" groups="stock.group_production_lot"/>
                                    <thead>
                                        <tr>
                                            <th name="th_product" >
                                                <strong>Código</strong>
                                            </th>
                                            <th>
                                                <strong>Descripción</strong>
                                            </th>
                                            <th name="th_from">
                                                <strong>Ubicación</strong>
                                            </th>
                                            <th name="th_to">
                                                <strong>Cantidad</strong>
                                            </th>
                                            <th name="th_barcode" class="text-center" t-if="has_barcode">
                                                <strong>Cód Barra</strong>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.move_line_ids_without_package" t-as="ml">
                                            <tr style="border: 1px solid white;">
                                                <td style="text-align:center;width:110px">
                                                    <span t-field="ml.product_id.default_code"/>
                                                </td>
                                                <td style="text-align:left">
                                                    <span t-esc="ml.product_id.name[:85]"/>
                                                </td>
                                                <td  style="text-align:center">
                                                    <div>
                                                        <span t-field="ml.location_id"/>
                                                        <t t-if="ml.result_package_id">
                                                            <span t-field="ml.result_package_id"/>
                                                        </t>
                                                    </div>
                                                </td>
                                                <td style="text-align:center">
                                                    <span t-field="ml.qty_done"/>
                                                </td>
                                                <td class=" text-center h6" t-if="has_serial_number" style="text-align:center">
                                                    <div t-if="has_serial_number and (ml.lot_id or ml.lot_name)" t-esc="ml.lot_id.name or ml.lot_name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 400, 'height': 100, 'img_style': 'width:100%;height:35px;'}"/>
                                                </td>
                                                <td class="text-center" t-if="has_barcode" style="text-align:center">
                                                    <t t-if="product_barcode != ml.product_id.barcode">
                                                        <span t-if="ml.product_id and ml.product_id.barcode">
                                                            <div t-field="ml.product_id.barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'width': 300, 'height': 100, 'quiet': 0, 'img_style': 'height:28px;'}"/>
                                                            <div t-field="ml.product_id.barcode"/>
                                                        </span>
                                                        <t t-set="product_barcode" t-value="ml.product_id.barcode"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                <table class="table table-sm" t-if="o.package_level_ids and o.picking_type_entire_packs and o.state in ['assigned', 'done']">
                                    <thead>
                                        <tr>
                                            <th name="th_package">Package</th>
                                            <th name="th_pko_from" t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">From</th>
                                            <th name="th_pki_from" t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">To</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.package_level_ids.sorted(key=lambda p: p.package_id.name)" t-as="package">
                                            <t t-set="package" t-value="package.with_context(picking_id=o.id)" />
                                            <td name="td_pk_barcode">
                                                <div t-field="package.package_id.name" t-options="{'widget': 'barcode', 'humanreadable': 1, 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;margin-left: -50px;'}"/><br/>
                                            </td>
                                            <td t-if="o.picking_type_id.code != 'incoming'" groups="stock.group_stock_multi_locations">
                                                <span t-field="package.location_id"/>
                                            </td>
                                            <td t-if="o.picking_type_id.code != 'outgoing'" groups="stock.group_stock_multi_locations">
                                                <span t-field="package.location_dest_id"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <t t-set="no_reserved_product" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty != x.reserved_availability and x.move_line_ids and x.state!='done')"/>
                                <p t-if="o.state in ['draft', 'waiting', 'confirmed'] or no_reserved_product"><i class="fa fa-exclamation-triangle" />
                                    No se pudieron reservar todos los productos. Haga clic en el botón "Comprobar disponibilidad" para intentar reservar productos.
                                </p>
                                <p t-field="o.note"/>
                            </div>
                        </t>
                    </t>
                </t>
        </template>
    </data>
</odoo>