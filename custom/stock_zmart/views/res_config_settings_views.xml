<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_binaural_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.zmart.stock</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="100"/>
        <field name="inherit_id" ref="binaural_stock.res_config_settings_view_form_binaural_stock"/>
        <field name="arch" type="xml">
	        <xpath expr="//div[@name='Binaural_warehouse_settings']" position="after">
                <div class="row mt16 o_settings_container">
                    <div class="col-5 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="warehouse_operator_ids" string="Operadores de Almacén" />
                            <field name="warehouse_operator_ids" class="oe_inline">
                                <tree  editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

