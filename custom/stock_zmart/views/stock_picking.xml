<odoo>
    <data>
        <record id="view_picking_form_inherited_zmart" model="ir.ui.view">
            <field name="name">stock.picking.form.zmart</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_scrap']" position="before">
                    <button string="Picking Order" type="object" name="print_operation_albaran"/>
                    <button string="Albarán" type="object" name="print_albaran"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>