<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_purchase_order_form_inherited_zmart" model="ir.ui.view">
            <field name="name">Extension de formulario de compra: agregar campo compania,nuro de tramporte y vl</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <button name="button_cancel" position="after">
                    <button name="button_report_purchase_order" string="Imprimir Pedido de Compra" type="object" class="oe_highlight"/>
                    <button name="button_report_purchase_quotation" string="Solicitud de Presupuesto" type="object" class="oe_highlight"/>
                </button>
                <xpath expr="//notebook" position="inside">
                <page name="information_vehicle" string="Información Transporte">
                    <group>
                        <group>
                            <field name="name_company"/>
                            <field name="type_company"/>
                            <field name="incoterm_id"/>
                            <field name="bl"/>
                            <field name="wl"/>
                        </group>
                        <group>
                            <field name="order_in_transit"/>
                            <field name="exit_etd"/>
                            <field name="inlay_port"/>
                            <field name="date_in_store" invisible="1"/>
                            <field name="aduana_agent"/>
                        </group>
                    </group>
                </page>
            </xpath>
            </field>
        </record>
        <record id="view_purchase_order_form_inherited_zmart_incoterm" model="ir.ui.view">
            <field name="name">Ocultar incoterm en pestana otra informacion</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
            <field name="arch" type="xml">
                <field name="incoterm_id" position="replace">
                    <field name="incoterm_id" invisible="True"/>
                </field>
            </field>
        </record>

        <record id="stock_report_view_graph" model="ir.ui.view">
            <field name="name">stock_report_view_graph</field>
            <field name="inherit_id" ref="stock.stock_report_view_graph"/>
            <field name="model">report.stock.quantity</field>
            <field name="arch" type="xml">
                <xpath expr="//graph" position="inside">
                    <field name="product_qty" />
                    <!-- <field name="product_qty" type="measure"/>
                    <field name="product_qty" type="measure"/>
                    <field name="product_qty" type="measure"/>
                    <field name="product_qty" type="measure"/>
                    <field name="product_qty" type="measure"/>
                    <field name="product_qty" type="measure"/> -->
                </xpath>
            </field>
        </record>
    </data>
</odoo>