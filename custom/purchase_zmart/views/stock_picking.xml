<odoo>
    <data>
        <record id="view_picking_form_inherited_zmart" model="ir.ui.view">
            <field name="name">stock.picking.form.zmart</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_dest_id']" position="after">
                    <field name="responsible_purchase" attrs="{'invisible': [('sequence_code', '!=', 'IN')]}"/>
                    <field name="user_responsible" attrs="{'invisible': [('sequence_code', '!=', 'IN')]}"/>
                </xpath> 
                <xpath expr="//notebook" position="inside">
                    <page name="information_vehicle" string="Información Transporte" attrs="{'invisible': [('sequence_code', '!=', 'IN')]}">
                        <group>
                            <group>
                                <field name="name_company"/>
                                <field name="type_company"/>
                                <field name="incoterm_id"/>
                                <field name="bl"/>
                                <field name="wl"/>
                                <field name="sequence_code" invisible="1"/>
                            </group>
                            <group>
                                <field name="order_in_transit"/>
                                <field name="exit_etd"/>
                                <field name="inlay_port"/>
                                <field name="date_in_store"/>
                                <field name="aduana_agent"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="view_picking_tree_inherit_zmart" model="ir.ui.view">
            <field name="name">stock.picking.tree.zmart</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.vpicktree"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="exit_etd"/>
                    <field name="inlay_port"/>
                    <field name="date_in_store"/>
                </field>
            </field>
        </record>
    </data>
</odoo>