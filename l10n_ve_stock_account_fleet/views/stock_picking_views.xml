<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_inherit_transport_fleet" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.l10n_ve_stock_account_fleet</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="l10n_ve_stock_account.stock_picking_form_view_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='transport_main']" position="before">
                <group name="transport_fleet" invisible="transport_data_source != 'fleet'">
                    <group>
                        <field name="transport_vehicle_id"
                               readonly="state in ('done', 'cancel')"
                               options="{'no_create': True}"/>
                        <field name="transport_trailer_id"
                               readonly="state in ('done', 'cancel')"
                               options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
