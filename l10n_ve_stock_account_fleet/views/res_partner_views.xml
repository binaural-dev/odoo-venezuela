<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_transport_fleet" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.l10n_ve_stock_account_fleet</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
