<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_invoice_free_form_bsf_cadipa_invoice">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang"/>
                    <t t-set="o" t-value="o.with_context(lang=lang)" />
                    <t t-set="base_vef" t-value="o.currency_id.id == %(base.VEF)s"/>
                    <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
                    <t t-call="cadipa_invoice.report_freeform_document_bsf" t-lang="lang"/>
                </t>
            </t>
        </t>
    </template>

    <template id="report_freeform_document_bsf">
        <div class="row mt-0 pt-0 mb-5 pb-5">
            <div class="header">
                <div class="col-12 d-flex justify-content-end ms-0 ps-0 me-4 pe-5">
                </div>
            </div>
        </div>
        <div class="mt-5">
            <div class="page" >
                <div id="informations" class="row mt-4 mb-4">
                    <div class="col-auto col-6 mw-100 mb-2">
                        <span><strong>Razón Social:</strong> <t t-out="o.partner_id.name"/></span>
                        <br/>
                        <span>
                            <strong>Dirección:</strong>
                            <t t-if="o.partner_id.street" t-out="o.partner_id.street"/>
                            <t t-if="o.partner_id.street2" t-out="' - ' + o.partner_id.street2"/>
                            <t t-if="o.partner_id.state_id" t-out="' - ' + o.partner_id.state_id.name"/>
                            <t t-if="o.partner_id.country_id" t-out="' - ' + o.partner_id.country_id.name"/> 
                            <t t-if="o.partner_id.city" t-out="' - ' + o.partner_id.city"/>
                        </span>
                        <br/>
                        <span t-if="o.partner_id.vat"><strong>RIF:</strong> <t t-out="o.partner_id.prefix_vat + '-' + o.partner_id.vat"/></span>
                        <br/>
                        <span t-if="o.partner_id.phone"><strong>Tlf:</strong> <t t-out="o.partner_id.phone"/><br/></span>                        
                        <span t-if="o.action_number"><strong>Nro. de suscripción:</strong> <t t-out="o.action_number"/></span>
                    </div>
                    <div class="col-auto col-1 mw-100 mb-1">                        
                        <t t-if="o.move_type == 'out_invoice' and not o.journal_id.is_debit">
                            <span><strong>Nro. Factura: </strong><t t-if="o.name != '/'" t-out="o.name"/></span>
                            <br/>
                            <p><strong>Fecha: </strong> <t t-out="o.invoice_date.strftime('%d/%m/%Y')"/></p>
                        </t>
                        <t t-if="o.move_type == 'out_refund'">
                            <span><strong>Nota de Crédito Nro.: </strong><t t-if="o.name != '/'" t-out="o.name"/></span>
                            <br/>
                            <span><strong>Factura afectada: </strong><t t-out="o.reversed_entry_id.name"/></span>
                            <br/>
                            <span><strong>Número de Control: </strong><t t-out="o.reversed_entry_id.correlative"/></span>
                            <br/>
                            <span><strong>Fecha de la Factura: </strong><t t-out="o.reversed_entry_id.invoice_date"/></span>
                            <br/>
                        </t>
                        <t t-if="o.journal_id.is_debit">
                            <span><strong>Nota de Débito Nro.: </strong><t t-if="o.name != '/'" t-out="o.name"/></span>
                            <br/>
                            <span><strong>Factura afectada: </strong><t t-out="o.debit_origin_id.name"/></span>
                            <br/>
                            <span><strong>Número de Control: </strong><t t-out="o.debit_origin_id.correlative"/></span>
                            <br/>
                            <span><strong>Fecha de la Factura: </strong><t t-out="o.debit_origin_id.invoice_date"/></span>
                            <br/>
                        </t>    
                    </div>
                </div>

                <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>

                <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                    <thead>
                        <tr class="border-bottom border-dark">
                            <th name="th_description" class="text-start"><span>Descripción</span></th>
                            <th name="th_quantity" class="text-end"><span>Cantidad</span></th>
                            <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Precio Unitario</span></th>
                            <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>% IVA</span></th>
                            <th name="th_subtotal" class="text-end">
                                <span groups="account.group_show_line_subtotals_tax_excluded">TOTAL</span>
                                <span groups="account.group_show_line_subtotals_tax_included">TOTAL</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>

                        <t t-foreach="lines" t-as="line">

                            <t t-if="base_vef">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                            </t>
                            <t t-else="">
                                <t t-set="current_subtotal" t-value="current_subtotal + line.foreign_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_included"/>
                            </t>

                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                <td name="account_invoice_line_name">
                    <span t-out="line.name[:90]" t-options="{'widget': 'text'}"/>
                    <t t-if="all(tax.amount == 0.0 for tax in line.tax_ids)">(E)</t>
                </td>
                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                        <span t-field="line.product_uom_id"  groups="uom.group_uom"/>
                                    </td> 
                                    <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <t t-if="base_vef">
                                            <span class="text-nowrap" t-field="line.price_unit"/>
                                        </t>
                                        <t t-else="">
                                            <span class="text-nowrap" t-field="line.foreign_price"/>
                                        </t>
                                    </td>
                                    <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span class="text-nowrap" t-field="line.discount"/>
                                    </td>
                                    <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                        <span t-out="', '.join(map(lambda x: ( str(x.amount) + '%' if x.amount > 0 else ''), line.tax_ids))" id="line_tax_ids"/>
                                    </td>
                                    <td class="text-end o_price_total">
                                        <t t-if="base_vef">
                                            <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                        </t>
                                        <t t-else="">
                                            <span class="text-nowrap" t-field="line.foreign_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                            <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_included"/>
                                        </t>
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>
                            </tr>

                            <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-end">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                            t-out="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": %(base.VEF)s}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix mb-4">
                    <div id="total" class="row">
                        <div class="col-6">
                            <table class="table table-borderless" style="page-break-inside: avoid;">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="cadipa_invoice.document_tax_totals_bsf"/>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
            
            <div class="footer"> 

                <div id="second_page" style="margin-top: 20em">
                    <div id="informations" class="row mt-4 mb-4">
                        <div class="col-auto col-6 mw-100 mb-2">
                            <span><strong>Razón Social:</strong> <t t-out="o.partner_id.name"/></span>
                            <br/>
                            <span>
                                <strong>Dirección:</strong>
                                <t t-if="o.partner_id.street" t-out="o.partner_id.street"/>
                                <t t-if="o.partner_id.street2" t-out="' - ' + o.partner_id.street2"/>
                                <t t-if="o.partner_id.state_id" t-out="' - ' + o.partner_id.state_id.name"/>
                                <t t-if="o.partner_id.country_id" t-out="' - ' + o.partner_id.country_id.name"/> 
                                <t t-if="o.partner_id.city" t-out="' - ' + o.partner_id.city"/>
                            </span>
                            <br/>
                            <span t-if="o.partner_id.vat"><strong>RIF:</strong> <t t-out="o.partner_id.prefix_vat + '-' + o.partner_id.vat"/></span>
                            <br/>
                            <span t-if="o.partner_id.phone"><strong>Tlf:</strong> <t t-out="o.partner_id.phone"/><br/></span>                        
                            <span t-if="o.action_number"><strong>Nro. de suscripción:</strong> <t t-out="o.action_number"/></span>
                        </div>
                        <div class="col-auto col-1 mw-100 mb-1">
                            <t t-if="o.move_type == 'out_invoice' and not o.journal_id.is_debit">
                                <span><strong>Nro. Factura: </strong><t t-if="o.name != '/'" t-out="o.name"/></span>
                                <br/>
                                <p><strong>Fecha: </strong> <t t-out="o.invoice_date.strftime('%d/%m/%Y')"/></p>
                            </t>
                            <t t-if="o.move_type == 'out_refund'">
                                <span><strong>Nota de Crédito Nro.: </strong><t t-if="o.name != '/'" t-out="o.name"/></span>
                                <br/>
                                <span><strong>Factura afectada: </strong><t t-out="o.reversed_entry_id.name"/></span>
                                <br/>
                                <span><strong>Número de Control: </strong><t t-out="o.reversed_entry_id.correlative"/></span>
                                <br/>
                                <span><strong>Fecha de la Factura: </strong><t t-out="o.reversed_entry_id.invoice_date"/></span>
                                <br/>
                            </t>
                            <t t-if="o.journal_id.is_debit">
                                <span><strong>Nota de Débito Nro.: </strong><t t-if="o.name != '/'" t-out="o.name"/></span>
                                <br/>
                                <span><strong>Factura afectada: </strong><t t-out="o.debit_origin_id.name"/></span>
                                <br/>
                                <span><strong>Número de Control: </strong><t t-out="o.debit_origin_id.correlative"/></span>
                                <br/>
                                <span><strong>Fecha de la Factura: </strong><t t-out="o.debit_origin_id.invoice_date"/></span>
                                <br/>
                            </t>    
                        </div>
                    </div>
    
                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
    
                    <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                        <thead>
                            <tr class="border-bottom border-dark">
                                <th name="th_description" class="text-start"><span>Descripción</span></th>
                                <th name="th_quantity" class="text-end"><span>Cantidad</span></th>
                                <th name="th_priceunit" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Precio Unitario</span></th>
                                <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>% IVA</span></th>
                                <th name="th_subtotal" class="text-end">
                                    <span groups="account.group_show_line_subtotals_tax_excluded">TOTAL</span>
                                    <span groups="account.group_show_line_subtotals_tax_included">TOTAL</span>
                                </th>
                            </tr>
                        </thead>
                        <tbody class="invoice_tbody">
                            <t t-set="current_subtotal" t-value="0"/>
                            <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>
    
                            <t t-foreach="lines" t-as="line">
    
                                <t t-if="base_vef">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                </t>
                                <t t-else="">
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.foreign_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_included"/>
                                </t>
    
                                <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                    <td name="account_invoice_line_name">
                        <span t-out="line.name[:90]" t-options="{'widget': 'text'}"/>
                        <t t-if="all(tax.amount == 0.0 for tax in line.tax_ids)">(E)</t>
                    </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity"/>
                                            <span t-field="line.product_uom_id"  groups="uom.group_uom"/>
                                        </td> 
                                        <td t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <t t-if="base_vef">
                                                <span class="text-nowrap" t-field="line.price_unit"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-nowrap" t-field="line.foreign_price"/>
                                            </t>
                                        </td>
                                        <td t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span class="text-nowrap" t-field="line.discount"/>
                                        </td>
                                        <td t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                            <span t-esc="', '.join(map(lambda x: ( str(x.amount) + '%' if x.amount > 0 else ''), line.tax_ids))" id="line_tax_ids"/>
                                        </td>
                                        <td class="text-end o_price_total">
                                            <t t-if="base_vef">
                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                                <span class="text-nowrap" t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-nowrap" t-field="line.foreign_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                                <span class="text-nowrap" t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_included"/>
                                            </t>
                                        </td>
                                    </t>
                                    <t t-if="line.display_type == 'line_section'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <t t-set="current_section" t-value="line"/>
                                        <t t-set="current_subtotal" t-value="0"/>
                                    </t>
                                    <t t-if="line.display_type == 'line_note'">
                                        <td colspan="99">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>
                                </tr>
    
                                <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                                    <tr class="is-subtotal text-end">
                                        <td colspan="99">
                                            <strong class="mr16">Subtotal</strong>
                                            <span
                                                t-esc="current_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": %(base.VEF)s}'
                                            />
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
    
                    <div class="clearfix mb-4">
                        <div id="total" class="row">
                            <div class="col-6">
                                <table class="table table-borderless" style="page-break-inside: avoid;">
                                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                                    <t t-call="cadipa_invoice.document_tax_totals_bsf"/>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div t-if="not is_html_empty(o.narration)" name="comment">
                <span t-field="o.narration"/>
            </div>
            <p t-if="not is_html_empty(o.fiscal_position_id.note)" name="note">
                <span t-field="o.fiscal_position_id.note"/>
            </p>
            <p t-if="o.invoice_incoterm_id" name="incoterm">
                <strong>Incoterm: </strong><span t-field="o.invoice_incoterm_id.code"/> - <span t-field="o.invoice_incoterm_id.name"/>
            </p>
        </div>
    </template>
    
    <template id="document_tax_totals_bsf">
        <t t-set="base_vef" t-value="o.currency_id.id == %(base.VEF)s"/>
        <t t-set="str_tax" t-value="'subtotals' if base_vef else 'foreign_subtotals'"/>
        <t t-foreach="tax_totals[str_tax]" t-as="subtotal">
            <tr class="border-black o_subtotal p-0 m-0">
                <td class="lh-1 p-0 m-0"><strong t-esc="subtotal['name']"/></td>

                <td class="text-end lh-1 p-0 m-0">
                    <span
                        class="oe_subtotal_footer_separator lh-1"
                        t-esc="subtotal['formatted_amount']"
                    />
                </td>
            </tr>

            <t t-set="subtotal_to_show" t-value="subtotal['name']"/>
            <t t-call="cadipa_invoice.tax_groups_totals"/>
        </t>

        <t t-set="has_rounding" t-value="'formatted_amount_total_rounded' in tax_totals"/>
        <tr class="border-black o_total">
            <t t-if="has_rounding"><td class="lh-1 p-0 m-0">Total</td></t>
            <t t-else=""><td class="lh-1 p-0 m-0"><strong>Total</strong></td></t>
            <td class="text-end lh-1 p-0 m-0">
                <t t-if="base_vef">
                    <span t-esc="tax_totals['formatted_amount_total']"/>
                </t>
                <t t-else="">
                    <span t-esc="tax_totals['foreign_formatted_amount_total']"/>
                </t>
            </td>
        </tr>
        <tr t-if="has_rounding">
            <td><strong>Total Rounded</strong></td>
            <td class="text-end">
                <span t-esc="tax_totals['formatted_amount_total_rounded']"/>
            </td>
        </tr>
    </template>
    
    <record id="cadipa_invoice.action_invoice_free_form_bsf" model="ir.actions.report">
        <field name="name">Factura Forma Libre BS</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cadipa_invoice.template_invoice_free_form_bsf_cadipa_invoice</field>
        <field name="report_file">cadipa_invoice.template_invoice_free_form_bsf_cadipa_invoice</field>
        <field name="paperformat_id" ref="cadipa_invoice.invoice_free_form_paperformat_cadipa_invoice"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>