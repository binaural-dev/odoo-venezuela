<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_ve_sale_price_list.ProductPricelistReport">
        <div class="o_action">
            <Layout display="{ controlPanel: { 'bottom-right': false } }">
                <t t-set-slot="control-panel-always-buttons">
                    <div class="d-flex align-items-center gap-2">
                        <div class="btn-group" role="group" aria-label="Pagination">
                            <button type="button" class="btn btn-secondary fa fa-chevron-left"
                                    title="Previous page"
                                    t-on-click="onClickPrevPage"
                                    t-att-disabled="state.page &lt;= 1"/>
                            <span class="btn btn-secondary disabled">
                                Page <t t-out="state.page"/> / <t t-out="totalPages"/>
                            </span>
                            <button type="button" class="btn btn-secondary fa fa-chevron-right"
                                    title="Next page"
                                    t-on-click="onClickNextPage"
                                    t-att-disabled="state.page &gt;= totalPages"/>
                        </div>
                        <button t-on-click="onClickPrint" type="button" class="btn btn-primary" title="Print">Print</button>
                        <button t-on-click="onClickExportExcel" type="button" class="btn btn-secondary" title="Download Excel">
                            <i class="fa fa-file-excel-o me-1"/>Excel
                        </button>
                    </div>
                </t>
                <t t-set-slot="layout-actions">
                    <form class="o_pricelist_report_form d-flex flex-column gap-1">
                        <div class="d-flex align-items-center gap-3 w-100">
                            <label class="visually-hidden" for="pricelists">Pricelist</label>
                            <div class="input-group w-auto">
                                <div class="input-group-text fw-bold">Pricelist</div>
                                <select name="pricelists"
                                        id="pricelists"
                                        class="o_select form-select border-0"
                                        t-on-change="onSelectPricelist">
                                    <option t-out="selectedPricelist.display_name" t-att-value="selectedPricelist.id"/>
                                    <t t-foreach="state.pricelists" t-as="pricelist" t-key="pricelist.id">
                                        <t t-if="pricelist.id != selectedPricelist.id">
                                            <option t-out="pricelist.display_name" t-att-value="pricelist.id"/>
                                        </t>
                                    </t>
                                </select>
                                <button class="o_add_qty btn btn-primary fa fa-plus"
                                        type="submit"
                                        t-on-click="onClickAddPricelist"
                                        title="Add a Price List"/>
                            </div>
                            <div class="d-flex align-items-center w-50">
                                <span class="o_badges_list">
                                    <t t-foreach="state.selectedPricelists" t-as="pl" t-key="pl.id">
                                        <span class="o_field_badge o_remove_pricelist badge rounded-pill me-2 py-1 border mb-2"
                                                t-att-data-id="pl.id">
                                            <t class="me-2" t-esc="pl.display_name"/>
                                            <i class="oi oi-close ms-1 opacity-50 opacity-100-hover text-900 cursor-pointer"
                                                title="Remove pricelist"
                                                t-on-click="onClickRemovePricelist"/>
                                        </span>
                                    </t>
                                </span>
                            </div>
                        </div>
                    </form>
                </t>
                <div t-on-click="onClickLink">
                    <t t-out="html"/>
                </div>
            </Layout>
        </div>
    </t>

</templates>
