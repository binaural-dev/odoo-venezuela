<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_ve_sale_price_list.ProductPricelistReport">
        <div class="o_action">
            <Layout display="{ controlPanel: { 'bottom-right': false } }">
                <t t-set-slot="control-panel-actions">
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <div class="btn-group" role="group" aria-label="Pagination">
                            <button type="button" class="oi btn btn-secondary" data-icon="chevron_left"
                                    title="Previous page"
                                    t-on-click="this.onClickPrevPage"
                                    t-att-disabled="this.state.page &lt;= 1"/>
                            <span class="btn btn-secondary disabled">
                                Page <t t-out="this.state.page"/> / <t t-out="this.totalPages"/>
                            </span>
                            <button type="button" class="oi btn btn-secondary" data-icon="chevron_right"
                                    title="Next page"
                                    t-on-click="this.onClickNextPage"
                                    t-att-disabled="this.state.page &gt;= this.totalPages"/>
                        </div>
                        <Dropdown>
                            <button type="button" class="btn btn-primary dropdown-toggle" title="Imprimir">Imprimir</button>
                            <t t-set-slot="content">
                                <DropdownItem onSelected.bind="this.onClickPrint">
                                    <i class="oi me-1" data-icon="picture_as_pdf"/>PDF
                                </DropdownItem>
                                <DropdownItem onSelected.bind="this.onClickExportExcel">
                                    <i class="oi me-1" data-icon="table_chart"/>Excel
                                </DropdownItem>
                            </t>
                        </Dropdown>
                    </div>
                    <form class="o_pricelist_report_form d-flex flex-wrap gap-1" style="max-width: 60vw;">
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <label class="visually-hidden" for="pricelists">Pricelist</label>
                            <div class="input-group w-auto">
                                <div class="input-group-text fw-bold">Pricelist</div>
                                <select name="pricelists"
                                        id="pricelists"
                                        class="o_select form-select border-0"
                                        t-on-change="this.onSelectPricelist">
                                    <option t-out="this.selectedPricelist.display_name" t-att-value="this.selectedPricelist.id"/>
                                    <t t-foreach="this.state.pricelists" t-as="pricelist" t-key="pricelist.id">
                                        <t t-if="pricelist.id != this.selectedPricelist.id">
                                            <option t-out="pricelist.display_name" t-att-value="pricelist.id"/>
                                        </t>
                                    </t>
                                </select>
                                <button class="oi o_add_qty btn btn-primary" data-icon="add"
                                        type="submit"
                                        t-on-click="this.onClickAddPricelist"
                                        title="Add a Price List"/>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="o_badges_list d-flex flex-wrap">
                                    <t t-foreach="this.state.selectedPricelists" t-as="pl" t-key="pl.id">
                                        <span class="o_field_badge o_remove_pricelist badge rounded-pill me-2 py-1 border mb-2"
                                                t-att-data-id="pl.id">
                                            <t class="me-2" t-out="pl.display_name"/>
                                            <i class="oi ms-1 opacity-50 opacity-100-hover text-900 cursor-pointer" data-icon="close_small"
                                                title="Remove pricelist"
                                                t-on-click="this.onClickRemovePricelist"/>
                                        </span>
                                    </t>
                                </span>
                            </div>
                        </div>
                    </form>
                </t>
                <div t-on-click="this.onClickLink">
                    <t t-out="this.html"/>
                </div>
            </Layout>
        </div>
    </t>

</templates>
