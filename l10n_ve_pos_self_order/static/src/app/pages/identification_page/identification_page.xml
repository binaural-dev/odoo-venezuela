<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_self_order.IdentificationPage">
        <div class="o_self_identification_box d-flex flex-column vh-100 overflow-hidden o_self_background o_self_fade"
             t-attf-style="background-image:#{this.selfOrder.kioskBackgroundImageUrl};background-size: cover; background-position: center;">
            <div class="d-flex flex-column flex-grow-1 overflow-y-auto">
                <div class="container o_self_container my-auto">

                    <!-- Step A: cédula -->
                    <t t-if="this.state.step === 'identify'">
                        <h1 class="text-center mt-4">Identify yourself to start</h1>
                        <p class="text-center text-muted mb-4">Enter your ID number (cédula/RIF)</p>
                        <div class="mx-auto" style="max-width: 32rem;">
                            <div class="d-flex gap-2 mb-3">
                                <select class="form-select form-select-lg flex-shrink-0 o_ve_prefix_select"
                                        t-on-change="(ev) => this.state.prefixVat = ev.target.value">
                                    <option t-foreach="this.prefixOptions" t-as="opt" t-key="opt"
                                            t-att-value="opt" t-att-selected="opt === this.state.prefixVat" t-out="opt"/>
                                </select>
                                <input type="text" inputmode="numeric" autocomplete="off"
                                       class="form-control form-control-lg"
                                       placeholder="ID number (cédula/RIF)"
                                       t-att-value="this.state.vat" t-on-input="(ev) => this.state.vat = ev.target.value"
                                       t-on-keyup="(ev) => ev.key === 'Enter' &amp;&amp; this.onIdentify()"/>
                            </div>
                            <div t-if="this.state.error" class="alert alert-warning py-2" t-out="this.state.error"/>
                            <!-- On-screen numeric keypad for the cédula/RIF -->
                            <div class="o_ve_numpad mt-2">
                                <button t-foreach="this.numpadKeys" t-as="key" t-key="key.value"
                                        type="button"
                                        class="btn btn-lg o_ve_numpad_key"
                                        t-att-class="{ 'o_ve_numpad_action': key.action }"
                                        t-att-disabled="this.state.loading"
                                        t-on-click="() => this.onNumpadKey(key.value)">
                                    <t t-out="key.label"/>
                                </button>
                            </div>
                        </div>
                    </t>

                    <!-- Step B: completar teléfono (cédula encontrada, sin teléfono) -->
                    <t t-elif="this.state.step === 'phone'">
                        <h1 class="text-center mt-4">Complete your phone</h1>
                        <p class="text-center text-muted mb-4">
                            We need your phone number to continue
                        </p>
                        <div class="mx-auto" style="max-width: 32rem;">
                            <p class="text-center text-muted small mb-3" t-out="this.requiredFieldsLegend"/>
                            <div class="d-flex gap-2 mb-3">
                                <select class="form-select form-select-lg flex-shrink-0 o_ve_phone_code_select"
                                        t-on-change="(ev) => { this.state.phoneCode = ev.target.value; this.state.error = ''; }">
                                    <option value="" t-out="this.phoneCodePlaceholder"/>
                                    <option t-foreach="this.phoneCodeOptions" t-as="code" t-key="code"
                                            t-att-value="code" t-att-selected="code === this.state.phoneCode" t-out="code"/>
                                </select>
                                <input type="tel" inputmode="numeric" autocomplete="off"
                                       class="form-control form-control-lg"
                                       t-att-placeholder="this.phoneNumberPlaceholder"
                                       t-att-value="this.state.phoneNumber"
                                       t-on-input="(ev) => this.onPhoneNumberInput(ev)"
                                       t-on-focus="() => this.onFieldFocus('phoneNumber', 'numeric')"
                                       t-on-click="() => this.onFieldFocus('phoneNumber', 'numeric')"
                                       t-on-keyup="(ev) => ev.key === 'Enter' &amp;&amp; this.onSavePhone()"/>
                            </div>
                            <div t-if="this.phoneNumberHint" class="form-text text-danger mt-n2 mb-3" t-out="this.phoneNumberHint"/>
                            <!-- Error above the keyboard: below it, it ends up out of view. -->
                            <div t-if="this.state.error" class="alert alert-warning py-2" t-out="this.state.error"/>
                            <KioskKeyboard t-if="this.state.activeField" mode="this.state.keyboardMode"
                                           onKey="(key) => this.onKeyboardKey(key)"/>
                        </div>
                    </t>

                    <!-- Step C: nuevo contacto (cédula no encontrada) -->
                    <t t-else="">
                        <h1 class="text-center mt-4">New customer</h1>
                        <p class="text-center text-muted mb-4">
                            ID number (cédula/RIF): <b><t t-out="this.state.prefixVat"/>-<t t-out="this.state.vat"/></b>
                        </p>
                        <div class="mx-auto" style="max-width: 32rem;">
                            <p class="text-center text-muted small mb-3" t-out="this.requiredFieldsLegend"/>
                            <input type="text" autocomplete="off"
                                   class="form-control form-control-lg mb-3"
                                   t-att-placeholder="this.firstNamePlaceholder"
                                   t-att-value="this.state.firstName" t-on-input="(ev) => this.state.firstName = ev.target.value"
                                   t-on-focus="() => this.onFieldFocus('firstName')"
                                   t-on-click="() => this.onFieldFocus('firstName')"/>
                            <input type="text" autocomplete="off"
                                   class="form-control form-control-lg mb-3"
                                   t-att-placeholder="this.lastNamePlaceholder"
                                   t-att-value="this.state.lastName" t-on-input="(ev) => this.state.lastName = ev.target.value"
                                   t-on-focus="() => this.onFieldFocus('lastName')"
                                   t-on-click="() => this.onFieldFocus('lastName')"/>
                            <div class="d-flex gap-2 mb-3">
                                <select class="form-select form-select-lg flex-shrink-0 o_ve_phone_code_select"
                                        t-on-change="(ev) => { this.state.phoneCode = ev.target.value; this.state.error = ''; }">
                                    <option value="" t-out="this.phoneCodePlaceholder"/>
                                    <option t-foreach="this.phoneCodeOptions" t-as="code" t-key="code"
                                            t-att-value="code" t-att-selected="code === this.state.phoneCode" t-out="code"/>
                                </select>
                                <input type="tel" inputmode="numeric" autocomplete="off"
                                       class="form-control form-control-lg"
                                       t-att-placeholder="this.phoneNumberPlaceholder"
                                       t-att-value="this.state.phoneNumber"
                                       t-on-input="(ev) => this.onPhoneNumberInput(ev)"
                                       t-on-focus="() => this.onFieldFocus('phoneNumber', 'numeric')"
                                       t-on-click="() => this.onFieldFocus('phoneNumber', 'numeric')"/>
                            </div>
                            <div t-if="this.phoneNumberHint" class="form-text text-danger mt-n2 mb-3" t-out="this.phoneNumberHint"/>
                            <!-- Address: optional unless self_ordering_require_address is on. -->
                            <div class="d-flex gap-2 mb-3">
                                <select class="form-select form-select-lg o_ve_address_select"
                                        t-on-change="(ev) => this.onStateChange(ev)">
                                    <option value="" t-out="this.statePlaceholder"/>
                                    <option t-foreach="this.stateOptions" t-as="opt" t-key="opt.id"
                                            t-att-value="opt.id" t-att-selected="opt.id === this.state.stateId"
                                            t-out="opt.name"/>
                                </select>
                                <select class="form-select form-select-lg o_ve_address_select"
                                        t-att-disabled="!this.state.stateId"
                                        t-on-change="(ev) => this.onMunicipalityChange(ev)">
                                    <option value="" t-out="this.municipalityPlaceholder"/>
                                    <option t-foreach="this.municipalityOptions" t-as="opt" t-key="opt.id"
                                            t-att-value="opt.id" t-att-selected="opt.id === this.state.municipalityId"
                                            t-out="opt.name"/>
                                </select>
                            </div>
                            <input type="text" autocomplete="off"
                                   class="form-control form-control-lg mb-3"
                                   t-att-placeholder="this.streetPlaceholder"
                                   t-att-value="this.state.street" t-on-input="(ev) => this.state.street = ev.target.value"
                                   t-on-focus="() => this.onFieldFocus('street')"
                                   t-on-click="() => this.onFieldFocus('street')"/>
                            <!-- Error above the keyboard: below it, it ends up out of view. -->
                            <div t-if="this.state.error" class="alert alert-warning py-2" t-out="this.state.error"/>
                            <KioskKeyboard t-if="this.state.activeField" mode="this.state.keyboardMode"
                                           onKey="(key) => this.onKeyboardKey(key)"/>
                        </div>
                    </t>

                </div>
            </div>

            <div class="o_self_footer py-3">
                <div class="container o_self_container d-flex justify-content-between align-items-center position-relative">
                    <button class="btn btn-lg btn-light btn-back border-light"
                            t-on-click="() => this.onClickBack()">
                        <i class="oi d-md-none" data-icon="chevron_backward"/>
                        <span class="d-none d-md-inline">Back</span>
                    </button>
                    <!-- Primary action lives in the footer, right side, at the
                         same height as Back. Its label/handler switch by step. -->
                    <button t-if="this.state.step === 'identify'"
                            class="btn btn-lg btn-primary px-5"
                            t-att-disabled="this.state.loading"
                            t-on-click="() => this.onIdentify()">
                        Continue
                    </button>
                    <button t-elif="this.state.step === 'phone'"
                            class="btn btn-lg btn-primary px-5"
                            t-att-disabled="this.phoneStepDisabled"
                            t-on-click="() => this.onSavePhone()">
                        Save and continue
                    </button>
                    <button t-else=""
                            class="btn btn-lg btn-primary px-5"
                            t-att-disabled="this.createDisabled"
                            t-on-click="() => this.onCreate()">
                        Create and continue
                    </button>
                </div>
            </div>

        </div>
    </t>
</templates>
