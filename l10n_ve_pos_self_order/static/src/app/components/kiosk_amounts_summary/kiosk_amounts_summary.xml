<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Ticket 80343 puntos 7+8: resumen de montos (base imponible, impuestos
         por tasa, total en Bs. y total en moneda foránea) antes de pulsar
         Pagar. Mismo lenguaje visual que el pie de totales del carrito del
         core (fs-3 fw-bold, text-primary, o-so-tabular-nums). -->
    <t t-name="l10n_ve_pos_self_order.KioskAmountsSummary">
        <div class="o_ve_kiosk_amounts w-100 ms-auto o-so-tabular-nums">
            <div class="d-flex justify-content-between text-muted fs-5">
                <span>Subtotal</span>
                <span t-esc="formatAmount(baseAmount)"/>
            </div>
            <div t-foreach="taxGroups" t-as="taxGroup" t-key="taxGroup.id"
                 class="d-flex justify-content-between text-muted fs-5">
                <span t-esc="formatTaxGroupLabel(taxGroup)"/>
                <span t-esc="formatAmount(taxGroup.tax_amount_currency)"/>
            </div>
            <div class="d-flex justify-content-between align-items-baseline fs-3 fw-bold border-top mt-1 pt-1">
                <span>Total</span>
                <span class="text-primary" t-esc="formatAmount(localTotal)"/>
            </div>
            <div t-if="showForeignTotal" class="d-flex justify-content-between fs-5 fw-semibold">
                <span>Total <t t-esc="foreignCurrency.name"/></span>
                <span t-esc="formatForeignTotal()"/>
            </div>
        </div>
    </t>

    <!-- Carrito: reemplaza el "Total / Taxes" del core por el desglose. -->
    <t t-name="l10n_ve_pos_self_order.CartPage" t-inherit="pos_self_order.CartPage" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('order-price')]" position="replace">
            <div class="container o_self_container order-price px-md-4">
                <KioskAmountsSummary/>
            </div>
        </xpath>
    </t>

</templates>
