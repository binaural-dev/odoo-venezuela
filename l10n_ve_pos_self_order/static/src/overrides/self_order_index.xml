<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_self_order.selfOrderIndex" t-inherit="pos_self_order.selfOrderIndex" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-set-slot='location']" position="after">
            <t t-set-slot="identification" route="`/pos-self/${selfOrder.config.id}/identification`">
                <IdentificationPage />
            </t>
        </xpath>
        <xpath expr="//MainComponentsContainer" position="after">
            <button t-if="env.debug" type="button"
                    class="btn btn-dark btn-sm position-fixed o_kiosk_debug_btn"
                    style="top: 8px; left: 8px; z-index: 2000;"
                    t-on-click="openKioskDebug">
                🛠 Debug Kiosko
            </button>
        </xpath>
    </t>
</templates>
