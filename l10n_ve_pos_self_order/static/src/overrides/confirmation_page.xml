<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_self_order.ConfirmationPage" t-inherit="pos_self_order.ConfirmationPage" t-inherit-mode="extension">
        <xpath expr="//h1[hasclass('mb-0')][not(hasclass('o_pos_sched'))]" position="replace">
            <h1 class="mb-0">Transaction successful</h1>
        </xpath>
        <xpath expr="//span[hasclass('o_pos_order_label')]" position="replace"/>
        <xpath expr="//span[hasclass('tracking-number')]" position="replace"/>
        <xpath expr="//div[hasclass('o_pos_order_box')]" position="attributes">
            <attribute name="t-if">this.state.payment and this.confirmedOrder.state !== 'paid'</attribute>
        </xpath>
    </t>
</templates>
