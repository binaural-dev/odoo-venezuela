<odoo>
    <data noupdate="1">
        <!-- Half letter landscape (21.59 x 13.97 cm = 8.5 x 5.5 inches; Odoo only
             accepts whole millimeters: 216 x 140) for the donation receipts. -->
        <record id="paperformat_donation_receipt_half_letter" model="report.paperformat">
            <field name="name">Donations - Half letter receipt</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_width">216</field>
            <field name="page_height">140</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">6</field>
            <field name="margin_bottom">6</field>
            <field name="margin_left">8</field>
            <field name="margin_right">8</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>
