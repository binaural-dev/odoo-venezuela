<odoo>
    <!-- The Donation Manager has a privilege of its own. A group without
         privilege is only drawn in developer mode ("Extra Rights"), and inside
         the Accounting privilege it was one more option of the same selector
         of the user form: saving the user with another Accounting level (e.g.
         Administrator) removed it. With its own privilege it is a selector of
         its own in the permissions tab, independent of Accounting. The record
         is not `noupdate`; the admin is added to the group when the module is
         installed (`post_init_hook`), not in every update. -->
    <record id="res_groups_privilege_donation" model="res.groups.privilege">
        <field name="name">Donations</field>
        <field name="category_id" ref="base.module_category_accounting" />
        <field name="sequence">50</field>
    </record>
    <record id="group_donation_manager" model="res.groups">
        <field name="name">Donation Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_donation" />
    </record>
</odoo>
