<odoo>
    <!-- Action Report for stock.picking (outgoing donation delivery) -->
    <record id="action_donation_delivery_certificate" model="ir.actions.report">
        <field name="name">Donation Certificate</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_donation.donation_delivery_certificate_template</field>
        <field name="report_file">l10n_ve_donation.donation_delivery_certificate_template</field>
        <field name="print_report_name">"Donation Certificate - " + object.name</field>
        <field name="paperformat_id" ref="l10n_ve_donation.paperformat_donation_certificate"/>
    </record>
</odoo>
