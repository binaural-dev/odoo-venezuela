<odoo>
    <!-- Common body of the Donation Certificate delivered to the DONOR. The
         caller (account.move or stock.picking) sets before the t-call:
           - o: the document (the data of the company comes from it)
           - donor: contact of the donor (res.partner)
           - certificate_date: date of the certificate
           - amounts: dict of `account.move._compute_donation_amounts`
           - donation_line_data, donation_grand_total, donation_cost_currency:
             detail of the goods for `donation_product_table` (goods; False
             for a money donation)
         Other modules extend it through the elements with an id:
         `donation_certificate_legal` (data of the legal representative of the
         company) and `donation_certificate_extra` (more data of the donation). -->
    <template id="donation_certificate_body" name="Donation Certificate - Body">
        <t t-set="meses" t-value="['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']"/>
        <div class="container-fluid">
            <!-- ===== HEADER ===== -->
            <div class="row mb-3">
                <div class="col-12 d-flex align-items-center flex-wrap">
                    <div class="me-3 flex-shrink-0">
                        <img t-if="o.company_id.logo"
                            t-att-src="image_data_uri(o.company_id.logo)"
                            style="max-height:90pt; max-width:140px; min-width:80px;"
                            alt="Logo" />
                    </div>
                    <div>
                        <p class="m-0">
                            <span class="fw-bold">Razón Social: </span><span t-out="o.company_id.name" /><br />
                            <span class="fw-bold">RIF: </span><span t-out="o.company_id.vat or ''" /><br />
                            <span class="fw-bold">Dirección Fiscal: </span><span t-out="o.company_id.street or ''" /><t t-if="o.company_id.city"><span t-out="', ' + o.company_id.city" /></t><br />
                            <span class="fw-bold">Teléfono: </span><span t-out="o.company_id.phone or ''" />
                        </p>
                    </div>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-12 text-center">
                    <h3 style="font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
                        Certificado de Donación
                    </h3>
                </div>
            </div>

            <!-- ===== DECLARATION ===== -->
            <div class="row mb-3">
                <div class="col-12">
                    <p style="text-align: justify; line-height: 2; font-size: 14px;">
                        <span id="donation_certificate_legal">
                            Yo, ______________________________________________________________________, de nacionalidad venezolana,
                            mayor de edad, y titular de la Cédula de Identidad No. _________________________, actuando en
                            nombre y representación de <strong><span t-out="o.company_id.name" /></strong>, sociedad
                            mercantil inscrita en el Registro Mercantil __________________________________________________, en fecha
                            ___/___/____, bajo el No. _______, Tomo _______, e inscrita en el Registro de Información
                            Fiscal (R.I.F) bajo el No. <strong><span t-out="o.company_id.vat or '__________________'" /></strong>, suficientemente facultado para este acto
                            según consta en ____________________________________________________________________________________________,
                        </span>
                        por el presente documento declaro que en nombre de mi representada recibo en calidad de DONACIÓN, en forma pura y simple, perfecta e
                        irrevocable, de <strong><span t-out="donor.name or '__________________'" /></strong>, titular del
                        RIF / Cédula de Identidad No.
                        <strong><span t-out="((donor.prefix_vat or '') + '-' + donor.vat) if donor and donor.vat else '__________________'" /></strong>,
                        con domicilio en
                        <strong><span t-out="(donor and (donor.contact_address or donor.street)) or '__________________'" /></strong>,
                        teléfono <strong><span t-out="(donor and (donor.phone or donor.mobile)) or '__________________'" /></strong>,
                        <t t-if="donation_line_data">los siguientes bienes:</t>
                        <t t-else="">la suma de
                            <strong><span t-out="amounts['amount']" t-options="{'widget': 'monetary', 'display_currency': amounts['currency']}" /></strong><t t-if="amounts['equivalent_currency']">, equivalente a
                            <strong><span t-out="amounts['equivalent_amount']" t-options="{'widget': 'monetary', 'display_currency': amounts['equivalent_currency']}" /></strong>
                            a la tasa BCV del día <strong><span t-out="certificate_date.strftime('%d/%m/%Y')" /></strong>, de
                            <strong><span t-out="amounts['rate']" t-options="{'widget': 'float', 'precision': 4}" /> <span t-out="amounts['currency'].name" /> por <span t-out="amounts['equivalent_currency'].name" /></strong></t>.
                        </t>
                    </p>
                </div>
            </div>

            <!-- ===== GOODS DETAIL (shared table) ===== -->
            <div class="row mb-3" t-if="donation_line_data">
                <div class="col-12" style="font-size: 14px;">
                    <t t-call="l10n_ve_donation.donation_product_table" />
                    <p class="m-0">
                        <span class="fw-bold">Valor al costo: </span>
                        <span t-out="amounts['amount']" t-options="{'widget': 'monetary', 'display_currency': amounts['currency']}" /><t t-if="amounts['equivalent_currency']">, equivalente a
                        <span t-out="amounts['equivalent_amount']" t-options="{'widget': 'monetary', 'display_currency': amounts['equivalent_currency']}" />
                        a la tasa BCV del día <span t-out="certificate_date.strftime('%d/%m/%Y')" />, de
                        <span t-out="amounts['rate']" t-options="{'widget': 'float', 'precision': 4}" /> <span t-out="amounts['currency'].name" /> por <span t-out="amounts['equivalent_currency'].name" /></t>
                    </p>
                </div>
            </div>

            <!-- ===== DESTINATION AND CLOSING ===== -->
            <div class="row mb-4">
                <div class="col-12" style="font-size: 14px;">
                    <div id="donation_certificate_extra" />
                    <p class="m-0">
                        <span class="fw-bold">Descripción del uso de la donación: </span>______________________________________________
                    </p>
                    <p class="m-0">
                        <span class="fw-bold">Tipo de donativo: </span>______________________________________________
                    </p>
                    <p style="text-align: justify; line-height: 2; font-size: 14px; margin-top: 15px;">
                        <t t-if="donation_line_data">Los bienes descritos serán destinados</t><t t-else="">Dicha suma será destinada</t>
                        a lograr los objetivos de dicha organización. Con el otorgamiento de este documento,
                        <strong><span t-out="donor.name or '__________________'" /></strong> transfiere a mi representada
                        la propiedad de <t t-if="donation_line_data">los mencionados bienes</t><t t-else="">la mencionada suma</t>.
                        Y nosotros _______________________________________________________________________________________,
                        venezolanos, mayores de edad, de este domicilio y titulares de las cédulas de identidad No. _________________________, respectivamente,
                        actuando en nuestro carácter de Representante Legal, y encontrándonos plenamente facultados, por medio del presente documento declaramos: que
                        aceptamos para nuestra representada la donación de <t t-if="donation_line_data">los bienes antes descritos</t><t t-else="">la suma antes descrita</t>, en los términos expuestos.
                    </p>
                    <p style="text-align: justify; line-height: 2; font-size: 14px; margin-top: 20px;">
                        En la ciudad de <strong><span t-out="o.company_id.city or '__________________'" /></strong> a los
                        <strong><span t-out="certificate_date.strftime('%d')" /></strong> días del mes de
                        <strong><span t-out="meses[int(certificate_date.strftime('%m')) - 1]" /></strong> de
                        <strong><span t-out="certificate_date.strftime('%Y')" /></strong>.
                    </p>
                </div>
            </div>

            <!-- ===== SIGNATURES ===== -->
            <div class="row mt-5 pt-5">
                <div class="col-6 text-center">
                    <div style="border-top: 1px solid #000; padding-top: 6px; margin: 0 30px;">
                        <p class="m-0"><strong>Representante Legal del Donante</strong></p>
                        <p class="m-0" style="font-size: 11px;">Nombre, Firma y Sello</p>
                    </div>
                </div>
                <div class="col-6 text-center">
                    <div style="border-top: 1px solid #000; padding-top: 6px; margin: 0 30px;">
                        <p class="m-0"><strong>Representante Legal del Beneficiario</strong></p>
                        <p class="m-0" style="font-size: 11px;">Nombre, Firma y Sello</p>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Donation certificate (money) - account.move -->
    <template id="donation_certificate_template_account_move" name="Donation Certificate Account Move">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-set="donor" t-value="o._get_donation_counterparty()" />
                        <t t-set="certificate_date" t-value="o.invoice_date or o.date" />
                        <t t-set="amounts" t-value="o._get_donation_amounts()" />
                        <t t-set="donation_line_data" t-value="False" />
                        <t t-call="l10n_ve_donation.donation_certificate_body" />
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Donation certificate (goods) - stock.picking -->
    <template id="donation_certificate_template_stock_picking" name="Donation Certificate Stock Picking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-set="donor" t-value="o.partner_id" />
                        <t t-set="certificate_date" t-value="o._get_donation_document_date()" />
                        <t t-set="amounts" t-value="o._get_donation_receipt_amounts()" />
                        <t t-set="donation_line_data" t-value="o._get_donation_product_lines()" />
                        <t t-set="donation_grand_total" t-value="o._get_donation_grand_total()" />
                        <t t-set="donation_cost_currency" t-value="o.company_id.currency_id" />
                        <t t-call="l10n_ve_donation.donation_certificate_body" />
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
