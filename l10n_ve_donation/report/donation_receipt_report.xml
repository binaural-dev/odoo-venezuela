<odoo>
    <!-- Donation receipt: the document delivered to the beneficiary of a
         donation GIVEN by the company (money: journal entry; goods: delivery). -->
    <record id="action_donation_receipt_account_move" model="ir.actions.report">
        <field name="name">Donation Receipt</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_donation.donation_receipt_template_account_move</field>
        <field name="report_file">l10n_ve_donation.donation_receipt_template_account_move</field>
        <field name="print_report_name">"Donation Receipt - " + object.name</field>
        <field name="paperformat_id" ref="l10n_ve_donation.paperformat_donation_receipt_half_letter"/>
    </record>

    <record id="action_donation_receipt_stock_picking" model="ir.actions.report">
        <field name="name">Donation Receipt</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_ve_donation.donation_receipt_template_stock_picking</field>
        <field name="report_file">l10n_ve_donation.donation_receipt_template_stock_picking</field>
        <field name="print_report_name">"Donation Receipt - " + object.name</field>
        <field name="paperformat_id" ref="l10n_ve_donation.paperformat_donation_receipt_half_letter"/>
    </record>
</odoo>
