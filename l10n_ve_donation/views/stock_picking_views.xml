<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_l10n_ve_donation" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.l10n_ve_donation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_donation" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
