<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_view_donation" model="ir.ui.view">
        <field name="name">stock.picking.form.view.donation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="l10n_ve_stock_account.stock_picking_form_view_inherited" />
        <field name="arch" type="xml">
            <!-- Add is_donation readonly field in form (visible only when is_donation) -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_donation" readonly="1" invisible="not is_donation" force_save="1"/>
            </xpath>

            <!-- Make partner_id readonly when is_donation (keeps the base's
                 state == 'done' guard: position="attributes" replaces the
                 whole value, it doesn't merge with the base condition) -->
            <xpath expr="//form//group//group//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">state == 'done' or order_is_consignment or partner_required or is_donation</attribute>
            </xpath>

            <!-- Make outgoing transfer_reason_id readonly when is_donation -->
            <xpath expr="//field[@name='transfer_reason_id'][not(@required)]" position="attributes">
                <attribute name="readonly">is_donation or state == 'done'</attribute>
            </xpath>

            <!-- Hide guide_number when there are no dispatch controls (base
                 condition, preserved) or when it's a donation -->
            <xpath expr="//field[@name='guide_number']" position="attributes">
                <attribute name="invisible">not dispatch_guide_controls or is_donation</attribute>
            </xpath>
        </field>
    </record>
</odoo>
