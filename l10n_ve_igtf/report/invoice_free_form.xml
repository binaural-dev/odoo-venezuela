<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_freeform_document" inherit_id="l10n_ve_invoice.report_freeform_document">
        <xpath expr="//div[@name='comment']" position="before">
                <div name="igtf_info" class="mx-2">
                    <span>Todo pago cancelado en divisas o efectivo en moneda extranjera generará la percepción del 3% de IGTF (Providencia SNAT/2022/000013).</span>
                </div>
        </xpath>
    </template>

    <template id="tax_groups_totals" inherit_id="l10n_ve_invoice.tax_groups_totals">
        <xpath expr="//t[4]" position="after">
            <t t-if="tax_totals['igtf_free_form']['show_igtf_suggested_account_move']">
                <tr>
                    <td>
                        BI IGTF(sugerido):
                    </td>
                    <td class="text-end o_price_total">
                        <span t-out="tax_totals['igtf_free_form']['formatted_igtf_base_amount_free']" />
                    </td>
                </tr>
                <tr>
                    <td>
                        IGTF 3.0%(sugerido):
                    </td>
                    <td class="text-end o_price_total">
                        <span t-out="tax_totals['igtf_free_form']['formatted_igtf_amount_free']" />
                    </td>
                </tr>
            </t>
        </xpath>
    </template>

    <template id="tax_groups_totals_ve" inherit_id="l10n_ve_invoice.tax_groups_totals_ve">
        <xpath expr="//t[4]" position="after">
            <t t-if="tax_totals['igtf_free_form']['show_igtf_suggested_account_move']">
                <tr>
                    <td>
                        BI IGTF(sugerido):
                    </td>
                    <td class="text-end o_price_total">
                        <span t-out="tax_totals['igtf_free_form']['formatted_foreign_igtf_base_amount_free']" />
                    </td>
                </tr>
                <tr>
                    <td>
                        IGTF 3.0% (sugerido):
                    </td>
                    <td class="text-end o_price_total">
                        <span t-out="tax_totals['igtf_free_form']['formatted_foreign_igtf_amount_free']" />
                    </td>
                </tr>
            </t>
        </xpath>
    </template>

</odoo>
