<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_freeform_document" inherit_id="l10n_ve_invoice.report_freeform_document">
        <xpath expr="//div[@name='comment']" position="before">
                <div name="igtf_info" class="mx-2">
                    <span>Todo pago está sujeto a la aplicación de la &#160;<strong>LIGTF GO 6687 y la PA SNAT/2022/000013</strong></span>
                    <span>Se designa a sujetos pasivos especiales como Agente de Percepción del <strong>IGTF 3%</strong></span>
                </div>
        </xpath>
    </template>

    <template id="tax_groups_totals" inherit_id="l10n_ve_invoice.tax_groups_totals">
        <xpath expr="//t[@t-foreach='tax_groups']" position="after">

            <t t-if="o.move_type == 'out_invoice' and o.payment_state == 'not_paid'">
                <t t-if="tax_totals['igtf_free_form']['show_igtf_suggested_account_move'] and float(tax_totals['igtf_free_form']['igtf_base_amount_free']) > 0.0 ">
                
                    <tr style="line-height:0.5;">
                        <td>
                            IGTF 3.0%(sugerido):
                        </td>
                        <td class="text-end o_price_total">
                            <span t-out="tax_totals['igtf_free_form']['formatted_igtf_amount_free']" />
                        </td>
                    </tr>
                </t>
            </t>

            <t t-if="o.move_type == 'out_invoice' and o.payment_state != 'not_paid'">
                <t t-if="tax_totals['igtf'] and float(tax_totals['igtf']['formatted_igtf_amount']) > 0.0 ">
                
                    <tr style="line-height:0.5;">
                        <td>
                            IGTF 3.0%:
                        </td>
                        <td class="text-end o_price_total">
                            <span t-out="tax_totals['igtf']['formatted_igtf_amount']" />
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
    </template>

    <template id="tax_groups_totals_ve" inherit_id="l10n_ve_invoice.tax_groups_totals_ve">
        <xpath expr="//t[@t-foreach='tax_groups']" position="after">
            <t t-if="o.move_type == 'out_invoice' and o.payment_state == 'not_paid'">
                
                <t t-if="tax_totals['igtf_free_form']['show_igtf_suggested_account_move']  and float(tax_totals['igtf_free_form']['foreign_igtf_base_amount_free']) > 0.0 ">
                   
                    <tr style="line-height:0.5;">
                        <td>
                            IGTF 3.0%(sugerido): :
                        </td>
                        <td class="text-end o_price_total">
                            <span t-out="tax_totals['igtf_free_form']['formatted_foreign_igtf_amount_free']" />
                        </td>
                    </tr>
                </t>
            </t>

            <t t-if="o.move_type == 'out_invoice' and o.payment_state != 'not_paid'">
                
                <t t-if="tax_totals['igtf'] and float(tax_totals['igtf']['formatted_igtf_amount']) > 0.0 ">
                   
                    <tr style="line-height:0.5;">
                        <td>
                            IGTF 3.0% :
                        </td>
                        <td class="text-end o_price_total">
                            <span t-out="tax_totals['igtf_free_form']['formatted_foreign_igtf_amount']" />
                        </td>
                    </tr>
                </t>
            </t>
        </xpath>
    </template>

</odoo>
