<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La ND de proveedor nace en el diario de compras de su factura: el título del PDF
         estándar solo mira move_type y la rotulaba "Factura de proveedor".
         No se reemplaza el título del núcleo: se oculta solo para la ND y se agrega el suyo
         al lado, así "Vendor Bill" conserva la traducción de `account` en todos los idiomas. -->
    <template id="report_invoice_document_debit_note_title" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@name='vendor_bill_title']" position="attributes">
            <attribute name="t-if">not o._is_debit_note()</attribute>
        </xpath>
        <xpath expr="//t[@name='vendor_bill_title']" position="after">
            <t name="vendor_debit_note_title" t-if="o._is_debit_note()">Vendor Debit Note</t>
        </xpath>
    </template>
</odoo>
