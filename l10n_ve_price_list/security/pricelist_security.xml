<odoo>
    <record id="group_pricelist_change_permission" model="res.groups">
        <field name="name">Pricelist Change Permission</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_editing_prices_sales_orders_and_invoices" model="res.groups">
        <field name="name">Editing prices on sales orders and invoices</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_hide_product_sale_prices" model="res.groups">
        <field name="name">Hide product sale prices</field>
    </record>
</odoo>
