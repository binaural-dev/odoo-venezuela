<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_l10n_ve_rate_systray" model="ir.ui.view">
        <field name="name">res.config.settings.l10n.ve.rate.systray</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="after">
                <block title="Exchange Rate in Top Bar" name="rate_systray_setting_container">
                    <setting id="rate_systray_setting"
                             company_dependent="1"
                             help="Show the latest exchange rate in the top bar: green when it is today's rate, red when it is from a previous date or missing">
                        <field name="show_rate_systray"/>
                        <div class="content-group mt-2" invisible="not show_rate_systray">
                            <div class="row">
                                <label for="rate_systray_currency_id" class="col-lg-4 o_light_label"/>
                                <field name="rate_systray_currency_id"
                                       required="show_rate_systray"
                                       options="{'no_create': True, 'no_open': True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
