#. module: l10n_ve_rate_systray
#: model:ir.model.fields,field_description:l10n_ve_rate_systray.field_res_company__show_rate_systray
#: model:ir.model.fields,field_description:l10n_ve_rate_systray.field_res_config_settings__show_rate_systray
msgid "Show Rate in Top Bar"
msgstr "Mostrar tasa en la barra superior"

#. module: l10n_ve_rate_systray
#: model:ir.model.fields,help:l10n_ve_rate_systray.field_res_company__show_rate_systray
#: model:ir.model.fields,help:l10n_ve_rate_systray.field_res_config_settings__show_rate_systray
msgid ""
"Shows the latest exchange rate of the selected currency in the top bar of the "
"backend: green when it is today's rate, red when it is from a previous date "
"or there is no rate."
msgstr ""
"Muestra la última tasa de la moneda seleccionada en la barra superior del "
"backend: en verde si es la tasa de hoy, en rojo si es de una fecha anterior "
"o no hay tasa."

#. module: l10n_ve_rate_systray
#: model_terms:ir.ui.view,arch_db:l10n_ve_rate_systray.res_config_settings_l10n_ve_rate_systray
msgid ""
"Show the latest exchange rate in the top bar: green when it is today's rate,"
" red when it is from a previous date or missing"
msgstr ""
"Muestra la última tasa en la barra superior: en verde si es la tasa de hoy,"
" en rojo si es de una fecha anterior o no hay tasa"

