<odoo>

<template id="cadipa_reservation_calendar"
          name="Cadipa Reservation Calendar">
    <t t-call="website.layout">
        <t t-set="title">Reservas</t>

        <div class="o_calendar_cadipa">
        <div class="toolbar-calendar d-flex align-items-center gap-2 mb-3">

            <div class="mb-3">
            <button type="button"
                    class="btn btn-dark"
                    data-bs-toggle="modal"
                    data-bs-target="#courtFilterModal"
                    id="btn-filter-areas">
                Filtrar por áreas
            </button>

            <!-- Modal nuevo -->
            <div class="modal fade" id="courtFilterModal" tabindex="-1"
                aria-labelledby="courtFilterModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="courtFilterModalLabel">Selecciona las áreas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <t t-foreach="reservation_zones" t-as="zone" t-key="zone.id">
                    <div class="form-check">
                        <input class="form-check-input court-chk"
                            type="checkbox"
                            t-att-value="zone.id"
                            t-att-id="'chk-zone-%d' % zone.id">
                        <label class="form-check-label" t-att-for="'chk-zone-%d' % zone.id">
                        <t t-esc="zone.name"/>
                        </label>
                        </input>
                    </div>
                    </t>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="btn-select-all">
                        Todas las áreas
                    </button>
                    
                    <button type="button" class="btn btn-success" id="btn-apply-filter"
                            data-bs-dismiss="modal">Aplicar</button>
                    <button type="button" class="btn btn-danger"
                            data-bs-dismiss="modal">Cerrar</button>
                </div>
                </div>
            </div>
            </div>

            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <button type="button" class="btn btn-light" id="btn-prev-day">
                    <i class="fa fa-chevron-left"/>
                </button>
                <div class="input-group" style="width: 200px;">
                    <input type="date" class="form-control text-center"
                           id="calendarDatePicker"/>
                    <button class="btn btn-outline-secondary" type="button"
                            id="btn-open-datepicker" style="display:none;">
                        <i class="fa fa-calendar"/>
                    </button>
                </div>
                <button type="button" class="btn btn-light" id="btn-next-day">
                    <i class="fa fa-chevron-right"/>
                </button>
            </div>
        </div>

<div class="timesheet-wrapper">
    <div id="content-reservation-calendar"></div>
</div>
        </div>

        <div class="modal fade" id="reservationDetailsModal" tabindex="-1"
     aria-labelledby="reservationDetailsModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reservationDetailsModalLabel">Detalles de la reserva</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <p><strong>Área:</strong> <span id="modalCourtName"></span></p>
        <p><strong>Cliente:</strong> <span id="modalPartnerName"></span></p>
        <p><strong>Hora:</strong> <span id="modalReservationTime"></span></p>
        <p><strong>Descripción:</strong><span id="modalDescription"></span></p>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>
    </t>
</template>

</odoo>