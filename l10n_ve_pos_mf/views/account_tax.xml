<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_tax_form_fiscal_code" model="ir.ui.view">
        <field name="name">account.tax.form.fiscal.code</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="fiscal_code" string="Código Fiscal (Máquina Fiscal)"/>
            </xpath>
        </field>
    </record>
</odoo>
