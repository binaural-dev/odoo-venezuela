<odoo>
    <!-- 
        Configuración de Máquina Fiscal (Web Serial API)
        
        Esta vista agrega los campos de configuración de la máquina fiscal
        directamente en el formulario de Punto de Venta (pos.config).
        
        Ya no usamos IoT Box - la conexión es directa vía Web Serial API.
    -->
    
    <record id="view_pos_config_inherit_fiscal_mf" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.fiscal.mf</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <!-- Buscar el notebook y agregar una página nueva -->
            <xpath expr="//notebook" position="inside">
                <page string="Máquina Fiscal" name="fiscal_machine">
                    <group>
                        <group string="Configuración de Impresora Fiscal">
                            <field name="serial_machine" readonly="1" 
                                   placeholder="Se detecta automáticamente al conectar"/>
                            
                            <field name="flag_21" 
                                   widget="radio"
                                   options="{'horizontal': true}"/>
                            
                            <field name="traditional_line"/>
                            <field name="has_cashbox"/>
                        </group>
                        
                        <group string="Opciones de Interfaz">
                            <field name="access_button_mf"/>
                            <field name="message_in_head"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Ayuda - Códigos Fiscales">
                            <div class="alert alert-info" role="alert">
                                <h4>Configuración de Impuestos (fiscal_code):</h4>
                                <ul>
                                    <li><strong>0</strong> = Exento (sin IVA)</li>
                                    <li><strong>1</strong> = General (IVA estándar 16%)</li>
                                    <li><strong>2</strong> = Reducido (segunda tasa)</li>
                                    <li><strong>3</strong> = Adicional (tercera tasa)</li>
                                </ul>
                                <p class="mb-0">
                                    <em>Configurar en: Contabilidad → Configuración → Impuestos</em>
                                </p>
                            </div>
                        </group>
                        
                        <group string="Ayuda - Métodos de Pago">
                            <div class="alert alert-info" role="alert">
                                <h4>Códigos de Métodos de Pago (code_fiscal_printer):</h4>
                                <ul>
                                    <li><strong>01</strong> = Efectivo</li>
                                    <li><strong>02</strong> = Cheque</li>
                                    <li><strong>03</strong> = Tarjeta de Débito</li>
                                    <li><strong>04</strong> = Tarjeta de Crédito</li>
                                    <li><strong>05</strong> = Transferencia</li>
                                    <li><strong>06</strong> = Depósito</li>
                                    <li><strong>07-24</strong> = Otros</li>
                                </ul>
                                <p class="mb-0">
                                    <em>Configurar en: Punto de Venta → Configuración → Métodos de Pago</em>
                                </p>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
