<odoo>
    <record id="pos_config_view_form_inherit" model="ir.ui.view">
        <field name="name">pos.config.form.inherit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="pos_iot.pos_iot_config_view_form" />
        <field name="arch" type="xml">
            <!-- Reemplazamos el label de Receipt Printer (ahora col-lg-5) -->
            <xpath expr="//div[@class='row'][1]/label[contains(@class, 'o_light_label')]" position="replace"/>
            
            <!-- Reemplazamos el row del Cashdrawer -->
            <xpath expr="//div[@class='row' and .//field[@name='iface_cashdrawer']]" position="replace"/>

            <!-- Ocultamos el campo iface_printer_id -->
            <xpath expr="//field[@name='iface_printer_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div[@name='row_scale']" position="after">
                <div class="row">
                    <label string="Fiscal Data Module" for="iface_fiscal_data_module"
                        class="col-lg-5 o_light_label" />
                    <field name="iface_fiscal_data_module" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
