
<odoo>
    <record id="account_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name='cashbox_id' readonly="1"/>
            </xpath>
            <xpath expr="//group[@name='accounting_info_group']" position="after">
                <group string="Fiscal Machine" name="fiscal_machine_group">
                    <field name='mf_invoice_number' readonly="1"/>
                    <field name='mf_serial' readonly="1"/>
                    <field name="mf_reportz" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_search_mf" model="ir.ui.view">
        <field name="name">view.account.move.search.mf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name='mf_invoice_number'/>
                <field name='mf_serial'/>
            </field>
        </field>
    </record>
</odoo>
