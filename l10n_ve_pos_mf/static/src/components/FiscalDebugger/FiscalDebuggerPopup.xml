<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="l10n_ve_pos_mf.FiscalDebuggerPopup">
        <div class="popup fiscal-debugger-popup">
            <header class="fiscal-debugger-header">
                <h2>🛠️ Fiscalizador - Debugger de Máquina Fiscal</h2>
                <button class="btn btn-sm btn-secondary" t-on-click="this.close">
                    <i class="oi" data-icon="close"/> Cerrar
                </button>
            </header>

            <!-- Tabs -->
            <nav class="fiscal-debugger-tabs">
                <button 
                    t-att-class="this.state.activeTab === 'monitor' ? 'active' : ''"
                    t-on-click="() => this.switchTab('monitor')">
                    📊 Monitor de Tramas
                </button>
                <button 
                    t-att-class="this.state.activeTab === 'status' ? 'active' : ''"
                    t-on-click="() => this.switchTab('status')">
                    🚦 Status Parser
                </button>
                <button 
                    t-att-class="this.state.activeTab === 's3' ? 'active' : ''"
                    t-on-click="() => this.switchTab('s3')">
                    📋 Diagnóstico Tasas
                </button>
                <button 
                    t-att-class="this.state.activeTab === 'console' ? 'active' : ''"
                    t-on-click="() => this.switchTab('console')">
                    💻 Consola Raw
                </button>
                <button 
                    t-att-class="this.state.activeTab === 'flags' ? 'active' : ''"
                    t-on-click="() => this.switchTab('flags')">
                    🏴 Flags
                </button>
            </nav>

            <!-- Tab Content -->
            <div class="fiscal-debugger-content">

                <!-- TAB: Monitor de Tramas -->
                <div t-if="this.state.activeTab === 'monitor'" class="tab-panel">
                    <div class="monitor-controls">
                        <button class="btn btn-sm btn-primary" t-on-click="this.clearLog">
                            <i class="oi oi-filled" data-icon="delete"/> Limpiar Log
                        </button>
                        <button class="btn btn-sm btn-success" t-on-click="this.exportLog">
                            <i class="oi" data-icon="download"/> Exportar Log
                        </button>
                        <label class="auto-scroll-toggle">
                            <input 
                                type="checkbox" 
                                t-model="this.autoScroll"/>
                            Auto-scroll
                        </label>
                    </div>

                    <div class="fiscal-debugger-log">
                        <t t-if="this.state.commandLog.length === 0">
                            <p class="text-muted">No hay comandos registrados aún.</p>
                        </t>
                        <t t-else="">
                            <t t-foreach="this.state.commandLog" t-as="entry" t-key="entry_index">
                                <div t-att-class="'log-entry log-' + (entry.direction || entry.type)">
                                    <span class="log-timestamp" t-out="entry.timestamp"/>
                                    
                                    <t t-if="entry.direction === 'sent'">
                                        <span class="log-direction">⬆️ SENT:</span>
                                        <span class="log-command" t-out="entry.command"/>
                                    </t>
                                    
                                    <t t-elif="entry.direction === 'received'">
                                        <span class="log-direction">⬇️ RECEIVED:</span>
                                        <span t-att-class="entry.success ? 'log-success' : 'log-error'">
                                            <t t-if="entry.success">
                                                <span t-out="entry.data"/> 
                                                <small class="log-duration">(<t t-out="entry.duration"/>ms)</small>
                                            </t>
                                            <t t-else="">
                                                <span t-out="entry.error"/>
                                            </t>
                                        </span>
                                    </t>
                                    
                                    <t t-else="">
                                        <span t-att-class="'log-message log-' + entry.type" t-out="entry.message"/>
                                    </t>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>

                <!-- TAB: Status Parser -->
                <div t-if="this.state.activeTab === 'status'" class="tab-panel">
                    <div class="status-controls">
                        <button class="btn btn-sm btn-primary" t-on-click="this.refreshStatus">
                            <i class="oi" data-icon="refresh"/> Refrescar Status
                        </button>
                        <label class="auto-refresh-toggle">
                            <input 
                                type="checkbox" 
                                t-model="this.autoRefresh"
                                t-on-change="this.toggleAutoRefresh"/>
                            Auto-refresh (2s)
                        </label>
                    </div>

                    <t t-if="!this.hasConnection">
                        <div class="alert alert-warning">
                            ⚠️ No hay conexión con la impresora fiscal.
                        </div>
                    </t>

                    <t t-elif="this.state.currentStatus">
                        <div class="status-display">
                            <!-- Status General -->
                            <div class="status-card">
                                <h4>Estado General</h4>
                                <div class="status-badge" t-att-style="'background-color: ' + this.statusIndicators.overall.color">
                                    <t t-out="this.statusIndicators.overall.icon"/>
                                    <t t-out="this.state.currentStatus.statusText"/>
                                </div>
                                <p class="status-raw">
                                    <strong>STS1:</strong> 0x<t t-out="this.state.currentStatus.rawHex.sts1"/> | 
                                    <strong>STS2:</strong> 0x<t t-out="this.state.currentStatus.rawHex.sts2"/>
                                </p>
                            </div>

                            <!-- Indicadores Individuales -->
                            <div class="status-indicators">
                                <div class="status-indicator" t-att-style="'border-left-color: ' + this.statusIndicators.fiscalMode.color">
                                    <span class="indicator-icon" t-out="this.statusIndicators.fiscalMode.icon"/>
                                    <span class="indicator-text" t-out="this.statusIndicators.fiscalMode.text"/>
                                </div>
                                
                                <div class="status-indicator" t-att-style="'border-left-color: ' + this.statusIndicators.paper.color">
                                    <span class="indicator-icon" t-out="this.statusIndicators.paper.icon"/>
                                    <span class="indicator-text" t-out="this.statusIndicators.paper.text"/>
                                </div>
                                
                                <div class="status-indicator" t-att-style="'border-left-color: ' + this.statusIndicators.drawer.color">
                                    <span class="indicator-icon" t-out="this.statusIndicators.drawer.icon"/>
                                    <span class="indicator-text" t-out="this.statusIndicators.drawer.text"/>
                                </div>
                                
                                <div class="status-indicator" t-att-style="'border-left-color: ' + this.statusIndicators.memory.color">
                                    <span class="indicator-icon" t-out="this.statusIndicators.memory.icon"/>
                                    <span class="indicator-text" t-out="this.statusIndicators.memory.text"/>
                                </div>
                                
                                <div class="status-indicator" t-att-style="'border-left-color: ' + this.statusIndicators.printer.color">
                                    <span class="indicator-icon" t-out="this.statusIndicators.printer.icon"/>
                                    <span class="indicator-text" t-out="this.statusIndicators.printer.text"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    
                    <t t-else="">
                        <p class="text-muted">Presiona "Refrescar Status" para obtener el estado de la impresora.</p>
                    </t>
                </div>

                <!-- TAB: Diagnóstico S3 -->
                <div t-if="this.state.activeTab === 's3'" class="tab-panel">
                    <div class="status-controls">
                        <button class="btn btn-sm btn-primary" t-on-click="this.refreshS3Data">
                            <i class="oi" data-icon="refresh"/> Leer S3
                        </button>
                    </div>

                    <t t-if="!this.hasConnection">
                        <div class="alert alert-warning mt-3">
                            ⚠️ No hay conexión con la impresora fiscal.
                        </div>
                    </t>

                    <t t-elif="this.state.s3Error">
                        <div class="alert alert-danger mt-3">
                            <strong>Error S3:</strong> <t t-out="this.state.s3Error"/>
                        </div>
                    </t>

                    <t t-elif="this.state.s3Data">
                        <div class="status-display">
                            <div class="status-card">
                                <h4>Tasas Programadas</h4>
                                <table class="table table-sm mt-2">
                                    <thead>
                                        <tr>
                                            <th>Tasa</th>
                                            <th>Tipo</th>
                                            <th>Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Tasa 1</td>
                                            <td><t t-out="this.state.s3Data.tax1.typeLabel"/></td>
                                            <td><t t-out="this.state.s3Data.tax1.value"/>%</td>
                                        </tr>
                                        <tr>
                                            <td>Tasa 2</td>
                                            <td><t t-out="this.state.s3Data.tax2.typeLabel"/></td>
                                            <td><t t-out="this.state.s3Data.tax2.value"/>%</td>
                                        </tr>
                                        <tr>
                                            <td>Tasa 3</td>
                                            <td><t t-out="this.state.s3Data.tax3.typeLabel"/></td>
                                            <td><t t-out="this.state.s3Data.tax3.value"/>%</td>
                                        </tr>
                                        <tr>
                                            <td>IGTF</td>
                                            <td><t t-out="this.state.s3Data.igtf.typeLabel"/></td>
                                            <td><t t-out="this.state.s3Data.igtf.value"/>%</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="status-card mt-3">
                                <h4>Flags del Sistema</h4>
                                <t t-if="this.state.s3Data.systemFlags.length">
                                    <p>
                                        <t t-foreach="this.state.s3Data.systemFlags" t-as="flag" t-key="flag_index">
                                            <span class="badge bg-secondary me-1" t-out="flag"/>
                                        </t>
                                    </p>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">S3 no reportó flags del sistema.</p>
                                </t>
                            </div>
                        </div>
                    </t>

                    <t t-else="">
                        <p class="text-muted">Presiona "Leer S3" para consultar tasas y flags de la impresora.</p>
                    </t>
                </div>

                <!-- TAB: Consola Raw -->
                <div t-if="this.state.activeTab === 'console'" class="tab-panel">
                    <div class="console-panel">
                        <!-- Accesos Rápidos -->
                        <div class="quick-actions">
                            <h5>⚡ Accesos Rápidos</h5>
                            <div class="quick-actions-buttons">
                                <button class="btn btn-primary" t-on-click="this.testConnection">
                                    <i class="oi" data-icon="power"/> Test Conexión
                                </button>
                                <button class="btn btn-info" t-on-click="() => this.quickCommand('D')">
                                    <i class="oi" data-icon="article"/> Programación
                                </button>
                                <button class="btn btn-success" t-on-click="() => this.quickCommand('I0X')">
                                    <i class="oi" data-icon="bar_chart"/> Reporte X
                                </button>
                                <button class="btn btn-warning" t-on-click="() => this.quickCommand('I0Z')">
                                    <i class="oi" data-icon="event_available"/> Reporte Z
                                </button>
                                <button class="btn btn-secondary" t-on-click="() => this.quickCommand('0')">
                                    <i class="oi" data-icon="inbox"/> Abrir Gaveta
                                </button>
                            </div>
                        </div>

                        <div class="alert alert-info mt-3">
                            <strong>⚠️ Modo Avanzado:</strong> Envía comandos crudos directamente a la impresora.
                            <br/>
                            <strong>Comandos de impresión:</strong> <code>D</code> (Programación), <code>I0X</code> (Reporte X), <code>I0Z</code> (Reporte Z), <code>0</code> (Abrir Gaveta)
                            <br/>
                            <strong>Configurar flags:</strong> <code>PJnnvv</code> (ej: <code>PJ0102</code> = flag 01, valor 02)
                        </div>

                        <div class="console-input-group">
                            <label>Comando:</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                t-model="this.rawCommand"
                                placeholder="Ej: I0X"/>
                            <button class="btn btn-primary" t-on-click="this.sendRawCommand">
                                <i class="oi oi-filled" data-icon="send"/> Enviar
                            </button>
                        </div>

                        <div class="console-output">
                            <label>Respuesta:</label>
                            <textarea 
                                class="form-control" 
                                rows="10" 
                                readonly="readonly"
                                t-att-value="this.state.rawResponse"/>
                        </div>
                    </div>
                </div>

                <!-- TAB: Flags -->
                <div t-if="this.state.activeTab === 'flags'" class="tab-panel">
                    <div class="flags-panel">
                        <div class="alert alert-warning">
                            <strong>⚠️ Configuración Avanzada:</strong> Las banderas (flags) configuran el comportamiento de la impresora.
                            <br/>
                            Consulta el Manual TFHKA antes de modificar. <strong>Cambios incorrectos pueden afectar la fiscalización.</strong>
                        </div>

                        <div class="flag-form">
                            <div class="form-group">
                                <label>Número de Flag (00-99):</label>
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    maxlength="2"
                                    t-model="this.flagNumber"
                                    placeholder="Ej: 01"/>
                            </div>

                            <div class="form-group">
                                <label>Valor (00-99):</label>
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    maxlength="2"
                                    t-model="this.flagValue"
                                    placeholder="Ej: 02"/>
                            </div>

                            <button class="btn btn-warning" t-on-click="this.sendFlag">
                                <i class="oi oi-filled" data-icon="flag"/> Enviar Flag
                            </button>
                        </div>

                        <div class="flags-reference">
                            <h5>Referencia Rápida de Flags Comunes:</h5>
                            <ul>
                                <li><strong>Flag 01:</strong> Configuración de Caracteres por Línea</li>
                                <li><strong>Flag 04:</strong> Apertura Automática de Gaveta</li>
                                <li><strong>Flag 21:</strong> Impresión de Logo/Header</li>
                                <li><strong>Flag 24:</strong> Control de Gaveta</li>
                            </ul>
                            <p class="text-muted">
                                <small>Consulta el Manual TFHKA v8.4.2 para la lista completa de flags disponibles según tu modelo de impresora.</small>
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
