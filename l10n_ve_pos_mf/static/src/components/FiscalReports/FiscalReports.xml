<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="l10n_ve_pos_mf.FiscalReports">
        <div class="fiscal-reports-container">
            <h4 class="fiscal-reports-title">Reportes Fiscales</h4>
            <div class="fiscal-reports-buttons">
                <button 
                    class="btn btn-primary fiscal-report-btn"
                    t-on-click="printReportX">
                    <i class="fa fa-file-text-o"/> Reporte X
                </button>
                <button 
                    class="btn btn-danger fiscal-report-btn"
                    t-on-click="printReportZ">
                    <i class="fa fa-file-text"/> Reporte Z (Cierre)
                </button>
            </div>
        </div>
    </t>

</templates>
