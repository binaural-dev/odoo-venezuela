<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_ve_pos_mf.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('print') and contains(@t-on-click, 'doFullPrint')]" position="replace"/>
        <xpath expr="//div[hasclass('pos-receipt-container')]" position="replace"/>
        <xpath expr="//div[hasclass('receipt-options')]" position="before">
            <div t-if="currentOrder.mf_invoice_number" class="text-center d-flex flex-column align-items-center mb-3 p-3 bg-light border rounded shadow-sm">
                <div class="fw-bold fs-5 text-success mb-2">
                    <t t-if="currentOrder.totalDue &lt; 0">Nota de Crédito Impresa</t>
                    <t t-else="">Factura Fiscal Impresa</t>
                </div>
                <p class="fw-bold mb-1" style="font-size: 1.15rem;">
                    Nro: <span class="text-primary"><t t-out="currentOrder.mf_invoice_number"/></span>
                </p>
                <p t-if="currentOrder.fiscal_machine" class="text-muted mb-1" style="font-size: 0.9rem; font-weight: normal;">
                    Serial Máquina: <t t-out="currentOrder.fiscal_machine"/>
                </p>
                <p t-if="currentOrder.mf_reportz" class="text-muted mb-0" style="font-size: 0.9rem; font-weight: normal;">
                    Reporte Z: <t t-out="currentOrder.mf_reportz"/>
                </p>
            </div>
        </xpath>
    </t>
</templates>
