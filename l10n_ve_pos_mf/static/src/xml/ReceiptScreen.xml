<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="binaural_pos_mf.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-container')]" position="before">
            <div t-if="currentOrder.mf_invoice_number" class="d-flex flex-column m-4 mb-0 alert alert-info">
                <p class="mb-1"><strong>Nro Factura:</strong> <t t-out="currentOrder.mf_invoice_number"/></p>
                <p t-if="currentOrder.fiscal_machine" class="mb-1">
                    <strong>Serial de la Maquina fiscal:</strong> <t t-out="currentOrder.fiscal_machine"/>
                </p>
                <p t-if="currentOrder.mf_reportz" class="mb-0">
                    <strong>Pertenece al siguiente Z:</strong> <t t-out="currentOrder.mf_reportz"/>
                </p>
            </div>
        </xpath>
    </t>
</templates>