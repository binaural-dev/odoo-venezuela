<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="binaural_pos_mf.ReceiptScreen" t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[1]/div[1]/div[2]/div[1]/div[1]" position="before">
            <div t-if="currentOrder.mf_invoice_number" class="text-center d-flex flex-column align-items-center m-4 mb-0 p-3 bg-light border rounded shadow-sm">
                <div class="fw-bold fs-5 text-success mb-2">
                    <t t-if="currentOrder.get_total_with_tax() &lt; 0">Nota de Credito Impresa</t>
                    <t t-else="">Factura Fiscal Impresa</t>
                </div>
                <p class="fw-bold mb-1" style="font-size: 1.15rem;">
                    Nro: <span class="text-primary"><t t-out="currentOrder.mf_invoice_number"/></span>
                </p>
                <p t-if="currentOrder.fiscal_machine" class="text-muted mb-1" style="font-size: 0.9rem; font-weight: normal;">
                    Serial Maquina: <t t-out="currentOrder.fiscal_machine"/>
                </p>
                <p t-if="currentOrder.mf_reportz" class="text-muted mb-0" style="font-size: 0.9rem; font-weight: normal;">
                    Reporte Z: <t t-out="currentOrder.mf_reportz"/>
                </p>
            </div>
        </xpath>
    </t>
</templates>
